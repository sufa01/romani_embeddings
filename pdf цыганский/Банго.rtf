\cb2 \'97 \uc0\u1052 \u1072 \u1085 \u1075 \u1101  \u1090 \u1088 \u1091 \u1073 \u1091 \u1081  \u1087 \u1086  \u1105 \u1082 \u1086 \u1088 \u1086 \u1089 \u1082 \u1086  \u1075 \u1101 \u1078 \u1080  \u1090 \u1101  \u1087 \u1101 \u1088 \u1072 \u1074 .\cb1 \
\cb2 \'97 \uc0\u1055 \u1101 \u1088 \u1101 \u1089 , \u1085 \u1072  \u1076 \u1072 \u1088 \u1072 . \u1057 \u1072 \u1088  \u1092 \u1101 \u1088 \u1080  \u1076 \u1077 \u1089 \u1072 \u1081 \u1074 \u1101 \u1083 \u1072  \'97 \u1096 \u1072 \u1081  \u1090 \u1088 \u1072 \u1076 \u1101 \u1089 . \u1055 \u1086  \u1073 \u1072 \u1088 \u1086  \u1076 \u1088 \u1086 \u1084 , \u1072 \u1081  \u1082 \u1072 \u1090 \u1101  \u1085 \u1072  \u1076 \u1091 \u1088 .\cb1 \
\cb2 \'97 \uc0\u1053 \u1072 \u1080 \u1089  \u1090 \u1091 \u1082 \u1101 .\cb1 \
\cb2 \uc0\u1052 \u1101  \u1083 \u1101 \u1084  \u1087 \u1072  \u1084 \u1072 \u1085 \u1076 \u1101  \u1082 \u1091 \u1088 \u1090 \u1082 \u1072  \u1072 \u1081  \u1097 \u1102 \u1090 \u1101 \u1084 -\u1084 \u1072  \u1076 \u1091 \u1084 \u1101 \u1089 \u1072  \u1082 \u1072 \u1081  \u1086  \u1090 \u1072 \u1090 \u1086  \u1073 \u1086 \u1074 \u1101 \u1089 \u1082 \u1086  \u1092 \u1072 \u1083 \u1086 . \u1052 \u1072 \u1085  \u1072 \u1073 \u1072  \u1094 \u1099 \u1088 \u1076 \u1101 \u1083 \u1072 \u1089  \u1072 \u1085 \u1076 \u1101  \u1083 \u1080 \u1085 \u1076 \u1088 \u1072 , \u1082 \u1072 \u1085 \u1072  \u1086  \u1087 \u1093 \u1091 \u1088 \u1086  \u1072 \u1082 \u1093 \u1072 \u1088 \u1076 \u1072 \u1089  \u1084 \u1072  \u1087 \u1072 \u1083 \u1072  \u1084 \u1101 \u1089 \u1072 \u1083 \u1103 . \u1040 \u1084 \u1101  \u1093 \u1072 \u1083 \u1072 \u1084 , \u1087 \u1080 \u1083 \u1072 \u1084  \u1095 \u1103 \u1105 , \u1089 \u1072 \u1074 \u1086  \u1089 \u1072 \u1075 \u1080 \u1103 \u1089  \u1095 \u1103 \u1088 \u1101 \u1085 \u1094 \u1072 . \u1054  \u1087 \u1093 \u1091 \u1088 \u1086  \u1095 \u1080  \u1084 \u1072 \u1081  \u1073 \u1091 \u1090  \u1087 \u1091 \u1097 \u1083 \u1072 \u1089  \u1082 \u1093 \u1072 \u1085 \u1095 \u1080 , \u1074 \u1080  \u1084 \u1101  \u1095 \u1080  \u1082 \u1072 \u1084 \u1086 \u1089  \u1090 \u1101  \u1074 \u1086 \u1088 \u1073 \u1080 \u1081 .\cb1 \
\cb2 \uc0\u1050 \u1086 \u1090 \u1072 \u1088  \u1084 \u1101  \u1083 \u1101 \u1084  \u1090 \u1101 \u1083 \u1101  \u1087 \u1072 \u1087 \u1091 \u1095 \u1080  \u1072 \u1081  \u1090 \u1099 \u1085 \u1079 \u1086 \u1089 \u1072 \u1081 \u1083 \u1101 \u1084  \u1087 \u1101  \u1073 \u1091 \u1083 \u1171 \u1080  \u1083 \u1086 \u1094 \u1072 , \u1091 \u1097 \u1103 \u1088 \u1072 \u1076 \u1099  \u1087 \u1086 \u1096 \u1090 \u1099 \u1085 \u1101 \u1089 \u1072 . \u1057 \u1072 \u1088  \u1084 \u1080 \u1096 \u1090 \u1086 , \u1082 \u1072 \u1085 \u1072  \u1087 \u1072 \u1083 \u1072  \u1083 \u1091 \u1085 \u1075 \u1086  \u1076 \u1077 \u1089  \u1072 \u1081  \u1087 \u1093 \u1072 \u1088 \u1086  \u1076 \u1088 \u1086 \u1084  \u1088 \u1072 \u1090 \u1103 \u1088 \u1101 \u1089  \u1072 \u1085 \u1076 \u1086  \u1082 \u1093 \u1101 \u1088 \u1086 \u1088 \u1086  \u1084 \u1072 \u1096 \u1082 \u1072 \u1088  \u1086  \u1074 \u1101 \u1096 \'85 \u1040 \u1074 \u1088 \u1072 \u1083  \u1073 \u1088 \u1080 \u1096 \u1099 \u1085 \u1076  \u1073 \u1072 \u1083 \u1074 \u1072 \u1083 \u1103 \u1089 \u1072 , \u1072 \u1081  \u1090 \u1091  \u1087 \u1072 \u1096 \u1083 \u1105 \u1089  \u1087 \u1072 \u1096 \u1072  \u1090 \u1072 \u1090 \u1086  \u1073 \u1086 \u1074 , \u1072 \u1081  \u1096 \u1091 \u1085 \u1101 \u1089  \u1089 \u1072 \u1088  \u1082 \u1080 \u1088 \u1094 \u1099 \u1085  \u1072 \u1085 \u1076 \u1101  \u1103 \u1075  \u1083 \u1101  \u1082 \u1072 \u1096 \u1090 . \u1052 \u1080 \u1096 \u1090 \u1086 , \u1082 \u1101  \u1089 \u1099  \u1072 \u1085 \u1076 \u1101  \u1083 \u1091 \u1084 \u1072  \u1083 \u1072 \u1097 \u1077  \u1084 \u1072 \u1085 \u1091 \u1096 .\cb1 \
\cb2 \uc0\u1069  \u1075 \u1080 \u1085 \u1076 \u1091 \u1088 \u1072  \u1072 \u1085 \u1076 \u1072  \u1096 \u1101 \u1088 \u1086  \u1076 \u1091 \u1088 \u1072 \u1081 \u1074 \u1101 \u1085 \u1072 \u1089 , \u1072 \u1081  \u1097 \u1103 \u1088 \u1072 \u1074 \u1083 \u1072 \u1089  \u1084 \u1072 \u1085  \u1101  \u1083 \u1080 \u1085 \u1076 \u1088 \u1072 . \u1025 \u1082 \u1074 \u1072 \u1088 \u1089 \u1072  \u1084 \u1101 \u1079 \u1099 \u1089 \u1072 \u1081 \u1083 \u1072 \u1089  \u1082 \u1101  \u1096 \u1091 \u1085 \u1076 \u1101 \u1084  \u1076 \u1091 \u1081  \u1079 \u1091 \u1088 \u1072 \u1083 \u1101  \u1095 \u1077 \u1085 \u1075 \u1101 \u1090 \u1099 \u1084 \u1072 \u1089 \u1082 \u1101  \u1072 \u1085 \u1075 \u1091 \u1088 \u1072 \'85 \u1052 \u1101  \u1087 \u1091 \u1090 \u1101 \u1088 \u1076 \u1101 \u1084  \u1083 \u1101  \u1103 \u1082 \u1093 \u1072  \u1072 \u1081  \u1076 \u1099 \u1082 \u1093 \u1083 \u1101 \u1084  \u1087 \u1101  \u1088 \u1080 \u1075 \u1072 . \u1054  \u1087 \u1093 \u1091 \u1088 \u1086  \u1082 \u1080 \u1076 \u1101 \u1083 \u1072 \u1089 -\u1087 \u1101  \u1090 \u1101  \u1089 \u1086 \u1074 \u1101 \u1083  \u1072 \u1081  \u1073 \u1101 \u1096 \u1083 \u1072 \u1089  \u1087 \u1086  \u1087 \u1072 \u1090 \u1086 . \u1055 \u1072 \u1083 \u1101  \u1089 \u1072 \u1088  \u1082 \u1072 \u1085 \u1072  \u1096 \u1091 \u1085 \u1076 \u1080 \u1083 \u1101  \u1083 \u1101  \u1072 \u1085 \u1075 \u1091 \u1088 \u1072 . \u1054  \u1087 \u1093 \u1091 \u1088 \u1086  \u1073 \u1086 \u1083 \u1076 \u1072 \u1089 -\u1087 \u1101  \u1082 \u1072 \u1081  \u1086  \u1092 \u1072 \u1083 \u1086 , \u1083 \u1091 \u1085 \u1078 \u1103 \u1088 \u1076 \u1072 \u1089  \u1086  \u1074 \u1072 \u1089 \u1090  \u1072 \u1081  \u1087 \u1093 \u1101 \u1085 \u1076 \u1072 \u1089 :\cb1 \
\cb2 \'97 \uc0\u1044 \u1086 \u1089 \u1090 \u1072 , \u1072 \u1073 \u1072  \u1073 \u1091 \u1090  \u1074 \u1088 \u1072 \u1084 \u1072 . \u1058 \u1088 \u1091 \u1073 \u1091 \u1081  \u1090 \u1101  \u1089 \u1086 \u1074 \u1072 \u1089 .\cb1 \
\cb2 \uc0\u1052 \u1101  \u1095 \'92\u1072 \u1090 \u1103 \u1088 \u1086 \u1089 : \u1082 \u1072 \u1089 \u1072  \u1074 \u1086 \u1074  \u1074 \u1086 \u1088 \u1073 \u1080 \u1081 ? \u1053 \u1072  \u1079 \u1091 \u1088 \u1072 \u1083 \u1086  \u1091 \u1076 \u1091 \u1090  \u1082 \u1072 \u1090 \u1072 \u1088  \u1101  \u1082 \u1080 \u1088 \u1072 \u1089 \u1080 \u1085 \u1086 \u1089 \u1082 \u1080  \u1083 \u1072 \u1084 \u1087 \u1072 , \u1082 \u1072 \u1081  \u1090 \u1086 \u1088 \u1076 \u1105 \u1083 \u1072 \u1089  \u1087 \u1072 \u1096 \u1072  \u1083 \u1101 \u1089 \u1082 \u1086  \u1090 \u1093 \u1072 \u1085 , \u1089 \u1099 \u1082 \u1072 \u1074 \u1083 \u1072 \u1089  \u1087 \u1086  \u1092 \u1072 \u1083 \u1086  \u1087 \u1091 \u1088 \u1072 \u1085 \u1101  \u1082 \u1080 \u1087 \u1091 \u1088 \u1072 . \u1055 \u1072 \u1096 \u1072  \u1083 \u1101 \u1085 \u1076 \u1101  \u1087 \u1086  \u1082 \u1072 \u1088 \u1092 \u1080 \u1085  \u1083 \u1086 \u1075 \u1080 \u1103 \u1089  \u1074 \u1080 \u1086 \u1083 \u1080 \u1085 .\cb1 \
\cb2 \'97 \uc0\u1042 \u1086 \u1074  \u1084 \u1072 \u1081  \u1073 \u1091 \u1090  \u1095 \u1080  \u1082 \u1101 \u1088 \u1083 \u1072 , \u1089 \u1086 \u1074 , \'97 \u1073 \u1086 \u1083 \u1076 \u1072 \u1089 -\u1087 \u1101  \u1084 \u1072 \u1085 \u1076 \u1101  \u1086  \u1087 \u1093 \u1091 \u1088 \u1086 .\cb1 \
\cb2 \'97 \uc0\u1050 \u1086 \u1085  \'97 \u1074 \u1086 \u1074 ? \'97 \u1087 \u1091 \u1097 \u1083 \u1101 \u1084  \u1084 \u1101 .\cb1 \
\cb2 \'97 \uc0\u1058 \u1091  \u1083 \u1101 \u1089  \u1095 \u1080  \u1078 \u1103 \u1085 \u1101 \u1089 .\cb1 \
\cb2 \uc0\u1064 \u1091 \u1076 \u1088 \u1080 \u1087 \u1101  \u1085 \u1072 \u1082 \u1093 \u1083 \u1072 \u1089  \u1087 \u1072  \u1084 \u1091 \u1088 \u1086  \u1076 \u1091 \u1084 \u1086 , \u1101  \u1083 \u1080 \u1085 \u1076 \u1088 \u1072  \u1105 \u1082 \u1074 \u1072 \u1088 \u1089 \u1072  \u1091 \u1088 \u1072 \u1081 \u1083 \u1072 \u1089 \'85 \u1054  \u1087 \u1093 \u1091 \u1088 \u1086  \u1073 \u1101 \u1096 \u1083 \u1072 \u1089  \u1072 \u1081  \u1095 \u1080  \u1084 \u1080 \u1096 \u1082 \u1080 \u1103 \u1089 -\u1087 \u1101 , \u1074 \u1080  \u1084 \u1101  \u1095 \'92\u1072 \u1090 \u1103 \u1088 \u1086 \u1089 , \u1082 \u1072 \u1081  \u1074 \u1086 \u1074  \u1076 \u1099 \u1082 \u1093 \u1101 \u1083 \u1072 \u1089 , \u1087 \u1101  \u1084 \u1072 \u1085 \u1076 \u1101  \u1074 \u1072 \u1081  \u1087 \u1101  \u1103 \u1075  \u1082 \u1101  \u1076 \u1099 \u1095 \u1105 \u1083 \u1072 \u1089  \u1087 \u1072 \u1083 \u1072  \u1073 \u1086 \u1074 \u1101 \u1089 \u1082 \u1086  \u1074 \u1091 \u1076 \u1072 \u1088 : \u1074 \u1086 \u1074  \u1089 \u1072 \u1089  \u1089 \u1072  \u1072 \u1085 \u1076 \u1101  \u1087 \u1101 \u1089 \u1082 \u1101  \u1075 \u1080 \u1085 \u1076 \u1091 \u1088 \u1072 .\cb1 \
\cb2 \uc0\u1052 \u1101  \u1072 \u1090 \u1103 \u1088 \u1076 \u1101 \u1084  \u1082 \u1101  \u1072 \u1073 \u1072  \u1095 \u1080  \u1089 \u1086 \u1074 \u1086  \u1072 \u1081  \u1087 \u1091 \u1097 \u1083 \u1101 \u1084 :\cb1 \
\cb2 \'97 \uc0\u1050 \u1072 \u1076 \u1086  \u1090 \u1091  \u1073 \u1072 \u1096 \u1072 \u1074 \u1101 \u1089  \u1087 \u1101  \u1083 \u1072 \u1090 \u1101 ?\cb1 \
\cb2 \'97 \uc0\u1042 \u1072 \u1088 \u1080 -\u1082 \u1072 \u1085 \u1072  \u1073 \u1072 \u1096 \u1072 \u1074 \u1086 \u1089 . \u1040 \u1082 \u1072 \u1085 \u1072 \u1082  \u1074 \u1086 \u1081  \u1082 \u1086 \u1088 \u1082 \u1086 \u1088 \u1080  \u1073 \u1072 \u1096 \u1072 \u1074 \u1101 \u1083 .\cb1 \
\cb2 \'97 \uc0\u1057 \u1072 \u1088  \u1082 \u1072 \u1076 \u1086 \'85 \'97 \u1082 \u1086 \u1088 \u1082 \u1086 \u1088 \u1080 ?!\cb1 \
\cb2 \uc0\u1054  \u1087 \u1093 \u1091 \u1088 \u1086  \u1088 \u1099 \u1085 \u1078 \u1103 \u1103 \u1089 :\cb1 \
\cb2 \'97 \uc0\u1041 \u1072 \u1096 \u1072 \u1074 \u1101 \u1083 ! \u1040 \u1085 \u1076 \u1086  \u1084 \u1091 \u1088 \u1086  \u1080 \u1083 \u1086 , \u1072 \u1085 \u1076 \u1101  \u1084 \u1091 \u1088 \u1101  \u1075 \u1080 \u1085 \u1076 \u1091 \u1088 \u1072 \'85 \u1040 \u1090 \u1091 \u1085 \u1095 \u1080  \u1084 \u1072 \u1085 \u1075 \u1101  \u1084 \u1101 \u1079 \u1099 \u1081 -\u1087 \u1101  \u1082 \u1101  \u1084 \u1091 \u1088 \u1086  \u1087 \u1072 \u1081 \u1090 \u1072 \u1096 \u1099  \u1087 \u1072 \u1083 \u1101  \u1083 \u1101 \u1083  \u1083 \u1072  \u1072 \u1085 \u1076 \u1101  \u1087 \u1101 \u1089 \u1082 \u1101  \u1074 \u1072 \u1089 \u1090 .\cb1 \
\cb2 \'97 \uc0\u1040 \u1081  \u1082 \u1086 \u1085  \u1089 \u1072 \u1089  \u1090 \u1080 \u1088 \u1086  \u1087 \u1072 \u1081 \u1090 \u1072 \u1096 \u1099 ?\cb1 \
\cb2 \uc0\u1054  \u1087 \u1093 \u1091 \u1088 \u1086  \u1072 \u1097 \u1103 \u1076 \u1080 \u1083 \u1072 \u1089 , \u1082 \u1086 \u1090 \u1072 \u1088  \u1087 \u1093 \u1101 \u1085 \u1076 \u1072 \u1089 :\cb1 \
\cb2 \'97 \uc0\u1063 \u1080  \u1078 \u1103 \u1085 \u1072 \u1074 , \u1089 \u1072 \u1088  \u1090 \u1101  \u1087 \u1093 \u1101 \u1085 \u1072 \u1074 \'85 \u1048 \u1074 \u1072  \u1084 \u1101  \u1078 \u1103 \u1085 \u1086 \u1089  \u1083 \u1101 \u1089 , \u1089 \u1072 \u1088  \u1082 \u1093 \u1086 \u1085 \u1080 \u1082  \u1087 \u1101  \u1083 \u1091 \u1084 \u1072 , \u1091 \u1085 \u1080 \u1074 \u1072 \u1088  \u1084 \u1072 \u1085 \u1075 \u1101  \u1084 \u1101 \u1079 \u1099 \u1081 -\u1087 \u1101  \u1082 \u1101  \u1082 \u1072 \u1076 \u1086  \u1089 \u1072 \u1089  \u1076 \u1091 \u1081  \u1084 \u1072 \u1085 \u1091 \u1096 . \u1042 \u1072 \u1081  \u1074 \u1086 \u1074  \u1089 \u1072 \u1089  \u1084 \u1072 \u1085 \u1091 \u1096  \'97 \u1072 \u1081  \u1074 \u1086 \u1074  \u1089 \u1072 \u1089  \u1074 \u1080  \u1084 \u1091 \u1079 \u1099 \u1082 \u1072 \'85 \u1060 \u1101 \u1088 \u1080  \u1082 \u1072 \u1076 \u1086  \u1089 \u1072 \u1089  \u1085 \u1072  \u1084 \u1072 \u1085 \u1091 \u1096 \u1072 \u1085 \u1099  \u1084 \u1091 \u1079 \u1099 \u1082 \u1072 \'85 \u1040 \u1085 \u1076 \u1072  \u1082 \u1086 \u1076 \u1072 \u1083  \u1076 \u1091 \u1081 -\u1078 \u1077 \u1085 \u1077  \u1074 \u1072 \u1088 \u1080 -\u1082 \u1086 \u1085  \u1090 \u1088 \u1091 \u1073 \u1091 \u1103 \u1089  \u1090 \u1101  \u1072 \u1074 \u1101 \u1083  \u1072 \u1085 \u1075 \u1083 \u1091 \u1085 \u1086 . \u1040 \u1090 \u1091 \u1085 \u1095 \u1080  \u1086  \u1084 \u1072 \u1085 \u1091 \u1096  \u1084 \u1091 \u1083 \u1072 \u1089 . \u1064 \u1072 \u1081 , \u1074 \u1086 \u1085  \u1084 \u1091 \u1083 \u1101  \u1089 \u1086 \u1083 -\u1076 \u1091 \u1081 ? \u1064 \u1072 \u1081  \u1074 \u1080  \u1085 \u1072 \u1089  \u1082 \u1093 \u1072 \u1085 \u1095 \u1080 , \u1092 \u1101 \u1088 \u1080  \u1082 \u1072 \u1076 \u1099  \u1074 \u1080 \u1086 \u1083 \u1080 \u1085  \u1082 \u1101  \u1080 \u1085 \u1082 \u1101  \u1076 \u1101 \u1083 -\u1087 \u1101  \u1075 \u1080 \u1085 \u1076 \u1086  \u1087 \u1072  \u1082 \u1086 \u1076 \u1099  \u1087 \u1091 \u1088 \u1072 \u1085 \u1099  \u1074 \u1088 \u1072 \u1084 \u1072 \'85\cb1 \
\cb2 \uc0\u1064 \u1091 \u1085 \u1076 \u1080 \u1083 \u1072 \u1089  \u1087 \u1072 \u1083 \u1101  \u1085 \u1072  \u1079 \u1091 \u1088 \u1072 \u1083 \u1086  \u1074 \u1080 \u1086 \u1083 \u1080 \u1085 \u1072 \u1082 \u1086  \u1075 \u1083 \u1072 \u1089 \u1086 . \u1054  \u1087 \u1093 \u1091 \u1088 \u1086  \u1076 \u1099 \u1082 \u1093 \u1083 \'e1\u1089  \u1087 \u1101  \u1084 \u1072 \u1085 \u1076 \u1101 :\cb1 \
\cb2 \'97 \uc0\u1053 \u1072  \u1076 \u1072 \u1088 \u1072 ! \u1050 \u1072 \u1076 \u1086  \u1074 \u1086 \u1081  \u1073 \u1088 \u1080 \u1075 \u1080 \u1081  \u1087 \u1072  \u1087 \u1091 \u1088 \u1072 \u1085 \u1099  \u1074 \u1088 \u1072 \u1084 \u1072 . \u1051 \u1072 \u1089 \u1072  \u1082 \u1072 \u1076 \u1086  \u1082 \u1101 \u1088 \u1076 \u1105 \u1083 .\cb1 \
\cb2 \uc0\u1052 \u1101  \u1076 \u1099 \u1082 \u1093 \u1086 \u1089  \u1087 \u1086  \u1087 \u1093 \u1091 \u1088 \u1086 , \u1082 \u1086 \u1090 \u1072 \u1088  \u1087 \u1101  \u1074 \u1080 \u1086 \u1083 \u1080 \u1085 , \u1072 \u1081  \u1095 \u1080  \u1090 \u1088 \u1086 \u1084 \u1072 \u1103 \u1089  \u1090 \u1101  \u1087 \u1091 \u1097 \u1103 \u1074  \u1083 \u1101 \u1089 . \u1042 \u1086 \u1074  \u1073 \u1080  \u1097 \u1080 \u1076 \u1103 \u1088 \u1072 \u1082 \u1086  \u1083 \u1072 \u1089  \u1094 \u1091 \u1082 \u1101 \u1083 \u1101 \u1094 \u1099  \u1076 \u1091 \u1075 \u1072 \u1085 \u1086 \u1089 \u1072 , \u1087 \u1093 \u1101 \u1088 \u1076 \u1072 \u1089  \u1083 \u1101 \u1089 \u1072  \u1101  \u1083 \u1102 \u1083 \u1103 \u1074 \u1072 , \u1082 \u1086 \u1090 \u1072 \u1088  \u1087 \u1093 \u1101 \u1085 \u1076 \u1072 \u1089 :\cb1 \
\cb2 \'97 \uc0\u1058 \u1101  \u1085 \u1072 \u1081  \u1090 \u1091 \u1090  \u1089 \u1086 \u1080 \u1087 \u1101  \'97 \u1096 \u1091 \u1085 .\cb1 \
\cb2 \uc0\u1052 \u1101  \u1074 \u1072 \u1079 \u1076 \u1101 \u1084 -\u1084 \u1072  \u1087 \u1072  \u1084 \u1091 \u1088 \u1086  \u1090 \u1093 \u1072 \u1085  \u1072 \u1081  \u1097 \u1102 \u1090 \u1101 \u1084 -\u1084 \u1072  \u1076 \u1091 \u1084 \u1101 \u1089 \u1072  \u1082 \u1072 \u1088 \u1080 \u1085 \u1075  \u1086  \u1090 \u1072 \u1090 \u1086  \u1073 \u1086 \u1074 . \u1054  \u1087 \u1093 \u1091 \u1088 \u1086  \u1087 \u1093 \u1072 \u1073 \u1072 \u1088 \u1076 \u1072 \u1089  \u1083 \u1102 \u1083 \u1103 \u1074 \u1072 , \u1094 \u1099 \u1088 \u1076 \u1072 \u1089  \u1076 \u1091 \u1081 -\u1090 \u1088 \u1080 \u1085  \u1090 \u1093 \u1091 \u1074 \u1072  \u1072 \u1081  \u1082 \u1080 \u1079 \u1076 \u1099 \u1089 \u1072 \u1088 \u1076 \u1072 \u1089  \u1087 \u1101 \u1089 \u1082 \u1086  \u1087 \u1072 \u1085 \u1072 \u1089 \u1099 . \u1042 \u1086 \u1074  \u1076 \u1099 \u1082 \u1093 \u1083 \u1072 \u1089  \u1072 \u1085 \u1075 \u1083 \u1072  \u1087 \u1101 \u1089 \u1090 \u1101 , \u1089 \u1072 \u1088  \u1082 \u1072 \u1085 \u1072  \u1086  \u1090 \u1088 \u1072 \u1105  \u1085 \'e1\u1082 \u1093 \u1083 \u1072 \u1089  \u1072 \u1085 \u1075 \u1083 \u1072  \u1083 \u1101 \u1089 \u1082 \u1101  \u1103 \u1082 \u1093 \u1072 . \u1040 \u1081  \u1083 \u1101 \u1089 \u1082 \u1086  \u1087 \u1072 \u1085 \u1072 \u1089 \u1099  \u1089 \u1072 \u1089  \u1089 \u1072 \u1088  \u1076 \u1080 \u1083 \u1099  \u1074 \u1072 \u1081  \u1087 \u1072 \u1088 \u1072 \u1084 \u1080 \u1095 \u1072 , \u1074 \u1072 \u1081  \u1083 \u1101  \u1073 \u1091 \u1090 \u1101 -\u1073 \u1101 \u1088 \u1096 \u1101 \u1085 \u1075 \u1080  \u1087 \u1091 \u1088 \u1072 \u1085 \u1080 \u1103 .\cb1 \
\cb2 \'ab\uc0\u1042 \u1072 \u1088 \u1080 -\u1082 \u1072 \u1085 \u1072  \u1072 \u1085 \u1076 \u1101  \u1082 \u1072 \u1076 \u1072 \u1083  \u1088 \u1080 \u1075 \u1072  \u1084 \u1101  \u1076 \u1101  \u1094 \u1099 \u1085 \u1072 \u1088 \u1072  \u1083 \u1099 \u1096 \u1099 \u1103 \u1089  \u1087 \u1072 \u1083 \u1072  \u1075 \u1088 \u1072 \u1089  \u1072 \u1085 \u1076 \u1086  \u1072 \u1084 \u1072 \u1088 \u1086  \u1090 \u1072 \u1073 \u1086 \u1088 \u1086 . \u1044 \u1091 \u1083 \u1084 \u1091 \u1090  \u1082 \u1072 \u1076 \u1086  \u1089 \u1072 \u1089 \'85 \u1050 \u1072 \u1076 \u1101  \u1076 \u1091 \u1083 \u1084 \u1091 \u1090 , \u1095 \u1080  \u1085 \u1072  \u1095 \u1080  \u1089 \u1101 \u1088 \u1072 \u1074 , \u1082 \u1072 \u1090 \u1080  \u1073 \u1101 \u1088 \u1096  \u1085 \u1072 \u1095 \u1080 \u1083 \u1072 \u1089 \'85 \u1052 \u1101  \u1072 \u1085 \u1076 \u1101  \u1082 \u1086 \u1076 \u1099  \u1074 \u1088 \u1072 \u1084 \u1072  \u1089 \u1099 \u1084 \u1072 \u1089  \u1080 \u1085 \u1082 \u1101  \u1097 \u1103 \u1074 \u1086 \u1088 \u1086 . \u1040 \u1090 \u1091 \u1085 \u1095 \u1080  \u1090 \u1088 \u1072 \u1080 \u1089 \u1072 \u1088 \u1072 \u1089 \u1072 \u1089  \u1072 \u1084 \u1101  \u1084 \u1080 \u1096 \u1090 \u1086 : \u1089 \u1072 \u1089  \u1072 \u1084 \u1101  \u1083 \u1072 \u1097 \u1077  \u1075 \u1088 \u1072 \u1089 , \u1171 \u1101 \u1088 \u1085 \u1077 \u1074 \u1086 . \u1052 \u1091 \u1088 \u1101  \u1076 \u1072 \u1076 \u1101 \u1089  \u1076 \u1101 \u1085 \u1072 \u1089  \u1087 \u1072 \u1090 \u1080 \u1074  \u1072 \u1085 \u1076 \u1086  \u1090 \u1072 \u1073 \u1086 \u1088 \u1086 . \u1057 \u1086  \u1080 \u1085 \u1082 \u1101  \u1090 \u1088 \u1091 \u1073 \u1091 \u1081  \u1083 \u1101  \u1088 \u1086 \u1084 \u1101 \u1089 \u1082 \u1101 ?\cb1 \
\cb2 \uc0\u1060 \u1101 \u1088 \u1080  \u1105 \u1082 \u1074 \u1072 \u1088 \u1089 \u1072  \u1089 \u1072 \u1088  \u1082 \u1072 \u1085 \u1072  \u1072 \u1088 \u1084 \u1072 \u1103  \u1076 \u1099 \u1085 \u1101  \u1072 \u1084 \u1101 \u1085 . \u1040 \u1085 \u1075 \u1083 \u1091 \u1085 \u1099 \u1084 \u1072 \u1089 \u1090 \u1072 \u1088  \u1087 \u1093 \u1101 \u1085 \u1072 \u1074  \u1087 \u1072  \u1084 \u1091 \u1088 \u1086  \u1087 \u1072 \u1081 \u1090 \u1072 \u1096 \u1099 . \u1042 \u1086 \u1074  \u1089 \u1072 \u1089  \u1084 \u1072 \u1081  \u1087 \u1093 \u1091 \u1088 \u1086  \u1084 \u1072 \u1085 \u1076 \u1072 \u1088 , \u1072 \u1085 \u1076 \u1101  \u1082 \u1086 \u1076 \u1099  \u1074 \u1088 \u1072 \u1084 \u1072  \'97 \u1090 \u1101 \u1088 \u1085 \u1099 \u1171 \u1072 \u1088  \u1097 \u1103 \u1074 \u1086 . \u1050 \u1072 \u1085 \u1072  \u1074 \u1086 \u1074  \u1089 \u1072 \u1089  \u1094 \u1099 \u1085 \u1086 , \u1083 \u1101 \u1089 \u1072  \u1082 \u1101 \u1088 \u1076 \u1080 \u1083 \u1072 \u1089  \u1073 \u1072 \u1088 \u1080  \u1090 \u1088 \u1072 \u1073 \u1072 . \u1025 \u1082 \u1074 \u1072 \u1088  \u1086  \u1090 \u1072 \u1073 \u1086 \u1088 \u1086  \u1087 \u1101 \u1083 \u1072 \u1089  \u1072 \u1085 \u1076 \u1086  \u1073 \u1072 \u1088 \u1086  \u1073 \u1088 \u1080 \u1096 \u1099 \u1085 \u1076 . \u1042 \u1080 \u1083 \u1072 \u1084 \u1085 \u1099 \u1103 \u1089 , \u1082 \u1072 \u1090 \u1072 \u1088  \u1086  \u1088 \u1086 \u1085 \u1076 \u1080 \u1090 \u1086  \u1083 \u1101  \u1075 \u1088 \u1072 \u1089  \u1076 \u1072 \u1088 \u1072 \u1081 \u1083 \u1101  \u1072 \u1081  \u1097 \u1080 \u1085 \u1076 \u1101  \u1087 \u1072  \u1074 \u1101 \u1096  \u1090 \u1101  \u1085 \u1072 \u1096 \u1101 \u1085 ; \u1086  \u1074 \u1091 \u1088 \u1076 \u1086 \u1085  \u1084 \u1072 \u1083 \u1072 \u1076 \u1080 \u1083 \u1072 \u1089  \u1072 \u1085 \u1076 \u1101  \u1082 \u1086 \u1087 \u1072 \u1095 \u1103 , \u1076 \u1072 \u1089 -\u1087 \u1101  \u1084 \u1091 \u1103 \u1083  \u1072 \u1081  \u1087 \u1093 \u1072 \u1075 \u1101 \u1088 \u1076 \u1080 \u1083 \u1072 \u1089  \u1089 \u1072 . \u1040 \u1085 \u1076 \u1101  \u1082 \u1086 \u1076 \u1072 \u1083  \u1082 \u1086 \u1085  \u1089 \u1072 \u1089  \u1072 \u1085 \u1076 \u1088 \u1101 , \u1072 \u1097 \u1080 \u1083 \u1072 \u1089  \u1078 \u1102 \u1074 \u1080 \u1085 \u1076 \u1086  \u1092 \u1101 \u1088 \u1080  \u1086  \u1052 \u1080 \u1083 \u1086 \u1096 . \u1051 \u1101 \u1089  \u1073 \u1072 \u1088 \u1072 \u1088 \u1076 \u1072 \u1089  \u1083 \u1101 \u1089 \u1082 \u1080  \u1084 \u1072 \u1084 \u1080 , \u1072 \u1081  \u1074 \u1086 \u1074  \u1082 \u1072 \u1090 \u1072 \u1088  \u1082 \u1086 \u1076 \u1099  \u1074 \u1088 \u1072 \u1084 \u1072  \u1082 \u1101 \u1088 \u1076 \u1080 \u1083 \u1072 \u1089  \u1073 \u1072 \u1085 \u1075 \u1086 : \u1087 \u1086  \u1076 \u1091 \u1084 \u1086  \u1076 \u1091 \u1094 \u1086 , \u1087 \u1101 \u1082  \u1087 \u1091 \u1085 \u1088 \u1086  \u1083 \u1072 \u1085 \u1075 \u1072 \u1083 \u1072 \u1089 , \u1083 \u1091 \u1085 \u1075 \u1080  \u1074 \u1072 \u1089 \u1090 . \u1040 \u1081  \u1092 \u1101 \u1088 \u1080  \u1086  \u1084 \u1091 \u1081 \'85 \u1040 \u1083 \u1086 \u1084  \u1083 \u1101 \u1089 \u1082 \u1086  \u1084 \u1091 \u1081  \u1084 \u1080 \u1096 \u1090 \u1086  \u1095 \u1080  \u1076 \u1099 \u1082 \u1093 \u1083 \u1072 \u1089  \u1082 \u1093 \u1086 \u1085 \u1080 \u1082 , \u1082 \u1101  \u1074 \u1086 \u1074  \u1083 \u1072 \u1078 \u1103 \u1083 \u1072 \u1089  \u1082 \u1072 \u1090 \u1072 \u1088  \u1087 \u1101 \u1089 \u1082 \u1086  \u1078 \u1102 \u1085 \u1075 \u1072 \u1083 \u1080 \u1087 \u1101  \u1090 \u1072 \u1081  \u1084 \u1080 \u1085 \u1076 \u1099 \u1082  \u1087 \u1093 \u1080 \u1088 \u1083 \u1072 \u1089  \u1084 \u1091 \u1082 \u1083 \u1101  \u1082 \u1072  \u1101  \u1087 \u1093 \u1091 \u1074  \u1096 \u1101 \u1088 \u1101 \u1089 \u1072 . \u1040 \u1073 \u1072  \u1082 \u1093 \u1086 \u1085 \u1080 \u1082  \u1095 \u1080  \u1089 \u1101 \u1088 \u1101 \u1083 \u1072 \u1089  \u1083 \u1101 \u1089 \u1082 \u1086  \u1072 \u1085 \u1072 \u1074  \u1072 \u1081  \u1072 \u1082 \u1093 \u1072 \u1088 \u1085 \u1072 \u1089  \u1083 \u1101 \u1089  \'ab\u1041 \u1072 \u1085 \u1075 \u1086 \'bb.\cb1 \
\cb2 \uc0\u1050 \u1072 \u1085 \u1072  \u1083 \u1101  \u1097 \u1103 \u1074 \u1086 \u1088 \u1072  \u1087 \u1088 \u1072 \u1089 \u1072 \u1085 \u1072 \u1089  \u1083 \u1101 \u1089 , \u1074 \u1086 \u1074  \u1082 \u1101 \u1088 \u1083 \u1072 \u1089 -\u1087 \u1101  \u1090 \u1101  \u1085 \u1072 \u1096 \u1101 \u1083  \u1087 \u1072 \u1083 \u1072  \u1083 \u1101 \u1085 \u1076 \u1101  \u1090 \u1072 \u1081  \u1082 \u1101 \u1088 \u1083 \u1072 \u1089  \u1093 \u1086 \u1083 \u1103 \u1088 \u1085 \u1080 \u1082 \u1072  \u1084 \u1091 \u1103 , \u1072 \u1083 \u1086 \u1084  \u1072 \u1085 \u1076 \u1101  \u1083 \u1101 \u1089 \u1082 \u1101  \u1103 \u1082 \u1093 \u1072  \u1085 \u1072 \u1089  \u1096 \u1086 \u1171 \u1072  \u1093 \u1086 \u1083 \u1080 . \u1065 \u1103 \u1074 \u1086 \u1088 \u1072  \u1072 \u1089 \u1072 \u1085 \u1072 \u1089  \u1083 \u1086 \u1096 \u1072 \u1090 \u1072 \u1088 , \u1072 \u1081  \u1095 \u1080  \u1075 \u1080 \u1085 \u1076 \u1099 \u1085 \u1072 \u1089  \u1087 \u1072  \u1082 \u1072 \u1076 \u1086 , \u1089 \u1086  \u1082 \u1101 \u1088 \u1076 \u1105 \u1083 \u1072 \u1089  \u1072 \u1085 \u1076 \u1086  \u1083 \u1101 \u1089 \u1082 \u1086  \u1076 \u1080 . \u1057 \u1072 \u1074 \u1086 \u1088 \u1101  \u1097 \u1080 \u1090 \u1080 \u1083 \u1101  \u1083 \u1101 \u1089 \u1090 \u1101 , \u1089 \u1072 \u1088  \u1097 \u1080 \u1090 \u1105 \u1085  \u1082 \u1086 \u1083 \u1086 \u1087 \u1086 \u1089 \u1090 \u1101  \u1074 \u1072 \u1081  \u1088 \u1086 \u1074 \u1083 \u1103 \u1090 \u1101 . \u1040 \u1081  \u1074 \u1086 \u1074  \u1089 \u1072 \u1089  \u1084 \u1072 \u1085 \u1091 \u1096 \'85\cb1 \
\cb2 \uc0\u1042 \u1086 \u1088 \u1090 \u1072  \u1072 \u1085 \u1076 \u1101  \u1082 \u1086 \u1076 \u1099  \u1074 \u1088 \u1072 \u1084 \u1072  \u1074 \u1080  \u1082 \u1101 \u1088 \u1076 \u1080 \u1083 \u1072 \u1089  \u1082 \u1086 \u1076 \u1086 : \u1082 \u1072 \u1081  \u1072 \u1084 \u1101  \u1095 \u1080  \u1090 \u1088 \u1072 \u1076 \u1072 \u1089 \u1072 \u1089 , \u1089 \u1072 \u1088  \u1092 \u1101 \u1088 \u1080  \u1072 \u1097 \u1103 \u1076 \u1102 \u1074 \u1072 \u1089 \u1072 \u1089  \u1087 \u1086  \u1090 \u1093 \u1072 \u1085  \'97 \u1096 \u1091 \u1085 \u1076 \u1105 \u1083 \u1072 \u1089  \u1072 \u1085 \u1076 \u1086  \u1074 \u1101 \u1096  \u1074 \u1080 \u1086 \u1083 \u1080 \u1085 . \u1040 \u1085 \u1075 \u1083 \u1091 \u1085 \u1099 \u1084 \u1072 \u1089 \u1090 \u1101  \u1087 \u1101  \u1082 \u1072 \u1076 \u1086  \u1095 \u1080  \u1083 \u1101 \u1085 \u1072 \u1089  \u1089 \u1072 \u1084 \u1072  \u1082 \u1093 \u1086 \u1085 \u1080 \u1082 , \u1082 \u1086 \u1090 \u1072 \u1088  \u1101  \u1084 \u1091 \u1079 \u1099 \u1082 \u1072  \u1083 \u1072 \u1089  \u1090 \u1101  \u1076 \u1072 \u1088 \u1072 \u1074 \u1101 \u1083  \u1083 \u1101  \u1084 \u1072 \u1085 \u1091 \u1096 \u1101 \u1085 : \u1074 \u1086 \u1081  \u1089 \u1072 \u1082 \u1086 \u1085 \u1101  \u1076 \u1077 \u1089 \u1101 \u1089 \u1072  \u1082 \u1101 \u1088 \u1076 \u1105 \u1083 \u1072 \u1089  \u1084 \u1072 \u1081  \u1095 \u1105 \u1093 \u1072 \u1085 \u1099  \u1072 \u1081  \u1084 \u1072 \u1081  \u1079 \u1091 \u1088 \u1072 \u1083 \u1099 . \u1064 \u1091 \u1085 \u1076 \u1105 \u1083 \u1072 \u1089  \u1074 \u1080 \u1086 \u1083 \u1080 \u1085 \u1072 \u1082 \u1086  \u1171 \u1072 \u1085 \u1075 \u1086  \'97 \u1074 \u1080  \u1101  \u1073 \u1072 \u1083 \u1074 \u1072 \u1083  \u1072 \u1097 \u1103 \u1076 \u1105 \u1083 \u1072 \u1089 , \u1072 \u1081  \u1084 \u1101 \u1079 \u1099 \u1103 \u1089 -\u1087 \u1101 , \u1082 \u1101  \u1095 \u1080  \u1084 \u1080 \u1096 \u1082 \u1080 \u1081 -\u1087 \u1101  \u1087 \u1101 \u1083  \u1082 \u1086 \u1087 \u1072 \u1095 \u1103  \u1095 \u1080 \u1082  \u1087 \u1072 \u1090 \u1088 \u1080 \u1085 . \u1050 \u1093 \u1086 \u1085 \u1080 \u1082  \u1085 \u1072 \u1096 \u1090 \u1099 \u1082  \u1082 \u1101 \u1088 \u1083 \u1072 \u1089  \u1073 \u1091 \u1090 \u1080 , \u1082 \u1101  \u1089 \u1072  \u1087 \u1101 \u1088 \u1083 \u1072 \u1089  \u1072 \u1085 \u1076 \u1072  \u1083 \u1101 \u1085 \u1075 \u1101  \u1074 \u1072 \u1089 \u1090 , \u1072 \u1081  \u1084 \u1072 \u1085 \u1091 \u1096  \u1085 \u1072 \u1096 \u1090 \u1099 \u1082  \u1082 \u1101 \u1088 \u1085 \u1072 \u1089  \u1095 \u1080 \u1082  \u1087 \u1072 \u1089 \u1086 , \u1092 \u1101 \u1088 \u1080  \u1096 \u1091 \u1085 \u1085 \u1072 \u1089  \u1082 \u1072 \u1076 \u1086  \u1085 \u1072  \u1084 \u1072 \u1085 \u1091 \u1096 \u1072 \u1085 \u1086  \u1073 \u1072 \u1096 \u1072 \u1080 \u1087 \u1101 . \u1041 \u1091 \u1090 \u1101 \u1085  \u1083 \u1101 \u1083 \u1072 \u1089  \u1076 \u1072 \u1088 . \u1051 \u1101  \u1084 \u1072 \u1085 \u1091 \u1096  \u1087 \u1091 \u1097 \u1085 \u1072 \u1089  \u1077 \u1082 \u1093  \u1077 \u1082 \u1093 \u1101 \u1089 \u1090 \u1072 \u1088 : \'ab\u1057 \u1086 \u1081  \u1082 \u1072 \u1076 \u1086 ? \u1050 \u1072 \u1081  \u1086  \u1083 \u1072 \u1097 \u1080 \u1087 \u1101  \u1074 \u1072 \u1081  \u1082 \u1072 \u1081  \u1086  \u1095 \u1105 \u1088 \u1080 \u1087 \u1101 ?\'bb. \u1040 \u1081  \u1101  \u1095 \u1105 \u1093 \u1072 \u1085 \u1099  \u1084 \u1091 \u1079 \u1099 \u1082 \u1072  \u1089 \u1072 \u1082 \u1086 \u1085 \u1101  \u1076 \u1077 \u1089 \u1101 \u1089 \u1072  \u1096 \u1091 \u1085 \u1076 \u1105 \u1083 \u1072 \u1089  \u1084 \u1072 \u1081  \u1079 \u1091 \u1088 \u1072 \u1083 \u1101 \u1089 , \u1072 \u1081  \u1087 \u1072 \u1096 \u1086 \u1083 \u1072 \u1089  \u1082 \u1072 \u1088 \u1080 \u1085 \u1075  \u1101  \u1094 \u1101 \u1088 \u1171 \u1080 .\cb1 \
\cb2 \uc0\u1040 \u1085 \u1075 \u1083 \u1091 \u1085 \u1099 \u1084 \u1072 \u1089 \u1090 \u1101  \u1090 \u1101 \u1088 \u1085 \u1101  \u1097 \u1103 \u1074 \u1101 , \u1082 \u1086 \u1085  \u1089 \u1072 \u1089  \u1084 \u1072 \u1081  \u1090 \u1088 \u1086 \u1084 \u1072 \u1096 \u1086 , \u1079 \u1091 \u1084 \u1072 \u1074 \u1085 \u1072 \u1089  \u1090 \'92\u1072 \u1088 \u1072 \u1082 \u1093 \u1101 \u1085  \u1082 \u1072 \u1076 \u1072 \u1083 \u1101  \u1095 \u1105 \u1093 \u1072 \u1085 \u1101  \u1083 \u1091 \u1074 \u1091 \u1090 \u1072 \u1088 \u1101 \u1089 , \u1072 \u1083 \u1086 \u1084  \u1086  \u1088 \u1086 \u1076 \u1099 \u1087 \u1101  \u1089 \u1072 \u1089  \u1080 \u1074 \u1072 . \u1050 \u1072 \u1085 \u1072  \u1074 \u1086 \u1085  \u1087 \u1072 \u1096 \u1086 \u1085 \u1072 \u1089  \u1082 \u1072 \u1081  \u1086  \u1090 \u1093 \u1072 \u1085 , \u1082 \u1072 \u1090 \u1072 \u1088  \u1096 \u1091 \u1085 \u1076 \u1105 \u1083 \u1072 \u1089  \u1101  \u1084 \u1091 \u1079 \u1099 \u1082 \u1072  \'97 \u1074 \u1086 \u1081  \u1105 \u1082 \u1074 \u1072 \u1088 \u1089 \u1072  \u1072 \u1097 \u1103 \u1076 \u1105 \u1083 \u1072 \u1089 , \u1072 \u1081  \u1087 \u1072  \u1085 \u1072  \u1073 \u1091 \u1090  \u1074 \u1088 \u1072 \u1084 \u1072  \u1096 \u1091 \u1085 \u1076 \u1105 \u1083 \u1072 \u1089  \u1072 \u1085 \u1076 \u1101  \u1082 \u1072 \u1074 \u1101 \u1088  \u1088 \u1080 \u1075 . \u1040 \u1081  \u1091 \u1085 \u1080 \u1074 \u1072 \u1088  \u1084 \u1101 \u1079 \u1099 \u1103 \u1089  \'97 \u1074 \u1086 \u1081  \u1096 \u1091 \u1085 \u1076 \u1105 \u1083  \u1072 \u1082 \u1072 \u1088 -\u1082 \u1072 \u1081 , \u1087 \u1072  \u1089 \u1072  \u1088 \u1080 \u1075 \u1072 , \u1082 \u1101  \u1073 \u1072 \u1096 \u1072 \u1074 \u1101 \u1083  \u1082 \u1086 \u1088 \u1082 \u1086 \u1088 \u1080  \u1101  \u1087 \u1093 \u1091 \u1074 , \u1082 \u1091 \u1089 \u1072  \u1089 \u1072  \u1082 \u1086 \u1087 \u1072 \u1095 \u1103 , \u1095 \u1103 \u1088 \u1101 \u1085 \u1094 \u1072  \u1082 \u1101  \u1089 \u1099  \u1090 \u1101 \u1083 \u1072  \u1087 \u1091 \u1085 \u1088 \u1101 , \u1082 \u1101  \u1073 \u1072 \u1096 \u1072 \u1074 \u1101 \u1085  \u1074 \u1080  \u1101  \u1091 \u1095 \u1077  \u1093 \u1072 \u1088 \u1072  \u1072 \u1081  \u1079 \u1101 \u1083 \u1101 \u1085 \u1101  \u1084 \u1072 \u1083 \u1103 . \u1052 \u1091 \u1079 \u1099 \u1082 \u1072  \u1089 \u1072  \u1096 \u1091 \u1085 \u1076 \u1105 \u1083 \u1072 \u1089 , \u1072 \u1081  \u1096 \u1091 \u1076 \u1088 \u1086 \u1085 \u1072 \u1089  \u1076 \u1072 \u1088 \u1072 \u1090 \u1072 \u1088  \u1084 \u1072 \u1085 \u1091 \u1096 \u1101 \u1085 \u1075 \u1101  \u1080 \u1083 \u1101 . \u1051 \u1101  \u1072 \u1085 \u1075 \u1091 \u1088 \u1072  \u1074 \u1072 \u1079 \u1076 \u1101 \u1085 \u1072 \u1089 -\u1087 \u1101  \u1089 \u1072  \u1084 \u1072 \u1081  \u1091 \u1095 \u1077 \u1089  \u1072 \u1081  \u1084 \u1072 \u1081  \u1091 \u1095 \u1077 \u1089  \u1072 \u1085 \u1076 \u1086  \u1095 \u1077 \u1088 \u1080  \u1072 \u1081  \u1080 \u1085 \u1075 \u1101 \u1088 \u1085 \u1072 \u1089  \u1087 \u1101 \u1089 \u1072  \u1084 \u1072 \u1085 \u1091 \u1096 \u1101 \u1085 \u1075 \u1080  \u1076 \u1072 \u1088  \u1074 \u1080  \u1101  \u1083 \u1086 \u1096 . \u1050 \u1072 \u1076 \u1086  \u1089 \u1072 \u1089  \u1089 \u1072 \u1082 \u1086  \u1076 \u1077 \u1089 : \u1092 \u1101 \u1088 \u1080  \u1086  \u1082 \u1093 \u1072 \u1084  \u1084 \u1101 \u1082 \u1083 \u1072 \u1089 -\u1087 \u1101  \u1082 \u1072  \u1091 \u1095 \u1077  \u1074 \u1101 \u1096 \u1101 \u1089 \u1082 \u1101  \u1082 \u1088 \u1072 \u1085 \u1078 \u1080  \'97 \u1082 \u1080 \u1079 \u1076 \u1099 \u1103 \u1089 -\u1087 \u1101  \u1082 \u1072 \u1076 \u1086  \u1085 \u1072  \u1084 \u1072 \u1085 \u1091 \u1096 \u1072 \u1085 \u1086  \u1073 \u1072 \u1096 \u1072 \u1080 \u1087 \u1101 .\cb1 \
\cb2 \uc0\u1057 \u1072 \u1089  \u1082 \u1072 \u1081  \u1072 \u1084 \u1072 \u1088 \u1086  \u1074 \u1072 \u1081 \u1076 \u1072  \u1077 \u1082 \u1093  \u1097 \u1077 \u1081 , \u1073 \u1091 \u1097 \u1105 \u1083 \u1072 \u1089  \u1047 \u1083 \u1072 \u1090 \u1072 . \u1040 \u1081  \u1089 \u1072 \u1089  \u1072 \u1085 \u1076 \u1101  \u1083 \u1072 \u1090 \u1101  \u1073 \u1101 \u1085 \u1075 \u1072 \u1085 \u1086  \u1096 \u1091 \u1082 \u1072 \u1088 \u1080 \u1087 \u1101 ! \u1044 \u1091 \u1081  \u1095 \u1091 \u1085 \u1088 \u1080  \u1089 \u1072 \u1088  \u1076 \u1091 \u1081  \u1082 \u1072 \u1083 \u1101  \u1089 \u1072 \u1087 \u1072  \u1084 \u1101 \u1082 \u1085 \u1072 \u1089 -\u1087 \u1101  \u1087 \u1072  \u1083 \u1072 \u1082 \u1101  \u1087 \u1093 \u1080 \u1082 \u1101  \u1078 \u1080  \u1082 \u1072 \u1081  \u1086  \u1089 \u1072 \u1085 \u1086  \u1084 \u1072 \u1096 \u1082 \u1072 \u1088 . \u1040 \u1081  \u1083 \u1101  \u1074 \u1091 \u1085 \u1101 \u1090 \u1072  \u1103 \u1082 \u1093 \u1072 , \u1084 \u1101 \u1079 \u1099 \u1103 \u1089 , \u1082 \u1080 \u1076 \u1101  \u1072 \u1085 \u1076 \u1101  \u1087 \u1101 \u1089 \u1090 \u1101  \u1089 \u1072  \u1083 \u1101  \u1095 \u1101 \u1088 \u1101 \u1089 \u1082 \u1086  \u1096 \u1091 \u1082 \u1072 \u1088 \u1080 \u1087 \u1101 . \u1040 \u1083 \u1086 \u1084  \u1089 \u1072 \u1089  \u1074 \u1086 \u1081  \u1095 \u1103 \u1095 \u1077 \u1089  \u1089 \u1072 \u1088  \u1089 \u1091 \u1084 \u1085 \u1072 \u1082 \u1091 \u1085 \u1099 , \u1085 \u1072  \u1080 \u1074 \u1072  \u1076 \u1099 \u1085 \u1101  \u1083 \u1072  \u1082 \u1072 \u1089 \u1072 \u1074 \u1086  \u1072 \u1085 \u1072 \u1074 . \u1054  \u1089 \u1091 \u1084 \u1085 \u1072 \u1082 \u1072 \u1081  \u1095 \u1103 \u1082  \u1089 \u1072 \u1089 \u1090 \u1088 \u1080 , \u1072 \u1081  \u1074 \u1080  \u1072 \u1085 \u1076 \u1101  \u1047 \u1083 \u1072 \u1090 \u1072  \u1089 \u1072 \u1089  \u1095 \u1103 \u1095 \u1102 \u1085 \u1086  \u1096 \u1091 \u1076 \u1088 \u1080 \u1087 \u1101  \u1083 \u1101  \u1089 \u1072 \u1089 \u1090 \u1088 \u1101 \u1089 \u1082 \u1086 : \u1086  \u1073 \u1072 \u1088 \u1080 \u1087 \u1101  \u1072 \u1088 \u1072 \u1082 \u1093 \u1072 \u1076 \u1080 \u1083 \u1072 \u1089  \u1082 \u1093 \u1101 \u1090 \u1072 \u1085 \u1101  \u1083 \u1072 \u1089 \u1072 , \u1082 \u1072 \u1076 \u1099  \u1097 \u1077 \u1081  \u1082 \u1093 \u1072 \u1085 \u1080 \u1082 \u1072 \u1089 \u1082 \u1101  \u1095 \u1080  \u1082 \u1072 \u1084 \u1083 \u1072 \u1089  \u1090 \u1101  \u1076 \u1101 \u1083  \u1087 \u1101 \u1089 \u1082 \u1086  \u1096 \u1091 \u1082 \u1072 \u1088 \u1080 \u1087 \u1101 . \u1041 \u1091 \u1090  \u1083 \u1072 \u1097 \u1077  \u1097 \u1103 \u1074 \u1101  \u1082 \u1072 \u1084 \u1085 \u1072 \u1089  \u1090 \u1101  \u1080 \u1085 \u1075 \u1088 \u1101 \u1085  \u1083 \u1072  \u1072 \u1085 \u1076 \u1101  \u1087 \u1101 \u1089 \u1082 \u1080  \u1094 \u1101 \u1088 \u1171 \u1072 , \u1072 \u1083 \u1086 \u1084  \u1095 \u1080  \u1077 \u1082 \u1093  \u1095 \u1080  \u1073 \u1080 \u1088 \u1080 \u1089 \u1072 \u1088 \u1076 \u1072 \u1089  \u1090 \u1101  \u1080 \u1085 \u1075 \u1101 \u1076 \u1099 \u1081  \u1083 \u1072 \u1082 \u1086  \u1080 \u1083 \u1086 . \u1042 \u1086 \u1081  \u1072 \u1089 \u1072 \u1083 \u1072 \u1089  \u1089 \u1072 \u1082 \u1086 \u1085 \u1101 \u1089 \u1090 \u1072 \u1088  \u1072 \u1081  \u1087 \u1093 \u1101 \u1085 \u1083 \u1072 \u1089 : \'ab\u1058 \u1091 \u1084 \u1101  \u1096 \u1091 \u1085 \u1101 \u1085 , \u1095 \u1077  \u1084 \u1091 \u1079 \u1099 \u1082 \u1072  \u1073 \u1072 \u1096 \u1072 \u1074 \u1101 \u1083  \u1084 \u1072 \u1085 \u1075 \u1101 ? \u1058 \u1091 \u1084 \u1072 \u1088 \u1101  \u1093 \u1091 \u1088 \u1076 \u1101  \u1080 \u1083 \u1101  \u1073 \u1080 \u1088 \u1080 \u1085  \u1072 \u1074 \u1088 \u1080  \u1082 \u1072 \u1089 \u1072 \u1074 \u1086  \u1082 \u1072 \u1084 \u1072 \u1080 \u1087 \u1101 ? \u1058 \u1091 \u1084 \u1101  \u1096 \u1072 \u1081  \u1097 \u1105 \u1085 -\u1087 \u1101  \u1087 \u1072 \u1096 \u1072  \u1082 \u1086 \u1076 \u1086 , \u1082 \u1086 \u1085  \u1087 \u1093 \u1080 \u1088 \u1101 \u1083  \u1087 \u1072 \u1083 \u1072  \u1084 \u1072 \u1085 \u1076 \u1101  \u1082 \u1072 \u1088 \u1080 \u1085 \u1075 \u1086 \u1076 \u1099 ? \u1040 \u1081  \u1074 \u1080  \u1074 \u1086 \u1074  \u1090 \u1101  \u1084 \u1072 \u1085 \u1075 \u1083 \u1072  \u1084 \u1072 \u1085 , \u1084 \u1101  \u1080 \u1085 \u1082 \u1101  \u1075 \u1080 \u1085 \u1076 \u1086 \u1103 !\'bb\cb1 \
\cb2 \uc0\u1051 \u1101  \u1084 \u1072 \u1085 \u1091 \u1096  \u1076 \u1072 \u1088 \u1072 \u1081 \u1074 \u1101 \u1085 \u1072 \u1089  \u1082 \u1072 \u1090 \u1072 \u1088  \u1083 \u1072 \u1082 \u1101  \u1074 \u1086 \u1088 \u1073 \u1080 . \u1055 \u1093 \u1101 \u1085 \u1085 \u1072 \u1089 : \'ab\u1053 \u1072 \u1096 \u1090 \u1099 \u1082  \u1082 \u1101 \u1088 \u1101 \u1089  \u1087 \u1101 \u1088 \u1072 \u1089 \u1072  \u1074 \u1101 \u1096 \u1101 \u1089 \u1082 \u1101  \u1076 \u1091 \u1093 \u1086 \u1089 \u1072 , \u1074 \u1086 \u1074  \u1082 \u1072 \u1076 \u1086  \u1095 \u1080  \u1073 \u1080 \u1089 \u1090 \u1088 \u1101 \u1083  \u1082 \u1093 \u1072 \u1085 \u1080 \u1082 \u1072 \u1089 \u1082 \u1101 . \u1050 \u1072 \u1089 \u1072 \u1074 \u1101  \u1087 \u1101 \u1088 \u1072 \u1089 \u1072  \u1096 \u1072 \u1081  \u1072 \u1085 \u1101 \u1085  \u1072 \u1085 \u1076 \u1086  \u1072 \u1084 \u1072 \u1088 \u1086  \u1090 \u1072 \u1073 \u1086 \u1088 \u1086  \u1073 \u1091 \u1090  \u1085 \u1072 \u1089 \u1091 \u1083 \u1099 \u1087 \u1101 \'85\'bb\cb1 \
\cb2 \uc0\u1069  \u1084 \u1091 \u1079 \u1099 \u1082 \u1072  \u1072 \u1073 \u1072  \u1096 \u1091 \u1085 \u1076 \u1105 \u1083 \u1072 \u1089  \u1089 \u1072 \u1082 \u1086  \u1076 \u1077 \u1089 . \u1043 \u1101 \u1083 \u1101  \u1074 \u1086 \u1088 \u1073 \u1080 , \u1082 \u1101  \u1101  \u1047 \u1083 \u1072 \u1090 \u1072  \u1087 \u1101 \u1089 \u1082 \u1101  \u1085 \u1072 \u1089 \u1091 \u1083  \u1074 \u1086 \u1088 \u1073 \u1101 \u1085 \u1094 \u1072  \u1094 \u1099 \u1088 \u1076 \u1072 \u1089  \u1082 \u1072 \u1088 \u1080 \u1085 \u1075  \u1087 \u1101 \u1089 \u1090 \u1101  \u1083 \u1101  \u1074 \u1101 \u1096 \u1101 \u1089 \u1082 \u1101  \u1084 \u1072 \u1085 \u1091 \u1096 \u1101 \u1089 . \u1040 \u1090 \u1091 \u1085 \u1095 \u1080  \u1082 \u1080 \u1076 \u1101 -\u1087 \u1101  \u1083 \u1101  \u1087 \u1093 \u1091 \u1088 \u1101  \u1072 \u1081  \u1072 \u1074 \u1080 \u1083 \u1101  \u1082 \u1072 \u1081  \u1083 \u1072 \u1082 \u1086  \u1076 \u1072 \u1076 :\cb1 \
\cb2 \'97 \uc0\u1058 \u1080 \u1088 \u1080  \u1097 \u1077 \u1081  \u1094 \u1099 \u1088 \u1076 \u1101 \u1083  \u1082 \u1072 \u1088 \u1080 \u1085 \u1075  \u1087 \u1101 \u1089 \u1090 \u1101  \u1086  \u1074 \u1101 \u1096 \u1101 \u1089 \u1082 \u1086  \u1076 \u1080  \u1087 \u1101 \u1089 \u1082 \u1101  \u1074 \u1086 \u1088 \u1073 \u1101 \u1085 \u1094 \u1072 , \u1072 \u1081  \u1072 \u1082 \u1072 \u1085 \u1072 \u1082  \u1085 \u1072 \u1081  \u1072 \u1084 \u1101  \u1087 \u1072 \u1095 \u1103 , \u1074 \u1086 \u1074  \u1087 \u1093 \u1080 \u1088 \u1101 \u1083  \u1087 \u1072 \u1083 \u1072  \u1072 \u1084 \u1072 \u1088 \u1101  \u1074 \u1091 \u1088 \u1084 \u1080  \u1082 \u1072 \u1088 \u1080 \u1085 \u1075 \u1086 \u1076 \u1099 . \u1050 \u1072 \u1076 \u1099  \u1084 \u1091 \u1079 \u1099 \u1082 \u1072  \u1076 \u1072 \u1088 \u1072 \u1074 \u1101 \u1083  \u1072 \u1084 \u1101 \u1085 : \u1082 \u1072 \u1085 \u1072  \u1074 \u1086 \u1081  \u1096 \u1091 \u1085 \u1076 \u1105 \u1083  \'97 \u1089 \u1072  \u1073 \u1072 \u1088 \u1086 \u1081 -\u1087 \u1101 , \u1072 \u1084 \u1101  \u1085 \u1072 \u1096 \u1090 \u1099 \u1082  \u1087 \u1072 \u1095 \u1103 \u1089 \u1072  \u1090 \u1088 \u1072 \u1080 \u1089 \u1072 \u1088 \u1072 \u1089  \u1072 \u1081  \u1082 \u1101 \u1088 \u1072 \u1089  \u1073 \u1091 \u1090 \u1080 . \u1069 \'a0\u1047 \u1083 \u1072 \u1090 \u1072 \u1082 \u1080  \u1096 \u1091 \u1082  \u1094 \u1099 \u1088 \u1076 \u1072 \u1089  \u1082 \u1072 \u1088 \u1080 \u1085 \u1075  \u1072 \u1084 \u1101 \u1085 \u1076 \u1101  \u1073 \u1080 \u1091 \u1078 \u1101 \u1089  \'97 \u1090 \u1088 \u1091 \u1073 \u1091 \u1081  \u1090 \u1101  \u1076 \u1072 \u1089  \u1083 \u1072  \u1072 \u1085 \u1076 \u1101  \u1084 \u1072 \u1085 \u1091 \u1096 \u1101 \u1089 \u1082 \u1101  \u1074 \u1072 \u1089 \u1090 .\cb1 \
\cb2 \uc0\u1069  \u1047 \u1083 \u1072 \u1090 \u1072 \u1082 \u1086  \u1076 \u1072 \u1076  \u1087 \u1093 \u1101 \u1085 \u1076 \u1072 \u1089 :\cb1 \
\cb2 \'97 \uc0\u1057 \u1099  \u1095 \u1103 \u1095 \u1080 \u1087 \u1101  \u1072 \u1085 \u1076 \u1101  \u1090 \u1091 \u1084 \u1072 \u1088 \u1101  \u1074 \u1086 \u1088 \u1073 \u1080 , \u1074 \u1086 \u1081  \u1090 \u1101 \u1088 \u1085 \u1099 \u1171 \u1072 \u1088  \u1097 \u1077 \u1081 , \u1072 \u1081  \u1076 \u1099 \u1082 \u1093 \u1101 \u1089 -\u1090 \u1091 , \u1072 \u1074 \u1080 \u1083 \u1072 \u1089  \u1083 \u1072 \u1082 \u1080  \u1074 \u1088 \u1072 \u1084 \u1072  \u1090 \u1101  \u1078 \u1103 \u1083  \u1088 \u1086 \u1084 \u1101 \u1089 \u1090 \u1101 . \u1052 \u1101 \u1082  \u1072 \u1074 \u1101 \u1085  \u1084 \u1072 \u1085 \u1075 \u1072 \u1074 \u1101 \u1085  \u1083 \u1101  \u1088 \u1086 \u1084  \u1082 \u1101  \u1072 \u1075 \u1086 \u1088  \u1083 \u1101  \u1084 \u1080 \u1083 \u1072 \u1089 \u1082 \u1086 .\cb1 \
\cb2 \uc0\u1069  \u1047 \u1083 \u1072 \u1090 \u1072  \u1095 \u1080  \u1087 \u1093 \u1101 \u1085 \u1076 \u1072 \u1089  \u1082 \u1093 \u1072 \u1085 \u1095 \u1080 , \u1092 \u1101 \u1088 \u1080  \u1076 \u1099 \u1082 \u1093 \u1083 \'e1\u1089  \u1087 \u1101  \u1089 \u1072 \u1074 \u1086 \u1088 \u1101  \u1093 \u1086 \u1083 \u1103 \u1089 \u1072  \u1072 \u1081  \u1075 \u1101 \u1083 \u1072 \u1089 -\u1090 \u1072 \u1088  \u1072 \u1085 \u1076 \u1101  \u1094 \u1101 \u1088 \u1171 \u1072 .\cb1 \
\cb2 \uc0\u1055 \u1072 \u1082  \u1076 \u1077 \u1089  \u1072 \u1084 \u1101  \u1090 \u1088 \u1072 \u1076 \u1072 \u1084  \u1087 \u1086  \u1082 \u1072 \u1074 \u1101 \u1088  \u1090 \u1093 \u1072 \u1085 . \u1055 \u1086  \u1084 \u1101 \u1079 \u1084 \u1077 \u1088 \u1080  \u1072 \u1084 \u1072 \u1088 \u1101  \u1074 \u1091 \u1088 \u1076 \u1086 \u1085 \u1072  \u1072 \u1097 \u1103 \u1076 \u1080 \u1083 \u1101  \u1087 \u1072 \u1096 \u1072  \u1075 \u1072 \u1074 , \u1084 \u1072 \u1096 \u1082 \u1072 \u1088  \u1086  \u1085 \u1072 \u1083  \u1072 \u1081  \u1086  \u1074 \u1101 \u1096 . \u1065 \u1103 \u1074 \u1101  \u1080 \u1085 \u1079 \u1072 \u1088 \u1085 \u1072 \u1089  \u1083 \u1101  \u1094 \u1101 \u1088 \u1171 \u1080 , \u1083 \u1101  \u1078 \u1102 \u1074 \u1083 \u1103  \u1087 \u1101 \u1083  \u1103 \u1075 \u1072  \u1082 \u1080 \u1088 \u1072 \u1074 \u1085 \u1072 \u1089  \u1093 \u1072 \u1073 \u1101 . \u1050 \u1093 \u1080 \u1085 \u1086  \u1082 \u1093 \u1072 \u1084  \u1084 \u1101 \u1082 \u1083 \u1072 \u1089 -\u1087 \u1101  \u1082 \u1072 \u1088 \u1080 \u1085 \u1075  \u1086  \u1074 \u1101 \u1096 . \u1057 \u1072 \u1074 \u1086 \u1088 \u1101  \u1076 \u1072 \u1088 \u1072 \u1089 \u1072  \u1078 \u1091 \u1090 \u1103 \u1088 \u1085 \u1072 \u1089 , \u1082 \u1072 \u1085 \u1072  \u1096 \u1091 \u1085 \u1076 \u1105 \u1083 \u1072  \u1101  \u1074 \u1080 \u1086 \u1083 \u1080 \u1085 . \u1052 \u1091 \u1079 \u1099 \u1082 \u1072  \u1085 \u1072 \u1089 , \u1072 \u1081  \u1089 \u1072 \u1082 \u1086  \u1083 \u1072 \u1089 -\u1087 \u1101  \u1087 \u1072 \u1083 \u1072  \u1087 \u1101 \u1089 \u1082 \u1080  \u1073 \u1091 \u1090 \u1080 . \u1060 \u1101 \u1088 \u1080  \u1101  \u1047 \u1083 \u1072 \u1090 \u1072  \u1095 \u1080  \u1082 \u1101 \u1088 \u1083 \u1072 \u1089  \u1082 \u1093 \u1072 \u1085 \u1095 \u1080 . \u1042 \u1086 \u1081  \u1090 \u1086 \u1088 \u1076 \u1105 \u1083 \u1072 \u1089  \u1087 \u1072 \u1096 \u1072  \u1103 \u1075 , \u1089 \u1072 \u1074 \u1080  \u1082 \u1080 \u1079 \u1076 \u1099 \u1103 \u1089  \u1090 \u1101  \u1087 \u1093 \u1072 \u1073 \u1086 \u1083 , \u1072 \u1081  \u1076 \u1099 \u1082 \u1093 \u1101 \u1083 \u1072 \u1089  \u1082 \u1072 \u1088 \u1080 \u1085 \u1075  \u1086  \u1074 \u1101 \u1096 . \u1052 \u1101  \u1076 \u1099 \u1082 \u1093 \u1083 \u1101 \u1084  \u1072 \u1085 \u1076 \u1101  \u1083 \u1072 \u1082 \u1101  \u1103 \u1082 \u1093 \u1072 , \u1072 \u1081 , \u1080 \u1074 \u1072  \u1074 \u1080  \u1089 \u1099 \u1084 \u1072 \u1089  \u1080 \u1085 \u1082 \u1101  \u1097 \u1103 \u1074 \u1086 \u1088 \u1086 , \u1072 \u1090 \u1103 \u1088 \u1076 \u1101 \u1084 : \u1074 \u1086 \u1081  \u1096 \u1072 \u1081  \u1082 \u1072 \u1084 \u1101 \u1083  \u1092 \u1101 \u1088 \u1080  \u1082 \u1086 \u1076 \u1086 \u1083 \u1101 \u1089 , \u1082 \u1086 \u1085  \u1095 \u1080  \u1073 \u1072 \u1096 \u1072 \u1074 \u1101 \u1083  \u1072 \u1076 \u1077 \u1089 . \u1040 \u1085 \u1076 \u1101  \u1083 \u1072 \u1082 \u1101  \u1103 \u1082 \u1093 \u1072  \u1085 \u1072 \u1089  \u1073 \u1072 \u1088 \u1080 \u1087 \u1101 , \u1082 \u1086 \u1090 \u1101  \u1089 \u1072 \u1089  \u1101  \u1076 \u1072 \u1088 .\cb1 \
\cb2 \uc0\u1025 \u1082 \u1074 \u1072 \u1088 \u1089 \u1072  \u1074 \u1080 \u1086 \u1083 \u1080 \u1085 \u1086 \u1089 \u1082 \u1101  \u1171 \u1072 \u1085 \u1075 \u1091 \u1088 \u1072  \u1097 \u1080 \u1085 \u1075 \u1077 \u1088 \u1076 \u1101  \u1084 \u1080 \u1079 \u1084 \u1101 \u1088 \u1101 \u1089 \u1082 \u1086  \u1095 \u1077 \u1085 \u1076 \u1077 \u1096 \u1080 \u1087 \u1101 . \u1060 \u1101 \u1088 \u1080  \u1101  \u1084 \u1091 \u1079 \u1099 \u1082 \u1072  \u1082 \u1080 \u1079 \u1076 \u1099 \u1089 \u1072 \u1081 \u1083 \u1072 \u1089  \u1085 \u1072  \u1082 \u1072 \u1076 \u1101 , \u1089 \u1072 \u1088  \u1084 \u1072 \u1080 \u1085 \u1090 \u1099  \'97 \u1076 \u1077  \u1076 \u1091 \u1088 \u1072 \u1083  \u1072 \u1081  \u1083 \u1086 \u1082 \u1093 \u1086 \u1088 \u1101 \u1089 . \u1040 \u1082 \u1072 \u1085 \u1072 \u1082  \u1074 \u1086 \u1081  \u1091 \u1073 \u1088 \u1101 \u1076 \u1099 \u1089 \u1072 \u1081 \u1083 \u1072 \u1089 \u1100  \u1080 \u1085 \u1090 \u1088 \u1101 \u1075 \u1086 \u1085 \u1101  \u1079 \u1086 \u1088 \u1072 \u1089 \u1072 , \u1072 \u1085 \u1076 \u1101  \u1083 \u1072 \u1090 \u1101  \u1096 \u1091 \u1085 \u1076 \u1105 \u1083 \u1072 \u1089  \u1076 \u1091 \u1082 \u1093  \u1097 \u1080 \u1085 \u1076 \u1101  \u1088 \u1091 \u1074 \u1101 \u1089 \u1082 \u1080 , \u1088 \u1086 \u1080 \u1087 \u1101  \u1073 \u1072 \u1083 \u1074 \u1072 \u1083 \u1103 \u1082 \u1086 , \u1088 \u1086 \u1085 \u1076 \u1080 \u1090 \u1086  \u1083 \u1101  \u1095 \u1077 \u1088 \u1101 \u1089 \u1082 \u1086 , \u1072 \u1088 \u1084 \u1072 \u1103  \u1072 \u1081  \u1074 \u1080  \u1088 \u1091 \u1076 \u1080 \u1087 \u1101 . \u1051 \u1101  \u1084 \u1072 \u1085 \u1091 \u1096  \u1097 \u1102 \u1074 \u1085 \u1072 \u1089  \u1076 \u1072 \u1088 \u1072 \u1090 \u1072 \u1088  \u1087 \u1101  \u1087 \u1101 \u1089 \u1090 \u1101  \u1090 \u1088 \u1091 \u1096 \u1091 \u1083 \u1072 \'85\cb1 \
\cb2 \uc0\u1047 \u1083 \u1072 \u1090 \u1072  \u1072 \u1089 \u1072 \u1103 \u1089  \u1085 \u1072 \u1089 \u1091 \u1083  \u1072 \u1089 \u1072 \u1084 \u1072 \u1089 \u1072 :\cb1 \
\cb2 \'97 \uc0\u1042 \u1086 \u1074  \u1082 \u1072 \u1090 \u1101 ! \u1042 \u1086 \u1074  \u1078 \u1091 \u1090 \u1103 \u1088 \u1101 \u1083  \u1084 \u1072 \u1085 ! \'97 \u1094 \u1099 \u1087 \u1080 \u1089 \u1072 \u1088 \u1076 \u1072 \u1089  \u1074 \u1086 \u1081 .\cb1 \
\cb2 \uc0\u1052 \u1101  \u1076 \u1099 \u1082 \u1093 \u1086 \u1089  \u1087 \u1101  \u1083 \u1072 \u1082 \u1086  \u1084 \u1091 \u1081 , \u1072 \u1081  \u1084 \u1072 \u1085 \u1075 \u1101  \u1089 \u1099 \u1082 \u1072 \u1076 \u1080 \u1083 \u1072 \u1089 , \u1082 \u1101  \u1074 \u1086 \u1081  \u1076 \u1072 \u1089  \u1090 \u1101 \u1083 \u1101  \u1087 \u1072  \u1075 \u1086 \u1076 \u1080 .\cb1 \
\cb2 \uc0\u1051 \u1101  \u1171 \u1072 \u1085 \u1075 \u1091 \u1088 \u1072  \u1105 \u1082 \u1074 \u1072 \u1088 \u1089 \u1072  \u1097 \u1080 \u1085 \u1076 \u1080 \u1083 \u1101 . \u1057 \u1072 \u1074 \u1086 \u1088 \u1101  \u1083 \u1086 \u1082 \u1093 \u1086 \u1088 \u1101 \u1089  \u1078 \u1102 \u1074 \u1080 \u1085 \u1076 \u1080 \u1089 \u1072 \u1081 \u1083 \u1101 . \u1047 \u1083 \u1072 \u1090 \u1072  \u1082 \u1101 \u1088 \u1076 \u1080 \u1083 \u1072 \u1089  \u1089 \u1072 \u1088  \u1084 \u1072 \u1080 \u1085 \u1090 \u1099  \u1073 \u1072 \u1088 \u1080 \u1084 \u1072 \u1085 \u1075 \u1080 . \u1040 \u1083 \u1086 \u1084  \u1084 \u1072 \u1085 \u1076 \u1072 \u1088  \u1072 \u1085 \u1076 \u1072  \u1096 \u1101 \u1088 \u1086  \u1095 \u1080  \u1078 \u1103 \u1083 \u1072 \u1089 -\u1090 \u1072 \u1088 , \u1089 \u1086 \u1089 \u1082 \u1086  \u1089 \u1072 \u1089  \u1083 \u1072 \u1090 \u1101  \u1084 \u1091 \u1081 , \u1082 \u1072 \u1085 \u1072  \u1074 \u1086 \u1081  \u1096 \u1091 \u1085 \u1083 \u1072 \u1089  \u1083 \u1101  \u1074 \u1101 \u1096 \u1101 \u1089 \u1082 \u1080  \u1084 \u1091 \u1079 \u1099 \u1082 \u1072 : \u1074 \u1086 \u1074  \u1082 \u1101 \u1088 \u1076 \u1080 \u1083 \u1072 \u1089  \u1082 \u1072 \u1089 \u1072 \u1074 \u1086  \u1078 \u1102 \u1085 \u1075 \u1072 \u1083 \u1086 , \u1089 \u1072 \u1088  \u1083 \u1101  \u1041 \u1072 \u1085 \u1075 \u1101 \u1089 \u1082 \u1086  \u1089 \u1090 \u1072 \u1090 \u1086 . \u1063 \u1103 \u1082  \u1074 \u1086 \u1081  \u1084 \u1080 \u1085 \u1076 \u1099 \u1082  \u1072 \u1089 \u1072 \u1083 \u1072 \u1089  \u1082 \u1072 \u1090 \u1072 \u1088  \u1083 \u1101 \u1089 \u1082 \u1086  \u1078 \u1102 \u1085 \u1075 \u1072 \u1083 \u1080 \u1087 \u1101 , \u1072 \u1081  \u1074 \u1086 \u1074  \u1075 \u1072 \u1088 \u1072 \u1076 \u1105 \u1083 \u1072 \u1089  \u1087 \u1072 \u1083 \u1072  \u1082 \u1086 \u1087 \u1072 \u1095 \u1080  \u1074 \u1072 \u1081  \u1087 \u1072 \u1083 \u1072  \u1074 \u1091 \u1088 \u1076 \u1086 \u1085 , \u1082 \u1072 \u1085 \u1072  \u1074 \u1086 \u1081  \u1085 \'e1\u1082 \u1093 \u1083 \u1072 \u1089  \u1087 \u1072 \u1096 \u1072  \u1083 \u1101 \u1089 \u1090 \u1101 .\cb1 \
\cb2 \uc0\u1055 \u1072  \u1076 \u1091 \u1081 -\u1090 \u1088 \u1080 \u1085  \u1076 \u1077 \u1089  \u1105 \u1082 \u1086 \u1088  \u1084 \u1101  \u1075 \u1101 \u1083 \u1101 \u1084  \u1083 \u1101  \u1097 \u1103 \u1074 \u1086 \u1088 \u1101 \u1085 \u1094 \u1072  \u1090 \u1101  \u1083 \u1099 \u1096 \u1099 \u1081  \u1083 \u1101  \u1075 \u1088 \u1072 \u1089 \u1090 \u1101 \u1085 . \u1040 \u1085 \u1076 \u1086  \u1082 \u1093 \u1101 \u1083 \u1099 \u1087 \u1101  \u1072 \u1084 \u1101  \u1073 \u1080 \u1089 \u1090 \u1101 \u1088 \u1076 \u1072 \u1084  \u1087 \u1072  \u1075 \u1088 \u1072 \u1089 , \u1074 \u1086 \u1085  \u1088 \u1080 \u1089 \u1087 \u1080 \u1089 \u1072 \u1081 \u1083 \u1101  \u1087 \u1072  \u1074 \u1101 \u1096 , \u1072 \u1081 \u1083 \u1101  \u1088 \u1086 \u1084  \u1073 \u1091 \u1090  \u1079 \u1086 \u1088  \u1076 \u1099 \u1085 \u1101  \u1078 \u1080  \u1087 \u1091 \u1085  \u1082 \u1080 \u1076 \u1101  \u1083 \u1101 \u1085 . \u1052 \u1091 \u1088 \u1086  \u1076 \u1072 \u1076  \u1084 \u1072 \u1088 \u1076 \u1072 \u1089  \u1084 \u1072  \u1088 \u1072 \u1080 \u1082 \u1072 \u1089 \u1072 , \u1072 \u1081  \u1084 \u1101  \u1093 \u1086 \u1083 \u1103 \u1090 \u1072 \u1088  \u1072 \u1085 \u1076 \u1101  \u1072 \u1089 \u1074 \u1072  \u1085 \u1072 \u1096 \u1083 \u1101 \u1084 -\u1090 \u1072 \u1088  \u1072 \u1085 \u1076 \u1086  \u1074 \u1101 \u1096 . \u1060 \u1101 \u1088 \u1080  \u1072 \u1073 \u1072  \u1087 \u1086  \u1084 \u1101 \u1079 \u1084 \u1077 \u1088 \u1080  \u1082 \u1080 \u1076 \u1101 \u1084 -\u1084 \u1072  \u1090 \u1101  \u1078 \u1103 \u1074  \u1082 \u1072 \u1088 \u1080 \u1085 \u1075  \u1101  \u1094 \u1101 \u1088 \u1171 \u1080 , \u1089 \u1072 \u1088  \u1072 \u1097 \u1103 \u1076 \u1080 \u1083 \u1101 \u1084  \u1087 \u1086  \u1090 \u1093 \u1072 \u1085 : \u1074 \u1072 \u1088 \u1080 -\u1082 \u1072 \u1081  \u1087 \u1072 \u1096 \u1101  \u1084 \u1072 \u1085 \u1076 \u1101  \u1096 \u1091 \u1085 \u1076 \u1080 \u1083 \u1072 \u1089  \u1082 \u1086 \u1076 \u1099  \u1095 \u1105 \u1093 \u1072 \u1085 \u1099  \u1074 \u1080 \u1086 \u1083 \u1080 \u1085 . \u1052 \u1101  \u1073 \u1072 \u1088 \u1086 \u1089 \u1072 \u1081 \u1083 \u1101 \u1084 , \u1072 \u1081  \u1086  \u1073 \u1072 \u1096 \u1072 \u1080 \u1087 \u1101  \u1089 \u1072  \u1087 \u1072 \u1096 \u1086 \u1083 \u1072 \u1089  \u1082 \u1072 \u1088 \u1080 \u1085 \u1075  \u1084 \u1072 \u1085 \u1076 \u1101 , \u1082 \u1086 \u1090 \u1072 \u1088  \u1072 \u1097 \u1103 \u1076 \u1080 \u1083 \u1072 \u1089 . \u1040 \u1085 \u1075 \u1083 \u1072  \u1084 \u1072 \u1085 \u1076 \u1101  \u1084 \u1080 \u1096 \u1082 \u1080 \u1089 \u1072 \u1081 \u1083 \u1101  \u1083 \u1101  \u1073 \u1091 \u1088 \'85 \u1052 \u1080 \u1096 \u1082 \u1080 \u1089 \u1072 \u1081 \u1083 \u1101  \u1074 \u1080  \u1101  \u1073 \u1072 \u1083  \u1087 \u1086  \u1084 \u1091 \u1088 \u1086  \u1096 \u1101 \u1088 \u1086 .\cb1 \
\cb2 \uc0\u1052 \u1101  \u1076 \u1072 \u1088 \u1072 \u1089 \u1072  \u1076 \u1099 \u1082 \u1093 \u1086 \u1089  \u1087 \u1101  \u1082 \u1086 \u1076 \u1072 \u1083  \u1073 \u1091 \u1088 \'85 \u1072 \u1083 \u1086 \u1084  \u1072 \u1085 \u1076 \u1072  \u1083 \u1101 \u1085 \u1076 \u1101  \u1089 \u1099 \u1082 \u1072 \u1076 \u1080 \u1083 \u1072 \u1089  \u1087 \u1080 \u1085 \u1078 \u1103 \u1088 \u1076 \u1086  \u1084 \u1091 \u1081 : \u1087 \u1101  \u1084 \u1072 \u1085 \u1076 \u1101  \u1076 \u1099 \u1082 \u1093 \u1083 \u1072 \u1089  \u1086  \u1041 \u1072 \u1085 \u1075 \u1086 . \u1042 \u1080  \u1074 \u1086 \u1074  \u1076 \u1072 \u1088 \u1072 \u1081 \u1083 \u1072 \u1089  \u1084 \u1072 \u1085 \u1076 \u1072 \u1088 . \u1051 \u1101 \u1089 \u1082 \u1086  \u1084 \u1091 \u1081  \u1085 \u1072 \u1089  \u1078 \u1102 \u1085 \u1075 \u1072 \u1083 \u1086  \u1089 \u1072 \u1088  \u1084 \u1072 \u1085 \u1075 \u1101  \u1084 \u1101 \u1079 \u1099 \u1103 \u1089  \u1084 \u1080 \u1085 \u1076 \u1099 \u1082 : \u1076 \u1099 \u1082 \u1093 \u1101 \u1089 -\u1090 \u1091 , \u1085 \u1072 \u1089  \u1084 \u1072 \u1085  \u1074 \u1088 \u1072 \u1084 \u1072  \u1090 \u1101  \u1076 \u1099 \u1082 \u1093 \u1072 \u1074  \u1083 \u1101 \u1089  \u1084 \u1080 \u1096 \u1090 \u1086 . \u1052 \u1101  \u1083 \u1086 \u1096 \u1072 \u1081 \u1083 \u1077 \u1084 , \u1082 \u1101  \u1082 \u1072 \u1076 \u1086  \u1089 \u1072 \u1089  \u1074 \u1086 \u1074 , \u1072  \u1085 \u1072  \u1074 \u1101 \u1096 \u1101 \u1089 \u1082 \u1086  \u1076 \u1080 .\cb1 \
\cb2 \'97 \uc0\u1057 \u1086  \u1090 \u1091  \u1082 \u1072 \u1090 \u1101  \u1082 \u1101 \u1088 \u1101 \u1089 ? \u1058 \u1091  \u1092 \u1072 \u1081 \u1084 \u1072  \u1073 \u1086 \u1082 \u1093 \u1072 \u1083 \u1086  \u1089 \u1072 \u1085 ? \'97 \u1042 \u1086 \u1074  \u1083 \u1072 \u1089  \u1072 \u1085 \u1076 \u1072  \u1087 \u1086 \u1089 \u1086 \u1090 \u1080  \u1082 \u1086 \u1090 \u1086 \u1088  \u1084 \u1072 \u1085 \u1088 \u1086 \'85 \u1050 \u1072 \u1089 \u1072 \u1074 \u1086  \u1080 \u1079 \u1099 \u1074 \u1085 \u1086  \u1084 \u1072 \u1085 \u1088 \u1086  \u1084 \u1101  \u1080 \u1085 \u1082 \u1101  \u1095 \u1080  \u1093 \u1072 \u1083 \u1101 \u1084 !\cb1 \
\cb2 \uc0\u1025 \u1082 \u1074 \u1072 \u1088 \u1089 \u1072  \u1084 \u1101  \u1076 \u1101 \u1084 -\u1084 \u1072  \u1075 \u1080 \u1085 \u1076 \u1086 :\cb1 \
\cb2 \'97 \uc0\u1053 \u1072 \u1096 \u1072 \u1089 ! \u1054  \u1074 \u1101 \u1096 \u1101 \u1089 \u1082 \u1086  \u1084 \u1072 \u1085 \u1091 \u1096  \u1082 \u1072 \u1090 \u1101  \u1087 \u1093 \u1080 \u1088 \u1101 \u1083 !\cb1 \
\cb2 \'97 \uc0\u1050 \u1086 \u1085  \u1087 \u1093 \u1080 \u1088 \u1101 \u1083 ? \'97 \u1095 ' \u1072 \u1090 \u1103 \u1088 \u1076 \u1072 \u1089  \u1086  \u1041 \u1072 \u1085 \u1075 \u1086 .\cb1 \
\cb2 \'97 \uc0\u1057 \u1072 \u1088  \u1082 \u1086 \u1085 ? \u1050 \u1086 \u1076 \u1086  \u1082 \u1072 \u1081  \u1073 \u1072 \u1096 \u1072 \u1074 \u1101 \u1083  \u1095 \u1105 \u1093 \u1072 \u1085 \u1099  \u1084 \u1091 \u1079 \u1099 \u1082 \u1072 .\cb1 \
\cb2 \'97 \uc0\u1063 \u1080  \u1090 \u1088 \u1091 \u1073 \u1091 \u1081  \u1090 \u1101  \u1085 \u1072 \u1096 \u1072 \u1089 , \'97 \u1084 \u1101 \u1082 \u1083 \u1072 \u1089  \u1090 \u1101 \u1083 \u1101  \u1086  \u1096 \u1101 \u1088 \u1086  \u1041 \u1072 \u1085 \u1075 \u1086 , \'97 \u1085 \u1072 \u1081  \u1089 \u1086  \u1076 \u1072 \u1088 \u1072 \u1089  \u1083 \u1101 \u1089 \u1090 \u1072 \u1088 .\cb1 \
\cb2 \uc0\u1052 \u1101  \u1092 \u1101 \u1088 \u1080  \u1072 \u1090 \u1091 \u1085 \u1095 \u1080  \u1083 \u1101 \u1084  \u1089 \u1072 \u1084 \u1072  \u1101  \u1074 \u1080 \u1086 \u1083 \u1080 \u1085 , \u1089 \u1072 \u1074 \u1080  \u1041 \u1072 \u1085 \u1075 \u1086  \u1075 \u1072 \u1088 \u1072 \u1074 \u1083 \u1072 \u1089  \u1087 \u1072 \u1083 \u1072  \u1076 \u1091 \u1084 \u1086 .\cb1 \
\cb2 \'97 \uc0\u1063 \u1103 \u1082  \u1082 \u1072 \u1076 \u1086  \u1090 \u1091  \u1089 \u1072 \u1085  \u1083 \u1101  \u1074 \u1101 \u1096 \u1101 \u1089 \u1082 \u1086  \u1076 \u1080 ?\cb1 \
\cb2 \uc0\u1054  \'ab\u1074 \u1101 \u1096 \u1101 \u1089 \u1082 \u1086  \u1076 \u1080 \'bb \u1083 \u1072 \u1078 \u1103 \u1081 \u1083 \u1072 \u1089 . \u1052 \u1101  \u1083 \u1101 \u1084  \u1090 \u1101  \u1072 \u1089 \u1072 \u1074  \'97 \u1083 \u1101  \u1074 \u1101 \u1096 \u1101 \u1089 \u1082 \u1086  \u1083 \u1091 \u1074 \u1091 \u1090 \u1072 \u1088 \u1080  \u1089 \u1072 \u1089  \u1072 \u1084 \u1072 \u1088 \u1086  \u1041 \u1072 \u1085 \u1075 \u1086 !\cb1 \
\cb2 \'97 \uc0\u1058 \u1091  \u1089 \u1086 \u1089 \u1090 \u1072 \u1088  \u1072 \u1089 \u1072 \u1089 ? \'97 \u1087 \u1091 \u1097 \u1083 \u1072 \u1089  \u1074 \u1086 \u1074 .\cb1 \
\cb2 \'97\'a0\uc0\u1063 \u1103 \u1082  \u1089 \u1072 \u1088  \u1090 \u1101  \u1085 \u1072  \u1083 \u1086 \u1096 \u1072 \u1074 ? \u1058 \u1091  \u1082 \u1072 \u1076 \u1101  \u1073 \u1072 \u1096 \u1072 \u1074 \u1101 \u1089  \'97 \u1087 \u1072 \u1096 \u1072  \u1090 \u1091 \u1090 \u1101  \u1085 \u1072 \u1096 \u1090 \u1099 \u1082  \u1097 \u1105 \u1085 -\u1087 \u1101  \u1074 \u1080  \u1095 \u1080 \u1088 \u1080 \u1082 \u1083 \u1103 ! \u1050 \u1072 \u1076 \u1086  \u1095 \u1080  \u1084 \u1101 \u1079 \u1099 \u1081  \u1087 \u1101  \u1082 \u1093 \u1072 \u1085 \u1095 \u1077 \u1089 \u1090 \u1101 ! \u1050 \u1072 \u1076 \u1099  \u1095 \u1077 \u1088 \u1101 \u1089 \u1082 \u1080  \u1084 \u1091 \u1079 \u1099 \u1082 \u1072 !\cb1 \
\cb2 \'97 \uc0\u1052 \u1091 \u1088 \u1080  \u1084 \u1091 \u1079 \u1099 \u1082 \u1072  \u1095 \u1072 \u1083 \u1105 \u1083  \u1089 \u1072 \u1074 \u1086 \u1088 \u1101 \u1085 \u1075 \u1101 ? \'97 \u1083 \u1086 \u1096 \u1072 \u1081 \u1083 \u1072 \u1089  \u1086  \u1083 \u1091 \u1074 \u1091 \u1090 \u1072 \u1088 \u1080 .\cb1 \
\cb2 \uc0\u1050 \u1072 \u1085 \u1072  \u1074 \u1086 \u1074  \u1072 \u1089 \u1072 \u1103 \u1089 , \u1084 \u1101  \u1087 \u1072 \u1083 \u1101  \u1076 \u1099 \u1082 \u1093 \u1083 \u1101 \u1084 , \u1089 \u1086 \u1089 \u1082 \u1086  \u1083 \u1101 \u1089 \u1090 \u1101  \u1096 \u1091 \u1082 \u1072 \u1088  \u1084 \u1091 \u1081  \u1072 \u1081  \u1073 \u1072 \u1088 \u1101  \u1092 \u1101 \u1084 \u1083 \u1099 \u1084 \u1101  \u1103 \u1082 \u1093 \u1072 , \u1072 \u1081  \u1076 \u1101 \u1084 -\u1084 \u1072  \u1075 \u1080 \u1085 \u1076 \u1086  \u1082 \u1101  \u1074 \u1086 \u1074  \u1073 \u1091 \u1097 \u1105 \u1083  \u1052 \u1080 \u1083 \u1086 \u1096 .\cb1 \
\cb2 \'97 \uc0\u1063 \u1072 \u1083 \u1105 \u1083 , \u1095 \u1072 \u1083 \u1105 \u1083 ! \'97 \u1084 \u1101  \u1083 \u1101 \u1084  \u1090 \u1101  \u1093 \u1091 \u1090 \u1103 \u1074  \u1082 \u1088 \u1091 \u1103 \u1083  \u1083 \u1101 \u1089 \u1090 \u1101 . \u1040 \u1081  \u1074 \u1080  \u1074 \u1086 \u1074  \u1083 \u1072 \u1089  \u1090 \u1101  \u1093 \u1091 \u1090 \u1105 \u1083  \u1087 \u1101  \u1087 \u1101 \u1089 \u1082 \u1101  \u1087 \u1093 \u1072 \u1075 \u1101  \u1087 \u1091 \u1085 \u1088 \u1101 .\cb1 \
\cb2 \'97 \uc0\u1040 \u1074 \u1101 \u1085  \u1084 \u1072 \u1081  \u1089 \u1099 \u1075 \u1086  \u1072 \u1085 \u1076 \u1101  \u1094 \u1101 \u1088 \u1171 \u1080  \u1090 \u1101  \u1087 \u1093 \u1101 \u1085 \u1072 \u1089  \u1089 \u1072 \u1074 \u1086 \u1088 \u1101 \u1085 \u1075 \u1101  \u1082 \u1101  \u1090 \u1091  \u1089 \u1072 \u1085  \u1082 \u1086 \u1076 \u1086  \u1074 \u1101 \u1096 \u1101 \u1089 \u1082 \u1086  \u1083 \u1091 \u1074 \u1091 \u1090 \u1072 \u1088 \u1080 !\cb1 \
\cb2 \uc0\u1054  \u1052 \u1080 \u1083 \u1086 \u1096  \u1072 \u1097 \u1103 \u1076 \u1080 \u1083 \u1072 \u1089 . \u1051 \u1101 \u1089 \u1082 \u1101  \u1103 \u1082 \u1093 \u1072  \u1089 \u1072 \u1088  \u1073 \u1072 \u1088 \u1101  \u1097 \u1103 \u1074 \u1086 \u1088 \u1101 \u1089 \u1090 \u1101  \u1072 \u1073 \u1072  \u1095 \u1080  \u1072 \u1089 \u1072 \u1085 \u1072 \u1089 , \u1074 \u1086 \u1074  \u1082 \u1080 \u1082 \u1080 \u1076 \u1072 \u1089 -\u1087 \u1101  \u1072 \u1085 \u1076 \u1101  \u1087 \u1101 \u1089 \u1082 \u1101  \u1087 \u1093 \u1080 \u1082 \u1101 , \u1084 \u1101 \u1082 \u1083 \u1072 \u1089  \u1090 \u1101 \u1083 \u1101  \u1086  \u1096 \u1101 \u1088 \u1086 , \u1072 \u1081  \u1082 \u1101 \u1088 \u1076 \u1080 \u1083 \u1072 \u1089  \u1087 \u1072 \u1083 \u1101  \u1095 \u1105 \u1088 \u1086  \u1041 \u1072 \u1085 \u1075 \u1086 .\cb1 \
\cb2 \'97 \uc0\u1053 \u1072 , \u1085 \u1072 ! \'97 \u1074 \u1086 \u1074  \u1076 \u1072 \u1088 \u1072 \u1089 \u1072  \u1082 \u1080 \u1082 \u1080 \u1076 \u1072 \u1089  \u1082 \u1072 \u1088 \u1080 \u1085 \u1075  \u1087 \u1101 \u1089 \u1090 \u1101  \u1101  \u1089 \u1082 \u1088 \u1080 \u1087 \u1082 \u1072 . \'97 \u1052 \u1101  \u1085 \u1072 \u1096 \u1090 \u1099 \u1082  \u1073 \u1072 \u1096 \u1072 \u1074 \u1072 \u1074  \u1072 \u1085 \u1075 \u1083 \u1072  \u1084 \u1072 \u1085 \u1091 \u1096 : \u1074 \u1086 \u1085  \u1076 \u1099 \u1082 \u1093 \u1085 \u1072  \u1087 \u1086  \u1084 \u1091 \u1088 \u1086  \u1078 \u1102 \u1085 \u1075 \u1072 \u1083 \u1080 \u1087 \u1101  \u1072 \u1081  \u1095 \u1080  \u1096 \u1091 \u1085 \u1085 \u1072  \u1084 \u1091 \u1088 \u1080  \u1084 \u1091 \u1079 \u1099 \u1082 \u1072 . \u1042 \u1086 \u1085  \u1095 \'92 \u1072 \u1090 \u1103 \u1088 \u1085 \u1072 , \u1082 \u1101  \u1084 \u1091 \u1079 \u1099 \u1082 \u1072  \u1089 \u1099 \u1084  \u1084 \u1101 , \u1082 \u1072 \u1076 \u1086  \u1084 \u1091 \u1088 \u1086  \u1076 \u1080  \u1073 \u1072 \u1096 \u1072 \u1074 \u1101 \u1083 , \u1072 \u1081  \u1085 \u1072  \u1082 \u1072 \u1083 \u1077 \u1082 \u1072  \u1082 \u1072 \u1081  \u1090 \u1086 \u1088 \u1076 \u1105 \u1083  \u1072 \u1085 \u1075 \u1083 \u1072  \u1083 \u1101 \u1085 \u1076 \u1101 . \u1052 \u1072 \u1085 \u1075 \u1072 \u1074  \u1090 \u1091 \u1090 , \u1085 \u1072  \u1087 \u1091 \u1088 \u1080 \u1089 \u1072 \u1088  \u1082 \u1093 \u1072 \u1085 \u1080 \u1082 \u1072 \u1089 \u1082 \u1077 ! \u1058 \u1101  \u1082 \u1072 \u1084 \u1101 \u1089 \u1072 , \u1084 \u1101  \u1096 \u1072 \u1081  \u1097 \u1080 \u1090 \u1103 \u1088 \u1072 \u1074  \u1090 \u1091 \u1090  \u1090 \u1101  \u1073 \u1072 \u1096 \u1072 \u1074 \u1101 \u1089 .\cb1 \
\cb2 \uc0\u1052 \u1101  \u1095 \u1080  \u1087 \u1072 \u1090 \u1105 \u1089  \u1084 \u1091 \u1088 \u1101  \u1082 \u1072 \u1085 \u1101 \u1085 \u1075 \u1101 : \u1084 \u1101  \u1076 \u1101  \u1094 \u1099 \u1085 \u1072 \u1088 \u1072  \u1097 \u1080 \u1090 \u1102 \u1074 \u1086 \u1089  \u1082 \u1072 \u1090 \u1072 \u1088  \u1084 \u1091 \u1088 \u1086  \u1076 \u1072 \u1076  \u1090 \u1101  \u1073 \u1072 \u1096 \u1072 \u1074 \u1072 \u1074  \u1087 \u1101  \u1083 \u1091 \u1074 \u1091 \u1090 \u1072 , \u1074 \u1080  \u1091 \u1085 \u1080 \u1074 \u1072 \u1088  \u1073 \u1072 \u1096 \u1072 \u1074 \u1086 \u1089  \u1083 \u1101 \u1089 \u1072  \u1087 \u1101 \u1083  \u1072 \u1073 \u1072 \u1074 \u1072 . \u1040 \u1083 \u1086 \u1084  \u1096 \u1086 \u1171 \u1072  \u1095 \u1080  \u1075 \u1080 \u1085 \u1076 \u1086 \u1103 \u1089 , \u1082 \u1101  \u1074 \u1080 \u1086 \u1083 \u1080 \u1085  \u1096 \u1072 \u1081  \u1171 \u1072 \u1085 \u1075 \u1086 \u1079 \u1099 \u1081  \u1082 \u1072 \u1076 \u1101  \u1095 \u1105 \u1093 \u1072 \u1085 \u1101 \u1089 , \u1072 \u1081  \u1082 \u1101  \u1084 \u1101  \u1082 \u1086 \u1088 \u1082 \u1086 \u1088 \u1086  \u1073 \u1080 \u1088 \u1080 \u1103  \u1090 \u1101  \u1094 \u1099 \u1088 \u1076 \u1072 \u1074  \u1083 \u1072 \u1090 \u1072 \u1088  \u1082 \u1072 \u1089 \u1072 \u1074 \u1101  \u1101 \u1088 \u1101 \u1082 \u1077 \u1096 \u1072  \u1171 \u1072 \u1085 \u1075 \u1091 \u1088 \u1072 .\cb1 \
\cb2 \'97 \uc0\u1050 \u1072 \u1084 \u1072 \u1074 , \'97 \u1087 \u1093 \u1101 \u1085 \u1076 \u1101 \u1084  \u1084 \u1101 , \u1072 \u1083 \u1086 \u1084  \u1083 \u1086 \u1096  \u1084 \u1072 \u1081  \u1073 \u1091 \u1090  \u1085 \u1072 \u1089  \u1072 \u1085 \u1076 \u1086  \u1084 \u1091 \u1088 \u1086  \u1080 \u1083 \u1086 . \u1052 \u1101  \u1089 \u1099 \u1084 \u1072 \u1089  \u1072 \u1090 \u1091 \u1085 \u1095 \u1080  \u1094 \u1099 \u1085 \u1086  \u1072 \u1081  \u1073 \u1091 \u1090  \u1095 ' \u1072 \u1090 \u1103 \u1088 \u1086 \u1089 , \u1092 \u1101 \u1088 \u1080  \u1072 \u1090 \u1103 \u1088 \u1076 \u1101 \u1084  \u1077 \u1082 \u1093 : \u1074 \u1072 \u1088 \u1080 -\u1089 \u1086  \u1085 \u1072 \u1081  \u1082 \u1072 \u1076 \u1101  \u1072 \u1085 \u1076 \u1086  \u1072 \u1084 \u1072 \u1088 \u1086  \u1090 \u1088 \u1072 \u1105 , \u1082 \u1072 \u1085 \u1072  \u1084 \u1072 \u1085 \u1091 \u1096  \u1076 \u1072 \u1088 \u1072 \u1083  \u1084 \u1072 \u1085 \u1091 \u1096 \u1101 \u1085 \u1076 \u1072 \u1088 , \u1082 \u1101  \u1074 \u1086 \u1074  \u1085 \u1072 \u1081  \u1082 \u1072 \u1089 \u1072 \u1074 \u1086  \u1089 \u1072 \u1088  \u1074 \u1086 \u1085 .\cb1 \
\cb2 \uc0\u1040 \u1084 \u1101  \u1082 \u1093 \u1101 \u1090 \u1072 \u1085 \u1101  \u1072 \u1074 \u1080 \u1083 \u1072 \u1084  \u1072 \u1085 \u1076 \u1101  \u1094 \u1101 \u1088 \u1171 \u1080 . \u1050 \u1072 \u1090 \u1072 \u1088  \u1082 \u1086 \u1076 \u1086  \u1076 \u1077 \u1089  \u1072 \u1084 \u1101  \u1082 \u1101 \u1088 \u1076 \u1080 \u1083 \u1072 \u1084  \u1083 \u1101 \u1089 \u1072  \u1087 \u1072 \u1081 \u1090 \u1072 \u1096 \u1072 , \u1089 \u1072 \u1088  \u1087 \u1093 \u1088 \u1072 \u1083 . \u1057 \u1072 \u1088  \u1084 \u1072 \u1080 \u1085 \u1090 \u1099 , \u1089 \u1072 \u1082 \u1086  \u1087 \u1101  \u1088 \u1072 \u1090 \u1103 \u1090 \u1101  \u1084 \u1091 \u1079 \u1099 \u1082 \u1072  \u1096 \u1091 \u1085 \u1076 \u1105 \u1083 \u1072 \u1089  \u1087 \u1072 \u1096 \u1072  \u1072 \u1084 \u1072 \u1088 \u1101  \u1094 \u1101 \u1088 \u1171 \u1080 , \u1092 \u1101 \u1088 \u1080  \u1072 \u1082 \u1072 \u1085 \u1072 \u1082  \u1074 \u1086 \u1081  \u1095 \u1080  \u1084 \u1101 \u1079 \u1099 \u1103 \u1089 \u1100  \u1082 \u1072 \u1089 \u1072 \u1074 \u1080  \u1089 \u1072 \u1083 \u1073 \u1072 \u1090 \u1086 . \u1040 \u1085 \u1076 \u1101  \u1083 \u1072 \u1090 \u1101  \u1085 \u1072 \u1089  \u1072 \u1073 \u1072  \u1076 \u1091 \u1082 \u1093  \u1072 \u1081  \u1073 \u1088 \u1080 \u1075 \u1072 , \u1082 \u1101  \u1041 \u1072 \u1085 \u1075 \u1086  \u1078 \u1103 \u1085 \u1083 \u1072 \u1089 , \u1082 \u1101  \u1083 \u1101 \u1089  \u1096 \u1091 \u1085 \u1101 \u1083  \u1089 \u1072  \u1086  \u1090 \u1072 \u1073 \u1086 \u1088 \u1086 . \u1040 \u1085 \u1076 \u1086  \u1073 \u1072 \u1096 \u1072 \u1080 \u1087 \u1101  \u1096 \u1091 \u1085 \u1076 \u1105 \u1083 \u1072 \u1089  \u1072 \u1082 \u1072 \u1085 \u1072 \u1082  \u1095 \u1080 \u1088 \u1080 \u1082 \u1083 \u1103 \u1085 \u1075 \u1086  \u1075 \u1080 \u1083 \u1072 \u1080 \u1087 \u1101 , \u1089 \u1072 \u1088  \u1085 \u1072 \u1096 \u1101 \u1083  \u1086  \u1092 \u1086 \u1083 \u1105 \u1074 \u1086  \u1084 \u1072 \u1096 \u1082 \u1072 \u1088  \u1083 \u1101  \u1095 \u1103 \u1088 \u1072 , \u1072 \u1081  \u1089 \u1072 \u1088  \u1086  \u1073 \u1072 \u1083 \u1074 \u1072 \u1083  \u1084 \u1072 \u1083 \u1099 \u1081  \u1082 \u1086 \u1087 \u1072 \u1095 \u1077 \u1085 \u1075 \u1101  \u1087 \u1072 \u1090 \u1088 \u1072 . \u1051 \u1101  \u1088 \u1086 \u1084  \u1072 \u1073 \u1072  \u1097 \u1080 \u1090 \u1080 \u1083 \u1101  \u1082 \u1072 \u1081  \u1083 \u1101 \u1089 \u1082 \u1086  \u1073 \u1072 \u1096 \u1072 \u1080 \u1087 \u1101 , \u1072 \u1083 \u1086 \u1084  \u1089 \u1072  \u1077 \u1082  \u1080 \u1085 \u1082 \u1101  \u1076 \'e1\u1088 \u1085 \u1072 \u1089  \u1082 \u1072 \u1090 \u1072 \u1088  \u1083 \u1101  \u1074 \u1101 \u1096 \u1101 \u1089 \u1082 \u1086  \u1083 \u1091 \u1074 \u1091 \u1090 \u1072 \u1088 \u1080 .\cb1 \
\cb2 \uc0\u1040 \u1084 \u1101  \u1078 \u1103 \u1089 \u1072 \u1089 -\u1090 \u1072 \u1088  \u1083 \u1101  \u1041 \u1072 \u1085 \u1075 \u1101 \u1089 \u1072  \u1072 \u1085 \u1076 \u1086  \u1074 \u1101 \u1096 , \u1072 \u1081  \u1082 \u1086 \u1090 \u1101  \u1074 \u1086 \u1074  \u1097 \u1080 \u1090 \u1103 \u1088 \u1083 \u1072 \u1089  \u1084 \u1072 \u1085  \u1090 \u1101  \u1073 \u1072 \u1096 \u1072 \u1074 \u1072 \u1074 . \u1042 \u1086 \u1074  \u1082 \u1086 \u1088 \u1082 \u1086 \u1088 \u1086  \u1097 \u1080 \u1090 \u1105 \u1083 \u1072 \u1089  \u1082 \u1072 \u1090 \u1072 \u1088  \u1086  \u1074 \u1101 \u1096 \u1101 \u1089 \u1082 \u1086  \u1090 \u1088 \u1072 \u1105 , \u1089 \u1072 \u1074 \u1086  \u1089 \u1099  \u1082 \u1088 \u1091 \u1103 \u1083  \u1072 \u1084 \u1101 \u1085 \u1076 \u1101 . \u1042 \u1072 \u1088 \u1080 -\u1082 \u1072 \u1085 \u1072 , \u1082 \u1072 \u1085 \u1072  \u1089 \u1072 \u1089  \u1074 \u1086 \u1074  \u1080 \u1085 \u1082 \u1101  \u1094 \u1099 \u1085 \u1086 , \u1086  \u1087 \u1093 \u1091 \u1088 \u1086  \u1083 \u1091 \u1074 \u1091 \u1090 \u1072 \u1088 \u1080  \u1043 \u1088 \u1091 \u1103  \u1089 \u1091 \u1085 \u1091 \u1089 \u1072 \u1088 \u1076 \u1072 \u1089  \u1086  \u1097 \u1103 \u1074 \u1086 \u1088 \u1101 \u1089 , \u1089 \u1072 \u1074 \u1086  \u1089 \u1072 \u1089  \u1084 \u1072 \u1088 \u1076 \u1086  \u1044 \u1101 \u1083 \u1074 \u1083 \u1101 \u1089 \u1090 \u1072 \u1088 , \u1072 \u1081  \u1076 \u1072 \u1089  \u1083 \u1101 \u1089 \u1082 \u1101  \u1087 \u1101 \u1089 \u1082 \u1080  \u1087 \u1091 \u1088 \u1072 \u1085 \u1099  \u1074 \u1080 \u1086 \u1083 \u1080 \u1085 . \u1041 \u1072 \u1085 \u1075 \u1086 , \u1089 \u1072 \u1088  \u1074 \u1080  \u1083 \u1101  \u1082 \u1072 \u1074 \u1101 \u1088  \u1076 \u1091 \u1081 -\u1090 \u1088 \u1080 \u1085  \u1097 \u1103 \u1074 \u1086 \u1088 \u1072  \u1084 \u1072 \u1096 \u1082 \u1072 \u1088  \u1072 \u1084 \u1101 \u1085 \u1076 \u1101 , \u1097 \u1080 \u1090 \u1105 \u1083 \u1072 \u1089  \u1087 \u1086 \u1082 -\u1094 \u1101 \u1088 \u1072  \u1090 \u1101  \u1073 \u1072 \u1096 \u1072 \u1074 \u1101 \u1083  \u1082 \u1072 \u1090 \u1072 \u1088  \u1086  \u1043 \u1088 \u1091 \u1103 , \u1072 \u1083 \u1086 \u1084  \u1074 \u1086 \u1074  \u1096 \u1086 \u1171 \u1072  \u1095 \u1080  \u1073 \u1072 \u1096 \u1072 \u1074 \u1083 \u1072 \u1089  \u1072 \u1085 \u1075 \u1083 \u1072  \u1084 \u1072 \u1085 \u1091 \u1096 , \u1089 \u1072 \u1088  \u1101  \u1082 \u1072 \u1074 \u1101 \u1088 . \u1042 \u1086 \u1074  \u1073 \u1072 \u1096 \u1072 \u1074 \u1083 \u1072 \u1089  \u1095 \u1105 \u1088 \u1072 \u1083 \u1101 \u1089 , \u1092 \u1101 \u1088 \u1080  \u1072 \u1090 \u1091 \u1085 \u1095 \u1080 , \u1082 \u1072 \u1085 \u1072  \u1078 \u1103 \u1083 \u1072 \u1089 -\u1090 \u1072 \u1088  \u1084 \u1072 \u1081  \u1076 \u1091 \u1088  \u1072 \u1085 \u1076 \u1086  \u1074 \u1101 \u1096 .\cb1 \
\cb2 \uc0\u1052 \u1101  \u1096 \u1091 \u1085 \u1086 \u1089  \u1089 \u1072 \u1088  \u1083 \u1101 \u1089 \u1082 \u1080  \u1074 \u1080 \u1086 \u1083 \u1080 \u1085  \u1074 \u1086 \u1088 \u1073 \u1080 \u1081  \u1095 \u1080 \u1088 \u1080 \u1082 \u1083 \u1103 \u1085 \u1094 \u1072 , \u1072 \u1081  \u1082 \u1086 \u1090 \u1072 \u1088  \u1089 \u1072 \u1088  \u1101  \u1095 \u1080 \u1088 \u1080 \u1082 \u1083 \u1103  \u1090 \u1072 \u1081  \u1101  \u1083 \u1091 \u1074 \u1091 \u1090 \u1072  \u1075 \u1080 \u1083 \u1072 \u1073 \u1101 \u1085  \u1082 \u1093 \u1101 \u1090 \u1072 \u1085 \u1101 \'85 \u1052 \u1101  \u1076 \u1072 \u1088 \u1086 \u1089  \u1090 \u1101  \u1087 \u1093 \u1091 \u1088 \u1076 \u1072 \u1074 : \u1084 \u1101 \u1079 \u1099 \u1103 \u1089 -\u1087 \u1101 , \u1082 \u1101  \u1084 \u1091 \u1088 \u1086  \u1080 \u1083 \u1086  \u1084 \u1072 \u1088 \u1076 \u1105 \u1083  \u1082 \u1072 \u1076 \u1101 , \u1082 \u1101  \u1096 \u1091 \u1085 \u1076 \u1105 \u1083  \u1087 \u1101  \u1089 \u1072  \u1086  \u1074 \u1101 \u1096 , \u1072 \u1081  \u1088 \u1091 \u1084 \u1091 \u1081  \u1082 \u1072 \u1076 \u1099  \u1095 \u1077 \u1088 \u1101 \u1089 \u1082 \u1080  \u1084 \u1091 \u1079 \u1099 \u1082 \u1072 . \u1057 \u1072 \u1089  \u1084 \u1072  \u1101  \u1074 \u1080 \u1086 \u1083 \u1080 \u1085  \u1082 \u1072 \u1090 \u1072 \u1088  \u1084 \u1091 \u1088 \u1086  \u1087 \u1072 \u1087 \u1086 , \u1072 \u1081  \u1084 \u1101  \u1089 \u1099 \u1075 \u1086  \u1097 \u1080 \u1090 \u1102 \u1074 \u1086 \u1089  \u1090 \u1101  \u1073 \u1072 \u1096 \u1072 \u1074 \u1072 \u1074 . \u1053 \u1072 \u1096 \u1090 \u1099 \u1082  \u1089 \u1072 \u1089  \u1090 \u1101  \u1085 \u1072 \u1097 \u1080 \u1090 \u1105 \u1089 , \u1082 \u1101  \u1086  \u1041 \u1072 \u1085 \u1075 \u1086  \u1082 \u1086 \u1088 \u1082 \u1086 \u1088 \u1086  \u1089 \u1072 \u1089  \u1101  \u1084 \u1091 \u1079 \u1099 \u1082 \u1072 ! \u1040 \u1081  \u1082 \u1072 \u1076 \u1099  \'ab\u1078 \u1102 \u1074 \u1080 \u1085 \u1076 \u1099  \u1084 \u1091 \u1079 \u1099 \u1082 \u1072 \'bb \u1089 \u1072 \u1089  \u1084 \u1091 \u1088 \u1086  \u1087 \u1072 \u1081 \u1090 \u1072 \u1096 \u1099 !\cb1 \
\cb2 \uc0\u1050 \u1072 \u1085 \u1072  \u1083 \u1101 \u1084  \u1090 \u1101  \u1073 \u1072 \u1096 \u1072 \u1074 \u1072 \u1074  \u1084 \u1072 \u1096 \u1082 \u1072 \u1088  \u1083 \u1101  \u1088 \u1086 \u1084  \u1072 \u1085 \u1076 \u1101  \u1094 \u1101 \u1088 \u1171 \u1080 , \u1089 \u1072 \u1074 \u1086 \u1088 \u1101  \u1083 \u1099 \u1085 \u1101  \u1089 \u1072 \u1084 \u1072  \u1089 \u1072 \u1088  \u1087 \u1072 \u1088 \u1091 \u1076 \u1080 \u1083 \u1101  \u1101  \u1075 \u1083 \u1072 \u1089 \u1091 \u1088 \u1072  \u1072 \u1085 \u1076 \u1101  \u1084 \u1091 \u1088 \u1080  \u1074 \u1080 \u1086 \u1083 \u1080 \u1085 , \u1072 \u1081  \u1084 \u1091 \u1094 \u1099 \u1085 \u1072 \u1089 -\u1087 \u1101 , \u1082 \u1072 \u1081  \u1072 \u1081  \u1089 \u1072 \u1088  \u1084 \u1101  \u1082 \u1072 \u1076 \u1101  \u1097 \u1080 \u1090 \u1080 \u1083 \u1101 \u1084 . \u1055 \u1093 \u1101 \u1085 \u1085 \u1072 \u1089 , \u1082 \u1101  \u1072 \u1085 \u1076 \u1072  \u1084 \u1072 \u1085 \u1076 \u1101  \u1082 \u1101 \u1088 \u1076 \u1105 \u1083 \u1072  \u1073 \u1072 \u1088 \u1086  \u1084 \u1091 \u1079 \u1099 \u1082 \u1072 \u1085 \u1090 \u1086 . \u1055 \u1093 \u1101 \u1085 \u1086 \u1089  \u1083 \u1101 \u1085 \u1075 \u1101  \u1087 \u1101 \u1088 \u1072 \u1089 \u1101 \u1085 \u1094 \u1072 , \u1082 \u1101  \u1097 \u1080 \u1090 \u1102 \u1074 \u1072 \u1074  \u1082 \u1072 \u1090 \u1072 \u1088  \u1086  \u1074 \u1101 \u1096 \u1101 \u1089 \u1082 \u1086  \u1084 \u1072 \u1085 \u1091 \u1096 . \u1051 \u1101  \u1088 \u1086 \u1084  \u1093 \u1086 \u1083 \u1103 \u1081 \u1074 \u1101 \u1085 \u1072 \u1089  \'97 \u1076 \u1072 \u1088 \u1085 \u1072 \u1089  \u1090 \u1101  \u1085 \u1072  \u1093 \u1086 \u1083 \u1103 \u1088 \u1072 \u1074  \u1086  \u1076 \u1080  \u1083 \u1101  \u1074 \u1101 \u1096 \u1101 \u1089 \u1082 \u1086 .\cb1 \
\cb2 \uc0\u1040 \u1084 \u1072 \u1088 \u1101  \u1088 \u1086 \u1084  \u1087 \u1072 \u1090 \u1103 \u1085 \u1072 \u1089 , \u1082 \u1101  \u1072 \u1085 \u1076 \u1101  \u1089 \u1072 , \u1089 \u1086  \u1089 \u1099  \u1082 \u1088 \u1091 \u1103 \u1083 , \u1089 \u1099  \u1087 \u1101 \u1089 \u1082 \u1086  \u1076 \u1080 , \u1089 \u1072 \u1074 \u1086  \u1082 \u1101 \u1088 \u1076 \u1072 \u1089  \u1086  \u1044 \u1101 \u1083 : \u1072 \u1085 \u1076 \u1101 \u1083  \u1082 \u1086 \u1087 \u1072 \u1095 \u1103 , \u1072 \u1085 \u1076 \u1086  \u1087 \u1072 \u1080 , \u1072 \u1085 \u1076 \u1101  \u1103 \u1075 , \u1072 \u1085 \u1076 \u1101  \u1093 \u1072 \u1088 \u1072 , \u1072 \u1085 \u1076 \u1086  \u1082 \u1093 \u1072 \u1084  \u1082 \u1072 \u1081  \u1076 \u1101 \u1083  \u1090 \u1088 \u1072 \u1105  \u1089 \u1072 \u1074 \u1086 \u1088 \u1101 \u1085 \u1075 \u1101 \'85 \u1050 \u1072 \u1085 \u1072  \u1083 \u1101  \u1088 \u1086 \u1084  \u1083 \u1101 \u1085 \u1072 \u1089  \u1090 \u1101  \u1080 \u1085 \u1079 \u1072 \u1088 \u1101 \u1085  \u1083 \u1101  \u1094 \u1101 \u1088 \u1171 \u1080  \u1087 \u1072 \u1096 \u1072  \u1074 \u1101 \u1096 , \u1101  \u1084 \u1072 \u1081  \u1087 \u1093 \u1091 \u1088 \u1080  \u1078 \u1102 \u1074 \u1083 \u1080  \u1072 \u1085 \u1076 \u1086  \u1090 \u1072 \u1073 \u1086 \u1088 \u1086  \u1072 \u1088 \u1072 \u1082 \u1093 \u1101 \u1083 \u1072 \u1089  \u1073 \u1072 \u1088 \u1086  \u1089 \u1090 \u1088 \u1101 \u1078 \u1072 \u1088 \u1080  \u1074 \u1072 \u1081  \u1073 \u1088 \u1072 \u1076 \u1086 , \u1097 \u1105 \u1083 \u1072 \u1089  \u1090 \u1101 \u1083 \u1072  \u1082 \u1086 \u1087 \u1072 \u1095 \u1080  \u1101 \u1082 -\u1094 \u1101 \u1088 \u1072  \u1093 \u1072 \u1073 \u1101  \u1074 \u1072 \u1081  \u1075 \u1091 \u1075 \u1083 \u1080 \u1087 \u1101  \u1090 \u1072 \u1081  \u1084 \u1072 \u1085 \u1075 \u1101 \u1083 \u1072 \u1089  \u1082 \u1072 \u1090 \u1072 \u1088  \u1086  \u1074 \u1101 \u1096 \u1101 \u1089 \u1082 \u1086  \u1076 \u1080  \u1090 \u1101  \u1085 \u1072  \u1093 \u1086 \u1083 \u1103 \u1081 \u1074 \u1101 \u1083  \u1087 \u1101 \u1083  \u1088 \u1086 \u1084  \u1082 \u1072 \u1081  \u1090 \u1086 \u1088 \u1076 \u1103 \u1088 \u1101 \u1085  \u1087 \u1101 \u1089 \u1082 \u1101  \u1074 \u1091 \u1088 \u1076 \u1086 \u1085 \u1072  \u1072 \u1085 \u1076 \u1086  \u1083 \u1101 \u1089 \u1082 \u1086  \u1082 \u1088 \u1072 \u1080 \u1087 \u1101 .\cb1 \
\cb2 \uc0\u1046 \u1103 \u1083 \u1072 \u1089  \u1074 \u1088 \u1072 \u1084 \u1072 . \u1041 \u1072 \u1085 \u1075 \u1086  \u1089 \u1072 \u1088  \u1084 \u1072 \u1080 \u1085 \u1090 \u1099  \u1082 \u1101 \u1088 \u1076 \u1080 \u1083 \u1072 \u1089  \u1073 \u1088 \u1080 \u1075 \u1072 \u1082 \u1086 . \u1025 \u1082 \u1074 \u1072 \u1088  \u1074 \u1086 \u1074  \u1087 \u1091 \u1097 \u1083 \'e1\u1089  \u1084 \u1072 \u1085 \u1076 \u1072 \u1088 :\cb1 \
\cb2 \'97 \uc0\u1055 \u1093 \u1101 \u1085  \u1084 \u1072 \u1085 \u1075 \u1101 , \u1092 \u1101 \u1088 \u1080  \u1095 \u1103 \u1095 \u1080 \u1087 \u1101 . \u1069  \u1047 \u1083 \u1072 \u1090 \u1072  \u1096 \u1091 \u1085 \u1101 \u1083  \u1084 \u1091 \u1088 \u1080  \u1084 \u1091 \u1079 \u1099 \u1082 \u1072 ?\cb1 \
\cb2 \'97 \uc0\u1042 \u1086 \u1081  \u1087 \u1093 \u1101 \u1085 \u1101 \u1083 , \u1082 \u1101  \u1074 \u1101 \u1096 \u1101 \u1089 \u1082 \u1086  \u1083 \u1091 \u1074 \u1091 \u1090 \u1072 \u1088 \u1080  \u1073 \u1072 \u1096 \u1072 \u1074 \u1101 \u1083  \u1092 \u1101 \u1088 \u1080  \u1083 \u1072 \u1082 \u1101 , \'97 \u1087 \u1093 \u1101 \u1085 \u1076 \u1101 \u1084  \u1084 \u1101 .\cb1 \
\cb2 \'97 \uc0\u1057 \u1072 \u1088  \u1075 \u1080 \u1085 \u1076 \u1099 \u1089 , \u1074 \u1086 \u1081  \u1096 \u1072 \u1081  \u1082 \u1072 \u1084 \u1083 \u1086  \u1084 \u1072 \u1085 ? \'97 \u1042 \u1086 \u1074  \u1076 \u1099 \u1082 \u1093 \u1083 \u1072 \u1089  \u1087 \u1101  \u1084 \u1072 \u1085 \u1076 \u1101 , \u1072 \u1081  \u1072 \u1085 \u1076 \u1101  \u1083 \u1101 \u1089 \u1082 \u1101  \u1103 \u1082 \u1093 \u1072  \u1089 \u1072 \u1089  \u1073 \u1080 \u1079 \u1099 \u1103 \u1083 \u1072 .\cb1 \
\cb2 \uc0\u1052 \u1101  \u1087 \u1093 \u1101 \u1085 \u1076 \u1101 \u1084  \u1089 \u1072 \u1088  \u1089 \u1072 \u1089 :\cb1 \
\cb2 \'97 \uc0\u1057 \u1086 \u1081  \u1090 \u1091 \u1089 \u1072 ? \u1042 \u1086 \u1081  \u1087 \u1101  \u1084 \u1072 \u1081  \u1083 \u1072 \u1097 \u1077  \u1097 \u1103 \u1074 \u1101  \u1095 \u1080  \u1076 \u1099 \u1082 \u1093 \u1101 \u1083 , \u1072 \u1081  \u1095 \u1080  \u1082 \u1072 \u1084 \u1101 \u1083  \u1082 \u1093 \u1072 \u1085 \u1080 \u1082 \u1072 \u1089 .\cb1 \
\cb2 \uc0\u1052 \u1101  \u1076 \u1099 \u1082 \u1093 \u1083 \u1101 \u1084  \u1072 \u1085 \u1076 \u1101  \u1083 \u1101 \u1089 \u1082 \u1101  \u1103 \u1082 \u1093 \u1072  \'97 \u1082 \u1086 \u1090 \u1101  \u1089 \u1072 \u1089  \u1101  \u1076 \u1091 \u1082 \u1093 . \u1052 \u1101  \u1076 \u1072 \u1088 \u1072 \u1081 \u1083 \u1101 \u1084  \'97 \u1041 \u1072 \u1085 \u1075 \u1101 \u1089 \u1082 \u1086  \u1084 \u1091 \u1081  \u1082 \u1101 \u1088 \u1076 \u1080 \u1083 \u1072 \u1089  \u1082 \u1072 \u1083 \u1086  \u1089 \u1072 \u1088  \u1101  \u1087 \u1093 \u1091 \u1074 . \u1042 \u1086 \u1074  \u1073 \u1086 \u1083 \u1076 \u1072 \u1089 -\u1087 \u1101  \u1072 \u1081  \u1075 \u1101 \u1083 \u1072 \u1089  \u1072 \u1085 \u1076 \u1086  \u1074 \u1101 \u1096 . \u1040 \u1085 \u1076 \u1086  \u1082 \u1086 \u1076 \u1086  \u1076 \u1077 \u1089  \u1082 \u1093 \u1086 \u1085 \u1080 \u1082  \u1095 \u1080  \u1096 \u1091 \u1085 \u1076 \u1072 \u1089  \u1083 \u1101 \u1089 \u1082 \u1086  \u1073 \u1072 \u1096 \u1072 \u1080 \u1087 \u1101 .\cb1 \
\cb2 \uc0\u1051 \u1101  \u1084 \u1072 \u1085 \u1091 \u1096  \u1072 \u1073 \u1072  \u1097 \u1080 \u1090 \u1080 \u1083 \u1101  \u1082 \u1072 \u1081  \u1101  \u1084 \u1091 \u1079 \u1099 \u1082 \u1072  \u1072 \u1081  \u1078 \u1091 \u1090 \u1103 \u1088 \u1085 \u1072 \u1089  \u1083 \u1072 . \u1040 \u1083 \u1086 \u1084  \u1074 \u1080  \u1087 \u1086  \u1082 \u1072 \u1074 \u1101 \u1088  \u1076 \u1077 \u1089  \u1082 \u1093 \u1086 \u1085 \u1080 \u1082  \u1095 \u1080  \u1073 \u1072 \u1096 \u1072 \u1074 \u1083 \u1072 \u1089 . \u1056 \u1086 \u1084  \u1087 \u1093 \u1101 \u1085 \u1085 \u1072 \u1089 : \'ab\u1057 \u1086  \u1082 \u1101 \u1088 \u1076 \u1080 \u1083 \u1072 \u1089 ? \u1064 \u1072 \u1081  \u1072 \u1074 \u1101 \u1083  \u1082 \u1072 \u1076 \u1086  \u1082 \u1072 \u1088 \u1080 \u1085 \u1075  \u1086  \u1095 \u1105 \u1088 \u1080 \u1087 \u1101 ?\'bb\cb1 \
\cb2 \uc0\u1054  \u1084 \u1080 \u1083 \u1072 \u1081  \u1087 \u1072 \u1096 \u1086 \u1083 \u1072 \u1089  \u1082 \u1072 \u1088 \u1080 \u1085 \u1075  \u1086  \u1072 \u1075 \u1086 \u1088 . \u1040 \u1074 \u1080 \u1083 \u1072 \u1089  \u1101  \u1074 \u1088 \u1072 \u1084 \u1072  \u1090 \u1101  \u1084 \u1072 \u1085 \u1075 \u1072 \u1074 \u1101 \u1085  \u1101  \u1047 \u1083 \u1072 \u1090 \u1072 . \u1057 \u1072 \u1074 \u1072 \u1090 \u1086 \u1085 \u1101  \u1083 \u1099 \u1085 \u1101  \u1090 \u1101  \u1072 \u1088 \u1101 \u1089 \u1101 \u1085  \u1072 \u1085 \u1076 \u1072  \u1082 \u1072 \u1074 \u1101 \u1088  \u1090 \u1072 \u1073 \u1086 \u1088 \u1072  \u1083 \u1101  \u1088 \u1086 \u1084 . \u1064 \u1090 \u1072 \u1088  \u1074 \u1072 \u1081  \u1087 \u1072 \u1085 \u1078 \u1100  \u1097 \u1103 \u1074 \u1101  \u1084 \u1072 \u1085 \u1075 \u1101 \u1085 \u1072 \u1089  \u1083 \u1072 \u1082 \u1086  \u1074 \u1072 \u1089 \u1090 . \u1040 \u1081  \u1101  \u1047 \u1083 \u1072 \u1090 \u1072  \u1095 \u1080  \u1076 \u1101 \u1083 \u1072 \u1089  \u1074 \u1086 \u1088 \u1073 \u1072  \u1082 \u1093 \u1072 \u1085 \u1080 \u1082 \u1072 \u1089 \u1082 \u1101 , \u1092 \u1101 \u1088 \u1080  \u1072 \u1089 \u1072 \u1083 \u1072 \u1089  \u1083 \u1101 \u1085 \u1076 \u1072 \u1088 : \u1082 \u1072 \u1076 \u1086  \u1089 \u1072 \u1089  \u1083 \u1072 \u1082 \u1086  \u1076 \u1077 \u1089 , \u1072 \u1085 \u1076 \u1072  \u1083 \u1072 \u1090 \u1101  \u1082 \u1080 \u1076 \u1101 -\u1087 \u1101  \u1082 \u1072 \u1090 \u1080  \u1084 \u1072 \u1085 \u1091 \u1096 ! \u1040 \u1081  \u1083 \u1101  \u1097 \u1103 \u1074 \u1101  \u1075 \u1072 \u1090 \u1072  \u1089 \u1072 \u1089  \u1090 \u1101  \u1084 \u1091 \u1076 \u1072 \u1088 \u1101 \u1085  \u1089 \u1072 \u1082 \u1086 \u1085 \u1101 \u1089 , \u1082 \u1086 \u1085  \u1090 \u1086 \u1088 \u1076 \u1105 \u1083 \u1072  \u1087 \u1101  \u1083 \u1101 \u1085 \u1075 \u1086  \u1076 \u1088 \u1086 \u1084 . \u1057 \u1072 \u1082 \u1086  \u1082 \u1072 \u1084 \u1083 \u1072 \u1089  \u1090 \u1101  \u1072 \u1074 \u1101 \u1083  \u1101  \u1047 \u1083 \u1072 \u1090 \u1072  \u1083 \u1101 \u1089 \u1082 \u1080  \u1088 \u1086 \u1084 \u1085 \u1080 .\cb1 \
\cb2 \uc0\u1053 \u1072 \u1095 \u1080 \u1083 \u1101  \u1076 \u1091 \u1081  \u1076 \u1077 \u1089 , \u1072 \u1083 \u1086 \u1084  \u1101  \u1047 \u1083 \u1072 \u1090 \u1072  \u1095 \u1080  \u1072 \u1083 \u1086 \u1089 \u1072 \u1088 \u1076 \u1072 \u1089  \u1082 \u1093 \u1072 \u1085 \u1080 \u1082 \u1072 \u1089 . \u1051 \u1072 \u1082 \u1086  \u1076 \u1072 \u1076  \u1087 \u1093 \u1101 \u1085 \u1076 \u1072 \u1089  \u1072 \u1090 \u1091 \u1085 \u1095 \u1080 :\cb1 \
\cb2 \'97 \uc0\u1050 \u1086 \u1085  \u1085 \u1080 \u1088 \u1080 \u1103  \u1087 \u1101  \u1075 \u1088 \u1072 \u1089 \u1090  \u1072 \u1085 \u1076 \u1086  \u1087 \u1088 \u1072 \u1089 \u1090 \u1072 \u1080 \u1087 \u1101 , \u1082 \u1086 \u1076 \u1086  \u1074 \u1080  \u1072 \u1074 \u1083 \u1072  \u1083 \u1072 \u1082 \u1086  \u1088 \u1086 \u1084 . \u1063 \u1080  \u1073 \u1080 \u1088 \u1080 \u1089 \u1072 \u1088 \u1076 \u1072 \u1089  \u1082 \u1086 \u1088 \u1082 \u1086 \u1088 \u1080  \u1090 \u1101  \u1072 \u1083 \u1086 \u1081  \u1087 \u1101 \u1089 \u1082 \u1101  \u1088 \u1086 \u1084 \u1101 \u1089  \'97 \u1072 \u1090 \u1091 \u1085 \u1095 \u1080  \u1084 \u1101 , \u1083 \u1072 \u1082 \u1086  \u1076 \u1072 \u1076 , \u1082 \u1101 \u1088 \u1072 \u1074  \u1082 \u1072 \u1076 \u1086 . \u1052 \u1101 \u1082  \u1086  \u1044 \u1101 \u1083  \u1072 \u1083 \u1086 \u1081  \u1084 \u1072 \u1081  \u1083 \u1072 \u1097 \u1077 \u1089 . \u1040 \u1082 \u1093 \u1072 \u1088 \u1101 \u1085  \u1083 \u1072 !\cb1 \
\cb2 \uc0\u1069  \u1047 \u1083 \u1072 \u1090 \u1072  \u1072 \u1074 \u1080 \u1083 \u1072 \u1089  \u1072 \u1074 \u1088 \u1080  \u1072 \u1085 \u1076 \u1072  \u1094 \u1101 \u1088 \u1171 \u1072  \u1090 \u1101 \u1083 \u1101  \u1084 \u1091 \u1082 \u1083 \u1101  \u1096 \u1101 \u1088 \u1101 \u1089 \u1072 . \u1050 \u1086 \u1090 \u1072 \u1088  \u1074 \u1072 \u1079 \u1076 \u1072 \u1089  \u1086  \u1074 \u1072 \u1089 \u1090  \u1090 \u1101  \u1087 \u1093 \u1101 \u1085 \u1101 \u1083  \u1074 \u1072 \u1088 \u1080 -\u1089 \u1086 .\cb1 \
