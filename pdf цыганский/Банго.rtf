\cb2 \uc0\u1050 \u1072 \u1090 \u1072 \u1088  \u1083 \u1072 \u1082 \u1086  \u1072 \u1089 \u1072 \u1080 \u1087 \u1101  \u1096 \u1091 \u1076 \u1088 \u1080 \u1083 \u1072 \u1089  \u1084 \u1091 \u1088 \u1086  \u1080 \u1083 \u1086 . \u1052 \u1101  \u1076 \u1099 \u1082 \u1093 \u1086 \u1089  \u1087 \u1101  \u1083 \u1072 \u1090 \u1101  \u1072 \u1081  \u1075 \u1080 \u1085 \u1076 \u1099 \u1103 \u1089  \u1082 \u1101  \u1074 \u1086 \u1081  \u1076 \u1072 \u1089  \u1090 \u1101 \u1083 \u1101  \u1087 \u1072  \u1075 \u1086 \u1076 \u1080 . \u1063 \'92 \u1072 \u1090 \u1103 \u1088 \u1086 \u1089 , \u1089 \u1086 \u1089 \u1090 \u1072 \u1088  \u1101  \u1082 \u1072 \u1074 \u1101 \u1088  \u1095 \u1080  \u1076 \u1099 \u1082 \u1093 \u1101 \u1085 , \u1082 \u1101  \u1086  \u1073 \u1072 \u1088 \u1080 \u1087 \u1101 , \u1089 \u1072 \u1088  \u1085 \u1072 \u1089 \u1091 \u1083  \u1103 \u1075 , \u1087 \u1093 \u1072 \u1073 \u1072 \u1088 \u1076 \u1072 \u1089  \u1072 \u1074 \u1088 \u1080  \u1083 \u1072 \u1082 \u1086  \u1076 \u1080 . \u1051 \u1101  \u1088 \u1086 \u1084  \u1076 \u1099 \u1082 \u1093 \u1101 \u1085 \u1072 \u1089  \u1076 \u1072 \u1088 \u1072 \u1089 \u1072  \u1082 \u1072 \u1088 \u1080 \u1085 \u1075  \u1086  \u1074 \u1101 \u1096 , \u1082 \u1072 \u1090 \u1072 \u1088  \u1087 \u1072 \u1096 \u1086 \u1083 \u1072 \u1089  \u1073 \u1072 \u1096 \u1072 \u1080 \u1087 \u1101 . \u1052 \u1072 \u1096 \u1082 \u1072 \u1088  \u1082 \u1086 \u1087 \u1072 \u1095 \u1103  \u1089 \u1099 \u1082 \u1072 \u1076 \u1080 \u1083 \u1072 \u1089  \u1084 \u1072 \u1085 \u1091 \u1096 , \u1089 \u1072 \u1074 \u1086  \u1073 \u1072 \u1096 \u1072 \u1074 \u1083 \u1072 \u1089  \u1087 \u1101  \u1083 \u1091 \u1074 \u1091 \u1090 \u1072 . \u1047 \u1083 \u1072 \u1090 \u1072  \u1075 \u1101 \u1083 \u1072 \u1089  \u1083 \u1101 \u1089 \u1090 \u1101 , \u1072 \u1081  \u1083 \u1101  \u1084 \u1072 \u1085 \u1091 \u1096  \u1076 \u1099 \u1085 \u1101  \u1083 \u1072  \u1076 \u1088 \u1086 \u1084 .\cb1 \
