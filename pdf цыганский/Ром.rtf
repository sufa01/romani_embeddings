\cb3 \'96\'a0\uc0\u1058 \u1086 \u1083 \u1100 \u1082 \u1086  \u1087 \u1072 \u1083 \u1101  \u1073 \u1088 \u1072 \u1074 \u1080 \u1085 \u1090 \u1072  \u1087 \u1083 \u1101 \u1089 \u1082 \u1080 \u1088 \u1076 \u1101  \u1073 \u1091 \u1090 \u1099 \u1088  \u1090 \u1088 \u1080 \u1085 \u1101 \u1096 \u1101 \u1083 \u1101 \u1085 \u1076 \u1099 \u1088 , \u1072 \u1076 \u1072  \u1090 \u1101  \u1085 \u1072 \'a0\u1075 \u1080 \u1085 \u1101 \u1089  \u1077 \u1097 \u1105  \u1093 \u1072 \u1073 \u1101 \u1085 \u1072 . \u1043 \u1077 \u1085 \u1077 \u1088 \u1072 \u1083 \u1086  \u1087 \u1088 \u1080 \u1087 \u1093 \u1101 \u1085 \u1076 \u1103  \u1085 \u1080 \u1095 \u1080  \u1090 \u1101  \u1085 \u1072 \'a0\u1090 \u1072 \u1085 \u1075 \u1080 \u1085 \u1101 \u1089 . \u1040 \'a0\u1087 \u1101  \u1083 \u1101 \u1089 \u1082 \u1080 \u1088 \u1086  \u1074 \u1080 \u1076 \u1086  \u1085 \u1072 \'a0\u1087 \u1086 \u1076 \u1091 \u1084 \u1080 \u1085 \u1101 \u1089 \u1072 , \u1089 \u1086 \'a0\u1105 \u1074  \u1076 \u1072 \u1089 \u1072 \u1074 \u1086 . \u1057 \u1091 \u1088 \u1100 \u1105 \u1079 \u1085 \u1086 .\cb1 \
\cb3 \'96\'a0\uc0\u1040 \u1080 ,\'a0\'96 \u1086 \u1087 \u1103 \u1090 \u1100  \u1089 \u1086 \u1075 \u1083 \u1072 \u1089 \u1080 \u1085 \u1076 \u1103 \u1087 \u1101  \u1089 \u1086 \u1089 \u1077 \u1076 \u1086 .\cb1 \
\cb3 \uc0\u1057 \u1082 \u1072 \u1084 \u1080 \u1085 \u1076 \u1072  \u1089 \u1099 \u1089  \u1087 \u1093 \u1101 \u1088 \u1076 \u1101 . \u1050 \u1086 \u1085 \u1077 \u1079 \u1072 \u1074 \u1086 \u1076 \u1086  \u1086 \u1090 \u1082 \u1101 \u1088 \u1076 \u1103  \u1074 \u1072 \u1096  \u1072 \u1076 \u1072 \u1074 \u1072  \u1073 \u1100 \u1103 \u1074  \u1087 \u1086 \u1088 \u1090 \u1072  \u1087 \u1090 \u1080 \u1095 \u1085 \u1080 \u1082 \u1086 \u1089 \u1090 \u1099 \u1088 , \u1082 \u1083 \u1072 \u1076 \u1086 \u1074 \u1099 \u1093 , \u1087 \u1086 \u1075 \u1088 \u1077 \u1073 \u1086 \u1089 \u1090 \u1099 \u1088 . \u1048 \'a0\u1072 \u1076 \u1072  \u1085 \u1072 \u1085 \u1101  \u1089 \u1072 \u1088 \u1086 . \u1057 \u1099 \u1075 \u1086  \u1052 \u1080 \u1093 \u1072 \u1080 \u1083 \u1086  \u1080 \'a0\u1053 \u1072 \u1089 \u1090 \u1103  \u1087 \u1086 \u1095 \u1090 \u1080  \u1079 \u1072 \u1085 \u1072 \u1096 \u1072 \u1076 \u1099 \u1085 \u1101 \u1087 \u1101 \u1089  \u1087 \u1072 \u1083 \u1086  \u1086 \u1090 \u1088 \u1077 \u1079 \u1099 , \u1082 \u1086 \u1088 \u1086 \u1073 \u1082 \u1080 . \u1050 \u1086 \u1083 \u1093 \u1086 \u1079 \u1086 \u1089 \u1090 \u1099 \u1088 , \u1087 \u1072 \u1088 \u1090 \u1082 \u1086 \u1084 \u1072 , \u1082 \u1086 \u1084 \u1080 \u1090 \u1077 \u1090 \u1072  \u1082 \u1086 \u1084 \u1089 \u1086 \u1084 \u1086 \u1083 \u1072 , \u1084 \u1080 \u1093 \u1072 \u1080 \u1083 \u1086 \u1089 \u1082 \u1080 \u1088 \u1080  \u1088 \u1086 \u1076 \u1085 \u1103 \u1090 \u1099 \u1088 , \u1085 \u1072 \u1089 \u1090 \u1103 \u1082 \u1080 \u1088 \u1101  \u1087 \u1086 \u1076 \u1088 \u1091 \u1078 \u1082 \u1101 \u1085 \u1076 \u1099 \u1088 . \u1040 \'a0\u1084 \u1091 \u1077 \u1089 \u1090 \u1099 \u1088  \u1089 \u1072 \u1088 \u1101  \u1088 \u1086 \u1084 \u1101 \u1085 \u1076 \u1099 \u1088  \u1087 \u1093 \u1091 \u1088 \u1086 \u1084  \u1087 \u1086 \u1076 \u1072 \u1088 \u1080 \u1085 \u1076 \u1103  \u1087 \u1088 \u1101  \u1086 \u1090 \u1082 \u1101 \u1088 \u1076 \u1101  \u1082 \u1086 \u1088 \u1086 \u1073 \u1086 \u1095 \u10