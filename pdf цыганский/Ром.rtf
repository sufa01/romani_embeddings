\cb3 \'96\'a0\uc0\u1057 \u1072  \u1077 \u1082 \u1093 . \u1052 \u1101  \u1082 \u1101 \u1076 \u1101  \u1088 \u1072 \u1082 \u1080 \u1088 \u1072 \u1074  \u1083 \u1072 \u1082 \u1101  \u1089 \u1077 \u1082 \u1088 \u1077 \u1090 \u1086 , \u1105 \u1081  \u1076 \u1101 \u1083  \u1084 \u1072 \u1085 \u1075 \u1101  \u1082 \u1086 \u1084 \u1089 \u1086 \u1084 \u1086 \u1083 \u1100 \u1089 \u1082 \u1086 \'a0\u1083 \u1072 \u1074 .\cb1 \
