\cb3 \'96\'a0\uc0\u1057 \u1072 \u1074 \u1101  \u1076 \u1101 \u1096  \u1084 \u1072 \u1088 \u1076 \u1101 ?\cb1 \
\cb3 \'96\'a0\uc0\u1052 \u1080 \u1088 \u1086  \u1096 \u1090 \u1088 \u1072 \u1092 \u1086 . \u1063 \u1080 \u1085  \u1087 \u1072 \u1083  \u1084 \u1072 \u1085 \u1076 \u1101 , \u1080 \'a0\u1086 \u1090 \u1084 \u1101 \u1082  \u1084 \u1072 \u1085 \u1091 \u1096 \u1101 \u1085  \u1082 \u1093 \u1101 \u1088 \u1101 . \u1040 \u1076 \u1072 \u1081  \u1087 \u1086 \'a0\u1084 \u1072 \u1088 \u1076 \u1086 . \u1053 \u1072 \'a0\u1087 \u1072 \u1090 \u1103 \u1089 \'a0\'96 \u1087 \u1077 \u1088 \u1077 \u1075 \u1080 \u1085 . \u1057 \u1072 \u1074 \u1101  \u1084 \u1072 \u1085 \u1075 \u1101  \u1076 \u1101 \u1085 \u1072 \u1089 , \u1076 \u1072 \u1089 \u1072 \u1074 \u1101 \u1085 \u1094 \u1072  \u1080 \'a0\u1087 \u1083 \u1101 \u1089 \u1082 \u1080 \u1088 \u1072 \u1074 . \u1045 \u1089 \u1083 \u1080  \u1085 \u1072 \u1073 \u1091 \u1090 \'85\cb1 \
\cb3 \uc0\u1053 \u1080 \u1082 \u1086 \u1083 \u1072 \u1105  \u1055 \u1077 \u1090 \u1088 \u1086 \u1074 \u1080 \u1095 \u1105  \u1074 \u1086 \u1079 \u1084 \u1091 \u1097 \u1077 \u1085 \u1080 \u1105 \u1089 \u1072  \u1087 \u1093 \u1101 \u1085 \u1076 \u1103 , \u1072 \u1078  \u1089 \'a0\u1087 \u1088 \u1080 \u1089 \u1074 \u1080 \u1089 \u1090 \u1086 \u1084 :\cb1 \
\cb3 \'96\'a0\uc0\u1058 \u1091 \u1084 \u1101  \u1076 \u1078 \u1080 \u1085 \u1101 \u1085 , \u1089 \u1086 \'a0\u1103 \u1074 \u1101 \u1083 \u1072  \u1087 \u1072 \u1083 \u1086  \u1085 \u1077 \u1091 \u1074 \u1072 \u1078 \u1077 \u1085 \u1080 \u1105  \u1082 \u1086  \u1089 \u1101 \u1085 \u1076 \u1086 ?\cb1 \
\cb3 \uc0\u1064 \u1077 \u1083 \u1086 \u1088 \u1086  \u1080 \u1089 \u1082 \u1088 \u1077 \u1085 \u1085 \u1105  \u1079 \u1076 \u1080 \u1074 \u1080 \u1085 \u1076 \u1103 \u1087 \u1101 :\cb1 \
\cb3 \'96\'a0\uc0\u1057 \u1072 \u1074 \u1086 \'a0 \u1085 \u1077 \u1091 \u1074 \u1072 \u1078 \u1077 \u1085 \u1080 \u1105 ?\'a0 \u1045 \u1089 \u1083 \u1080 \'a0 \u1073 \u1099 \'a0 \u1085 \u1077 \'a0 \u1091 \u1074 \u1072 \u1078 \u1072 \u1083 \u1072 , \u1082 \u1086 \'a0 \u1091 \u1090 \u1088 \u1086 \'a0 \'a0\u1085 \u1072 \'a0 \u1088 \u1086 \u1079 \u1075 \u1101 \u1085 \u1101 \u1087 \u1101 \u1089  \u1072 \u1076 \u1072 \u1094 \u1080 \u1088 . \u1056 \u1086 \u1084 \u1072  \u1082 \u1072 \u1084 \u1101 \u1085  \u1090 \u1101  \u1087 \u1086 \u1088 \u1072 \u1082 \u1080 \u1088 \u1101 \u1085 . \u1052 \u1101  \u1087 \u1101 \u1089 \u1082 \u1080 \u1088 \u1086  \u1096 \u1090 \u1088 \u1072 \u1092 \u1086  \u1082 \u1072 \u1084 \u1072 \u1084  \u1076 \u1086 \u1073 \u1088 \u1086 \u1074 \u1086 \u1083 \u1100 \u1085 \u1101 \u1089  \u1090 \u1101  \u1086 \u1090 \u1076 \u1072 \u1074 . \u1063 \u1080 \u1085  \u1083 \u1101 \u1089 , \u1053 \u1080 \u1082 \u1086 \u1083 \u1072 \u1105  \u1055 \u1077 \u1090 \u1088 \u1086 \u1074 \u1080 \u1095 \u1105 , \u1087 \u1072 \u1083  \u1084 \u1072 \u1085 \u1076 \u1101 , \u1080 \'a0\u1086 \u1090 \u1084 \u1101 \u1082  \u1084 \u1072 \u1085 \u1091 \u1096 \u1101 \u1085 .\cb1 \
\cb3 \uc0\u1053 \u1080 \u1082 \u1086 \u1083 \u1072 \u1105  \u1055 \u1077 \u1090 \u1088 \u1086 \u1074 \u1080 \u1095 \u1105  \u1073 \u1088 \u1077 \u1079 \u1075 \u1083 \u1080 \u1074 \u1086  \u1086 \u1090 \u1095 \u1102 \u1088 \u1076 \u1099 \u1103  \u1083 \u1086 \u1074 \u1101 , \u1105 \u1085 \u1101  \u1077 \u1076 \u1074 \u1072  \u1085 \u1072 \'a0\u1087 \u1099 \u1085 \u1101  \u1087 \u1088 \u1086  \u1087 \u1072 \u1090 \u1086 .\cb1 \
\cb3 \'96\'a0\uc0\u1058 \u1091 \u1084 \u1101  \u1089 \u1086 , \u1079 \u1072 \u1082 \u1072 \u1084 \u1083 \u1101  \u1072 \u1076 \u1072 \u1083 \u1101 \u1085 \u1094 \u1072  \u1083 \u1086 \u1074 \u1101 \u1085 \u1094 \u1072  \u1084 \u1101 \u1083 \u1072 \u1083 \u1101 \u1085 \u1094 \u1072  \u1090 \u1101  \u1086 \u1090 \u1082 \u1080 \u1085 \u1101 \u1085 \u1087 \u1101 ?\cb1 \
\cb3 \uc0\u1064 \u1077 \u1083 \u1086 \u1088 \u1086  \u1088 \u1086 \u1089 \u1087 \u1093 \u1091 \u1088 \u1076 \u1099 \u1103  \u1085 \u1072 \u1082 \u1093 . \u1055 \u1086 \u1089 \u1099 \u1082 \u1072 \u1076 \u1099 \u1103 , \u1089 \u1086 \'a0\u1105 \u1081  \u1088 \u1086 \u1079 \u1084 \u1072 \u1088 \u1083 \u1072 \u1089 \u1087 \u1101  \u1073 \u1091 \u1088 \u1103 \u1089 \u1072 , \u1085 \u1101  \u1105 \u1081  \u1087 \u1093 \u1101 \u1085 \u1076 \u1103 :\cb1 \
\cb3 \'96\'a0\uc0\u1053 \u1072 \'a0\u1082 \u1091 \u1095 , \u1053 \u1080 \u1082 \u1086 \u1083 \u1072 \u1105  \u1055 \u1077 \u1090 \u1088 \u1086 \u1074 \u1080 \u1095 \u1105 . \u1058 \u1091 \u1090  \u1080 \'a0\u1075 \u1072 \u1076 \u1078 \u1105 , \u1080 \'a0\u1088 \u1086 \u1084 \u1072  \u1091 \u1074 \u1072 \u1078 \u1072 \u1102 \u1090  \u1076 \u1088 \u1086  \u1087 \u1086 \u1089 \u1105 \u1083 \u1082 \u1086 , \u1072 \'a0\u1090 \u1091  \u1084 \u1072 \u1085 \u1075 \u1101  \u1073 \u1080 \u1076 \u1072  \u1082 \u1101 \u1088 \u1101 \u1089 . \u1057 \u1086 \u1089 \u1090 \u1099 \u1088  \u1084 \u1101 \u1083 \u1072 \u1083 \u1101 ? \u1050 \u1072 \u1078 \u1076 \u1086  \u1084 \u1072 \u1085 \u1091 \u1096  \u1087 \u1086 \u1083 \u1091 \u1095 \u1082 \u1080 \u1088 \u1101 \u1083  \u1087 \u1072 \u1083  \u1087 \u1101 \u1089 \u1082 \u1080 \u1088 \u1080  \u1073 \u1091 \u1090 \u1099 , \u1089 \u1072 \u1074 \u1080  \u1076 \u1078 \u1080 \u1085 \u1101 \u1083 . \u1048 \'a0\u1090 \u1091 , \u1053 \u1080 \u1082 \u1086 \u1083 \u1072 \u1105  \u1055 \u1077 \u1090 \u1088 \u1086 \u1074 \u1080 \u1095 \u1105  \u1084 \u1080 \u1088 \u1101 \u1085 \u1094 \u1072  \u1083 \u1086 \u1074 \u1101 \u1085 \u1094 \u1072  \u1085 \u1077 \'a0\u1073 \u1088 \u1077 \u1079 \u1075 \u1091 \u1081 . \u1040 \u1076 \u1072 \u1081  \u1087 \u1072 \u1083 \u1101  \u1089 \u1072 \u1088 \u1101  \u1076 \u1101 \u1074 \u1101 \u1089 \u1072 , \u1089 \u1086 \'a0\u1087 \u1088 \u1086 \u1075 \u1091 \u1083 \u1080 \u1085 \u1076 \u1105 \u1084 . \u1055 \u1088 \u1101  \u1082 \u1091 \u1082 \u1091 \u1088 \u1091 \u1079 \u1072  \u1084 \u1072 \u1085 \u1075 \u1101  \u1073 \u1091 \u1090 \u1099 \u1088  \u1080 \'a0\u1085 \u1072 \'a0\u1087 \u1083 \u1101 \u1089 \u1082 \u1080 \u1088 \u1101 \u1085 \u1072 \u1089 .\cb1 \
\cb3 \uc0\u1057 \u1086 \u1073 \u1099  \u1087 \u1093 \u1101 \u1085 \u1101 \u1083 \u1072 \u1089  \u1053 \u1080 \u1082 \u1086 \u1083 \u1072 \u1105  \u1055 \u1077 \u1090 \u1088 \u1086 \u1074 \u1080 \u1095 \u1105  \u1085 \u1077 \'a0\u1080 \u1079 \u1074 \u1077 \u1089 \u1090 \u1085 \u1086 , \u1085 \u1101  \u1083 \u1101 \u1089 \u1082 \u1080 \u1088 \u1086  \u1089 \u1086 \u1089 \u1077 \u1076 \u1086  \u1087 \u1093 \u1101 \u1085 \u1076 \u1103 :\cb1 \
\cb3 \'96\'a0\uc0\u1040 \'a0\u1090 \u1091 \'a0\u1073 \u1099  \u1085 \u1072 \'a0\u1095 \u1102 \u1088 \u1076 \u1101 \u1089 \u1072 \u1089  \u1087 \u1072 \u1090 \u1088 \u1103  \u1076 \u1088 \u1101  \u1082 \u1091 \u1082 \u1091 \u1088 \u1091 \u1079 \u1072 , \u1084 \u1086 \u1078 \u1077 \u1090 , \u1080 \'a0\u1073 \u1091 \u1090 \u1099 \u1088  \u1074 \u1099 \u1076 \u1078 \u1103 \u1083 \u1072 \u1089 \'a0\u1073 \u1099 .\cb1 \
\cb3 \uc0\u1064 \u1077 \u1083 \u1086 \u1088 \u1086  \u1087 \u1086 \u1082 \u1072 \u1095 \u1080 \u1085 \u1076 \u1103  \u1096 \u1101 \u1088 \u1101 \u1089 \u1072 :\cb1 \
\cb3 \'96\'a0\uc0\u1040 \u1084 \u1101 \u1085 \u1075 \u1101  \u1076 \u1072 \u1089 \u1072 \u1074 \u1080  \u1073 \u1091 \u1090 \u1099  \u1085 \u1072 \'a0\u1087 \u1086 \u1076 \u1076 \u1078 \u1103 \u1083 .\cb1 \
\cb3 \'96\'a0\uc0\u1057 \u1086 \u1089 \u1090 \u1099 \u1088  \u1090 \u1091 \u1082 \u1101  \u1085 \u1072 \'a0\u1083 \u1072 \u1095 \u1080  \u1073 \u1091 \u1090 \u1099 ?\cb1 \
\cb3 \'96\'a0\uc0\u1058 \u1091 , \u1073 \u1088 \u1080 \u1075 \u1072 \u1076 \u1080 \u1088 \u1086 , \u1084 \u1072 \u1085  \u1087 \u1088 \u1086  \u1083 \u1072 \u1074  \u1085 \u1072 \'a0\u1089 \u1090 \u1072 \u1088 . \u1044 \u1091 \u1084 \u1080 \u1085 \u1101 \u1089 , \u1090 \u1091  \u1077 \u1082 \u1076 \u1078 \u1080 \u1085 \u1086  \u1072 \u1076 \u1072 \u1081  \u1089 \u1072 \u1084 \u1086  \u1075 \u1086 \u1076 \u1103 \u1074 \u1080 \u1088 ? \u1050 \u1072 \u1084 \u1101 \u1089  \u1090 \u1101  \u1089 \u1090 \u1072 \u1088 \u1101 \u1089 \'a0\'96 \u1083 \u1101  \u1096 \u1090 \u1088 \u1072 \u1092 \u1086 . \u1040 \'a0\u1082 \u1072 \u1084 \u1101 \u1089  \u1095 \u1103 \u1095 \u1080 \u1087 \u1101  \u1084 \u1072 \u1085 \u1076 \u1099 \u1088  \u1090 \u1101  \u1091 \u1076 \u1078 \u1080 \u1085 \u1101 \u1089 \'a0\'96 \u1087 \u1086 \u1096 \u1091 \u1085 . \u1052 \u1101 \'a0\u1078 \u1077  \u1085 \u1072 \'a0\u1087 \u1093 \u1101 \u1085 \u1076 \u1105 \u1084  \u1085 \u1072 \u1083 \u1072 \u1095 \u1080  \u1073 \u1091 \u1090 \u1099 , \u1084 \u1101  \u1087 \u1093 \u1101 \u1085 \u1076 \u1105 \u1084  \u1089 \u1086 \'a0\u1085 \u1072 \u1085 \u1101  \u1088 \u1086 \u1084 \u1072 \u1085 \u1099  \u1105 \u1081 . \u1058 \u1101 \u1083 \u1101  \u1072 \u1084 \u1072 \u1088 \u1080  \u1087 \u1088 \u1080 \u1088 \u1086 \u1076 \u1072  \u1085 \u1072 \'a0\u1087 \u1086 \u1076 \u1076 \u1078 \u1103 \u1083 . \u1050 \u1086 \u1085  \u1089 \u1086 \'a0\u1076 \u1078 \u1080 \u1085 \u1101 \u1083 , \u1082 \u1101  \u1089 \u1086 \'a0\u1087 \u1088 \u1080 \u1089 \u1099 \u1082 \u1083 \u1099 \u1103 . \u1040 \u1084 \u1101 \'a0\'96 \u1084 \u1072 \u1085 \u1091 \u1096 \u1072  \u1087 \u1088 \u1080 \u1088 \u1086 \u1076 \u1072 \u1090 \u1099 \u1088 . \u1040 \u1084 \u1101 \u1085 \u1075 \u1101  \u1095 \u1077 \u1081 \u1085 \u1086  \u1074 \u1088 \u1077 \u1084 \u1105 , \u1089 \u1086 \u1073 \u1099  \u1087 \u1088 \u1080 \u1089 \u1099 \u1082 \u1083 \u1099 \u1103 \u1084 .\cb1 \
\cb3 \uc0\u1040 \u1076 \u1072 \u1081  \u1090 \u1088 \u1080 \u1090 \u1086  \u1084 \u1086 \u1083 \u1086  \u1087 \u1072 \u1083 \u1101  \u1073 \u1077 \u1083 \u1100 \u1074 \u1077 \u1083 \u1077  \u1093 \u1091 \u1083 \u1072 \u1085 \u1099  \u1090 \u1082 \u1085 \u1091 \u1083 \u1072  \u1076 \u1088 \u1086  \u1073 \u1086 \u1082 \u1086 :\cb1 \
\cb3 \'96\'a0\uc0\u1064 \u1091 \u1085 , \u1096 \u1091 \u1085 . \u1050 \u1072 \u1085 \u1072  \u1087 \u1072 \u1083  \u1072 \u1076 \u1072 \u1103  \u1087 \u1088 \u1080 \u1088 \u1086 \u1076 \u1072  \u1084 \u1080 \u1088 \u1080  \u1082 \u1074 \u1072 \u1088 \u1090 \u1080 \u1088 \u1072 \u1085 \u1090 \u1082 \u1072  \u1053 \u1072 \u1089 \u1090 \u1103  \u1074 \u1095 \u1080 \u1085 \u1101 \u1083 \u1072 . \u1057 \u1099 \u1088  \u1088 \u1086 \u1084 \u1085 \u1099  \u1088 \u1086 \u1084 \u1085 \u1103 \u1082 \u1101 .\cb1 \
\cb3 \uc0\u1058 \u1101 \u1083 \u1086  \u1087 \u1077 \u1088 \u1074 \u1086  \u1088 \u1103 \u1076 \u1086  \u1082 \u1086 \u1083 \u1099 \u1093 \u1085 \u1091 \u1083 \u1089 \u1103  \u1082 \u1072 \u1083 \u1101 \u1073 \u1072 \u1083 \u1101 \u1085 \u1075 \u1080 \u1088 \u1086  \u1082 \u1091 \u1089 \u1090 \u1086 . \u1050 \u1101 \u1088 \u1076 \u1103 \u1087 \u1101  \u1090 \u1080 \u1096 \u1080 \u1085 \u1072 . \u1053 \u1072 \u1089 \u1090 \u1105  \u1087 \u1088 \u1077 \u1079 \u1088 \u1077 \u1085 \u1080 \u1105 \u1089 \u1072  \u1089 \u1087 \u1091 \u1095 \u1100 \u1103 :\cb1 \
\cb3 \'96\'a0\uc0\u1048 \'a0\u1087 \u1101 \u1089 \u1082 \u1080 \u1088 \u1101 \u1085 \u1076 \u1099 \u1088  \u1095 \u1072 \u1074 \u1086 \u1088 \u1101 \u1085 \u1076 \u1099 \u1088  \u1090 \u1091  \u1082 \u1072 \u1084 \u1101 \u1089  \u1090 \u1101  \u1086 \u1090 \u1082 \u1080 \u1085 \u1101 \u1089 \u1087 \u1101  \u1076 \u1101 \u1096 \u1080 \u1090 \u1082 \u1086 \u1085 \u1072 \u1089 \u1072 ?\cb1 \
\cb3 \uc0\u1064 \u1077 \u1083 \u1086 \u1088 \u1086  \u1076 \u1103 \u1082 \u1101 \'a0\u1078 \u1077 , \u1089 \u1072 \u1073 \u1085 \u1072 \u1089 \u1072  \u1087 \u1093 \u1101 \u1085 \u1076 \u1103 :\cb1 \
\cb3 \'96\'a0\uc0\u1052 \u1080 \u1088 \u1080  \u1095 \u1072 \u1074 \u1086 \u1088 \u1101 , \u1053 \u1072 \u1089 \u1090 \u1105 , \u1072 \u1076 \u1072 \u1081  \u1085 \u1080  \u1087 \u1088 \u1080 \u1095 \u1105 \u1084 . \u1058 \u1091  \u1073 \u1080 \u1103 \u1085  \u1072 \u1085 \u1075 \u1083 \u1099 \u1076 \u1099 \u1088  \u1087 \u1101 \u1089 \u1082 \u1080 \u1088 \u1101 \u1085 . \u1053 \u1101  \u1072 \u1085 \u1075 \u1080 \u1083  \u1088 \u1086 \u1084 \u1101 \u1089  \u1087 \u1101 \u1089 \u1082 \u1101  \u1083 \u1072 \u1090 \u1093 , \u1040 \'a0\u1090 \u1086  \u1090 \u1091 , \u1095 \u1105 \u1088 \u1086 \u1088 \u1080 , \u1085 \u1072 \'a0\u1076 \u1078 \u1080 \u1085 \u1101 \u1089 , \u1087 \u1072 \u1083  \u1082 \u1086 \u1085 \u1101 \u1089 \u1090 \u1101  \u1090 \u1101  \u1076 \u1078 \u1103 \u1089 . \u1058 \u1101 \u1088 \u1085 \u1086 , \u1080 \u1083 \u1080  \u1073 \u1088 \u1086 \u1076 \u1072 \u1090 \u1086 .\cb1 \
\cb3 \uc0\u1055 \u1088 \u1101  \u1072 \u1076 \u1072 \u1089 \u1072 \u1074 \u1101  \u1083 \u1072 \u1074 \u1072  \u1076 \u1088 \u1086  \u1079 \u1072 \u1083 \u1086  \u1087 \u1088 \u1086 \u1087 \u1088 \u1072 \u1089 \u1090 \u1072 \u1085 \u1076 \u1099 \u1103  \u1089 \u1072 \u1074 \u1086  \'97\u1090 \u1086  \u1096 \u1105 \u1087 \u1086 \u1090 \u1086 , \u1075 \u1091 \u1083 \u1086 . \u1053 \u1072 \u1089 \u1090 \u1103  \u1085 \u1072 \u1073 \u1091 \u1090  \u1089 \u1084 \u1091 \u1090 \u1080 \u1083 \u1072 \u1089 \u1100 , \u1085 \u1101  \u1072 \u1076 \u1072 \u1081 \'a0\u1078 \u1077  \u1074 \u1095 \u1102 \u1088 \u1076 \u1099 \u1103  \u1082 \u1072 \u1083 \u1101 \u1073 \u1072 \u1083 \u1099 \u1090 \u1082 \u1086  \u1096 \u1101 \u1088 \u1086 :\cb1 \
\cb3 \'96\'a0\uc0\u1053 \u1077 \'a0\u1073 \u1077 \u1089 \u1087 \u1086 \u1082 \u1086 \u1081 \u1089 \u1103 , \u1064 \u1077 \u1083 \u1086 \u1088 \u1086 . \u1058 \u1091 \u1090  \u1073 \u1091 \u1073 \u1085 \u1086 \u1089 \u1072  \u1087 \u1088 \u1086  \u1073 \u1100 \u1103 \u1074  \u1089 \u1072  \u1077 \u1082 \u1093  \u1085 \u1072 \'a0\u1087 \u1086 \u1082 \u1093 \u1072 \u1088 \u1072 \u1074 \u1072 . \u1040 \'a0\u1090 \u1099 \u1088 \u1101 \u1085  \u1095 \u1072 \u1074 \u1086 \u1088 \u1101 \u1085 , \u1082 \u1101 \u1076 \u1101  \u1090 \u1091  \u1090 \u1088 \u1072 \u1076 \u1101 \u1089  \u1084 \u1072 \u1085 \u1091 \u1096 \u1101 \u1085  \u1090 \u1101  \u1076 \u1099 \u1083 \u1085 \u1103 \u1082 \u1080 \u1088 \u1101 \u1089 , \u1084 \u1072 \u1085 \u1075 \u1101  \u1087 \u1088 \u1080 \u1076 \u1078 \u1103 \u1083 \u1072 \u1089 \u1087 \u1101  \u1082 \u1091 \u1087 \u1072 \u1090 \u1100 , \u1090 \u1101  \u1088 \u1086 \u1089 \u1087 \u1093 \u1101 \u1085 \u1072 \u1074  \u1087 \u1072 \u1088 \u1072 \u1084 \u1099 \u1089 \u1080  \u1087 \u1088 \u1101  \u1088 \u1072 \u1090 . \u1061 \u1086 \u1090 \u1103  \u1083 \u1101 \u1085 \u1076 \u1101  \u1080 \u1089 \u1099  \u1076 \u1072 \u1081  \u1076 \u1078 \u1080 \u1076 \u1099 . \u1048 \'a0\u1072 \u1076 \u1072 \'a0\u1073 \u1099  \u1077 \u1097 \u1105  \u1085 \u1080 \u1095 \u1080 \'85\cb1 \
\cb3 \uc0\u1064 \u1077 \u1083 \u1086 \u1088 \u1086  \u1089 \u1077 \u1088 \u1100 \u1105 \u1079 \u1085 \u1101 \u1089  \u1085 \u1080 \u1079 \u1082 \u1086  \u1087 \u1086 \u1082 \u1083 \u1086 \u1085 \u1080 \u1083 \u1072 \u1089 \u1100  \u1053 \u1072 \u1089 \u1090 \u1103 \u1082 \u1101 :\cb1 \
\cb3 \'96\'a0\uc0\u1055 \u1072 \u1083 \u1101  \u1087 \u1101 \u1089 \u1082 \u1080 \u1088 \u1101 \u1085 \u1076 \u1101  \u1095 \u1072 \u1074 \u1086 \u1088 \u1101 \u1085 \u1076 \u1101  \u1084 \u1101 , \u1053 \u1072 \u1089 \u1090 \u1105 , \u1091 \u1078 \u1077  \u1088 \u1072 \u1082 \u1080 \u1088 \u1076 \u1105 \u1084  \u1085 \u1072 \u1080 \u1089 . \u1048 \'a0\u1077 \u1097 \u1105  \u1077 \u1082 \u1093  \u1084 \u1086 \u1083 \u1086  \u1085 \u1077 \'a0\u1087 \u1086 \u1083 \u1077 \u1085 \u1102 \u1089 \u1100  \u1090 \u1101  \u1087 \u1093 \u1101 \u1085 \u1072 \u1074 . \u1053 \u1101  \u1072 \u1076 \u1072  \u1090 \u1099 \u1088 \u1080  \u1073 \u1091 \u1090 \u1099  \u1076 \u1088 \u1101  \u1095 \u1072 \u1074 \u1086 \u1088 \u1101 \u1085 \u1075 \u1080 \u1088 \u1086  \u1089 \u1072 \u1076 \u1080 \u1082 \u1086 . \u1058 \u1091 \u1082 \u1101  \u1087 \u1072 \u1083  \u1072 \u1076 \u1072  \u1083 \u1086 \u1074 \u1101  \u1087 \u1083 \u1101 \u1089 \u1082 \u1080 \u1088 \u1101 \u1085 .\cb1 \
\cb3 \uc0\u1054 \u1087 \u1103 \u1090 \u1100  \u1087 \u1088 \u1086 \u1087 \u1088 \u1072 \u1089 \u1090 \u1072 \u1085 \u1076 \u1099 \u1103  \u1074 \u1086 \u1083 \u1085 \u1072  \u1089 \u1072 \u1074 \u1086 \'a0\'96 \u1090 \u1086  \u1075 \u1091 \u1083 \u1086 . \u1056 \u1086 \u1087 \u1086 \u1090 \u1086  \u1089 \u1099 \u1089  \u1085 \u1072 \u1085 \u1101  \u1076 \u1088 \u1101  \u1064 \u1077 \u1083 \u1086 \u1088 \u1101 \u1089 \u1082 \u1080 \u1088 \u1080  \u1087 \u1086 \u1083 \u1100 \u1079 \u1072 . \u1059 \u1096 \u1091 \u1085 \u1076 \u1103  \u1088 \u1077 \u1087 \u1083 \u1080 \u1082 \u1080 :\cb1 \
\cb3 \'96\'a0\uc0\u1040 \'a0\u1090 \u1099 \u1088 \u1080  \u1089 \u1072 \u1074 \u1080  \u1076 \u1086 \u1083 \u1078 \u1085 \u1086 \u1089 \u1090 \u1100 ?\cb1 \
\cb3 \'96\'a0\uc0\u1048 \'a0\u1072 \u1076 \u1072  \u1076 \u1072 \u1081  \u1082 \u1093 \u1072 \u1088 \u1101 \u1083 \u1087 \u1101 !\cb1 \
\cb3 \'96\'a0\uc0\u1052 \u1086 \u1078 \u1077 \u1090 , \u1087 \u1072 \u1083  \u1072 \u1076 \u1072 \u1074 \u1072  \u1090 \u1086 \u1078 \u1077  \u1079 \u1072 \u1088 \u1087 \u1083 \u1072 \u1090 \u1072  \u1090 \u1101  \u1087 \u1083 \u1101 \u1089 \u1082 \u1080 \u1088 \u1101 \u1089 ?\cb1 \
\cb3 \uc0\u1056 \u1086 \u1084 \u1085 \u1099  \u1055 \u1091 \u1089 \u1090 \u1086 \u1096 \u1082 \u1080 \u1085 \u1072  \u1076 \u1072 \u1078 \u1077  \u1074 \u1089 \u1082 \u1086 \u1095 \u1080 \u1085 \u1076 \u1103  \u1096 \u1090 \u1101 \u1090 \u1086 \u1089 \u1090 \u1099 \u1088 , \u1090 \u1101  \u1083 \u1101 \u1083  \u1088 \u1077 \u1074 \u1072 \u1085 \u1096 \u1086  \u1087 \u1072 \u1083 \u1086  \u1088 \u1086 \u1084 \u1101 \u1089 \u1082 \u1080 \u1088 \u1086  \u1083 \u1072 \u1076 \u1078 \u1103 \u1080 \u1087 \u1101 :\cb1 \
\cb3 \'96\'a0\uc0\u1025 \u1081 , \u1079 \u1085 \u1072 \u1095 \u1080 \u1090 , \u1090 \u1101  \u1079 \u1091 \u1084 \u1072 \u1074 \u1101 \u1083 , \u1072 \'a0\u1072 \u1084 \u1101  \u1083 \u1072 \u1082 \u1080 \u1088 \u1101 \u1085  \u1095 \u1072 \u1074 \u1086 \u1088 \u1101 \u1085  \u1090 \u1101  \u1088 \u1072 \u1082 \u1093 \u1072 \u1089 ?\cb1 \
\cb3 \uc0\u1071 \u1075  \u1087 \u1077 \u1088 \u1077 \u1075 \u1101 \u1103  \u1087 \u1088 \u1101  \u1083 \u1072 \u1090 \u1101 :\cb1 \
\cb3 \'96\'a0\uc0\u1069 \u1085 \u1072 , \u1089 \u1072 \u1074 \u1080  \u1088 \u1086 \u1084 \u1085 \u1099  \u1042 \u1072 \u1089 \u1103 \u1089 \u1082 \u1080 \u1088 \u1080 !\cb1 \
\cb3 \'96\'a0\uc0\u1054 \u1090 \u1086 \u1084 \u1089 \u1090 \u1080 \u1083 \u1072 , \u1052 \u1072 \u1083 \u1072 \u1096 \u1072 !\cb1 \
\cb3 \'96\'a0\uc0\u1044 \u1091 \u1078 \u1072 \u1082 \u1080 \u1088 \u1101 \u1083 \u1072 \u1089 , \u1076 \u1091 \u1078 \u1072 \u1082 \u1080 \u1088 \u1101 \u1083 \u1072 \u1089 , \u1080 \'a0\u1087 \u1086 \u1076 \u1089 \u1090 \u1077 \u1088 \u1077 \u1075 \u1083 \u1072 !\cb1 \
\cb3 \'96\'a0\uc0\u1044 \u1103 \u1082 \u1101  \u1083 \u1101 \u1085 , \u1072 \u1076 \u1072 \u1083 \u1101 \u1085  \u1094 \u1099 \u1075 \u1072 \u1085 \u1077 \u1081 .\cb1 \
\cb3 \'96\'a0\uc0\u1057 \u1086 \u1073 \u1099  \u1085 \u1077 \'a0\u1086 \u1073 \u1080 \u1078 \u1072 \u1083 \u1080  \u1090 \u1099 \u1088 \u1101 \u1089  \u1042 \u1072 \u1089 \u1103 \u1089 !\cb1 \
\cb3 \'96\'a0\uc0\u1055 \u1072 \u1083  \u1076 \u1072 \u1089 \u1072 \u1074 \u1101  \u1090 \u1072 \u1085 \u1082 \u1086 \u1081  \u1090 \u1091 , \u1042 \u1072 \u1089 \u1103 , \u1085 \u1072 \'a0\u1093 \u1072 \u1089 \u1105 \u1089 \u1072 .\cb1 \
\cb3 \uc0\u1044 \u1072 \u1078 \u1077  \u1064 \u1077 \u1083 \u1086 \u1088 \u1086  \u1079 \u1072 \u1089 \u1072 \u1085 \u1076 \u1103 \u1087 \u1101 , \u1085 \u1101  \u1087 \u1088 \u1101  \u1083 \u1072 \u1074 \u1082 \u1072  \u1085 \u1072 \'a0\u1073 \u1101 \u1096 \u1090 \u1103 . \u1052 \u1072 \u1083 \u1072 \u1096 \u1072  \u1082 \u1072 \u1084 \u1100 \u1103  \u1090 \u1101  \u1087 \u1080 \u1088 \u1080 \u1075 \u1086 \u1076 \u1083 \u1101 \u1083  \u1101  \u1075 \u1074 \u1072 \u1083 \u1090 \u1072 , \u1085 \u1101  \u1085 \u1077 \'a0\u1089 \u1084 \u1086 \u1075 \u1083 \u1072 .\cb1 \
\cb3 \'96\'a0\uc0\u1040 , \u1076 \u1072  \u1085 \u1091  \u1090 \u1091 \u1084 \u1101 \u1085 !\cb1 \
\cb3 \uc0\u1025 \u1081  \u1073 \u1101 \u1096 \u1090 \u1103 . \u1055 \u1091 \u1089 \u1090 \u1086 \u1096 \u1082 \u1080 \u1085 \u1099 \u1084  \u1103 \u1074 \u1085 \u1086  \u1076 \u1072 \u1076 \u1099 \u1074 \u1101 \u1089  \u1085 \u1072 \u1085 \u1101  \u1073 \u1072 \u1093 \u1090  \u1087 \u1088 \u1101  \u1090 \u1088 \u1080 \u1073 \u1091 \u1085 \u1072 . \u1044 \u1088 \u1086  \u1079 \u1072 \u1083 \u1086  \u1075 \u1091 \u1083 \u1080 \u1085 \u1101 \u1085 \u1072 \u1089  \u1083 \u1072 \u1082 \u1080 \u1088 \u1101  \u1083 \u1072 \u1074 \u1072 : \'ab\'96 \u1025 \u1081 , \u1079 \u1085 \u1072 \u1095 \u1080 \u1090 , \u1103 \u1074 \u1101 \u1083 \u1072  \u1090 \u1101  \u1079 \u1091 \u1084 \u1072 \u1074 \u1101 \u1083 , \u1072 \'a0\u1072 \u1084 \u1101 , \u1079 \u1085 \u1072 \u1095 \u1080 \u1090 , \u1083 \u1072 \u1082 \u1080 \u1088 \u1101  \u1095 \u1072 \u1074 \u1086 \u1088 \u1101 \u1085  \u1090 \u1101  \u1088 \u1072 \u1082 \u1093 \u1072 \u1089 ?\'bb. \u1040 \u1076 \u1072 \u1081  \u1082 \u1086 \u1085 \'a0\'96 \u1090 \u1086  \u1089 \u1087 \u1091 \u1095 \u1100 \u1103 :\cb1 \
\cb3 \'96\'a0\uc0\u1040 \'a0\u1089 \u1099 \u1088  \u1082 \u1072 \u1085 \u1072  \u1105 \u1085 \u1101  \u1083 \u1101 \u1085 \u1072  \u1090 \u1101  \u1090 \u1088 \u1072 \u1076 \u1101 \u1085  \u1090 \u1101  \u1079 \u1091 \u1084 \u1072 \u1074 \u1101 \u1085 ?\cb1 \
\cb3 \uc0\u1055 \u1093 \u1101 \u1085 \u1076 \u1103  \u1085 \u1072 \u1085 \u1101  \u1079 \u1086 \u1088 \u1072 \u1083 \u1099  \u1075 \u1083 \u1086 \u1089 \u1103 \u1089 \u1072 , \u1085 \u1101  \u1064 \u1077 \u1083 \u1086 \u1088 \u1086  \u1079 \u1072 \u1084 \u1077 \u1090 \u1085 \u1086  \u1074 \u1079 \u1076 \u1088 \u1086 \u1075 \u1080 \u1085 \u1076 \u1103 . \u1047 \u1072 \u1084 \u1101 \u1103 . \u1071 \u1082 \u1093 \u1101 \u1085 \u1094 \u1072 , \u1089 \u1099 \u1088  \u1076 \u1091 \u1081  \u1073 \u1072 \u1088 \u1101  \u1096 \u1084 \u1077 \u1083 \u1080 , \u1088 \u1086 \u1076 \u1101 \u1085 \u1072 \u1089  \u1082 \u1086 \u1085 \u1101 \u1089 \'a0\'96 \u1090 \u1086  \u1076 \u1088 \u1086  \u1079 \u1072 \u1083 \u1086 . \u1025 \u1081  \u1085 \u1077 \'a0\u1084 \u1086 \u1075 \u1083 \u1072  \u1080 \'a0\u1085 \u1072 \'a0\u1076 \u1078 \u1080 \u1085 \u1101 \u1083 \u1072 \u1089 , \u1089 \u1099 \u1088  \u1090 \u1101  \u1089 \u1088 \u1080 \u1082 \u1080 \u1088  \u1076 \u1072 \u1088 . \u1053 \u1101 , \u1089 \u1099 \u1082 \u1072 \u1076 \u1103 , \u1085 \u1072 \u1085 \u1101  \u1090 \u1086 \u1083 \u1100 \u1082 \u1086  \u1083 \u1072 . \u1057 \u1072 \u1088 \u1101  \u1088 \u1086 \u1084 \u1072  \u1087 \u1086 \u1085 \u1091 \u1088 \u1080 \u1083 \u1080 \u1089 \u1100 , \u1073 \u1101 \u1096 \u1101 \u1085 \u1072 \u1089  \u1090 \u1080 \u1093 \u1101 \u1089 . \u1053 \u1072 \u1089 \u1090 \u1103 \'a0\u1078 \u1077 , \u1082 \u1086 \u1083 \u1099 \u1093 \u1085 \u1091 \u1083 \u1072  \u1082 \u1072 \u1083 \u1101  \u1073 \u1072 \u1083 \u1072 , \u1087 \u1093 \u1101 \u1085 \u1076 \u1103 :\cb1 \
\cb3 \'96\'a0\uc0\u1055 \u1072 \u1083  \u1072 \u1076 \u1072 \u1074 \u1072  \u1095 \u1105 \u1081 \u1085 \u1086  \u1090 \u1101  \u1089 \u1087 \u1091 \u1095 \u1077 \u1083  \u1085 \u1072 \u1085 \u1101  \u1083 \u1072 \u1090 \u1099 \u1088 . \u1060 \u1101 \u1076 \u1099 \u1088  \u1088 \u1086 \u1089 \u1087 \u1093 \u1101 \u1085 \u1101 \u1083 \u1072  \u1083 \u1072 \u1082 \u1080 \u1088 \u1086  \u1088 \u1086 \u1084  \u1045 \u1075 \u1086 \u1088 \u1086 .\cb1 \
\cb3 \uc0\u1053 \u1080 \u1082 \u1086 \u1083 \u1072 \u1105  \u1055 \u1077 \u1090 \u1088 \u1086 \u1074 \u1080 \u1095 \u1105  \u1091 \u1096 \u1090 \u1099 \u1103 :\cb1 \
\cb3 \'96\'a0\uc0\u1045 \u1075 \u1086 \u1088 \u1086  \u1056 \u1086 \u1084 \u1072 \u1085 \u1086 \u1074  \u1072 \u1076 \u1072 \u1081 ?\cb1 \
\cb3 \uc0\u1057 \u1099 \u1075 \u1086  \u1091 \u1076 \u1078 \u1080 \u1085 \u1076 \u1083 \u1101 , \u1089 \u1086 \'a0\u1045 \u1075 \u1086 \u1088 \u1086  \u1056 \u1086 \u1084 \u1072 \u1085 \u1086 \u1074  \u1085 \u1072 \u1096 \u1072 \u1076 \u1103 \u1087 \u1101  \u1076 \u1088 \u1086  \u1079 \u1072 \u1083 \u1086  \u1082 \u1072 \u1081  \u1087 \u1086 \u1090 \u1105 \u1084 \u1082 \u1080 , \u1089 \u1099 \u1088  \u1089 \u1091 \u1074  \u1076 \u1088 \u1086  \u1089 \u1090 \u1086 \u1075 \u1086  \u1082 \u1093 \u1072 \u1089 . \u1025 \u1074  \u1089 \u1099 \u1089  \u1090 \u1099 \u1082 \u1085 \u1101 \u1076 \u1099 \u1088  \u1089 \u1072 \u1088 \u1101 \u1085 \u1076 \u1099 \u1088  \u1084 \u1091 \u1088 \u1096 \u1101 \u1085 \u1076 \u1099 \u1088 . \u1040 \'a0\u1089 \u1072 \u1088 \u1101 \u1089 \u1072  \u1085 \u1072 \u1076 \u1091 \u1088  \u1089 \u1099 \u1088  \u1103 \u1089 \u1090 \u1088 \u1077 \u1073 \u1086  \u1095 \u1102 \u1088 \u1076 \u1101 \u1083 \u1072 \u1089 \u1087 \u1101  \u1087 \u1088 \u1086  \u1055 \u1091 \u1089 \u1090 \u1086 \u1096 \u1082 \u1080 \u1085 \u1072 . \u1064 \u1091 \u1085 \u1076 \u1083 \u1086  \u1080 \'a0\u1076 \u1099 \u1082 \u1093 \u1085 \u1086  \u1083 \u1101 \u1089  \u1089 \u1099 \u1089  \u1092 \u1101 \u1076 \u1099 \u1088  \u1089 \u1072 \u1088 \u1101 \u1085 \u1076 \u1099 \u1088 . \u1040 \'a0\u1072 \u1076 \u1072 \u1081  \u1045 \u1075 \u1086 \u1088 \u1086  \u1093 \u1072 \u1089 \u1080 \u1103 . \u1056 \u1086 \u1084 \u1085 \u1099  \u1083 \u1101 \u1089 \u1082 \u1080 \u1088 \u1080  \u1064 \u1077 \u1083 \u1086 \u1088 \u1086  \u1090 \u1101 \u1088 \u1076 \u1099  \u1087 \u1072 \u1096  \u1089 \u1094 \u1077 \u1085 \u1072 , \u1072 \'a0\u1103 \u1082 \u1093 \u1072  \u1084 \u1077 \u1090 \u1072 \u1083 \u1080 \u1089 \u1100  \u1087 \u1080 \u1088 \u1086  \u1079 \u1072 \u1083 \u1086 . \u1053 \u1080 \u1082 \u1086 \u1083 \u1072 \u1105  \u1055 \u1077 \u1090 \u1088 \u1086 \u1074 \u1080 \u1095 \u1105  \u1091 \u1078 \u1077  \u1087 \u1088 \u1101  \u1072 \u1076 \u1072  \u1088 \u1101 \u1085 \u1076 \u1086  \u1089 \u1082 \u1101 \u1088 \u1076 \u1103  \u1074 \u1072 \u1089 \u1090 , \u1085 \u1101  \u1072 \u1076 \u1072 \u1081  \u1055 \u1091 \u1089 \u1090 \u1086 \u1096 \u1082 \u1080 \u1085  \u1091 \u1096 \u1090 \u1099 \u1103  \u1096 \u1090 \u1101 \u1090 \u1086 \u1089 \u1090 \u1099 \u1088 , \u1076 \u1086 \u1083 \u1075 \u1086  \u1073 \u1091 \u1088 \u1072 \u1074 \u1080 \u1083  \u1079 \u1072 \u1083 \u1086  \u1103 \u1082 \u1093 \u1101 \u1085 \u1094 \u1072 , \u1091 \u1076 \u1099 \u1082 \u1090 \u1103  \u1045 \u1075 \u1086 \u1088 \u1086 \u1089 .\cb1 \
\cb3 \'96\'a0\uc0\u1069 \u1085 \u1072 , \u1082 \u1072 \u1081  \u1105 \u1074 ! \u1051 \u1101 \u1089  \u1082 \u1086 \u1082 \u1086 \u1088 \u1101  \u1088 \u1086 \u1084 \u1072  \u1075 \'92\u1072 \u1088 \u1072 \u1074 \u1101 \u1085  \u1076 \u1088 \u1086  \u1079 \u1072 \u1082 \u1091 \u1090 \u1082 \u1086 !\cb1 \
\cb3 \uc0\u1055 \u1072 \u1083  \u1072 \u1076 \u1072 \u1074 \u1072  \u1088 \u1086 \u1084 \u1101 \u1085 \u1075 \u1101 , \u1089 \u1072 \u1074 \u1101  \u1082 \u1072 \u1084 \u1101 \u1085 \u1072 \u1089  \u1090 \u1101  \u1075 \'92\u1072 \u1088 \u1072 \u1074 \u1101 \u1085  \u1045 \u1075 \u1086 \u1088 \u1086 \u1089 , \u1087 \u1088 \u1080 \u1076 \u1078 \u1103 \u1083 \u1072 \u1089 \u1087 \u1101  \u1090 \u1101  \u1074 \u1099 \u1090 \u1099 \u1088 \u1076 \u1101 \u1085  \u1083 \u1101 \u1089  \u1082 \u1086  \u1089 \u1074 \u1101 \u1090 \u1086 .\cb1 \
