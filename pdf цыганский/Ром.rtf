\cb3 \'96\'a0\uc0\u1055 \u1072 \u1083  \u1072 \u1076 \u1072 \u1074 \u1072  \u1080 \'a0\u1089 \u1083 \u1091 \u1093 \u1072 \u1090 \u1100  \u1085 \u1072 \'a0\u1082 \u1072 \u1084 \u1072 \u1084 ! \u1052 \u1072 \u1085 \u1076 \u1101  \u1085 \u1072 \u1085 \u1101  \u1096 \u1082 \u1091 \u1088 \u1086 \u1076 \u1105 \u1088 \u1086 \u1074 \u1082 \u1072 ! \u1053 \u1072 \u1085 \u1101  \u1087 \u1072 \u1083  \u1077 \u1082 \u1093  \u1087 \u1086 \u1089 \u1090 \u1077 \u1083 \u1100  \u1083 \u1072 \u1074 \u1072 . \u1041 \u1101 \u1096 . \u1052 \u1072 \u1085 \u1076 \u1101  \u1076 \u1072 \u1076 \u1099 \u1074 \u1101 \u1089  \u1083 \u1072 \u1087 \u1096 \u1072  \u1080 \'a0\u1082 \u1072 \u1075 \'92\u1085 \u1099 . \u1040 \'a0\u1077 \u1097 \u1105  \u1087 \u1083 \u1072 \u1094 \u1077 \u1085 \u1076 \u1072 . \u1050 \u1101  \u1090 \u1091 \u1084 \u1101  \u1087 \u1101 \u1082 \u1101 \u1085  \u1087 \u1083 \u1072 \u1094 \u1077 \u1085 \u1076 \u1072 ?\cb1 \
\cb3 \'96\'a0\uc0\u1040 \'a0\u1089 \u1086 \'a0\u1072 \u1076 \u1072 ?\cb1 \
\cb3 \'96\'a0\uc0\u1050 \u1086 \u1082 \u1086 \u1088 \u1080  \u1091 \u1076 \u1078 \u1080 \u1085 \u1101 \u1089 \u1072 . \u1040 \u1076 \u1072  \u1076 \u1072 \u1089 \u1072 \u1074 \u1086  \u1075 \u1091 \u1076 \u1083 \u1086  \u1089 \u1083 \u1086 \u1105 \u1085 \u1086  \u1087 \u1080 \u1088 \u1086 \u1075 \u1086 . \u1053 \u1072 \u1083 \u1072 \u1076 \u1078 \u1103 ,\'a0\u1073 \u1101 \u1096 .\cb1 \
