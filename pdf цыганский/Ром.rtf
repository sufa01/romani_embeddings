\cb3 \'96\'a0\uc0\u1050 \u1072 \u1085 \u1072  \u1087 \u1093 \u1101 \u1085  \u1072 \u1084 \u1101 \u1085 \u1075 \u1101 , \u1042 \u1072 \u1089 \u1103 , \u1087 \u1086 \u1078 \u1072 \u1083 \u1091 \u1081 \u1089 \u1090 \u1072 , \u1087 \u1088 \u1101  \u1089 \u1086 \'a0\u1090 \u1091  \u1085 \u1072 \u1076 \u1077 \u1103 \u1083 \u1089 \u1103 , \u1082 \u1101 \u1076 \u1101  \u1079 \u1072 \u1083 \u1099 \u1076 \u1078 \u1080 \u1103 \u1085  \u1082 \u1101  \u1073 \u1072 \u1073 \u1072  \u1052 \u1077 \u1076 \u1074 \u1077 \u1076 \u1077 \u1074 \u1086 \u1081  \u1090 \u1101  \u1075 \u1080 \u1085 \u1101 \u1083  \u1082 \u1072 \u1075 \'92\u1085 \u1077 \u1085 ? \u1058 \u1091  \u1085 \u1077 \'a0\u1089 \u1087 \u1077 \u1096 \u1080  \u1090 \u1101  \u1088 \u1072 \u1082 \u1080 \u1088 \u1101 \u1089 , \u1087 \u1086 \u1076 \u1091 \u1084 \u1080 \u1085 \u1101 . \u1058 \u1091 \'a0\u1078 \u1077  \u1072 \u1085 \u1075 \u1083 \u1099 \u1076 \u1099 \u1088  \u1089 \u1072 \u1085 \u1072 \u1089  \u1089 \u1086 \u1086 \u1073 \u1088 \u1072 \u1079 \u1080 \u1090 \u1077 \u1083 \u1100 \u1085 \u1086 . \u1055 \u1086 \u1083 \u1101 \u1089 , \u1089 \u1086 \'a0\u1077 \u1089 \u1083 \u1080  \u1089 \u1091 \u1093 \u1090 \u1099 \u1083 \u1101 \u1085 \u1072 , \u1085 \u1072 \'a0\u1087 \u1086 \u1075 \u1083 \u1072 \u1076 \u1080 \u1085 \u1101 \u1085 \u1072  \u1087 \u1080 \u1088 \u1086  \u1096 \u1101 \u1088 \u1086 \u1088 \u1086 .\cb1 \
