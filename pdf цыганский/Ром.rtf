\cb3 \uc0\u1063 \u1072 \u1081  \u1076 \u1088 \u1101  \u1086 \u1088 \u1072 \u1085 \u1078 \u1077 \u1074 \u1086  \u1082 \u1086 \u1092 \u1090 \u1086 \u1095 \u1082 \u1072  \u1080 \'a0\u1089 \u1080 \u1085 \u1103  \u1093 \u1086 \u1083 \u1086 \u1074 \u1072  \u1073 \u1101 \u1096 \u1090 \u1103  \u1072 \u1085 \u1075 \u1080 \u1083  \u1089 \u1082 \u1072 \u1084 \u1080 \u1085 \u1076  \u1087 \u1088 \u1077 \u1079 \u1080 \u1076 \u1080 \u1091 \u1084 \u1072  \u1076 \u1088 \u1086  \u1087 \u1077 \u1088 \u1074 \u1086  \u1088 \u1103 \u1076 \u1086  \u1079 \u1072 \u1083 \u1072 .\cb1 \
