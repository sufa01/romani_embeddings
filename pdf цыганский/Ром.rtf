\cb3 \'96\'a0\uc0\u1053 \u1101 , \u1087 \u1088 \u1086 \u1076 \u1078 \u1103 . \u1057 \u1099 \u1088  \u1090 \u1091 \u1090  \u1082 \u1093 \u1072 \u1088 \u1101 \u1085 ?\cb1 \
\cb3 \'96\'a0\uc0\u1050 \u1093 \u1101 \u1088 \u1101  \u1082 \u1093 \u1072 \u1088 \u1101 \u1085  \u1055 \u1077 \u1090 \u1088 \u1086 \u1074 \u1085 \u1072 .\cb1 \
