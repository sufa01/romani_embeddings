\cb3 \'96\'a0\uc0\u1057 \u1082 \u1088 \u1099 \u1090 \u1085 \u1086  \u1090 \u1091 . \u1040 \'a0\u1084 \u1101  \u1082 \u1072 \u1084 \u1072 \u1084  \u1090 \u1101  \u1087 \u1086 \u1088 \u1072 \u1082 \u1080 \u1088 \u1072 \u1074 . \u1052 \u1072 \u1085 \u1075 \u1101  \u1074 \u1072 \u1074 \u1088 \u1101 \u1089  \u1085 \u1072 \u1096 \u1090 \u1099 . \u1045 \u1082 \u1076 \u1078 \u1080 \u1085 \u1099 . \u1048 \u1085 \u1072 \u1095 \u1077 \'a0\u1073 \u1099  \u1080 \'a0\u1085 \u1072 \'a0\u1084 \u1101 \u1082 \u1090 \u1105 \u1084  \u1085 \u1080 \u1082 \u1086 \u1085 \u1101 \u1089 . \u1054 \u1076 \u1086 \u1081  \u1087 \u1086 \u1088 \u1072 \u1082 \u1080 \u1088 \u1072 \u1074 \u1072 , \u1072 \u1076 \u1072 \u1081 \'85 \u1091 \u1076 \u1078 \u1080 \u1085 \u1101 \u1089 \u1072  \u1089 \u1099 \u1088  \u1084 \u1072 \u1085 \u1091 \u1096 \u1072  \u1076 \u1078 \u1080 \u1074 \u1101 \u1085 . \u1058 \u1101  \u1076 \u1078 \u1080 \u1085 \u1072 \u1074 \'a0\u1073 \u1099 , \u1089 \u1086 \'a0\u1090 \u1091  \u1076 \u1072 \u1089 \u1072 \u1074 \u1080 , \u1085 \u1072 \'a0\u1084 \u1101 \u1082 \u1072 \u1074 \u1072 \u1089 \'a0\u1073 \u1099  \u1090 \u1091 \u1090  \u1082 \u1101  \u1087 \u1101 . \u1053 \u1101 , \u1083 \u1072 \u1076 \u1085 \u1086 , \u1055 \u1077 \u1090 \u1088 \u1086 \u1074 \u1085 \u1072  \u1076 \u1103 \u1082 \u1101  \u1055 \u1077 \u1090 \u1088 \u1086 \u1074 \u1085 \u1072 . \u1040 \'a0\u1084 \u1072 \u1085  \u1082 \u1093 \u1072 \u1088  \u1052 \u1072 \u1082 \u1072 \u1088 \u1100 \u1077 \u1074 \u1085 \u1072 . \u1052 \u1086 \u1078 \u1077 \u1090 , \u1090 \u1091  \u1082 \u1072 \u1084 \u1101 \u1089  \u1076 \u1088 \u1086 \u1084 \u1101 \u1089 \u1090 \u1099 \u1088  \u1090 \u1101  \u1086 \u1090 \u1082 \u1093 \u1080 \u1085 \u1105 \u1089 ? \u1050 \u1086 \u1081 \u1082 \u1072  \u1080 \u1089 \u1099 . \u1055 \u1072 \u1083 \u1101  \u1090 \u1088 \u1091 \u1073 \u1072  \u1089 \u1087 \u1086 \u1082 \u1086 \u1081 \u1085 \u1101 \u1089 , \u1085 \u1080 \u1095 \u1080  \u1085 \u1072 \'a0\u1076 \u1099 \u1082 \u1093 \u1085 \u1086 . \u1040 \'a0\u1086 \u1076 \u1086 \u1081 , \u1087 \u1072 \u1083  \u1079 \u1072 \u1085 \u1072 \u1074 \u1077 \u1089 \u1082 \u1072 , \u1090 \u1088 \u1080 \u1085  \u1096 \u1090 \u1101 \u1090 \u1072  \u1074 \u1072 \u1096 \u1101  \u1075 \u1072 \u1076 \u1078 \u1101 \u1085 \u1075 \u1101 . \u1055 \u1072 \u1083  \u1074 \u1072 \u1085 \u1090 \u1072  \u1084 \u1072 \u1085 \u1076 \u1101  \u1087 \u1086 \u1089 \u1090 \u1086 \u1103 \u1085 \u1085 \u1086  \u1076 \u1078 \u1080 \u1074 \u1101 \u1083  \u1090 \u1101 \u1088 \u1085 \u1099  \u1088 \u1086 \u1084 \u1085 \u1086 \u1088 \u1080 . \u1053 \u1101  \u1082 \u1072 \u1085 \u1072  \u1082 \u1093 \u1101 \u1088 \u1101  \u1085 \u1072 \u1085 \u1101 .\cb1 \
\cb3 \uc0\u1055 \u1088 \u1080 \u1077 \u1079 \u1078 \u1086  \u1086 \u1073 \u1088 \u1080 \u1089 \u1080 \u1103  \u1084 \u1091 \u1081  \u1082 \u1101  \u1093 \u1091 \u1083 \u1072 \u1085 \u1099 . \u1040 \u1076 \u1072 \u1103  \u1091 \u1089 \u1087 \u1086 \u1082 \u1086 \u1080 \u1083 \u1072 \'a0\u1083 \u1072 :\cb1 \
\cb3 \'96\'a0\uc0\u1044 \u1072  \u1090 \u1091  \u1085 \u1072 \'a0\u1076 \u1072 \u1088 \u1087 \u1101 ! \u1052 \u1101  \u1090 \u1086 \u1078 \u1077  \u1072 \u1085 \u1075 \u1083 \u1099 \u1076 \u1099 \u1088  \u1088 \u1086 \u1084 \u1101 \u1085 \u1076 \u1099 \u1088  \u1076 \u1072 \u1088 \u1072 \u1074 \u1072 \u1089 \u1087 \u1101 . \u1055 \u1086 \u1076 \u1099 \u1082 \u1093 \u1090 \u1105 \u1084 , \u1072 \'a0\u1084 \u1072 \u1096 \u1082 \u1080 \u1088  \u1083 \u1101 \u1085 \u1076 \u1101  \u1080 \u1089 \u1099  \u1088 \u1072 \u1079 \u1085 \u1072  \u1084 \u1072 \u1085 \u1091 \u1096 \u1072 . \u1055 \u1088 \u1080 \u1090 \u1088 \u1072 \u1076 \u1099 \u1085 \u1101  \u1073 \u1091 \u1090 . \u1048 \u1089 \u1099  \u1080 \'a0\u1073 \u1080 \u1082 \u1093 \u1101 \u1088 \u1080 \u1090 \u1082 \u1072 , \u1095 \u1105 \u1088 \u1072 . \u1050 \u1072 \u1085 \u1072  \u1087 \u1086 \u1087 \u1088 \u1080 \u1089 \u1099 \u1082 \u1083 \u1099 \u1085 \u1101 , \u1086 \u1090 \'92\u1103 \u1095 \u1085 \u1101 . \u1058 \u1101  \u1079 \u1091 \u1084 \u1072 \u1074 \u1101 \u1085  \u1076 \u1078 \u1103 \u1085 \u1072  \u1076 \u1088 \u1101  \u1074 \u1072 \u1074 \u1088 \u1101  \u1096 \u1090 \u1101 \u1090 \u1072 . \u1053 \u1101  \u1084 \u1080 \u1088 \u1080  \u1082 \u1074 \u1072 \u1088 \u1090 \u1080 \u1088 \u1072 \u1085 \u1090 \u1086 \u1095 \u1082 \u1072  \u1053 \u1072 \u1089 \u1090 \u1103  \u1074 \u1072 \u1074 \u1080 \u1088 . \u1043 \u1088 \u1072 \u1084 \u1086 \u1090 \u1085 \u1086 . \u1051 \u1086 \u1074 \u1101  \u1072 \u1085 \u1075 \u1080 \u1083  \u1087 \u1072 \u1083  \u1095 \u1105 \u1085  \u1076 \u1101 \u1083 . \u1044 \u1072  \u1090 \u1091  \u1085 \u1072 \'a0\u1083 \u1072 \u1076 \u1078 \u1103 , \u1077 \u1089 \u1083 \u1080  \u1082 \u1093 \u1080 \u1085 \u1099 , \u1087 \u1072 \u1089 \u1105 \u1074 .\cb1 \
\cb3 \'96\'a0\uc0\u1052 \u1101  \u1085 \u1072 \u1085 \u1101  \u1082 \u1093 \u1080 \u1085 \u1099 .\cb1 \
