\cb3 \'96\'a0\uc0\u1058 \u1086 \u1078 \u1077  \u1088 \u1086 \u1084 . \u1055 \u1088 \u1086 \u1082 \u1091 \u1088 \u1086 \u1088 \u1086  \u1080 \'a0\u1079 \u1072 \u1097 \u1080 \u1090 \u1085 \u1080 \u1082 \u1086  \u1082 \u1101  \u1072 \u1084 \u1101  \u1088 \u1086 \u1084 \u1072 , \u1072 \'a0\u1089 \u1101 \u1085 \u1076 \u1086  \u1089 \u1072 \u1088 \u1101  \u1088 \u1091 \u1089 \u1089 \u1082 \u1072 . \u1058 \u1101 \u1088 \u1076 \u1105 \u1074 , \u1089 \u1099 \u1088  \u1105 \u1081  \u1083 \u1101 \u1089 \u1072  \u1090 \u1101  \u1095 \u1080 \u1085 \u1101 \u1083 \u1087 \u1101  \u1083 \u1101 \u1083 \u1072 .\cb1 \
\cb3 \'96\'a0\uc0\u1040 \'a0\u1042 \u1072 \u1089 \u1080 \u1083 \u1080 \u1103  \u1055 \u1091 \u1089 \u1090 \u1086 \u1096 \u1082 \u1080 \u1085 \u1072  \u1084 \u1072 \u1085 \u1075 \u1072 \u1089 \u1072  \u1087 \u1101  \u1087 \u1101 \u1089 \u1082 \u1080 \u1088 \u1086 \'85\'a0\'96 \u1080 \'a0\u1105 \u1074  \u1087 \u1086 \u1089 \u1099 \u1082 \u1072 \u1076 \u1103  \u1087 \u1088 \u1101  \u1083 \u1072 \u1074 \u1082 \u1072 , \u1089 \u1072 \u1074 \u1080  \u1090 \u1101 \u1088 \u1076 \u1099  \u1072 \u1085 \u1075 \u1080 \u1083  \u1087 \u1077 \u1088 \u1074 \u1086  \u1088 \u1103 \u1076 \u1086  \u1079 \u1072 \u1083 \u1072 . \u1052 \u1072 \u1085 \u1091 \u1096 , \u1082 \u1101 \u1076 \u1101  \u1087 \u1086 \u1087 \u1101 \u1088 \u1101 \u1083  \u1087 \u1088 \u1101  \u1083 \u1072 \u1090 \u1101 , \u1095 \u1091 \u1074 \u1089 \u1090 \u1074 \u1080 \u1085 \u1101  \u1087 \u1101 \u1089  \u1103 \u1074 \u1085 \u1086  \u1085 \u1077 \'a0\u1091 \u1102 \u1090 \u1085 \u1086 . \u1057 \u1099 \u1088  \u1084 \u1072 \u1096 \u1082 \u1080 \u1088  \u1076 \u1091 \u1077 \u1085 \u1076 \u1101  \u1103 \u1075 \u1101 \u1085 \u1076 \u1101 . \u1057 \u1082 \u1072 \u1084 \u1080 \u1085 \u1076  \u1087 \u1088 \u1077 \u1079 \u1080 \u1076 \u1080 \u1091 \u1084 \u1072  \u1080 \'a0\u1089 \u1090 \u1088 \u1086 \u1075 \u1086  \u1087 \u1091 \u1073 \u1083 \u1080 \u1082 \u1072 . \u1055 \u1072 \u1083  \u1072 \u1076 \u1072 \u1074 \u1072  \u1085 \u1072 \'a0\u1082 \u1072 \u1084 \u1101 \u1083  \u1090 \u1101  \u1076 \u1078 \u1103 \u1083  \u1079 \u1076 \u1086 \u1088 \u1086 \u1074 \u1077 \u1085 \u1085 \u1086  \u1095 \u1072 \u1074 \u1086  \u1082 \u1088 \u1101 \u1085 \u1075 \u1083 \u1072  \u1103 \u1082 \u1093 \u1101 \u1085 \u1094 \u1072  \u1042 \u1072 \u1089 \u1080 \u1083 \u1080 \u1105  \u1055 \u1091 \u1089 \u1090 \u1086 \u1096 \u1082 \u1080 \u1085 . \u1053 \u1072 \u1089 \u1090 \u1086 \u1081 \u1095 \u1080 \u1074 \u1086  \u1087 \u1088 \u1080 \u1075 \u1083 \u1072 \u1096 \u1077 \u1085 \u1080 \u1105  \u1053 \u1080 \u1082 \u1086 \u1083 \u1072 \u1103  \u1055 \u1077 \u1090 \u1088 \u1086 \u1074 \u1080 \u1095 \u1072  \u1105 \u1074  \u1074 \u1099 \u1087 \u1086 \u1083 \u1085 \u1080 \u1083 . \u1044 \u1078 \u1103 \u1083 , \u1089 \u1099 \u1088  \u1079 \u1072 \u1080 \u1082 \u1072 \u1077 \u1090 \u1089 \u1103 , \u1084 \u1077 \u1083 \u1082 \u1072  \u1096 \u1072 \u1078 \u1082 \u1101 \u1085 \u1094 \u1072 . \u1053 \u1080 \u1082 \u1086 \u1083 \u1072 \u1105  \u1055 \u1077 \u1090 \u1088 \u1086 \u1074 \u1080 \u1095 \u1105  \u1087 \u1093 \u1101 \u1085 \u1076 \u1103 :\cb1 \
\cb3 \'96\'a0\uc0\u1044 \u1078 \u1103 , \u1042 \u1072 \u1089 \u1103 , \u1076 \u1078 \u1103 . \u1053 \u1072 \'a0\u1083 \u1072 \u1076 \u1078 \u1103 .\cb1 \
\cb3 \uc0\u1055 \u1091 \u1073 \u1083 \u1080 \u1082 \u1072  \u1087 \u1088 \u1086 \u1083 \u1099 \u1076 \u1078 \u1080 \u1103  \u1083 \u1101 \u1089  \u1083 \u1072 \u1074 \u1101 \u1085 \u1094 \u1072 :\cb1 \
