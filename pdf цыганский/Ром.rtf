\cb3 \'96\'a0\uc0\u1044 \u1086 \u1083 \u1078 \u1085 \u1086  \u1090 \u1101  \u1103 \u1074 \u1101 \u1083 , \u1090 \u1091 \u1089 \u1072  \u1087 \u1086 \u1089 \u1086 \u1074 \u1077 \u1090 \u1086 \u1074 \u1072 \u1083 \u1072 \u1089 \u1100 , \u1082 \u1072 \u1088 \u1080 \u1082  \u1092 \u1101 \u1076 \u1099 \u1088  \u1090 \u1101  \u1087 \u1101 \u1088 \u1101 \u1083 .\cb1 \
\cb3 \uc0\u1058 \u1080 \u1084 \u1086 \u1092 \u1077 \u1105  \u1048 \u1083 \u1100 \u1080 \u1095 \u1105  \u1087 \u1086 \u1090 \u1072 \u1089 \u1072 \u1076 \u1103  \u1087 \u1089 \u1080 \u1082 \u1101 \u1085 \u1094 \u1072 , \u1080 \'a0\u1087 \u1088 \u1086 \u1090 \u1099 \u1088 \u1076 \u1099 \u1103  \u1074 \u1072 \u1089 \u1090  \u1089 \u1077 \u1082 \u1088 \u1077 \u1090 \u1072 \u1088 \u1105 \u1089 \u1082 \u1101 :\cb1 \
\cb3 \'96\'a0\uc0\u1044 \u1099 \u1082 \u1093 \u1101 \u1085 \u1090 \u1077 , \u1048 \u1074 \u1072 \u1085 \u1086  \u1044 \u1084 \u1080 \u1090 \u1088 \u1080 \u1077 \u1074 \u1080 \u1095 \u1105 , \u1082 \u1072 \u1085 \u1072  \u1090 \u1091 \u1084 \u1101  \u1089 \u1072 \u1088 \u1101 \u1089 \u1072  \u1076 \u1088 \u1086  \u1082 \u1091 \u1088 \u1089 \u1086 .\cb1 \
\cb3 \uc0\u1053 \u1101  \u1089 \u1077 \u1082 \u1088 \u1077 \u1090 \u1072 \u1088 \u1105  \u1088 \u1072 \u1081 \u1082 \u1086 \u1084 \u1072 , \u1093 \u1072 \u1081  \u1085 \u1072 \'a0\u1091 \u1076 \u1099 \u1082 \u1093 \u1090 \u1103 . \u1054 \u1090 \u1075 \u1101 \u1103  \u1076 \u1088 \u1086  \u1074 \u1101 \u1085 \u1075 \u1083 \u1086 , \u1080 \'a0\u1086 \u1092 \u1080 \u1094 \u1080 \u1072 \u1083 \u1100 \u1085 \u1101 \u1089  \u1087 \u1093 \u1101 \u1085 \u1076 \u1103 :\cb1 \
\cb3 \'96\'a0\uc0\u1051 \u1072 \u1076 \u1078 \u1103 \u1074 \u1086 , \u1090 \u1086 \u1074 \u1086 \u1088 \u1080 \u1097 \u1105  \u1045 \u1088 \u1084 \u1072 \u1082 \u1086 \u1074 ! \u1044 \u1103 \u1082 \u1101  \u1080 \u1083 \u1080  \u1085 \u1072 \u1090 , \u1085 \u1101  \u1075 \u1072 \u1085 \u1076 \u1083 \u1072 \u1076 \u1103  \u1088 \u1080 \u1089 \u1082 \u1080 \u1088 \u1101 \u1089 \u1072 .\cb1 \
\cb3 \uc0\u1055 \u1088 \u1077 \u1076 \u1089 \u1077 \u1076 \u1072 \u1090 \u1077 \u1083 \u1105  \u1089 \u1099 \u1088  \u1089 \u1099 \u1089  \u1090 \u1101 \u1088 \u1076 \u1086  \u1076 \u1088 \u1101  \u1096 \u1083 \u1103 \u1087 \u1072 , \u1076 \u1103 \u1082 \u1101  \u1080 \'a0\u1073 \u1101 \u1096 \u1090 \u1103 .\cb1 \
\cb3 \'96\'a0\uc0\u1040 \'a0\u1089 \u1086 \u1089 \u1072 , \u1048 \u1074 \u1072 \u1085 \u1086  \u1044 \u1084 \u1080 \u1090 \u1088 \u1080 \u1077 \u1074 \u1080 \u1095 \u1105 , \u1072 \u1084 \u1101  \u1083 \u1072 \u1089 \u1072  \u1074 \u1080 \u1085 \u1086 \u1075 \u1088 \u1072 \u1076 \u1086 \u1089 \u1082 \u1080 \u1088 \u1101  \u1083 \u1086 \u1079 \u1099  \u1082 \u1101  \u1079 \u1080 \u1084 \u1072  \u1090 \u1101  \u1082 \u1101 \u1088 \u1072 \u1089 ?\cb1 \
\cb3 \uc0\u1057 \u1077 \u1082 \u1088 \u1077 \u1090 \u1072 \u1088 \u1105  \u1088 \u1086 \u1079 \u1083 \u1099 \u1076 \u1078 \u1080 \u1103  \u1074 \u1072 \u1089 \u1090 \u1101 \u1085 \u1094 \u1072 :\cb1 \
\cb3 \'96\'a0\uc0\u1040 \u1076 \u1072 \u1074 \u1072  \u1085 \u1072 \'a0\u1076 \u1078 \u1080 \u1085 \u1086 \u1084 . \u1061 \u1072 \u1089 \u1105 \u1085 \u1072 \'a0\'96 \u1089 \u1087 \u1091 \u1095 \u1072 \u1089 \u1072  \u1090 \u1091 \u1090 \u1099 \u1088 . \u1045 \u1089 \u1083 \u1080  \u1082 \u1072 \u1084 \u1101 \u1089 \'a0\'96 \u1087 \u1086 \u1088 \u1072 \u1082 \u1080 \u1088 , \u1084 \u1086 \u1078 \u1077 \u1090 , \u1090 \u1086 \u1074 \u1072 \u1088 \u1080 \u1097 \u1105  \u1089 \u1086 \u1075 \u1083 \u1072 \u1089 \u1085 \u1086  \u1083 \u1086 \u1074 \u1101 \u1085 \u1094 \u1072  \u1090 \u1101 \'a0\u1083 \u1101 \u1083 .\cb1 \
\cb3 \uc0\u1056 \u1086 \u1084  \u1087 \u1093 \u1101 \u1085 \u1076 \u1103 :\cb1 \
\cb3 \'96\'a0\uc0\u1055 \u1086 \u1083 \u1102 \u1073 \u1086 \u1074 \u1085 \u1086  \u1089 \u1072 \u1088 \u1086  \u1084 \u1086 \u1078 \u1085 \u1086 .\cb1 \
\cb3 \uc0\u1058 \u1080 \u1084 \u1086 \u1092 \u1077 \u1105  \u1048 \u1083 \u1100 \u1080 \u1095 \u1105  \u1075 \'92\u1072 \u1079 \u1076 \u1099 \u1103  \u1074 \u1072 \u1089 \u1090 \u1072  \u1082 \u1086  \u1073 \u1086 \u1083 \u1099 \u1073 \u1101 :\cb1 \
\cb3 \'96\'a0\uc0\u1058 \u1091  \u1087 \u1086 \u1083 \u1101 \u1089  \u1080 \u1083 \u1080  \u1085 \u1072 \u1090 , \u1073 \u1101 \u1085 \u1075 \u1086 \u1088 \u1086  \u1095 \u1072 \u1074 \u1086 , \u1089 \u1086 \'a0\u1084 \u1101  \u1085 \u1077 \'a0\u1084 \u1086 \u1075 \u1091  \u1073 \u1077 \u1079  \u1072 \u1082 \u1090 \u1072 ? \u1040 \u1076 \u1072 \u1103  \u1075 \u1088 \u1072 \u1089 \u1085 \u1099  \u1084 \u1072 \u1085 \u1076 \u1101  \u1075 \u1080 \u1085 \u1101 \u1083 \u1087 \u1101  \u1089 \u1099 \u1088  \u1076 \u1078 \u1080 \u1076 \u1099 !\cb1 \
\cb3 \uc0\u1056 \u1086 \u1084  \u1074 \u1099 \u1090 \u1099 \u1088 \u1076 \u1099 \u1103  \u1082 \u1080 \u1089 \u1099 \u1082 \u1072 \u1090 \u1099 \u1088 \'a0\u1083 \u1099 \u1083 .\cb1 \
\cb3 \'96\'a0\uc0\u1040 \u1082 \u1090 \u1086 \'a0\u1080 \u1089 \u1099 .\cb1 \
\cb3 \uc0\u1058 \u1080 \u1084 \u1086 \u1092 \u1077 \u1105  \u1048 \u1083 \u1100 \u1080 \u1095 \u1105  \u1087 \u1088 \u1086 \u1075 \u1080 \u1085 \u1076 \u1103  \u1083 \u1099 \u1083 , \u1087 \u1086 \u1074 \u1077 \u1089 \u1077 \u1083 \u1077 \u1083 :\cb1 \
\cb3 \'96\'a0\uc0\u1057 \u1072 \u1088 \u1086  \u1087 \u1088 \u1072 \u1074 \u1080 \u1083 \u1100 \u1085 \u1101 \u1089 . \u1058 \u1091  \u1076 \u1077 \u1081 \u1089 \u1090 \u1074 \u1080 \u1090 \u1077 \u1083 \u1100 \u1085 \u1086  \u1075 \u1088 \u1072 \u1084 \u1086 \u1090 \u1085 \u1086  \u1088 \u1086 \u1084 . \u1040 \'a0\u1089 \u1083 \u1099 \u1085 \u1101  \u1094 \u1099 \u1087 \u1072 ? \u1041 \u1072 \u1085 \u1075 \u1101  \u1072 \u1084 \u1101 \u1085 \u1075 \u1101  \u1094 \u1099 \u1087 \u1072 .\cb1 \
\cb3 \'96\'a0\uc0\u1048 \'a0\u1094 \u1099 \u1087 \u1072  \u1089 \u1083 \u1099 \u1103 \u1084 . \u1056 \u1080 \u1089 \u1082 \u1080 \u1088 \u1072 \u1089 \u1072 ,\'a0\'96 \u1087 \u1093 \u1101 \u1085 \u1076 \u1103 \'a0\u1088 \u1086 \u1084 .\cb1 \
\cb3 \uc0\u1055 \u1088 \u1077 \u1076 \u1089 \u1077 \u1076 \u1072 \u1090 \u1077 \u1083 \u1105  \u1089 \u1072 \u1088 \u1101 \u1089 \u1072  \u1088 \u1072 \u1079 \u1074 \u1077 \u1089 \u1077 \u1083 \u1080 \u1083 \u1089 \u1103 :\cb1 \
\cb3 \'96\'a0\uc0\u1058 \u1091  \u1088 \u1086 \u1084  \u1075 \u1086 \u1076 \u1103 \u1074 \u1080 \u1088 . \u1055 \u1077 \u1088 \u1074 \u1086  \u1084 \u1086 \u1083 \u1086  \u1076 \u1072 \u1089 \u1072 \u1074 \u1101 \u1089  \u1074 \u1089 \u1090 \u1088 \u1077 \u1085 \u1080 \u1085 \u1076 \u1105 \u1084 . \u1050 \u1072 \u1085 \u1072  \u1095 \u1080 \u1085 \u1072 \u1074 \u1072  \u1083 \u1099 \u1083  \u1073 \u1091 \u1093 \u1075 \u1072 \u1083 \u1090 \u1077 \u1088 \u1086 \u1089 \u1082 \u1101 . \u1051 \u1101 \u1089 \u1072  \u1087 \u1072 \u1083 \u1101  \u1073 \u1080 \u1073 \u1072 \u1093 \u1090 \u1072 \u1083 \u1101  \u1075 \u1072 \u1085 \u1076 \u1083 \u1072 \u1076 \u1103  \u1087 \u1101 \u1089 \u1082 \u1080 \u1088 \u1101  \u1083 \u1086 \u1074 \u1101 . \u1048 \'a0\u1095 \u1077 \u1081 \u1085 \u1086  \u1089 \u1099 \u1089  \u1072 \u1076 \u1072 \u1088 \u1080 \u1082  \u1090 \u1101  \u1076 \u1078 \u1103 \u1089 . \u1058 \u1091  \u1093 \u1091 \u1083 \u1072 \u1080 \u1073 \u1085 \u1099 \u1090 \u1082 \u1086  \u1088 \u1086 \u1084 . \u1050 \u1101  \u1084 \u1101  \u1076 \u1088 \u1086  \u1079 \u1072 \u1084 \u1077 \u1089 \u1090 \u1080 \u1090 \u1077 \u1083 \u1080  \u1076 \u1078 \u1103 \u1089 \u1072 ? \u1052 \u1072 \u1085 \u1075 \u1101  \u1079 \u1072 \u1084 \u1077 \u1089 \u1090 \u1080 \u1090 \u1077 \u1083 \u1105  \u1095 \u1077 \u1081 \u1085 \u1086 .\cb1 \
\cb3 \'96\'a0\uc0\u1053 \u1072 \'a0\u1076 \u1078 \u1103 \u1074 \u1072 .\cb1 \
\cb3 \'96\'a0\uc0\u1057 \u1086 \u1089 \u1090 \u1099 \u1088 ?\cb1 \
\cb3 \'96\'a0\uc0\u1044 \u1072 \u1088 \u1072 \u1074 , \u1085 \u1077 \'a0\u1089 \u1088 \u1072 \u1073 \u1086 \u1090 \u1072 \u1077 \u1084 \u1089 \u1103 .\cb1 \
\cb3 \'96\'a0\uc0\u1040 \u1076 \u1072  \u1090 \u1091  \u1085 \u1072 \u1087 \u1088 \u1072 \u1089 \u1085 \u1086 . \u1052 \u1101  \u1085 \u1072 \u1085 \u1101  \u1079 \u1083 \u1086 \u1087 \u1072 \u1084 \u1103 \u1090 \u1085 \u1086 . \u1048 \'a0\u1090 \u1091  \u1084 \u1072 \u1085 \u1075 \u1101  \u1087 \u1086 \u1082 \u1072 \u1084 \u1100 \u1103 \u1087 \u1101 . \u1051 \u1072 \u1095 \u1105  \u1082 \u1086 \u1083 \u1093 \u1086 \u1079 \u1086 . \u1042 \u1080 \u1085 \u1086 \u1075 \u1088 \u1072 \u1076 \u1086 . \u1041 \u1088 \u1072 \u1074 \u1080 \u1085 \u1090 \u1072  \u1083 \u1072 \u1089 \u1072  \u1090 \u1101  \u1082 \u1101 \u1088 \u1072 \u1089 ,\'a0\'96 \u1080 \'a0\u1086 \u1090 \u1076 \u1099 \u1103  \u1083 \u1099 \u1083  \u1074 \u1072 \u1096  \u1073 \u1091 \u1093 \u1075 \u1072 \u1083 \u1090 \u1077 \u1088 \u1086 \u1089 \u1082 \u1101 , \u1079 \u1072 \u1089 \u1072 \u1085 \u1076 \u1103 \u1087 \u1101 :\cb1 \
\cb3 \'96\'a0\uc0\u1040 \u1082 \u1101 , \u1079 \u1086 \u1088 \u1072 \u1083 \u1101 \u1089  \u1088 \u1080 \u1082 \u1080 \u1088 ! \u1041 \u1072 \u1083 \u1074 \u1072 \u1083  \u1074 \u1099 \u1088 \u1080 \u1089 \u1082 \u1080 \u1088 \u1101 \u1083 \u1072 .\cb1 \
\cb3 \'96\'a0\uc0\u1052 \u1072 \u1085 \u1076 \u1101  \u1085 \u1072 \'a0\u1074 \u1099 \u1088 \u1080 \u1089 \u1082 \u1080 \u1088 \u1101 \u1083 \u1072 .\cb1 \
\cb3 \uc0\u1057 \u1077 \u1082 \u1088 \u1077 \u1090 \u1072 \u1088 \u1105  \u1088 \u1072 \u1081 \u1082 \u1086 \u1084 \u1072  \u1048 \u1074 \u1072 \u1085 \u1086  \u1044 \u1084 \u1080 \u1090 \u1088 \u1080 \u1077 \u1074 \u1080 \u1095 \u1105  \u1045 \u1088 \u1105 \u1084 \u1080 \u1085  \u1087 \u1086 \u1076 \u1099 \u1082 \u1093 \u1090 \u1103  \u1087 \u1088 \u1101  \u1083 \u1101 \u1085 \u1076 \u1101  \u1080 \'a0\u1079 \u1072 \u1089 \u1072 \u1085 \u1076 \u1103 \u1087 \u1101 .\cb1 \
\cb3 \uc0\u1055 \u1093 \u1091 \u1088 \u1080  \u1051 \u1091 \u1097 \u1080 \u1083 \u1080 \u1093 \u1072  \u1085 \u1072 \u1089 \u1083 \u1072 \u1078 \u1076 \u1072 \u1083 \u1072 \u1089 \u1100 . \u1025 \u1081  \u1087 \u1086 \u1076 \u1082 \u1101 \u1076 \u1099 \u1103  \u1091 \u1096 \u1090 \u1072 , \u1089 \u1095 \u1102 \u1076 \u1103  \u1074 \u1072 \u1089 \u1090 \u1072  \u1087 \u1088 \u1086  \u1082 \u1086 \u1083 \u1099 \u1085 , \u1076 \u1099 \u1103  \u1090 \u1101  \u1087 \u1086 \u1083 \u1101 \u1089 , \u1089 \u1086 \'a0\u1072 \u1076 \u1072  \u1094 \u1074 \u1077 \u1090 \u1080 \u1082 \u1080 , \u1075 \u1083 \u1072 \u1074 \u1085 \u1086 \'a0\'96 \u1072 \u1085 \u1075 \u1080 \u1083 , \u1050 \u1083 \u1072 \u1074 \u1076 \u1080 \u1103  \u1076 \u1101 \u1083 \u1072  \u1090 \u1080 \u1084 \u1080 \u1085  \u1083 \u1072 \u1082 \u1080 \u1088 \u1100 \u1103 \u1082 \u1080 \u1088 \u1101  \u1086 \u1089 \u1074 \u1077 \u1076 \u1086 \u1084 \u1083 \u1105 \u1085 \u1085 \u1086 \u1089 \u1090 \u1080 . \u1025 \u1081  \u1076 \u1091 \u1078 \u1072 \u1082 \u1080 \u1088 \u1083 \u1072 \u1089  \u1082 \u1101 \u1076 \u1101  \u1050 \u1083 \u1072 \u1074 \u1076 \u1080 \u1103  \u1087 \u1086 \u1089 \u1099 \u1082 \u1072 \u1074 \u1101 \u1083 \u1072  \u1083 \u1102 \u1073 \u1086 \u1087 \u1099 \u1090 \u1089 \u1090 \u1074 \u1086 , \u1085 \u1101  \u1085 \u1072 \'a0\u1091 \u1088 \u1080 \u1082 \u1080 \u1088 \u1076 \u1103 \u1087 \u1101 . \u1055 \u1088 \u1080 \u1076 \u1074 \u1080 \u1085 \u1091 \u1083 \u1072 \u1089 \u1100  \u1082 \u1101  \u1105 \u1081  \u1082 \u1093 \u1101 \u1090 \u1072 \u1085 \u1101  \u1090 \u1072 \u1073 \u1091 \u1088 \u1077 \u1090 \u1082 \u1072 \u1089 \u1072 .\cb1 \
\cb3 \'96\'a0\uc0\u1061 \u1072 \u1081  \u1080 \'a0\u1075 \u1088 \u1072 \u1084 \u1086 \u1090 \u1085 \u1086  \u1076 \u1072 \u1089 \u1072 \u1074 \u1086  \u1088 \u1086 \u1084 , \u1072 \'a0\u1089 \u1072 \u1074 \u1080 \'a0\'96 \u1090 \u1086  \u1087 \u1088 \u1080 \u1076 \u1091 \u1088 \u1100  \u1080 \u1089 \u1099 . \u1051 \u1072 \u1095 \u1103 \u1090 \u1099 \u1088  \u1076 \u1086 \u1083 \u1078 \u1085 \u1086 \u1089 \u1090 \u1103 \u1090 \u1099 \u1088  \u1086 \u1090 \u1087 \u1093 \u1101 \u1085 \u1076 \u1103 \u1087 \u1101 , \u1080 \'a0\u1072 \u1076 \u1072 \u1081 \'a0\u1078 \u1077  \u1087 \u1086 \u1084 \u1072 \u1085 \u1075 \u1100 \u1103 \u1087 \u1101  \u1082 \u1086 \u1074 \u1072 \u1083 \u1105 \u1089 \u1072 . \u1057 \u1086 \u1089 \u1090 \u1099 \u1088  \u1072 \u1084 \u1072 \u1088 \u1086  \u1075 \u1072 \u1074  \u1087 \u1086 \u1082 \u1072 \u1084 \u1100 \u1103 \u1087 \u1101  \u1083 \u1101 \u1089 \u1082 \u1101 .\cb1 \
\cb3 \uc0\u1051 \u1091 \u1097 \u1080 \u1083 \u1080 \u1093 \u1072  \u1087 \u1088 \u1080 \u1076 \u1074 \u1080 \u1085 \u1091 \u1083 \u1072 \u1089 \u1100  \u1077 \u1097 \u1105  \u1087 \u1072 \u1096 \u1099 \u1076 \u1099 \u1088  \u1082 \u1093 \u1101 \u1090 \u1072 \u1085 \u1101  \u1090 \u1072 \u1073 \u1091 \u1088 \u1077 \u1090 \u1082 \u1072 \u1089 \u1072 , \u1087 \u1086 \u1082 \u1086 \u1089 \u1080 \u1085 \u1076 \u1103 \u1087 \u1101  \u1087 \u1088 \u1101  \u1092 \u1101 \u1085 \u1096 \u1090 \u1088 \u1072 , \u1080 \'a0\u1087 \u1093 \u1101 \u1085 \u1076 \u1103  \u1096 \u1105 \u1087 \u1086 \u1090 \u1086 \u1089 \u1072 :\cb1 \
\cb3 \'96\'a0\uc0\u1040 \'a0\u1076 \u1078 \u1080 \u1085 \u1101 \u1089 , \u1050 \u1083 \u1072 \u1074 \u1072 , \u1089 \u1086 \u1089 \u1090 \u1099 \u1088  \u1087 \u1086 \u1082 \u1072 \u1084 \u1100 \u1103 ? \u1052 \u1080 \u1088 \u1086  \u1087 \u1083 \u1077 \u1084 \u1103 \u1085 \u1085 \u1080 \u1082 \u1086  \u1091 \u1096 \u1091 \u1085 \u1076 \u1103 , \u1089 \u1099 \u1088  \u1105 \u1074  \u1088 \u1086 \u1089 \u1087 \u1093 \u1101 \u1085 \u1101 \u1083 \u1072 \u1089  \u1087 \u1086 \u1090 \u1086 \u1084  \u1089 \u1077 \u1082 \u1088 \u1077 \u1090 \u1072 \u1088 \u1105 \u1089 \u1082 \u1101  \u1088 \u1072 \u1081 \u1082 \u1086 \u1084 \u1072  \u1080 \'a0\u1087 \u1088 \u1077 \u1076 \u1089 \u1077 \u1076 \u1072 \u1090 \u1077 \u1083 \u1105 \u1089 \u1082 \u1101 , \u1093 \u1072 \u1081  \u1082 \u1072 \u1081 \'a0\'96 \u1090 \u1086  \u1072 \u1076 \u1072 \u1081  \u1083 \u1101 \u1089 \u1082 \u1080 \u1088 \u1100 \u1103  \u1088 \u1086 \u1084 \u1085 \u1103  \u1079 \u1072 \u1090 \u1072 \u1089 \u1072 \u1076 \u1103  \u1085 \u1077 \u1084 \u1077 \u1094 \u1082 \u1086  \u1090 \u1072 \u1085 \u1082 \u1086 , \u1082 \u1072 \u1085 \u1072  \u1083 \u1072 \u1090 \u1093 \u1090 \u1103  \u1083 \u1072 \u1082 \u1080 \u1088 \u1080  \u1084 \u1086 \u1075 \u1080 \u1083 \u1082 \u1072 . \u1050 \u1072 \u1085 \u1072  \u1087 \u1088 \u1086 \u1075 \u1101 \u1103  \u1084 \u1080 \u1084 \u1086  \u1072 \u1084 \u1072 \u1088 \u1080  \u1082 \u1091 \u1079 \u1085 \u1103 , \u1079 \u1072 \u1084 \u1082 \u1086  \u1089 \u1083 \u1099 \u1085 \u1086 , \u1080 \'a0\u1095 \u1072 \u1074 \u1086 \u1088 \u1101  \u1086 \u1076 \u1086 \u1088 \u1080 \u1082  \u1089 \u1087 \u1088 \u1072 \u1089 \u1090 \u1072 \u1085 \u1076 \u1099 \u1085 \u1101 \u1087 \u1101 \u1089 . \u1052 \u1101  \u1086 \u1076 \u1086 \u1081  \u1080 \'a0\u1090 \u1099 \u1088 \u1101 \u1089  \u1042 \u1072 \u1085 \u1103 \u1089  \u1076 \u1099 \u1082 \u1093 \u1090 \u1105 \u1084 .\cb1 \
\cb3 \uc0\u1025 \u1081  \u1085 \u1072 \u1089 \u1083 \u1072 \u1078 \u1076 \u1072 \u1083 \u1072 \u1089 \u1100  \u1101  \u1076 \u1105 \u1089 \u1090 \u1099 \u1088 . \u1056 \u1077 \u1072 \u1082 \u1094 \u1080 \u1103  \u1089 \u1099 \u1089  \u1076 \u1072 \u1089 \u1072 \u1074 \u1080 , \u1089 \u1086 \'a0\u1087 \u1093 \u1091 \u1088 \u1080  \u1076 \u1072 \u1078 \u1077  \u1079 \u1076 \u1072 \u1088 \u1072 \u1085 \u1076 \u1099 \u1103 \u1087 \u1101 .\cb1 \
\cb3 \'96\'a0\uc0\u1057 \u1086 \'a0\u1090 \u1091 \u1089 \u1072 , \u1050 \u1083 \u1072 \u1074 \u1086 \u1095 \u1082 \u1072 ? \u1055 \u1101  \u1090 \u1091 \u1090 \u1101  \u1084 \u1091 \u1081  \u1085 \u1072 \u1085 \u1101 ! \u1054 \u1076 \u1086 \u1081 , \u1087 \u1072 \u1083 \u1086  \u1044 \u1086 \u1085 \u1086 , \u1082 \u1086 \u1084 \u1072 \u1088 \u1086 \u1089 \u1090 \u1099 \u1088  \u1083 \u1080 \u1093 \u1086 \u1084 \u1072 \u1085 \u1082 \u1072  \u1076 \u1088 \u1086  \u1076 \u1091 \u1081  \u1089 \u1095 \u1105 \u1090 \u1099  \u1084 \u1086 \u1078 \u1085 \u1086  \u1090 \u1101  \u1089 \u1091 \u1093 \u1090 \u1099 \u1083 \u1101 \u1089 .\cb1 \
\cb3 \'96\'a0\uc0\u1053 \u1072 \u1090 , \u1085 \u1080 \u1095 \u1080 , \u1084 \u1101  \u1085 \u1072 \u1085 \u1101  \u1085 \u1072 \u1089 \u1074 \u1072 \u1083 \u1099 . \u1058 \u1091 , \u1087 \u1093 \u1091 \u1088 \u1080 , \u1083 \u1101  \u1076 \u1088 \u1086  \u1082 \u1072 \u1090 \u1091 \u1093 \u1086  \u1073 \u1072 \u1083 \u1099 \u1095 \u1105 \u1088 \u1101 \u1089 , \u1080 , \u1087 \u1086 \u1078 \u1072 \u1083 \u1091 \u1081 \u1089 \u1090 \u1072 , \u1091 \u1076 \u1078 \u1103 .\cb1 \
\cb3 \'96\'a0\uc0\u1055 \u1072 \u1089 \u1105 \u1074 , \u1084 \u1080 \u1083 \u1077 \u1085 \u1100 \u1082 \u1086 , \u1087 \u1072 \u1089 \u1105 \u1074 ! \u1040 \'a0\u1087 \u1072 \u1083 \u1101  \u1073 \u1072 \u1083 \u1099 \u1095 \u1105 \u1088 \u1101 \u1089  \u1085 \u1072 \u1080 \u1089 . \u1058 \u1086 \'a0\'96 \u1090 \u1086  \u1084 \u1080 \u1088 \u1086  \u1087 \u1072 \u1087 \u1091  \u1086 \u1073 \u1088 \u1072 \u1076 \u1099 \u1085 \u1101 \u1083 \u1072 \u1087 \u1101 . \'85\u1040 \u1093 , \u1090 \u1091 , \u1044 \u1101 \u1074 \u1101 \u1083 !\'a0\'96 \u1080 \'a0\u1051 \u1091 \u1097 \u1080 \u1083 \u1080 \u1093 \u1072  \u1074 \u1079 \u1084 \u1072 \u1093 \u1080 \u1085 \u1076 \u1103  \u1073 \u1091 \u1075 \'92\u1083 \u1101  \u1073 \u1072 \u1103 ,\'a0\'96 \u1040 \'a0\u1075 \u1086 \u1085 \u1086 \'a0\'96 \u1090 \u1086  \u1084 \u1101 , \u1087 \u1093 \u1091 \u1088 \u1080 , \u1079 \u1072 \u1073 \u1080 \u1089 \u1090 \u1099 \u1088 \u1076 \u1105 \u1084 ! \u1058 \u1091  \u1084 \u1072 \u1085 \u1075 \u1101 , \u1050 \u1083 \u1072 \u1074 \u1086 \u1095 \u1082 \u1072 , \u1076 \u1101 \u1089 \u1072  \u1087 \u1101 \u1089 \u1082 \u1080 \u1088 \u1086 ?\cb1 \
\cb3 \uc0\u1050 \u1083 \u1072 \u1074 \u1076 \u1080 \u1103  \u1088 \u1072 \u1079 \u1088 \u1077 \u1096 \u1080 \u1085 \u1076 \u1103 :\cb1 \
\cb3 \'96\'a0\uc0\u1051 \u1101  \u1076 \u1088 \u1086  \u1089 \u1077 \u1085 \u1094 \u1099 .\cb1 \
\cb3 \uc0\u1041 \u1077 \u1083 \u1100 \u1074 \u1077 \u1083 \u1103 \u1089 \u1072 , \u1082 \u1101 \u1076 \u1101  \u1103 \u1074 \u1100 \u1103  \u1095 \u1072 \u1074 \u1086 , \u1050 \u1083 \u1072 \u1074 \u1076 \u1080 \u1103  \u1089 \u1087 \u1091 \u1095 \u1100 \u1103 \'a0\u1083 \u1101 \u1089 :\cb1 \
\cb3 \'96\'a0\uc0\u1050 \u1072 \u1081  \u1089 \u1072 \u1085 \u1072 \u1089 ? \u1048 \'a0\u1086 \'a0\u1075 \u1072 \u1076  \u1076 \u1088 \u1086  \u1089 \u1072 \u1074 \u1086 \'a0\'96 \u1090 \u1086  \u1084 \u1072 \u1079 \u1091 \u1090 \u1086 .\cb1 \
\cb3 \'96\'a0\uc0\u1040 \u1076 \u1072  \u1085 \u1072 \u1085 \u1101  \u1084 \u1072 \u1079 \u1091 \u1090 \u1086 . \u1040 \u1076 \u1072  \u1072 \u1084 \u1101  \u1095 \u1072 \u1074 \u1086 \u1088 \u1101 \u1085 \u1094 \u1072  \u1087 \u1086 \u1084 \u1086 \u1075 \u1072 \u1083 \u1080  \u1085 \u1101 \u1074 \u1086  \u1082 \u1086 \u1074 \u1072 \u1083 \u1105 \u1089 \u1082 \u1101  \u1090 \u1101  \u1090 \u1093 \u1086 \u1074 \u1101 \u1089  \u1075 \u1086 \u1088 \u1085 \u1086 .\cb1 \
\cb3 \'96\'a0\uc0\u1053 \u1072 \u1085 \u1101  \u1087 \u1072 \u1083 \u1089 \u1086  \u1090 \u1101  \u1076 \u1078 \u1103 \u1089  \u1086 \u1076 \u1086 \u1088 \u1080 \u1082 ,\'a0\'96 \u1087 \u1093 \u1101 \u1085 \u1076 \u1103  \u1050 \u1083 \u1072 \u1074 \u1076 \u1080 \u1103 .\cb1 \
\cb3 \uc0\u1025 \u1074  \u1086 \u1073 \u1088 \u1080 \u1089 \u1082 \u1080 \u1088 \u1076 \u1103  \u1082 \u1101  \u1105 \u1081  \u1082 \u1072 \u1083 \u1101 \u1103 \u1082 \u1093 \u1101 \u1085 \u1075 \u1080 \u1088 \u1086 \'a0\u1084 \u1091 \u1081 .\cb1 \
\cb3 \'96\'a0\uc0\u1057 \u1086 \u1089 \u1090 \u1099 \u1088 ?\cb1 \
\cb3 \'96\'a0\uc0\u1053 \u1072 \u1085 \u1101  \u1089 \u1086 \'a0\u1090 \u1101  \u1082 \u1101 \u1088 \u1101 \u1089  \u1086 \u1076 \u1086 \u1081 .\cb1 \
\cb3 \'96\'a0\uc0\u1052 \u1072 \u1085 \u1075 \u1101  \u1091 \u1078 \u1077  \u1076 \u1101 \u1096 \u1091 -\u1096 \u1086 \u1074  \u1073 \u1101 \u1088 \u1096 \u1072 . \u1052 \u1101  \u1085 \u1072 \u1085 \u1101  \u1090 \u1099 \u1082 \u1085 \u1086 . \u1052 \u1072 \u1085 \u1076 \u1099 \u1088  \u1089 \u1072 \u1088 \u1101  \u1095 \u1072 \u1074 \u1086 \u1088 \u1101  \u1089 \u1072 \u1085 \u1087 \u1101 : \'ab\'96 \u1044 \u1099 \u1082 \u1093 , \u1089 \u1099 \u1088 \'a0\u1073 \u1099  \u1088 \u1086 \u1084  \u1090 \u1091 \u1090  \u1076 \u1088 \u1086  \u1075 \u1086 \u1085 \u1086  \u1085 \u1072 \'a0\u1087 \u1086 \u1095 \u1102 \u1076 \u1103 !\'bb.\cb1 \
\cb3 \'96\'a0\uc0\u1044 \u1099 \u1083 \u1099 \u1085 \u1101 , \u1087 \u1072 \u1083 \u1086 \u1076 \u1086 \u1074 \u1072  \u1080 \'a0\u1089 \u1072 \u1085 \u1087 \u1101 . \u1045 \u1089 \u1083 \u1080  \u1085 \u1072 \'a0\u1082 \u1072 \u1084 \u1101 \u1089  \u1090 \u1101  \u1082 \u1086 \u1096 \u1101 \u1089 \u1087 \u1101  \u1076 \u1072 \u1089 \u1072 , \u1085 \u1072 \'a0\u1076 \u1078 \u1103  \u1086 \u1076 \u1086 \u1088 \u1080 \u1082 .\cb1 \
\cb3 \'96\'a0\uc0\u1053 \u1102 \u1088 \u1082 \u1072 \u1082 \u1101  \u1090 \u1091  \u1085 \u1072 \'a0\u1079 \u1072 \u1087 \u1093 \u1101 \u1085 \u1076 \u1103 \u1085 !\cb1 \
\cb3 \'96\'a0\uc0\u1025 \u1081  \u1080 \'a0\u1082 \u1086 \u1082 \u1086 \u1088 \u1080  \u1086 \u1076 \u1086 \u1088 \u1080 \u1082  \u1085 \u1072 \'a0\u1076 \u1078 \u1103 \u1083 .\cb1 \
\cb3 \uc0\u1055 \u1088 \u1086 \u1075 \u1101 \u1103  \u1087 \u1072 \u1096 \u1073 \u1101 \u1088 \u1096 . \u1041 \u1091 \u1090  \u1087 \u1072 \u1085 \u1099  \u1091 \u1075 \u1101 \u1103 . \u1042 \u1086 \u1083 \u1085 \u1077 \u1085 \u1080 \u1103  \u1087 \u1072 \u1083 \u1101  \u1088 \u1086 \u1084 \u1101 \u1089 \u1090 \u1101  \u1091 \u1087 \u1072 \u1089 \u1080 \u1085 \u1101 \u1087 \u1101 \u1089 . \u1050 \u1101  \u1041 \u1091 \u1076 \u1091 \u1083 \u1072 \u1105  \u1087 \u1088 \u1080 \u1089 \u1099 \u1082 \u1083 \u1099 \u1085 \u1101 . \u1062 \u1077 \u1083 \u1072  \u1076 \u1101 \u1074 \u1101 \u1089 \u1072  \u1089 \u1099 \u1089  \u1076 \u1088 \u1101  \u1082 \u1091 \u1079 \u1085 \u1103 . \u1025 \u1081  \u1079 \u1072 \u1076 \u1078 \u1080 \u1074 \u1076 \u1103 . \u1050 \u1072 \u1085 \u1072  \u1079 \u1072 \u1084 \u1082 \u1086  \u1087 \u1088 \u1101  \u1083 \u1072 \u1090 \u1101  \u1089 \u1099 \u1089  \u1090 \u1086 \u1083 \u1100 \u1082 \u1086  \u1082 \u1101  \u1073 \u1077 \u1083 \u1100 \u1074 \u1077 \u1083 \u1100 . \u1057 \u1072 \u1088 \u1086  \u1074 \u1088 \u1077 \u1084 \u1105  \u1087 \u1086 \u1088 \u1090 \u1099  \u1089 \u1099 \u1089  \u1086 \u1090 \u1082 \u1101 \u1088 \u1076 \u1101 . \u1089 \u1099 \u1089  \u1076 \u1099 \u1082 \u1093 \u1085 \u1086 , \u1089 \u1099 \u1088  \u1105 \u1085 \u1101  \u1089 \u1074 \u1077 \u1090 \u1080 \u1085 \u1101 \u1085 \u1087 \u1101 \u1089 .\cb1 \
\cb3 \uc0\u1044 \u1078 \u1080 \u1074 \u1101 \u1083  \u1041 \u1091 \u1076 \u1091 \u1083 \u1072 \u1105  \u1087 \u1072 \u1096 \u1086  \u1044 \u1086 \u1085 \u1086 , \u1076 \u1088 \u1086  \u1092 \u1083 \u1080 \u1075 \u1080 \u1083 \u1105 . \u1057 \u1086 \'a0\u1105 \u1074  \u1082 \u1101 \u1088 \u1101 \u1083  \u1086 \u1076 \u1086 \u1081  \u1073 \u1077 \u1083 \u1100 \u1074 \u1077 \u1083 \u1103 \u1089 \u1072  \u1085 \u1080 \u1082 \u1086 \u1085  \u1085 \u1072 \'a0\u1076 \u1078 \u1080 \u1085 \u1101 \u1083 . \u1061 \u1072 \u1073 \u1101  \u1082 \u1101 \u1088 \u1101 \u1083  \u1087 \u1101 \u1089 \u1082 \u1101  \u1082 \u1086 \u1082 \u1086 \u1088 \u1086 . \u1057 \u1072 \u1088 \u1086  \u1091 \u1076 \u1078 \u1080 \u1085 \u1101 \u1089 \u1072 , \u1077 \u1089 \u1083 \u1080  \u1089 \u1072 \u1085 \u1072 \u1089  \u1087 \u1088 \u1086  \u1084 \u1072 \u1088 \u1080 \u1073 \u1101 , \u1083 \u1086 \u1076 \u1101 \u1089 \u1072 \u1089 . \u1044 \u1099 \u1082 \u1093 \u1085 \u1101  \u1083 \u1101 \u1089  \u1091 \u1090 \u1088 \u1086 \u1089 \u1072  \u1080 \u1083 \u1080  \u1073 \u1077 \u1083 \u1100 \u1074 \u1077 \u1083 \u1077  \u1076 \u1088 \u1101  \u1092 \u1101 \u1083 \u1076 \u1072  \u1087 \u1072 \u1096 \u1101  \u1083 \u1101 \u1089 \u1082 \u1080 \u1088 \u1101  \u1088 \u1086 \u1084 \u1085 \u1103 \u1082 \u1080 \u1088 \u1080  \u1084 \u1086 \u1075 \u1080 \u1083 \u1082 \u1072 . \u1051 \u1072 \u1082 \u1080 \u1088 \u1080  \u1082 \u1080 \u1073 \u1080 \u1090 \u1082 \u1072  \u1072 \u1095 \u1100 \u1103 \u1087 \u1101  \u1077 \u1082 \u1076 \u1078 \u1080 \u1085 \u1099 , \u1051 \u1072  \u1076 \u1086 \u1088 \u1101 \u1089 \u1090 \u1103  \u1080 \'a0\u1079 \u1072 \u1090 \u1072 \u1089 \u1072 \u1076 \u1103  \u1085 \u1077 \u1084 \u1077 \u1094 \u1082 \u1086  \u1090 \u1072 \u1085 \u1082 \u1086 . \u1043 \u1072 \u1074 \u1080 \u1090 \u1082 \u1072  \u1076 \u1078 \u1102 \u1074 \u1083 \u1103  \u1083 \u1101 \u1089  \u1078 \u1072 \u1083 \u1080 \u1085 \u1077 \u1085 \u1072 \u1089 . \u1056 \u1072 \u1082 \u1080 \u1088 \u1101 \u1085 \u1072 \u1089 , \u1089 \u1086 \'a0\u1105 \u1074  \u1085 \u1072 \u1085 \u1101  \u1087 \u1093 \u1091 \u1088 \u1086 . \u1044 \u1072 \u1078 \u1077  \u1075 \u1086 \u1078 \u1086  \u1088 \u1086 \u1084 . \u1025 \u1074  \u1074 \u1089 \u1077 \u1075 \u1076 \u1072  \u1079 \u1076 \u1086 \u1088 \u1086 \u1074 \u1080 \u1085 \u1076 \u1103 \u1087 \u1101 .\cb1 \
\cb3 \uc0\u1059 \u1078 \u1077  \u1080 \'a0\u1095 \u1072 \u1074 \u1086 \u1088 \u1101 \u1085  \u1085 \u1072 \u1085 \u1101  \u1087 \u1072 \u1096  \u1082 \u1091 \u1079 \u1085 \u1103 . \u1054 \u1089 \u1090 \u1088 \u1086 \u1090 \u1072  \u1074 \u1087 \u1077 \u1095 \u1072 \u1090 \u1083 \u1077 \u1085 \u1080 \u1103  \u1087 \u1088 \u1086 \u1075 \u1101 \u1103 . \u1043 \u1072 \u1076 \u1103  \u1088 \u1072 \u1082 \u1080 \u1088 \u1101 \u1085 \u1072 \u1089  \u1050 \u1083 \u1072 \u1074 \u1076 \u1103 \u1082 \u1101 :\cb1 \
\cb3 \'96\'a0\uc0\u1058 \u1099 \u1088 \u1086  \u1042 \u1072 \u1085 \u1100 \u1082 \u1072 , \u1076 \u1086 \u1083 \u1078 \u1085 \u1086  \u1090 \u1101  \u1103 \u1074 \u1101 \u1083 , \u1082 \u1086  \u1041 \u1091 \u1076 \u1091 \u1083 \u1072 \u1105  \u1076 \u1088 \u1086  \u1087 \u1086 \u1076 \u1084 \u1072 \u1089 \u1090 \u1077 \u1088 \u1100 \u1103  \u1079 \u1072 \u1095 \u1080 \u1085 \u1076 \u1103 \u1087 \u1101 . \u1058 \u1086  \u1094 \u1101 \u1083 \u1072  \u1076 \u1101 \u1074 \u1101 \u1089 \u1072  \u1076 \u1088 \u1101  \u1082 \u1091 \u1079 \u1085 \u1103  \u1076 \u1099 \u1082 \u1093 \u1101 \u1083 \u1072 \u1089 , \u1082 \u1072 \u1085 \u1072  \u1091 \u1078 \u1077  \u1076 \u1088 \u1101  \u1082 \u1091 \u1079 \u1085 \u1103  \u1084 \u1101 \u1082 \u1090 \u1103 . \u1057 \u1086 \'a0\'96 \u1090 \u1086  \u1091 \u1078 \u1077  \u1082 \u1086 \u1082 \u1086 \u1088 \u1086  \u1084 \u1086 \u1083 \u1086 \u1090 \u1086 \u1095 \u1082 \u1086 \u1089 \u1072  \u1087 \u1086 \u1090 \u1102 \u1082 \u1080 \u1074 \u1072 \u1077 \u1090 . \u1050 \u1101 \u1076 \u1101  \u1085 \u1072 \'a0\u1087 \u1088 \u1086 \u1076 \u1078 \u1103 \u1089 \'a0\'96 \u1105 \u1074  \u1086 \u1076 \u1086 \u1081 . \u1048 \'a0\u1089 \u1086 \'a0\u1090 \u1091  \u1076 \u1072 \u1088 \u1101 \u1089 \u1087 \u1101 , \u1076 \u1099 \u1083 \u1099 \u1085 \u1099 ? \u1058 \u1091 \'a0\u1078 \u1077  \u1076 \u1078 \u1080 \u1085 \u1101 \u1089 , \u1089 \u1072 \u1074 \u1101  \u1105 \u1085 \u1101  \u1082 \u1086 \u1074 \u1072 \u1083 \u1080 . \u1041 \u1091 \u1076 \u1091 \u1083 \u1072 \u1105  \u1042 \u1072 \u1085 \u1100 \u1082 \u1091  \u1083 \u1099 \u1103 \u1087 \u1101  \u1090 \u1101  \u1089 \u1099 \u1082 \u1083 \u1103 \u1082 \u1080 \u1088 \u1101 \u1089 . \u1071 \u1074 \u1101 \u1083 \u1072  \u1084 \u1072 \u1089 \u1090 \u1077 \u1088 \u1086 \u1089 \u1072 , \u1103 \u1074 \u1101 \u1083 \u1072  \u1101  \u1076 \u1072 \u1081  \u1090 \u1101  \u1095 \u1103 \u1088 \u1072 \u1074 \u1101 \u1083 .\cb1 \
\cb3 \uc0\u1057 \u1086 \'a0\u1105 \u1081  \u1084 \u1086 \u1075 \u1083 \u1072  \u1090 \u1101  \u1087 \u1093 \u1101 \u1085 \u1101 \u1083 , \u1082 \u1101 \u1076 \u1101  \u1089 \u1072 \u1088 \u1086  \u1074 \u1088 \u1077 \u1084 \u1105  \u1087 \u1072 \u1083 \u1086  \u1044 \u1086 \u1085 \u1086 , \u1085 \u1072 \u1085 \u1101  \u1076 \u1088 \u1086  \u1093 \u1091 \u1090 \u1086 \u1088 \u1086 , \u1080 \'a0\u1085 \u1072 \'a0\u1084 \u1086 \u1078 \u1080 \u1085 \u1101 \u1083  \u1090 \u1101  \u1087 \u1088 \u1080 \u1076 \u1099 \u1082 \u1093 \u1101 \u1083  \u1087 \u1072 \u1083 \u1101  \u1095 \u1072 \u1074 \u1101 \u1089 \u1090 \u1101 . \u1057 \u1099 \u1088 \'a0\'96 \u1090 \u1086  \u1105 \u1081  \u1087 \u1088 \u1080 \u1090 \u1088 \u1072 \u1076 \u1099 \u1103 , \u1079 \u1072 \u1088 \u1072 \u1082 \u1080 \u1088 \u1076 \u1103  \u1087 \u1072 \u1083  \u1072 \u1076 \u1072 \u1074 \u1072 , \u1089 \u1087 \u1091 \u1095 \u1100 \u1103 . \u1025 \u1074  \u1088 \u1072 \u1082 \u1080 \u1088 \u1101 \u1083 \u1072 \u1089  \u1091 \u1082 \u1083 \u1086 \u1085 \u1095 \u1080 \u1074 \u1086 . \u1041 \u1091 \u1090 \u1099 \u1088  \u1105 \u1081  \u1085 \u1072 \'a0\u1088 \u1072 \u1082 \u1080 \u1088 \u1076 \u1103  \u1085 \u1080 \u1095 \u1080 . \u1025 \u1074  \u1074 \u1079 \u1088 \u1086 \u1089 \u1083 \u1086 . \u1055 \u1088 \u1086 \u1075 \u1101 \u1103  \u1074 \u1088 \u1077 \u1084 \u1105 , \u1082 \u1101 \u1076 \u1101  \u1087 \u1089 \u1080 \u1088 \u1101 \u1083 \u1072 \u1089  \u1076 \u1072 \u1089 \u1072  \u1087 \u1072 \u1083 \u1086  \u1074 \u1072 \u1089 \u1090 .\cb1 \
\cb3 \uc0\u1045 \u1082 \u1093  \u1084 \u1086 \u1083 \u1086  \u1087 \u1088 \u1077 \u1076 \u1089 \u1077 \u1076 \u1072 \u1090 \u1077 \u1083 \u1105  \u1079 \u1072 \u1090 \u1088 \u1072 \u1076 \u1099 \u1103  \u1076 \u1088 \u1086  \u1093 \u1091 \u1090 \u1086 \u1088 \u1086 . \u1047 \u1072 \u1075 \u1101 \u1103  \u1076 \u1088 \u1086  \u1082 \u1091 \u1079 \u1085 \u1103 . \u1051 \u1072 \u1090 \u1093 \u1090 \u1103  \u1041 \u1091 \u1076 \u1091 \u1083 \u1072 \u1105 \u1089 \u1072 , \u1087 \u1086 \u1084 \u1072 \u1085 \u1075 \u1076 \u1103  \u1090 \u1101  \u1090 \u1088 \u1072 \u1076 \u1101 \u1089  \u1087 \u1072 \u1083 \u1086  \u1044 \u1086 \u1085 \u1086  \u1076 \u1088 \u1086  \u1089 \u1074 \u1080 \u1085 \u1072 \u1088 \u1085 \u1080 \u1082 \u1086 . \u1057 \u1086 \u1073  \u1082 \u1086 \u1082 \u1086 \u1088 \u1086  \u1087 \u1086 \u1076 \u1099 \u1082 \u1090 \u1103  \u1074 \u1086 \u1088 \u1086 \u1090 \u1072 , \u1089 \u1086 \u1073  \u1073 \u1072 \u1083 \u1099 \u1095 \u1105 \u1088 \u1101  \u1083 \u1101 \u1085  \u1085 \u1072 \'a0\u1084 \u1072 \u1088 \u1076 \u1101 .\cb1 \
\cb3 \'96\'a0\uc0\u1044 \u1072 \u1085 \u1076 \u1099 \u1088 \u1101 \u1085 , \u1072 \u1088 \u1084 \u1072 \u1085 \u1076 \u1099 \u1085 \u1101 , \u1082 \u1072 \u1096 \u1090 \u1072 , \u1089 \u1099 \u1088  \u1087 \u1093 \u1091 \u1089 . \u1052 \u1086 \u1078 \u1077 \u1090 , \u1077 \u1082 \u1093  \u1084 \u1086 \u1083 \u1086  \u1086 \u1082 \u1086 \u1074 \u1072 \u1090 \u1100  \u1089 \u1072 \u1089 \u1090 \u1099 \u1088 \u1101 \u1085 \u1089 \u1072 , \u1084 \u1101 \u1082  \u1090 \u1086 \u1095 \u1072 \u1090  \u1087 \u1101 \u1089 \u1082 \u1080 \u1088 \u1101  \u1076 \u1072 \u1085 \u1076 \u1072 .\cb1 \
\cb3 \uc0\u1059 \u1076 \u1099 \u1082 \u1093 \u1090 \u1103  \u1095 \u1072 \u1074 \u1086 \u1088 \u1101 \u1089 \u1082 \u1080 \u1088 \u1086  \u1089 \u1080 \u1083 \u1091 \u1101 \u1090 \u1086 , \u1080 \'a0\u1089 \u1087 \u1091 \u1095 \u1100 \u1103 :\cb1 \
\cb3 \uc0\u1040 \'a0\u1089 \u1086 \'a0\u1079 \u1072 \'a0\u1095 \u1072 \u1074 \u1086 \u1088 \u1086  \u1090 \u1091 \u1090 \u1101 ?\cb1 \
\cb3 \uc0\u1056 \u1086 \u1079 \u1091 \u1088 \u1080 \u1076 \u1086  \u1078 \u1099 \u1082 \u1086  \u1087 \u1086 \u1103 \u1089 \u1086 , \u1105 \u1074  \u1088 \u1086 \u1089 \u1087 \u1093 \u1091 \u1088 \u1076 \u1101 \u1083 \u1072 \u1089  \u1103 \u1075  \u1076 \u1088 \u1086  \u1075 \u1086 \u1088 \u1085 \u1086 . \u1057 \u1084 \u1091 \u1075 \u1083 \u1086  \u1094 \u1099 \u1087 \u1072  \u1089 \u1099 \u1089  \u1082 \u1093 \u1072 \u1084 \u1083 \u1099  \u1080 \'a0\u1083 \u1086 \u1089 \u1085 \u1080 \u1083 \u1072 \u1089 \u1100 . \u1044 \u1091 \u1081  \u1103 \u1082 \u1093 \u1072  \u1089 \u1074 \u1077 \u1090 \u1080 \u1085 \u1101 \u1085 \u1072 \u1089 \u1087 \u1101  \u1082 \u1072 \u1083 \u1099 \u1087 \u1085 \u1072 \u1089 \u1090 \u1099 \u1088  \u1103 \u1088 \u1082 \u1086 , \u1089 \u1099 \u1088  \u1088 \u1072 \u1089 \u1082 \u1072 \u1083 \u1105 \u1085 \u1085 \u1072  \u1074 \u1072 \u1085 \u1075 \u1072 \u1088 \u1072 .\cb1 \
\cb3 \'96\'a0\uc0\u1040 \u1076 \u1072  \u1095 \u1072 \u1074 \u1086  \u1050 \u1083 \u1072 \u1074 \u1076 \u1080 \u1080  \u1055 \u1077 \u1090 \u1088 \u1086 \u1074 \u1085 \u1099  \u1055 \u1091 \u1093 \u1083 \u1103 \u1082 \u1086 \u1074 \u1086 \u1081 ,\'a0\'96 \u1087 \u1093 \u1101 \u1085 \u1076 \u1103  \u1041 \u1091 \u1076 \u1091 \u1083 \u1072 \u1105 .\cb1 \
\cb3 \uc0\u1050 \u1086 \u1074 \u1083 \u1099  \u1089 \u1091 \u1076 \u1086 \u1088 \u1086 \u1075 \u1072  \u1087 \u1088 \u1086 \u1087 \u1088 \u1072 \u1089 \u1090 \u1072 \u1085 \u1076 \u1099 \u1103  \u1087 \u1088 \u1101  \u1083 \u1101 \u1089 \u1082 \u1080 \u1088 \u1086  \u1084 \u1091 \u1081 . \u1063 \u1072 \u1089 \u1086  \u1087 \u1072 \u1083 \u1101  \u1105 \u1074  \u1074 \u1099 \u1096 \u1091 \u1085 \u1076 \u1103  \u1072 \u1090 \u1072 \u1082 \u1072  \u1083 \u1072 \u1090 \u1099 \u1088 . \u1057 \u1099 \u1088  \u1095 \u1077 \u1089 \u1090 \u1080 \u1083 \u1072  \u1083 \u1101 \u1089  \u1087 \u1072 \u1083  \u1086 \u1076 \u1086 \u1074 \u1072 , \u1089 \u1086 \'a0\u1085 \u1080 \u1082 \u1086 \u1085  \u1085 \u1072 \'a0\u1076 \u1086 \u1075 \'92\u1072 \u1083 \u1099 \u1103 \u1087 \u1101  \u1090 \u1101  \u1086 \u1073 \u1084 \u1072 \u1088 \u1101 \u1089  \u1074 \u1086 \u1088 \u1086 \u1090 \u1072  \u1089 \u1072 \u1089 \u1090 \u1099 \u1088 \u1101 \u1085 \u1089 \u1072 . \u1055 \u1072 \u1083 \u1086 \u1076 \u1086 \u1074 \u1072  \u1087 \u1088 \u1077 \u1076 \u1089 \u1077 \u1076 \u1072 \u1090 \u1077 \u1083 \u1105  \u1089 \u1099 \u1075 \u1101 \u1089  \u1082 \u1101  \u1041 \u1091 \u1076 \u1091 \u1083 \u1072 \u1105 . \u1055 \u1086 \u1083 \u1099 \u1103 , \u1089 \u1086 \'a0\u1095 \u1072 \u1074 \u1086 \u1088 \u1101 \u1089 \u1082 \u1080 \u1088 \u1101  \u1103 \u1082 \u1093 \u1072  \u1089 \u1099 \u1088  \u1076 \u1072 \u1090 \u1101 .\cb1 \
\cb3 \'96\'a0\uc0\u1057 \u1082 \u1080 \u1094 \u1080 \u1082  \u1083 \u1101 \u1089 \u1082 \u1101  \u1073 \u1101 \u1088 \u1096 ?\cb1 \
\cb3 \'96\'a0\uc0\u1044 \u1101 \u1096 \u1091 -\u1096 \u1086 \u1074 ,\'a0\'96 \u1087 \u1093 \u1101 \u1085 \u1076 \u1103  \u1041 \u1091 \u1076 \u1091 \u1083 \u1072 \u1105 .\cb1 \
\cb3 \'96\'a0\uc0\u1053 \u1072 \u1088 \u1091 \u1096 \u1077 \u1085 \u1080 \u1077  \u1082 \u1086 \u1076 \u1077 \u1082 \u1089 \u1072  \u1079 \u1072 \u1082 \u1086 \u1085 \u1086 \u1074  \u1086 \'a0\u1090 \u1088 \u1091 \u1076 \u1077 . \u1058 \u1091  \u1076 \u1078 \u1080 \u1085 \u1101 \u1089 , \u1089 \u1086 \'a0\u1087 \u1086 \u1076 \u1088 \u1086 \u1089 \u1090 \u1082 \u1072 \u1084  \u1073 \u1091 \u1090 \u1099  \u1087 \u1088 \u1101  \u1074 \u1088 \u1077 \u1076 \u1085 \u1086  \u1087 \u1088 \u1086 \u1080 \u1079 \u1074 \u1086 \u1076 \u1089 \u1090 \u1074 \u1086  \u1079 \u1072 \u1087 \u1088 \u1077 \u1097 \u1077 \u1085 \u1086 ?\'a0\'96 \u1087 \u1093 \u1101 \u1085 \u1076 \u1103  \u1087 \u1088 \u1077 \u1076 \u1089 \u1077 \u1076 \u1072 \u1090 \u1077 \u1083 \u1105 , \u1085 \u1101  \u1083 \u1101 \u1089  \u1087 \u1077 \u1088 \u1077 \u1084 \u1072 \u1088 \u1076 \u1103  \u1095 \u1072 \u1074 \u1086 \u1088 \u1101 \u1089 \u1082 \u1080 \u1088 \u1080  \u1075 \u1083 \u1086 \u1089 :\cb1 \
\cb3 \'96\'a0\uc0\u1055 \u1080 \u1088 \u1076 \u1072 \u1083  \u1095 \u1105 \u1085 , \u1076 \u1074 \u1072 \u1076 \u1094 \u1072 \u1090 \u1100  \u1087 \u1103 \u1090 \u1086 \u1075 \u1086  \u1080 \u1102 \u1083 \u1103 , \u1103 \u1074 \u1101 \u1083 \u1072  \u1076 \u1101 \u1096 \u1091 -\u1101 \u1092 \u1090 \u1072 .\cb1 \
\cb3 \'96\'a0\uc0\u1058 \u1091 \u1090  \u1085 \u1080 \u1082 \u1086 \u1085  \u1085 \u1072 \'a0\u1087 \u1091 \u1095 \u1077 \u1083 . \u1058 \u1099 \u1088 \u1086  \u1088 \u1101 \u1085 \u1076 \u1086  \u1075 \u1091 \u1088 \u1091 \u1074 \u1086 \u1088 \u1101 \u1089 \u1082 \u1080 \u1088 \u1086 .\cb1 \
\cb3 \uc0\u1053 \u1072 \'a0\u1091 \u1093 \u1090 \u1099 \u1083 \u1101 \u1083 , \u1089 \u1086 \u1073 \u1099  \u1083 \u1101 \u1089  \u1090 \u1101  \u1089 \u1099 \u1082 \u1083 \u1103 \u1082 \u1080 \u1088 \u1101 \u1083  \u1080 \'a0\u1050 \u1083 \u1072 \u1074 \u1076 \u1103 \u1082 \u1080 \u1088 \u1086  \u1095 \u1072 \u1074 \u1086 \u1088 \u1086 . \u1045 \u1089 \u1083 \u1080  \u1089 \u1072 \u1088 \u1101 \u1085  \u1076 \u1103 \u1082 \u1101  \u1090 \u1101  \u1088 \u1086 \u1079 \u1084 \u1101 \u1082 \u1101 \u1089 , \u1090 \u1086  \u1089 \u1099 \u1075 \u1086  \u1082 \u1086 \u1083 \u1099 \u1085 \u1099 \u1090 \u1082 \u1072  \u1095 \u1072 \u1074 \u1086 \u1088 \u1101  \u1083 \u1101 \u1085 \u1072  \u1090 \u1101  \u1089 \u1099 \u1082 \u1083 \u1103 \u1082 \u1080 \u1088 \u1101 \u1085  \u1089 \u1086 \'a0\u1083 \u1101 \u1089 \u1082 \u1101  \u1090 \u1101  \u1082 \u1101 \u1088 \u1101 \u1083 .\cb1 \
\cb3 \'96\'a0\uc0\u1058 \u1088 \u1072 \u1076 \u1101  \u1087 \u1101  \u1090 \u1072 \u1089 \u1103 , \u1080 \'a0\u1089 \u1083 \u1101  \u1089 \u1084 \u1077 \u1088 \u1086 \u1082 ,\'a0\'96 \u1095 \u1102 \u1088 \u1076 \u1099 \u1103  \u1087 \u1088 \u1077 \u1076 \u1089 \u1077 \u1076 \u1072 \u1090 \u1077 \u1083 \u1105  \u1041 \u1091 \u1076 \u1091 \u1083 \u1072 \u1105 \u1089 \u1082 \u1101 . \u1054 \u1073 \u1088 \u1080 \u1089 \u1080 \u1103 \u1087 \u1101  \u1082 \u1086  \u1095 \u1072 \u1074 \u1086 \u1088 \u1086 , \u1080 \'a0\u1087 \u1093 \u1101 \u1085 \u1076 \u1103 :\cb1 \
\cb3 \'96\'a0\uc0\u1040 \'a0\u1090 \u1091  \u1087 \u1101  \u1090 \u1072 \u1089 \u1103  \u1076 \u1078 \u1103  \u1076 \u1088 \u1086  \u1073 \u1088 \u1080 \u1075 \u1072 \u1076 \u1072  \u1087 \u1088 \u1080 \u1094 \u1077 \u1087 \u1097 \u1080 \u1082 \u1086 \u1089 \u1072 . \u1054 \u1076 \u1086 \u1081  \u1085 \u1072 \u1085 \u1101  \u1087 \u1088 \u1080 \u1094 \u1077 \u1087 \u1097 \u1080 \u1082 \u1101 \u1085 . \u1040 \u1076 \u1072 \u1088 \u1080 \u1082  \u1073 \u1080 \u1095 \u1103 \u1074 \u1072 \u1074 \u1072  \u1084 \u1086 \u1083 \u1086 \u1090 \u1086 \u1073 \u1086 \u1081 \u1094 \u1072 .\cb1 \
\cb3 \uc0\u1025 \u1074  \u1082 \u1072 \u1084 \u1100 \u1103  \u1090 \u1101  \u1074 \u1099 \u1076 \u1078 \u1103 \u1083 , \u1085 \u1101  \u1076 \u1088 \u1101  \u1087 \u1086 \u1088 \u1090 \u1072  \u1091 \u1096 \u1091 \u1085 \u1076 \u1103 :\cb1 \
\cb3 \'96\'a0\uc0\u1044 \u1103 \u1076 \u1077 \u1085 \u1100 \u1082 \u1072  \u1087 \u1088 \u1077 \u1076 \u1089 \u1077 \u1076 \u1072 \u1090 \u1077 \u1083 \u1105 , \u1087 \u1086 \u1078 \u1072 \u1083 \u1091 \u1081 \u1089 \u1090 \u1072 , \u1085 \u1072 \'a0\u1073 \u1080 \u1095 \u1103 \u1074 \u1101 \u1085 \u1090 \u1080  \u1084 \u1072 \u1085  \u1082 \u1091 \u1079 \u1085 \u1103 \u1090 \u1099 \u1088 !\cb1 \
\cb3 \uc0\u1055 \u1072 \u1083 \u1086 \u1076 \u1086 \u1074 \u1072  \u1080 \'a0\u1041 \u1091 \u1076 \u1091 \u1083 \u1072 \u1105  \u1087 \u1086 \u1084 \u1072 \u1085 \u1075 \u1076 \u1103 :\cb1 \
\cb3 \'96\'a0\uc0\u1053 \u1072 \'a0\u1095 \u1077 \u1081 \u1085 \u1086 , \u1058 \u1080 \u1084 \u1086 \u1092 \u1077 \u1105  \u1048 \u1083 \u1100 \u1080 \u1095 \u1105 , \u1086 \u1073 \u1080 \u1076 \u1099  \u1090 \u1101  \u1082 \u1101 \u1088 \u1101 \u1089  \u1095 \u1072 \u1074 \u1086 \u1088 \u1101 \u1089 \u1082 \u1101 . \u1025 \u1074  \u1080 \'a0\u1076 \u1103 \u1082 \u1101  \u1095 \u1105 \u1088 \u1072 \u1093 \u1072 \u1085 \u1101 \u1089  \u1076 \u1072 \u1090 \u1099 \u1088  \u1093 \u1086 \u1076 \u1080 \u1085 \u1101 \u1083  \u1072 \u1076 \u1072 \u1088 \u1080 \u1082 . \u1025 \u1081  \u1089 \u1086 \u1089 \u1090 \u1099 \u1088  \u1079 \u1072 \u1087 \u1093 \u1101 \u1085 \u1076 \u1103  \u1083 \u1101 \u1089 \u1082 \u1101 . \u1040 \'a0\u1095 \u1072 \u1074 \u1086  \u1089 \u1084 \u1099 \u1096 \u1083 \u1105 \u1085 \u1086 .\cb1 \
\cb3 \uc0\u1041 \u1091 \u1076 \u1091 \u1083 \u1072 \u1105  \u1087 \u1086 \u1095 \u1102 \u1076 \u1103  \u1074 \u1072 \u1089 \u1090  \u1087 \u1088 \u1086  \u1042 \u1072 \u1085 \u1103 \u1089 \u1082 \u1080 \u1088 \u1086  \u1096 \u1101 \u1088 \u1086 .\cb1 \
\cb3 \'96\'a0\uc0\u1045 \u1097 \u1105  \u1073 \u1101 \u1088 \u1096  \u1072 \u1076 \u1072 \u1081  \u1087 \u1086 \u1082 \u1088 \u1101 \u1085 \u1094 \u1080 \u1085 \u1101 \u1083 \u1072 \u1087 \u1101 , \u1080 \'a0\u1074 \u1099 \u1076 \u1078 \u1103 \u1083 \u1072  \u1083 \u1072 \u1095 \u1105  \u1082 \u1086 \u1074 \u1072 \u1083 \u1105 . \u1040 \'a0\u1087 \u1086 \u1088 \u1090 \u1099  \u1089 \u1074 \u1080 \u1085 \u1072 \u1088 \u1085 \u1080 \u1082 \u1086 \u1089 \u1090 \u1101  \u1089 \u1082 \u1101 \u1088 \u1072 \u1074 \u1072  \u1076 \u1072 \u1089 \u1072 \u1074 \u1101 , \u1089 \u1086 \'a0\u1087 \u1091 \u1096 \u1082 \u1072 \u1089 \u1072  \u1085 \u1072 \'a0\u1087 \u1088 \u1086 \u1084 \u1072 \u1088 \u1101 \u1089 \u1072 .\cb1 \
\cb3 \uc0\u1058 \u1080 \u1084 \u1086 \u1092 \u1077 \u1105  \u1048 \u1083 \u1100 \u1080 \u1095 \u1105  \u1085 \u1072 \'a0\u1089 \u1099 \u1089  \u1093 \u1086 \u1083 \u1103 \u1084 \u1086  \u1084 \u1072 \u1085 \u1091 \u1096 . \u1055 \u1086 \u1076 \u1091 \u1084 \u1080 \u1085 \u1076 \u1103 , \u1085 \u1072 \'a0\u1103 \u1074 \u1101 \u1083 \u1072 \'a0\u1083 \u1080  \u1072 \u1076 \u1072 , \u1089 \u1086 \'a0\u1089 \u1083 \u1099 \u1076 \u1078 \u1080 \u1103  \u1089 \u1095 \u1105 \u1090 \u1099  \u1050 \u1083 \u1072 \u1074 \u1076 \u1103 \u1089 \u1072 ? \u1069 \u1085 \u1072 , \u1089 \u1072 \u1074 \u1080  \u1075 \u1072 \u1076 \u1080 ! \u1048 \'a0\u1095 \u1072 \u1074 \u1101 \u1089 \u1082 \u1101  \u1085 \u1072 \u1085 \u1101  \u1074 \u1086 \u1083 \u1103  \u1083 \u1072 \u1090 \u1099 \u1088 ! \u1057 \u1086 \u1073  \u1083 \u1072 \u1083  \u1072 \u1076 \u1072 \u1074 \u1072  \u1087 \u1088 \u1077 \u1076 \u1089 \u1077 \u1076 \u1072 \u1090 \u1077 \u1083 \u1105  \u1089 \u1099 \u1089  \u1083 \u1072 \u1082 \u1101  \u1089 \u1086 \u1102 \u1079 \u1085 \u1080 \u1082 \u1086 \u1089 \u1072 ?! \u1053 \u1072 \'a0\u1103 \u1074 \u1101 \u1083 \u1072  \u1076 \u1103 \u1082 \u1101 ! \u1040 \'a0\u1074 \u1076 \u1088 \u1091 \u1075 , \u1095 \u1103 \u1095 \u1105 , \u1074 \u1099 \u1076 \u1078 \u1103 \u1083 \u1072  \u1083 \u1101 \u1089 \u1090 \u1099 \u1088  \u1083 \u1072 \u1095 \u1105  \u1082 \u1086 \u1074 \u1072 \u1083 \u1105 ? \u1055 \u1086 \u1078 \u1072 \u1083 \u1080 \u1085 \u1076 \u1103 . \u1053 \u1072 \'a0\u1086 \u1073 \u1088 \u1080 \u1089 \u1080 \u1103 \u1087 \u1101 , \u1095 \u1102 \u1088 \u1076 \u1099 \u1103 :\cb1 \
\cb3 \'96\'a0\uc0\u1053 \u1101 , \u1089 \u1099 \u1088  \u1082 \u1072 \u1084 \u1101 \u1089 .\'a0\'96 \u1080 \'a0\u1074 \u1099 \u1075 \u1101 \u1103  \u1082 \u1091 \u1079 \u1085 \u1103 \u1090 \u1099 \u1088 .\cb1 \
\cb3 \uc0\u1041 \u1091 \u1076 \u1091 \u1083 \u1072 \u1105  \u1088 \u1080 \u1082 \u1080 \u1088 \u1076 \u1103  \u1074 \u1072 \u1089 \u1090  \u1087 \u1088 \u1086  \u1095 \u1072 \u1074 \u1101 \u1089 \u1082 \u1080 \u1088 \u1086  \u1096 \u1101 \u1088 \u1086 , \u1089 \u1087 \u1091 \u1095 \u1100 \u1103 :\cb1 \
\cb3 \'96\'a0\uc0\u1050 \u1101 \u1076 \u1101 , \u1090 \u1091 , \u1042 \u1072 \u1085 \u1103 , \u1088 \u1072 \u1082 \u1080 \u1088 \u1101 \u1089 , \u1073 \u1080 \u1103 \u1085 \u1076 \u1103 \u1085 \u1087 \u1101 ?\cb1 \
\cb3 \'96\'a0\uc0\u1044 \u1074 \u1072 \u1076 \u1094 \u1072 \u1090 \u1100 \'a0 \u1087 \u1103 \u1090 \u1086 \u1075 \u1086 \'a0 \u1080 \u1102 \u1083 \u1103 . \u1050 \u1072 \u1085 \u1072 \'a0 \u1091 \u1078 \u1077  \u1090 \u1099 \u1082 \u1085 \u1101 \u1076 \u1099 \u1088 ,\'a0\'96 \u1080 \'a0\u1095 \u1072 \u1074 \u1086  \u1088 \u1086 \u1089 \u1087 \u1093 \u1101 \u1085 \u1076 \u1103 :\cb1 \
\cb3 \'96\'a0\uc0\u1040 \u1084 \u1101 \u1085  \u1053 \u1102 \u1088 \u1082 \u1072 \u1089 \u1072  \u1076 \u1072 \u1081  \u1076 \u1088 \u1101  \u1082 \u1091 \u1082 \u1091 \u1088 \u1091 \u1079 \u1072  \u1073 \u1080 \u1103 \u1085 \u1076 \u1103 , \u1082 \u1101 \u1076 \u1101  \u1075 \'92\u1072 \u1088 \u1072 \u1076 \u1105 \u1085 \u1072 \u1089  \u1085 \u1077 \u1084 \u1077 \u1094 \u1082 \u1086 \u1085 \u1101 \u1089 \u1090 \u1099 \u1088  \u1090 \u1072 \u1085 \u1082 \u1086 \u1089 \u1090 \u1099 \u1088 . \u1025 \u1081  \u1091 \u1076 \u1099 \u1082 \u1093 \u1090 \u1103 , \u1089 \u1099 \u1088  \u1085 \u1077 \u1084 \u1077 \u1094 \u1082 \u1086  \u1090 \u1072 \u1085 \u1082 \u1086  \u1088 \u1072 \u1089 \u1090 \u1072 \u1089 \u1072 \u1076 \u1103  \u1088 \u1086 \u1084 \u1072 \u1085 \u1099  \u1082 \u1080 \u1073 \u1080 \u1090 \u1082 \u1072 , \u1080 \'a0\u1073 \u1080 \u1103 \u1085 \u1076 \u1103  \u1072 \u1084 \u1101 \u1085 .\cb1 \
\cb3 \uc0\u1042 \u1085 \u1077 \u1079 \u1072 \u1087 \u1085 \u1086  \u1087 \u1086 \u1095 \u1091 \u1080 \u1085 \u1076 \u1103 , \u1089 \u1099 \u1088  \u1079 \u1072 \u1080 \u1079 \u1076 \u1088 \u1072 \u1085 \u1076 \u1099 \u1103  \u1041 \u1091 \u1076 \u1091 \u1083 \u1072 \u1105 \u1089 \u1082 \u1080 \u1088 \u1086  \u1074 \u1072 \u1089 \u1090  \u1087 \u1088 \u1086  \u1096 \u1101 \u1088 \u1086 , \u1091 \u1076 \u1080 \u1074 \u1083 \u1105 \u1085 \u1085 \u1086  \u1075 \'92\u1072 \u1079 \u1076 \u1099 \u1103  \u1103 \u1082 \u1093 \u1072 . \u1041 \u1091 \u1076 \u1091 \u1083 \u1072 \u1105  \u1086 \u1090 \u1088 \u1080 \u1089 \u1082 \u1080 \u1088 \u1076 \u1103  \u1086 \'a0\u1084 \u1091 \u1081 , \u1080 \'a0\u1089 \u1083 \u1099 \u1103  \u1074 \u1072 \u1089 \u1090 .\cb1 \
\cb3 \uc0\u1041 \u1091 \u1076 \u1091 \u1083 \u1072 \u1105  \u1090 \u1088 \u1072 \u1076 \u1099 \u1103  \u1087 \u1072 \u1083 \u1086  \u1044 \u1086 \u1085 \u1086 , \u1089 \u1099 \u1088  \u1087 \u1093 \u1101 \u1085 \u1076 \u1103  \u1087 \u1088 \u1077 \u1076 \u1089 \u1077 \u1076 \u1072 \u1090 \u1077 \u1083 \u1105 \u1089 \u1082 \u1101 . \u1055 \u1077 \u1088 \u1074 \u1086  \u1084 \u1072 \u1085 \u1091 \u1096 , \u1082 \u1086 \u1085 \u1101 \u1089  \u1091 \u1076 \u1099 \u1082 \u1093 \u1090 \u1103  \u1086 \u1076 \u1086 \u1081 , \u1089 \u1099 \u1089  \u1050 \u1083 \u1072 \u1074 \u1076 \u1103 . \u1025 \u1074  \u1075 \u1101 \u1103  \u1090 \u1088 \u1086 \u1087 \u1080 \u1085 \u1082 \u1072 \u1089 \u1072  \u1084 \u1072 \u1096 \u1082 \u1080 \u1088  \u1082 \u1072 \u1096 \u1090 \u1072  \u1082 \u1086  \u1089 \u1074 \u1080 \u1085 \u1072 \u1088 \u1085 \u1080 \u1082 \u1086 , \u1072 \'a0\u1105 \u1081  \u1075 \u1101 \u1103  \u1074 \u1101 \u1076 \u1088 \u1072 \u1089 \u1072  \u1087 \u1072 \u1083 \u1086  \u1087 \u1072 \u1085 \u1099  \u1082 \u1086  \u1044 \u1086 \u1085 \u1086 . \u1025 \u1074  \u1087 \u1077 \u1088 \u1074 \u1086  \u1091 \u1076 \u1099 \u1082 \u1093 \u1090 \u1103  \u1083 \u1072 . \u1025 \u1081  \u1085 \u1072 \'a0\u1076 \u1078 \u1080 \u1085 \u1101 \u1083 \u1072 \u1089 , \u1089 \u1086 \'a0\u1105 \u1074  \u1083 \u1072  \u1076 \u1099 \u1082 \u1093 \u1101 \u1083 , \u1075 \u1101 \u1103  \u1087 \u1101 \u1089 \u1082 \u1101  \u1090 \u1088 \u1086 \u1087 \u1080 \u1085 \u1082 \u1072 \u1089 \u1072  \u1082 \u1086  \u1088 \u1101 \u1082 \u1072 . \u1025 \u1081  \u1085 \u1072 \u1085 \u1101  \u1089 \u1099 \u1075 \u1086  \u1091 \u1076 \u1099 \u1082 \u1093 \u1090 \u1103  \u1083 \u1101 \u1089 . \u1043 \u1101 \u1103  \u1079 \u1084 \u1101 \u1082 \u1080  \u1096 \u1101 \u1088 \u1086 , \u1076 \u1099 \u1082 \u1093 \u1101 \u1083  \u1090 \u1101 \u1083 \u1086  \u1075 \'92\u1101 \u1088 \u1072  \u1087 \u1101 \u1089 \u1082 \u1101 . \u1043 \u1101 \u1103  \u1085 \u1072 \'a0\u1089 \u1099 \u1075 \u1101 \u1089 . \u1025 \u1081  \u1089 \u1086 \'a0\'96 \u1090 \u1086  \u1076 \u1091 \u1084 \u1080 \u1085 \u1101 \u1083 \u1072 \u1089 . \u1051 \u1072 \u1082 \u1101  \u1076 \u1078 \u1103 \u1083 \u1072 \u1089  \u1087 \u1072 \u1088 \u1085 \u1086  \u1093 \u1072 \u1083 \u1072 \u1090 \u1086 . \u1041 \u1091 \u1076 \u1091 \u1083 \u1072 \u1105  \u1091 \u1076 \u1099 \u1082 \u1093 \u1090 \u1103  \u1087 \u1077 \u1088 \u1074 \u1086  \u1084 \u1086 \u1083 \u1086  \u1087 \u1088 \u1101  \u1083 \u1072 \u1090 \u1101 . \u1025 \u1074  \u1075 \u1101 \u1103  \u1082 \u1101  \u1105 \u1081 . \u1050 \u1076 \u1072 \u1074 \u1076 \u1103  \u1087 \u1086 \u1089 \u1099 \u1082 \u1072 \u1076 \u1103 \u1087 \u1101  \u1083 \u1101 \u1089 \u1082 \u1101  \u1090 \u1101 \u1088 \u1085 \u1099 , \u1073 \u1077 \u1079 \u1079 \u1072 \u1097 \u1080 \u1090 \u1085 \u1086 . \u1044 \u1088 \u1080 \u1074 \u1072 \u1085  \u1079 \u1072 \u1082 \u1072 \u1084 \u1100 \u1103  \u1090 \u1101  \u1076 \u1078 \u1080 \u1085 \u1101 \u1083 , \u1089 \u1086 \'a0\u1105 \u1081  \u1076 \u1091 \u1084 \u1080 \u1085 \u1101 \u1083 . \u1041 \u1091 \u1076 \u1091 \u1083 \u1072 \u1105  \u1085 \u1072 \'a0\u1079 \u1072 \u1082 \u1072 \u1084 \u1100 \u1103  \u1084 \u1077 \u1096 \u1072 \u1090 \u1100 , \u1080 \'a0\u1089 \u1075 \u1101 \u1103  \u1090 \u1088 \u1086 \u1087 \u1080 \u1085 \u1082 \u1072 \u1090 \u1099 \u1088 . \u1059 \u1096 \u1090 \u1099 \u1103  \u1087 \u1072 \u1083 \u1086  \u1082 \u1072 \u1096 \u1090 . \u1040 \u1076 \u1072 \u1081  \u1050 \u1083 \u1072 \u1074 \u1076 \u1103  \u1075 \'92\u1072 \u1079 \u1076 \u1099 \u1103  \u1103 \u1082 \u1093 \u1072 , \u1091 \u1076 \u1099 \u1082 \u1093 \u1103  \u1083 \u1101 \u1089 , \u1080 \'a0\u1088 \u1072 \u1076 \u1103  \u1074 \u1101 \u1076 \u1088 \u1072 .\cb1 \
\cb3 \'96\'a0\uc0\u1054 \u1081 !\cb1 \
\cb3 \uc0\u1042 \u1090 \u1086 \u1088 \u1086  \u1084 \u1086 \u1083 \u1086  \u1105 \u1085 \u1101  \u1074 \u1089 \u1090 \u1088 \u1101 \u1085 \u1080 \u1085 \u1076 \u1083 \u1101 \u1087 \u1101 \u1089 , \u1080 \'a0\u1089 \u1072 \u1088 \u1086  \u1087 \u1088 \u1101  \u1082 \u1072 \u1096 \u1091 \u1082 \u1086  \u1090 \u1088 \u1086 \u1087 \u1080 \u1085 \u1082 \u1072 .\cb1 \
\cb3 \'96\'a0\uc0\u1053 \u1077 \u1091 \u1078 \u1077 \u1083 \u1080  \u1084 \u1101  \u1076 \u1072 \u1089 \u1072 \u1074 \u1086  \u1076 \u1072 \u1088 \u1072 \u1085 \u1086 ?\'a0\'96 \u1089 \u1087 \u1091 \u1095 \u1100 \u1103  \u1041 \u1091 \u1076 \u1091 \u1083 \u1072 \u1105 ,\'a0\'96 \u1057 \u1086 \u1089 \u1090 \u1099 \u1088  \u1090 \u1091 \u1084 \u1101  \u1084 \u1072 \u1085 \u1076 \u1099 \u1088  \u1076 \u1072 \u1088 \u1101 \u1085 \u1072 ?\cb1 \
\cb3 \'96\'a0\uc0\u1052 \u1101  \u1090 \u1091 \u1084 \u1101 \u1085 \u1076 \u1099 \u1088  \u1085 \u1072 \'a0\u1076 \u1072 \u1088 \u1072 \u1074 \u1087 \u1101 ,\'a0\'96 \u1087 \u1093 \u1101 \u1085 \u1076 \u1103  \u1050 \u1083 \u1072 \u1074 \u1076 \u1103 .\cb1 \
\cb3 \uc0\u1025 \u1081  \u1076 \u1077 \u1081 \u1089 \u1090 \u1074 \u1080 \u1090 \u1077 \u1083 \u1100 \u1085 \u1086  \u1089 \u1075 \u1086 \u1076 \u1083 \u1099 \u1103  \u1086 \u1090 \'a0\u1085 \u1077 \u1086 \u1078 \u1080 \u1076 \u1072 \u1085 \u1085 \u1086 \u1089 \u1090 \u1080 .\cb1 \
\cb3 \'96\'a0\uc0\u1047 \u1085 \u1072 \u1095 \u1080 \u1090 , \u1084 \u1072 \u1085 \u1075 \u1101  \u1087 \u1086 \u1089 \u1099 \u1082 \u1072 \u1076 \u1099 \u1103 \u1087 \u1101 ,\'a0\'96 \u1083 \u1086 \u1082 \u1093 \u1080 \u1087 \u1101 \u1089 \u1072  \u1087 \u1093 \u1101 \u1085 \u1076 \u1103  \u1041 \u1091 \u1076 \u1091 \u1083 \u1072 \u1105 , \u1075 \'92\u1072 \u1079 \u1076 \u1099 \u1103  \u1083 \u1072 \u1082 \u1101  \u1074 \u1101 \u1076 \u1088 \u1072 .\'a0\'96 \u1052 \u1101  \u1075 \'92\u1072 \u1088 \u1072  \u1082 \u1072 \u1084 \u1072 \u1084  \u1090 \u1091 \u1084 \u1101 \u1085  \u1090 \u1101  \u1089 \u1087 \u1091 \u1095 \u1072 \u1074 ,\'a0\'96 \u1075 \u1083 \u1086 \u1089  \u1072 \u1095 \u1100 \u1103  \u1089 \u1072 \u1088 \u1101 \u1089 \u1072  \u1082 \u1072 \u1096 \u1091 \u1082 \u1080 ,\'a0\'96 \u1058 \u1091 \u1084 \u1101 , \u1088 \u1072 \u1082 \u1080 \u1088 \u1101 \u1085 , \u1076 \u1099 \u1082 \u1093 \u1085 \u1101 , \u1089 \u1099 \u1088  \u1087 \u1072 \u1083 \u1086  \u1093 \u1091 \u1090 \u1086 \u1088 \u1086  \u1085 \u1077 \u1084 \u1077 \u1094 \u1082 \u1086  \u1090 \u1072 \u1085 \u1082 \u1086  \u1088 \u1086 \u1089 \u1090 \u1072 \u1089 \u1072 \u1076 \u1103  \u1088 \u1086 \u1084 \u1072 \u1085 \u1099  \u1082 \u1080 \u1073 \u1080 \u1090 \u1082 \u1072 . \u1058 \u1091 \u1084 \u1101  \u1085 \u1072 \'a0\u1088 \u1080 \u1087 \u1080 \u1088 \u1101 \u1085 , \u1082 \u1086 \u1085  \u1077 \u1097 \u1105  \u1086 \u1076 \u1086 \u1081  \u1089 \u1099 \u1089  \u1087 \u1072 \u1096 \u1101  \u1082 \u1080 \u1073 \u1080 \u1090 \u1082 \u1072 ?\cb1 \
\cb3 \uc0\u1053 \u1072 \'a0\u1075 \'92\u1072 \u1079 \u1076 \u1099 \u1080  \u1103 \u1082 \u1093 \u1072 , \u1050 \u1083 \u1072 \u1074 \u1076 \u1103  \u1087 \u1093 \u1101 \u1085 \u1076 \u1103 :\cb1 \
\cb3 \'96\'a0\uc0\u1054 \u1076 \u1086 \u1081  \u1089 \u1099 \u1089  \u1087 \u1093 \u1091 \u1088 \u1086 \u1084  \u1080 \'a0\u1090 \u1101 \u1088 \u1085 \u1099  \u1088 \u1086 \u1084 \u1085 \u1099 . \u1041 \u1091 \u1090 \u1099 \u1088  \u1084 \u1101  \u1085 \u1080 \u1095 \u1080  \u1085 \u1072 \'a0\u1076 \u1099 \u1082 \u1090 \u1105 \u1084 \'85\cb1 \
\cb3 \'96\'a0\uc0\u1052 \u1101  \u1076 \u1078 \u1080 \u1085 \u1086 \u1084 ,\'a0\'96 \u1087 \u1093 \u1101 \u1085 \u1076 \u1103  \u1105 \u1074  \u1089 \u1086 \u1095 \u1091 \u1089 \u1090 \u1074 \u1080 \u1105 \u1089 \u1072 ,\'a0\'96 \u1048 \'a0\u1077 \u1097 \u1105  \u1084 \u1101  \u1090 \u1091 \u1084 \u1101 \u1085  \u1084 \u1072 \u1085 \u1075 \u1072 \u1074 , \u1085 \u1072 \'a0\u1079 \u1072 \u1087 \u1093 \u1101 \u1085 \u1101 \u1085 \u1090 \u1080  \u1042 \u1072 \u1085 \u1103 \u1089 \u1082 \u1101  \u1076 \u1088 \u1101  \u1082 \u1091 \u1079 \u1085 \u1103  \u1090 \u1101  \u1079 \u1072 \u1076 \u1078 \u1103 \u1083 . \u1025 \u1074  \u1089 \u1084 \u1099 \u1096 \u1083 \u1105 \u1085 \u1086 .\cb1 \
\cb3 \uc0\u1025 \u1074  \u1074 \u1077 \u1078 \u1083 \u1080 \u1074 \u1086  \u1086 \u1073 \u1075 \u1101 \u1103  \u1083 \u1072 , \u1091 \u1075 \u1101 \u1103  \u1076 \u1088 \u1086 \u1084 \u1101 \u1089 \u1072 .\cb1 \
\cb3 \uc0\u1055 \u1093 \u1072 \u1088 \u1086  \u1080 \u1089 \u1099  \u1087 \u1088 \u1080 \u1077 \u1079 \u1078 \u1086 \u1085 \u1101 \u1089 \u1082 \u1101  \u1084 \u1072 \u1085 \u1091 \u1096 \u1101 \u1089 \u1082 \u1101  \u1084 \u1072 \u1096 \u1082 \u1080 \u1088  \u1086 \u1089 \u1090 \u1088 \u1072  \u1087 \u1088 \u1101  \u1095 \u1080 \u1073  \u1082 \u1072 \u1079 \u1072 \u1082 \u1101 \u1085 \u1076 \u1101 , \u1090 \u1077 \u1084  \u1073 \u1086 \u1083 \u1077 \u1077 , \u1077 \u1089 \u1083 \u1080  \u1084 \u1072 \u1085 \u1091 \u1096  \u1088 \u1086 \u1084 . \u1025 \u1085 \u1101  \u1076 \u1091 \u1084 \u1080 \u1085 \u1101 \u1085 \u1072 \u1089  \u1089 \u1086 \'a0\u1073 \u1080 \u1082 \u1093 \u1101 \u1088 \u1080 \u1090 \u1082 \u1086 , \u1083 \u1086 \u1076 \u1099 \u1088 \u1100 . \u1041 \u1091 \u1076 \u1091 \u1083 \u1072 \u1105 \u1089  \u1087 \u1088 \u1080 \u1083 \u1099 \u1085 \u1101  \u1089 \u1099 \u1075 \u1086  \u1089 \u1099 \u1088  \u1087 \u1101 \u1089 \u1082 \u1080 \u1088 \u1101 \u1089  \u1087 \u1072 \u1083  \u1086 \u1076 \u1086 \u1074 \u1072 , \u1089 \u1086 \'a0\u1091 \u1076 \u1099 \u1082 \u1093 \u1085 \u1101 , \u1089 \u1086 \'a0\u1105 \u1074  \u1090 \u1088 \u1091 \u1076 \u1103 \u1075 \u1072 . \u1050 \u1101 \u1076 \u1101  \u1089 \u1099 \u1089  \u1079 \u1072 \u1084 \u1082 \u1086  \u1087 \u1088 \u1101  \u1082 \u1091 \u1079 \u1085 \u1103 , \u1085 \u1072 \'a0\u1089 \u1099 \u1089  \u1082 \u1086 \u1074 \u1072 \u1083 \u1105 \u1089 , \u1080 \'a0\u1076 \u1103 \u1082 \u1101 , \u1093 \u1072 \u1081 , \u1082 \u1091 \u1095 . \u1050 \u1072 \u1085 \u1072 , \u1082 \u1101 \u1076 \u1101  \u1086 \u1090 \u1082 \u1101 \u1088 \u1076 \u1099  \u1094 \u1101 \u1083 \u1072  \u1076 \u1101 \u1074 \u1101 \u1089 \u1072 , \u1084 \u1072 \u1085 \u1091 \u1096 \u1072  \u1087 \u1088 \u1086 \u1090 \u1086 \u1087 \u1072 \u1083 \u1080  \u1076 \u1088 \u1086 \u1084 , \u1083 \u1099 \u1076 \u1078 \u1080 \u1085 \u1101  \u1089 \u1072 \u1088 \u1086  \u1083 \u1101 \u1089 \u1082 \u1101 : \u1075 \u1072 \u1085 \u1076 \u1083 \u1072 \u1076 \u1103 , \u1090 \u1103 \u1087 \u1082 \u1080 , \u1075 \u1088 \u1072 \u1073 \u1083 \u1080 , \u1089 \u1072 \u1088 \u1080  \u1084 \u1077 \u1083 \u1086 \u1095 \u1100 . \u1053 \u1072 \'a0\u1089 \u1099 \u1089  \u1096 \u1090 \u1101 \u1090 \u1086  \u1074 \u1072 \u1096  \u1073 \u1072 \u1088 \u1080 \u1087 \u1101 .\cb1 \
\cb3 \uc0\u1044 \u1078 \u1080 \u1085 \u1076 \u1103  \u1041 \u1091 \u1076 \u1091 \u1083 \u1072 \u1105  \u1089 \u1099 \u1088  \u1079 \u1072 \u1082 \u1072 \u1083 \u1080 \u1090 \u1100 . \u1044 \u1072 \u1078 \u1077  \u1076 \u1088 \u1101  \u1089 \u1090 \u1072 \u1085 \u1080 \u1094 \u1072  \u1085 \u1072 \'a0\u1076 \u1078 \u1080 \u1085 \u1101 \u1085 \u1072 \u1089  \u1090 \u1101  \u1082 \u1101 \u1088 \u1101 \u1085  \u1092 \u1101 \u1076 \u1099 \u1088 . \u1044 \u1072 \u1089 \u1072 \u1074 \u1086  \u1089 \u1077 \u1082 \u1088 \u1077 \u1090 \u1086  \u1087 \u1077 \u1088 \u1077 \u1076 \u1099 \u1103  \u1083 \u1101 \u1089 \u1082 \u1101  \u1076 \u1072 \u1076 , \u1072 \'a0\u1083 \u1101 \u1089 \u1082 \u1101  \u1083 \u1101 \u1089 \u1082 \u1080 \u1088 \u1086  \u1076 \u1072 \u1076 . \u1050 \u1072 \u1084 \u1101 \u1083 \u1072 \u1089  \u1090 \u1101  \u1087 \u1077 \u1088 \u1077 \u1076 \u1101 \u1083  \u1083 \u1101 \u1089  \u1074 \u1072 \u1074 \u1088 \u1101 \u1085 \u1075 \u1101 \'a0\'96 \u1085 \u1072 \'a0\u1074 \u1099 \u1076 \u1078 \u1103 \u1083 . \u1055 \u1088 \u1072 \u1074 \u1080 \u1083 \u1100 \u1085 \u1101 \u1089  \u1088 \u1086 \u1089 \u1087 \u1093 \u1101 \u1085 \u1101 \u1083 \u1072  \u1084 \u1072 \u1085 \u1091 \u1096 , \u1072 \'a0\u1089 \u1099 \u1088  \u1090 \u1101  \u1082 \u1101 \u1088 \u1101 \u1089 \'a0\'96 \u1089 \u1072  \u1077 \u1082 \u1093  \u1085 \u1072 \'a0\u1076 \u1103 \u1082 \u1101 . \u1053 \u1072 \u1073 \u1091 \u1090 \u1082 \u1072 , \u1072 \'a0\u1085 \u1072 \'a0\u1076 \u1103 \u1082 \u1101 . \u1025 \u1074  \u1085 \u1072 \'a0\u1085 \u1072 \u1096 \u1072 \u1074 \u1101 \u1083  \u1085 \u1072 \u1076 \u1077 \u1078 \u1076 \u1072  \u1090 \u1101  \u1087 \u1077 \u1088 \u1077 \u1076 \u1101 \u1083  \u1082 \u1101 \u1076 \u1101 \'a0\'96 \u1085 \u1080 \u1073 \u1091 \u1076 \u1100  \u1089 \u1077 \u1082 \u1088 \u1077 \u1090 \u1086  \u1074 \u1072 \u1074 \u1088 \u1101 \u1089 \u1082 \u1101 . \u1040 \u1085 \u1075 \u1080 \u1083  \u1076 \u1091 \u1084 \u1080 \u1085 \u1101 \u1083 \u1072 \u1089  \u1090 \u1101  \u1087 \u1077 \u1088 \u1077 \u1076 \u1101 \u1089  \u1087 \u1101 \u1089 \u1082 \u1080 \u1088 \u1101 \u1089 \u1082 \u1101  \u1095 \u1072 \u1074 \u1101 \u1089 \u1082 \u1101 . \u1056 \u1072 \u1085 \u1085 \u1077 \u1081  \u1074 \u1077 \u1089 \u1085 \u1086 \u1081  \u1083 \u1101 \u1089 \u1082 \u1080 \u1088 \u1080  \u1088 \u1086 \u1084 \u1085 \u1099  \u1043 \u1072 \u1083 \u1103  \u1087 \u1093 \u1101 \u1085 \u1076 \u1103 , \u1089 \u1086 \'a0\u1103 \u1074 \u1101 \u1083 \u1072  \u1095 \u1072 \u1074 \u1086 \u1088 \u1086 . \u1042 \u1072 \u1074 \u1088 \u1101 \u1089  \u1080 \'a0\u1090 \u1101  \u1072 \u1074 \u1101 \u1083  \u1085 \u1077 \'a0\u1084 \u1086 \u1075 \u1083 \u1086 . \u1057 \u1072 \u1088 \u1101  \u1076 \u1088 \u1086  \u1088 \u1086 \u1076 \u1086  \u1089 \u1099 \u1089  \u1082 \u1086 \u1074 \u1072 \u1083 \u1080 . \u1044 \u1103 \u1082 \u1101  \u1080 \'a0\u1091 \u1075 \u1101 \u1103  \u1087 \u1088 \u1086  \u1084 \u1072 \u1088 \u1080 \u1073 \u1101 . \u1052 \u1072 \u1085 \u1075 \u1100 \u1103  \u1083 \u1101 \u1085  \u1090 \u1101  \u1076 \u1078 \u1103 \u1085  \u1082 \u1072 \u1081  \u1073 \u1077 \u1079 \u1086 \u1087 \u1072 \u1089 \u1085 \u1086 , \u1090 \u1101  \u1088 \u1072 \u1082 \u1093 \u1101 \u1083  \u1095 \u1072 \u1074 \u1101 \u1089 . \u1055 \u1093 \u1101 \u1085 \u1076 \u1103 : \'ab\'96 \u1052 \u1101  \u1090 \u1091 \u1084 \u1101 \u1085  \u1083 \u1072 \u1090 \u1093 \u1072 \u1074 \u1072 . \u1056 \u1086 \u1084  \u1088 \u1086 \u1084 \u1101 \u1089 \u1082 \u1101  \u1087 \u1086 \u1089 \u1099 \u1082 \u1072 \u1076 \u1105 \u1083 \u1072  \u1076 \u1088 \u1086 \u1084 \'bb. \u1053 \u1072 \'a0\u1091 \u1076 \u1099 \u1082 \u1093 \u1090 \u1103 , \u1089 \u1099 \u1088  \u1043 \u1072 \u1083 \u1103  \u1087 \u1099 \u1103  \u1087 \u1088 \u1086  \u1095 \u1103 \u1085 \u1075 \u1072 , \u1087 \u1088 \u1086 \u1090 \u1099 \u1088 \u1076 \u1099 \u1103  \u1082 \u1101  \u1105 \u1074  \u1074 \u1072 \u1089 \u1090 \u1072 , \u1072 \'a0\u1087 \u1093 \u1091 \u1088 \u1086 \u1084 , \u1083 \u1101 \u1089 \u1082 \u1080 \u1088 \u1086  \u1082 \u1072 \u1096 \u1091 \u1082 \u1086  \u1076 \u1072 \u1076 , \u1076 \u1099 \u1103  \u1083 \u1072 \u1082 \u1101  \u1087 \u1072 \u1085 \u1099 .\cb1 \
\cb3 \uc0\u1041 \u1091 \u1090  \u1076 \u1088 \u1086 \u1084 \u1072  \u1105 \u1074  \u1087 \u1088 \u1086 \u1075 \u1101 \u1103  \u1082 \u1093 \u1101 \u1090 \u1072 \u1085 \u1101  \u1082 \u1072 \u1079 \u1072 \u1082 \u1101 \u1085 \u1094 \u1072  \u1044 \u1086 \u1085 \u1089 \u1082 \u1086 \u1075 \u1086  \u1082 \u1072 \u1074 \u1072 \u1083 \u1077 \u1088 \u1080 \u1081 \u1089 \u1082 \u1086 \u1075 \u1086  \u1082 \u1086 \u1088 \u1087 \u1091 \u1089 \u1072  \u1058 \u1077 \u1088 \u1077 \u1082 \u1086 \u1089 \u1090 \u1099 \u1088  \u1082 \u1101  \u1040 \u1074 \u1089 \u1090 \u1088 \u1080 \u1081 \u1089 \u1082 \u1086  \u1040 \u1083 \u1100 \u1087 \u1099 . \u1055 \u1086 \u1083 \u1079 \u1080 \u1085 \u1101 \u1083 \u1072 \u1089  \u1087 \u1101  \u1080 \u1074 \u1100 \u1103 , \u1095 \u1103 \u1088 , \u1085 \u1072 \'a0\u1089 \u1091 \u1090 \u1103  \u1076 \u1088 \u1101  \u1088 \u1072 \u1079 \u1074 \u1077 \u1076 \u1082 \u1072 , \u1087 \u1072 \u1089 \u1105 \u1083 \u1072 \u1089  \u1076 \u1088 \u1086  \u1075 \u1086 \u1089 \u1087 \u1080 \u1090 \u1072 \u1083 \u1105 . \u1048 \'a0\u1089 \u1072 \u1088 \u1086  \u1074 \u1088 \u1077 \u1084 \u1105  \u1076 \u1078 \u1080 \u1074 \u1101 \u1083 \u1072 \u1089  \u1084 \u1077 \u1095 \u1090 \u1072 \u1089 \u1072 , \u1082 \u1101 \u1076 \u1101  \u1103 \u1074 \u1101 \u1083 \u1072 , \u1083 \u1101 \u1083 \u1072  \u1087 \u1072 \u1083 \u1086  \u1074 \u1072 \u1089 \u1090  \u1087 \u1077 \u1088 \u1074 \u1077 \u1085 \u1094 \u1086 \u1089 , \u1082 \u1086 \u1085 \u1101 \u1089  \u1043 \u1072 \u1083 \u1103 \u1089 \u1072  \u1076 \u1086 \u1088 \u1072 \u1082 \u1080 \u1088 \u1076 \u1101 \u1087 \u1101 \u1089  \u1090 \u1101  \u1082 \u1093 \u1072 \u1088 \u1101 \u1085  \u1042 \u1072 \u1085 \u1103 . \u1044 \u1088 \u1086  \u1087 \u1077 \u1088 \u1074 \u1086  \u1084 \u1086 \u1083 \u1086  \u1087 \u1086 \u1076 \u1083 \u1099 \u1076 \u1078 \u1080 \u1103  \u1083 \u1101 \u1089  \u1082 \u1101  \u1085 \u1072 \u1082 \u1086 \u1074 \u1072 \u1083 \u1100 \u1085 \u1103 . \u1055 \u1086 \u1089 \u1074 \u1103 \u1090 \u1080 \u1090  \u1083 \u1101 \u1089  \u1076 \u1088 \u1101  \u1087 \u1072 \u1087 \u1091 \u1089 \u1082 \u1080 \u1088 \u1086  \u1089 \u1077 \u1082 \u1088 \u1077 \u1090 \u1086 . \u1058 \u1074 \u1105 \u1088 \u1076 \u1086  \u1087 \u1072 \u1090 \u1103 \u1083 \u1072 \u1089  \u1041 \u1091 \u1076 \u1091 \u1083 \u1072 \u1105 , \u1089 \u1086 \'a0\u1042 \u1072 \u1085 \u1103  \u1103 \u1074 \u1101 \u1083 \u1072  \u1082 \u1086 \u1074 \u1072 \u1083 \u1105 \u1089 \u1072 , \u1082 \u1086 \u1085 \u1101 \u1089  \u1085 \u1080 \u1082 \u1086 \u1085  \u1085 \u1072 \'a0\u1076 \u1099 \u1082 \u1093 \u1090 \u1103 . \u1057 \u1099 \u1088  \u1095 \u1102 \u1088 \u1076 \u1101 \u1083 \u1072  \u1087 \u1088 \u1101  \u1087 \u1093 \u1091 \u1074  \u1082 \u1072 \u1088 \u1090 \u1091 \u1079 \u1086 , \u1080 \'a0\u1087 \u1093 \u1101 \u1085 \u1101 \u1083 \u1072 : \'ab\'96 \u1044 \u1072 \u1076 \u1086 , \u1084 \u1101  \u1091 \u1078 \u1077  \u1089 \u1072 \u1088 \u1086  \u1076 \u1078 \u1080 \u1085 \u1072 \u1074 , \u1091 \u1093 \u1090 \u1099 \u1083 \u1072 . \u1050 \u1072 \u1084 \u1072 \u1084  \u1080 \u1085 \u1078 \u1077 \u1085 \u1077 \u1088 \u1086 \u1089 \u1072 -\u1084 \u1077 \u1093 \u1072 \u1085 \u1080 \u1082 \u1086 \u1089 \u1072 \'bb. \u1044 \u1072 \u1089 \u1072 \u1074 \u1101  \u1084 \u1099 \u1089 \u1083 \u1080  \u1089 \u1099 \u1089  \u1076 \u1088 \u1086  \u1096 \u1101 \u1088 \u1086  \u1041 \u1091 \u1076 \u1091 \u1083 \u1072 \u1105 \u1089 \u1090 \u1101 , \u1082 \u1101 \u1076 \u1101  \u1096 \u1091 \u1085 \u1101 \u1083 \u1072 \u1089  \u1088 \u1072 \u1082 \u1080 \u1088 \u1080 \u1073 \u1101  \u1086 \u1076 \u1085 \u1086 \u1087 \u1086 \u1083 \u1095 \u1072 \u1085  \u1087 \u1072 \u1083 \u1101  \u1087 \u1101 \u1089 \u1082 \u1080 \u1088 \u1101  \u1095 \u1072 \u1074 \u1086 \u1088 \u1101 \u1085 . \u1057 \u1086 \u1089 \u1090 \u1099 \u1088  \u1083 \u1101 \u1089 \u1082 \u1080 \u1088 \u1086  \u1095 \u1072 \u1074 \u1086  \u1042 \u1072 \u1085 \u1103  \u1103 \u1074 \u1101 \u1083 \u1072  \u1090 \u1101  \u1082 \u1093 \u1101 \u1083 \u1101 \u1083  \u1087 \u1088 \u1086  \u1090 \u1072 \u1088 \u1075 \u1086  \u1084 \u1072 \u1096 \u1082 \u1080 \u1088  \u1090 \u1086 \u1083 \u1087 \u1072 , \u1090 \u1101  \u1084 \u1072 \u1085 \u1075 \u1101 \u1083  \u1075 \'92\u1072 \u1089 \u1087 \u1088 \u1103 ? \u1044 \u1072 \u1078 \u1077  \u1085 \u1072 \'a0\u1089 \u1086 \u1074 \u1101 \u1083 \u1072 \u1089 , \u1089 \u1099 \u1088  \u1087 \u1086 \u1076 \u1091 \u1084 \u1080 \u1085 \u1101 \u1083 \u1072  \u1076 \u1103 \u1082 \u1101 . \u1025 \u1074  \u1087 \u1086 \u1075 \'92\u1072 \u1088 \u1072 \u1076 \u1103  \u1084 \u1077 \u1095 \u1090 \u1099  \u1076 \u1088 \u1101  \u1092 \u1101 \u1083 \u1076 \u1072 , \u1082 \u1072 \u1081  \u1087 \u1072 \u1096 \u1083 \u1099  \u1043 \u1072 \u1083 \u1103 . \u1052 \u1072 \u1088 \u1080 \u1073 \u1101  \u1086 \u1090 \u1083 \u1099 \u1103  \u1083 \u1101 \u1089 \u1090 \u1099 \u1088  \u1043 \u1072 \u1083 \u1103 . \u1053 \u1080 \u1082 \u1101 \u1076 \u1101  \u1085 \u1072 \'a0\u1103 \u1074 \u1101 \u1083 \u1072  \u1076 \u1103 \u1082 \u1101 , \u1089 \u1099 \u1088  \u1084 \u1077 \u1095 \u1090 \u1072 \u1083  \u1073 \u1080 \u1089 \u1086 \u1080 \u1073 \u1085 \u1099 \u1090 \u1082 \u1072  \u1088 \u1072 \u1090 \u1101 \u1085 \u1094 \u1072 . \u1053 \u1072 \u1085 \u1101  \u1082 \u1086 \u1085 \u1101 \u1089 \u1082 \u1101  \u1090 \u1101  \u1087 \u1077 \u1088 \u1077 \u1076 \u1101 \u1083  \u1074 \u1072 \u1089 \u1090 \u1101 \u1085 \u1076 \u1099 \u1088  \u1076 \u1088 \u1101  \u1074 \u1072 \u1089 \u1090 \u1072  \u1087 \u1101 \u1089 \u1082 \u1080 \u1088 \u1086  \u1089 \u1077 \u1082 \u1088 \u1077 \u1090 \u1086  \u1082 \u1086 \u1074 \u1072 \u1083 \u1105 \u1089 . \u1025 \u1074  \u1080 \u1083 \u1101 \u1089 \u1090 \u1099 \u1088  \u1087 \u1099 \u1090 \u1072 \u1083 \u1089 \u1103  \u1090 \u1101  \u1087 \u1077 \u1088 \u1077 \u1076 \u1101 \u1083 , \u1085 \u1072 \'a0\u1074 \u1099 \u1075 \u1101 \u1103 . \u1053 \u1072 \'a0\u1073 \u1072 \u1096 \u1072 \u1074 \u1101 \u1083  \u1086 \'a0\u1089 \u1072 \u1089 \u1090 \u1099 \u1088 , \u1085 \u1072 \'a0\u1076 \u1078 \u1103 \u1083  \u1087 \u1072 \u1088 \u1072 \u1084 \u1101 \u1089 \u1072 . \u1055 \u1086 \u1082 \u1072  \u1085 \u1072 \'a0\u1103 \u1074 \u1100 \u1103  \u1042 \u1072 \u1085 \u1103 .\cb1 \
\cb3 \uc0\u1050 \u1083 \u1072 \u1074 \u1076 \u1080 \u1103  \u1091 \u1078 \u1077  \u1085 \u1072 \'a0\u1079 \u1072 \u1087 \u1093 \u1101 \u1085 \u1101 \u1083 \u1072 \u1089  \u1087 \u1101 \u1089 \u1082 \u1080 \u1088 \u1101  \u1095 \u1072 \u1074 \u1101 \u1089 \u1082 \u1101  \u1090 \u1101  \u1086 \u1073 \u1076 \u1078 \u1103 \u1083  \u1089 \u1090 \u1088 \u1086 \u1085 \u1072 \u1090 \u1099 \u1088  \u1082 \u1091 \u1079 \u1085 \u1103 . \u1050 \u1072 \u1085 \u1072  \u1105 \u1074  \u1082 \u1072 \u1078 \u1076 \u1086  \u1091 \u1090 \u1088 \u1086  \u1086 \u1090 \u1082 \u1088 \u1099 \u1090 \u1086  \u1089 \u1082 \u1101 \u1076 \u1101 \u1083 \u1087 \u1101  \u1089 \u1099 \u1088  \u1087 \u1088 \u1101  \u1073 \u1091 \u1090 \u1099 . \u1040 \u1076 \u1072  \u1080 \'a0\u1089 \u1099 \u1089  \u1083 \u1101 \u1089 \u1082 \u1080 \u1088 \u1080  \u1073 \u1091 \u1090 \u1099 . \u1041 \u1091 \u1076 \u1091 \u1083 \u1072 \u1105  \u1074 \u1099 \u1084 \u1072 \u1088 \u1076 \u1103  \u1087 \u1088 \u1077 \u1076 \u1089 \u1077 \u1076 \u1072 \u1090 \u1077 \u1083 \u1105 \u1089 \u1090 \u1099 \u1088  \u1095 \u1072 \u1074 \u1101 \u1089 \u1082 \u1101  \u1087 \u1086 \u1083 \u1090 \u1086 \u1088 \u1072  \u1090 \u1088 \u1091 \u1076 \u1086 \u1076 \u1085 \u1103  \u1087 \u1072 \u1083 \u1101  \u1089 \u1084 \u1077 \u1085 \u1072  \u1089 \u1099 \u1088  \u1084 \u1083 \u1072 \u1076 \u1096 \u1086 \u1085 \u1101 \u1089 \u1082 \u1101  \u1084 \u1086 \u1083 \u1086 \u1090 \u1086 \u1073 \u1086 \u1081 \u1094 \u1086 \u1089 \u1082 \u1101 . \u1063 \u1077 \u1081 \u1085 \u1086 \'a0\'96 \u1089 \u1090 \u1072 \u1088 \u1096 \u1086  \u1084 \u1086 \u1083 \u1086 \u1090 \u1086 \u1073 \u1086 \u1081 \u1094 \u1086 \u1089 \u1072  \u1089 \u1099 \u1089  \u1042 \u1086 \u1083 \u1086 \u1076 \u1100 \u1082 \u1072  \u1062 \u1072 \u1088 \u1100 \u1082 \u1086 \u1074 . \u1041 \u1091 \u1076 \u1091 \u1083 \u1072 \u1105  \u1083 \u1101 \u1089  \u1082 \u1093 \u1072 \u1088 \u1101 \u1083 \u1072 \u1089 . \u1063 \u1072 \u1074 \u1086  \u1089 \u1099 \u1089  \u1079 \u1086 \u1088 \u1072 \u1083 \u1086 . \u1053 \u1101  \u1086 \u1076 \u1086 \u1074 \u1072  \u1095 \u1072 \u1089 \u1090 \u1086  \u1082 \u1072 \u1087 \u1088 \u1080 \u1079 \u1085 \u1080 \u1095 \u1072 \u1083 , \u1084 \u1072 \u1085 \u1075 \u1101 \u1083  \u1073 \u1088 \u1072 \u1074 \u1080 \u1085 \u1090 \u1072 , \u1087 \u1072 \u1083  \u1072 \u1076 \u1072 \u1074 \u1072  \u1041 \u1091 \u1076 \u1091 \u1083 \u1072 \u1105  \u1089 \u1072 \u1088 \u1101 \u1089 \u1072  \u1080 \'a0\u1086 \u1090 \u1087 \u1093 \u1101 \u1085 \u1076 \u1103  \u1083 \u1101 \u1089 \u1082 \u1101 . \u1042 \u1072 \u1085 \u1103  \u1087 \u1086 \u1085 \u1072 \u1073 \u1091 \u1090 \u1082 \u1072  \u1084 \u1091 \u1078 \u1072 \u1083 , \u1074 \u1099 \u1073 \u1072 \u1088 \u1080 \u1103 , \u1082 \u1101 \u1088 \u1101 \u1083  \u1073 \u1091 \u1090 \u1099  \u1085 \u1072 \u1073 \u1072 \u1088 \u1086  \u1084 \u1086 \u1083 \u1086 \u1090 \u1086 \u1089 \u1072 , \u1080 \'a0\u1041 \u1091 \u1076 \u1091 \u1083 \u1072 \u1105  \u1084 \u1086 \u1075  \u1073 \u1080  \u1089 \u1090 \u1072 \u1088 \u1096 \u1086 \u1085 \u1101 \u1089 \u1082 \u1080 \u1088 \u1086  \u1084 \u1086 \u1083 \u1086 \u1090 \u1086 \u1073 \u1086 \u1081 \u1094 \u1086 \u1089 \u1082 \u1080 \u1088 \u1086 .\cb1 \
\cb3 \uc0\u1057 \u1084 \u1091 \u1075 \u1083 \u1086 , \u1088 \u1086 \u1089 \u1083 \u1086 , \u1075 \u1086 \u1078 \u1086  \u1089 \u1099 \u1089  \u1042 \u1072 \u1085 \u1103 . \u1053 \u1101 , \u1091 \u1096 \u1091 \u1085 \u1076 \u1103  \u1041 \u1091 \u1076 \u1091 \u1083 \u1072 \u1105 , \u1089 \u1086 \'a0\u1085 \u1072 \'a0\u1087 \u1086 \u1076 \u1076 \u1078 \u1103 \u1083  \u1105 \u1074  \u1082 \u1086  \u1076 \u1072 \u1076  \u1084 \u1091 \u1077 \u1089 \u1072 . \u1055 \u1086 \u1076 \u1091 \u1084 \u1080 \u1085 \u1076 \u1103 , \u1089 \u1086 \'a0\u1089 \u1072 \u1074 \u1101 \'a0\'96 \u1090 \u1086  \u1088 \u1086 \u1076 \u1080 \u1095 \u1080  \u1076 \u1072 \u1089 \u1072 \u1074 \u1101 . \u1054 \u1076 \u1086 \u1074 \u1072  \u1085 \u1072 \'a0\u1087 \u1093 \u1101 \u1085 \u1101 \u1089 \u1072  \u1087 \u1072 \u1083 \u1101  \u1053 \u1102 \u1088 \u1082 \u1072 \u1090 \u1101 , \u1076 \u1072 \u1082 \u1080 \u1088 \u1080  \u1095 \u1072 \u1081 . \u1057 \u1077 \u1088 \u1086 \u1103 \u1082 \u1093 \u1080 \u1090 \u1082 \u1086  \u1096 \u1091 \u1082 \u1072 \u1088 \u1085 \u1099 , \u1090 \u1086 \u1083 \u1100 \u1082 \u1086  \u1090 \u1080 \u1093 \u1086  \u1080 \'a0\u1089 \u1082 \u1088 \u1086 \u1084 \u1085 \u1086 . \u1057 \u1099 \u1088  \u1076 \u1072 \u1081  \u1087 \u1088 \u1080 \u1083 \u1077 \u1078 \u1085 \u1086 . \u1050 \u1093 \u1101 \u1088 \u1101  \u1080 \'a0\u1076 \u1088 \u1101  \u1073 \u1091 \u1090 \u1099  \u1083 \u1099 \u1085 \u1072 \u1105 \u1089 \u1072  \u1076 \u1088 \u1086  \u1074 \u1080 \u1085 \u1086 \u1075 \u1088 \u1072 \u1076 \u1085 \u1080 \u1082 \u1086  \u1089 \u1099 \u1089  \u1103 \u1075 . \u1044 \u1088 \u1101  \u1096 \u1082 \u1086 \u1083 \u1072  \u1087 \u1086 \u1084 \u1086 \u1075 \u1072 \u1083 \u1072  \u1087 \u1096 \u1072 \u1083 \u1101 \u1089 \u1082 \u1101  \u1090 \u1101  \u1088 \u1077 \u1096 \u1080 \u1085 \u1101 \u1083  \u1079 \u1072 \u1076 \u1072 \u1095 \u1082 \u1080 . \u1057 \u1099 \u1082 \u1083 \u1105 \u1085 \u1072 \u1089  \u1076 \u1088 \u1086  \u1077 \u1082 \u1093 \u1101  \u1082 \u1083 \u1072 \u1089 \u1089 \u1086 , \u1076 \u1088 \u1080 \u1074 \u1072 \u1085  \u1082 \u1072 \u1084 \u1101 \u1085 \u1072 \u1089  \u1077 \u1082 \u1093  \u1077 \u1082 \u1093 \u1101 \u1089 . \u1053 \u1080 \u1082 \u1086 \u1085  \u1084 \u1072 \u1096 \u1082 \u1080 \u1088  \u1095 \u1072 \u1074 \u1086 \u1088 \u1101 \u1085 \u1076 \u1101  \u1085 \u1072 \'a0\u1076 \u1105 \u1088 \u1075 \u1080 \u1085 \u1076 \u1103  \u1053 \u1102 \u1088 \u1082 \u1072  \u1087 \u1072 \u1083 \u1101  \u1073 \u1072 \u1083 \u1072 . \u1059 \u1090 \u1088 \u1086 \u1089 \u1072  \u1082 \u1093 \u1101 \u1090 \u1072 \u1085 \u1101  \u1075 \u1101 \u1085 \u1101  \u1076 \u1088 \u1101  \u1096 \u1082 \u1086 \u1083 \u1072  \u1073 \u1088 \u1101 \u1075 \u1086 \u1089 \u1072  \u1044 \u1086 \u1085 \u1086  \u1076 \u1088 \u1086  \u1089 \u1090 \u1072 \u1085 \u1080 \u1094 \u1072 . \u1050 \u1093 \u1101 \u1090 \u1072 \u1085 \u1101  \u1088 \u1080 \u1089 \u1080 \u1085 \u1101 \u1085 \u1072 \u1089  \u1082 \u1093 \u1101 \u1088 \u1101 . \u1053 \u1080 \u1082 \u1086 \u1085  \u1085 \u1080  \u1077 \u1082 \u1093  \u1084 \u1086 \u1083 \u1086  \u1085 \u1072 \'a0\u1091 \u1076 \u1099 \u1082 \u1093 \u1090 \u1103 , \u1089 \u1086 \u1073 \u1099  \u1105 \u1085 \u1101  \u1082 \u1086 \u1096 \u1101 \u1085 \u1072 \u1089 \u1087 \u1101 \u1089  \u1084 \u1072 \u1096 \u1082 \u1080 \u1088  \u1087 \u1101 \u1089 \u1090 \u1101 , \u1089 \u1099 \u1088  \u1080 \u1089 \u1099  \u1084 \u1072 \u1096 \u1082 \u1080 \u1088  \u1087 \u1096 \u1072 \u1083 \u1101 \u1089 \u1090 \u1101  \u1080 \'a0\u1087 \u1093 \u1101 \u1085 \u1103 \u1090 \u1101 .\cb1 \
\cb3 \uc0\u1057 \u1072 \u1088 \u1101  \u1076 \u1078 \u1080 \u1085 \u1101 \u1085 \u1072 \u1089 , \u1089 \u1086 \'a0\u1087 \u1096 \u1072 \u1083 \u1101 \u1089 \u1082 \u1080 \u1088 \u1086  \u1091 \u1074 \u1083 \u1077 \u1095 \u1077 \u1085 \u1080 \u1077 , \u1089 \u1099 \u1088  \u1080 \'a0\u1076 \u1072 \u1081 , \u1105 \u1081  \u1085 \u1077 \'a0\u1086 \u1076 \u1086 \u1073 \u1088 \u1103 \u1077 \u1090 , \u1093 \u1086 \u1090 \u1100  \u1080 \'a0\u1085 \u1072 \'a0\u1088 \u1072 \u1082 \u1080 \u1088 \u1101 \u1083  \u1085 \u1080 \u1082 \u1086 \u1085 \u1101 \u1089 \u1082 \u1101 . \u1041 \u1091 \u1076 \u1091 \u1083 \u1072 \u1105  \u1095 \u1072 \u1089 \u1090 \u1086  \u1076 \u1091 \u1084 \u1080 \u1085 \u1101 \u1083 \u1072 \u1089 , \u1089 \u1086 \'a0\u1073 \u1080  \u1042 \u1072 \u1085 \u1103 \u1090 \u1101  \u1083 \u1101 \u1089 \u1082 \u1101  \u1085 \u1072 \'a0\u1083 \u1086 \u1082 \u1093 \u1101 \u1089  \u1089 \u1099 \u1089 . \u1044 \u1101 \u1074 \u1101 \u1089  \u1089 \u1099 \u1089  \u1090 \u1099 \u1082 \u1085 \u1086 . \u1058 \u1086  \u1044 \u1072 \u1088 \u1100 \u1103 \u1082 \u1080 \u1088 \u1080  \u1073 \u1088 \u1080 \u1075 \u1072 \u1076 \u1072  \u1087 \u1088 \u1080 \u1103 \u1085 \u1076 \u1083 \u1101  \u1090 \u1103 \u1087 \u1082 \u1080 , \u1090 \u1086  \u1080 \u1079 \'a0\u1086 \u1075 \u1086 \u1088 \u1086 \u1076 \u1085 \u1086 \u1081  \u1073 \u1088 \u1080 \u1075 \u1072 \u1076 \u1099  \u1075 \u1072 \u1085 \u1076 \u1083 \u1072 \u1076 \u1103 . \u1048 \'a0\u1089 \u1072 \u1088 \u1086  \u1095 \u1077 \u1081 \u1085 \u1086  \u1089 \u1099 \u1075 \u1101 \u1089  \u1090 \u1101  \u1082 \u1101 \u1088 \u1101 \u1089 . \u1041 \u1091 \u1076 \u1091 \u1083 \u1072 \u1105  \u1072 \u1076 \u1103 \u1082 \u1101  \u1082 \u1101 \u1088 \u1101 \u1083  \u1088 \u1077 \u1089 \u1089 \u1086 \u1088 \u1072 , \u1089 \u1086 \'a0\u1092 \u1101 \u1076 \u1099 \u1088  \u1085 \u1101 \u1074 \u1101 \u1089 \u1090 \u1099 \u1088 . \'ab\'96 \u1025 \u1074  \u1076 \u1078 \u1080 \u1085 \u1101 \u1083  \u1089 \u1072 \u1074 \u1080 \'a0\'96 \u1090 \u1086  \u1088 \u1086 \u1084 \u1072 \u1085 \u1099  \u1084 \u1086 \u1083 \u1080 \u1090 \u1074 \u1072 , \u1080 \u1083 \u1080  \u1089 \u1072 \u1074 \u1086 \'a0\'96 \u1090 \u1086  \u1087 \u1086 \u1088 \u1086 \u1096 \u1082 \u1086  \u1083 \u1101 \u1089 \u1090 \u1101  \u1089 \u1099 \'bb\'a0\'96 \u1088 \u1072 \u1082 \u1080 \u1088 \u1101 \u1083 \u1072 \u1089  \u1074 \u1086 \u1089 \u1093 \u1080 \u1097 \u1105 \u1085 \u1085 \u1086  \u1096 \u1086 \u1092 \u1077 \u1088 \u1086 .\cb1 \
\cb3 \uc0\u1050 \u1101 \u1076 \u1101  \u1076 \u1072 \u1089 \u1072 \u1074 \u1101  \u1089 \u1083 \u1091 \u1093 \u1080  \u1076 \u1086 \u1075 \u1101 \u1085 \u1101  \u1082 \u1086  \u1041 \u1091 \u1076 \u1091 \u1083 \u1072 \u1105 , \u1105 \u1074  \u1079 \u1072 \u1089 \u1072 \u1085 \u1076 \u1103 \u1087 \u1101 . \u1053 \u1080 \u1095 \u1080  \u1076 \u1072 \u1089 \u1072 \u1074 \u1086  \u1085 \u1072 \'a0\u1089 \u1099 \u1089 . \u1053 \u1072 \'a0\u1087 \u1072 \u1090 \u1103 \u1083  \u1076 \u1088 \u1086  \u1095 \u1091 \u1076 \u1077 \u1089 \u1099  \u1086 \u1076 \u1086 \u1083 \u1101  \u1084 \u1086 \u1083 \u1086 \u1089 \u1090 \u1099 \u1088 , \u1082 \u1101 \u1076 \u1101  \u1080 \u1089 \u1099 \u1089  \u1087 \u1072 \u1096 \u1083 \u1086  \u1076 \u1088 \u1086  \u1075 \u1086 \u1089 \u1087 \u1080 \u1090 \u1072 \u1083 \u1105 . \u1057 \u1087 \u1093 \u1072 \u1075 \u1080 \u1088 \u1076 \u1103  \u1075 \'92\u1101 \u1088 \u1086 \u1081 . \u1054 \u1076 \u1086 \u1081  \u1080 \'a0\u1074 \u1099 \u1089 \u1099 \u1082 \u1083 \u1103 \u1082 \u1080 \u1088 \u1076 \u1103 \u1087 \u1101  \u1075 \u1088 \u1072 \u1084 \u1086 \u1090 \u1072 \u1082 \u1101 . \u1055 \u1072 \u1083  \u1072 \u1076 \u1072 \u1074 \u1072  \u1088 \u1086 \u1089 \u1082 \u1086 \u1096 \u1085 \u1101 \u1087 \u1101 \u1089  \u1073 \u1072 \u1088 \u1101  \u1090 \u1072 \u1073 \u1086 \u1088 \u1086 \u1089 \u1072  \u1044 \u1072 \u1085 \u1080 \u1083 \u1072 \u1089 \u1072 . \u1025 \u1074  \u1095 \u1102 \u1088 \u1076 \u1099 \u1103  \u1083 \u1099 \u1083  \u1041 \u1091 \u1076 \u1091 \u1083 \u1072 \u1105 \u1089 \u1090 \u1099 \u1088  \u1076 \u1088 \u1101  \u1103 \u1075 . \u1041 \u1091 \u1076 \u1091 \u1083 \u1072 \u1105  \u1089 \u1077 \u1084 \u1100 \u1103 \u1089 \u1072  \u1091 \u1075 \u1101 \u1103  \u1090 \u1072 \u1073 \u1086 \u1088 \u1086 \u1089 \u1090 \u1099 \u1088 , \u1083 \u1086 \u1076 \u1101 \u1083 \u1072 \u1089  \u1087 \u1101 \u1089 \u1082 \u1080 \u1088 \u1101  \u1089 \u1077 \u1084 \u1100 \u1103 \u1089 \u1072  \u1078 \u1099 \u1082 \u1101  \u1084 \u1072 \u1088 \u1080 \u1073 \u1101 .\cb1 \
\cb3 \uc0\u1056 \u1080 \u1089 \u1080 \u1103 \u1087 \u1101  \u1076 \u1088 \u1086  \u1090 \u1072 \u1073 \u1086 \u1088 \u1086  \u1041 \u1091 \u1076 \u1091 \u1083 \u1072 \u1105  \u1087 \u1072 \u1083 \u1086  \u1084 \u1072 \u1088 \u1080 \u1073 \u1101 . \u1044 \u1072 \u1085 \u1080 \u1083 \u1072  \u1091 \u1078 \u1077  \u1084 \u1101 \u1103 . \u1056 \u1086 \u1084 \u1072 , \u1091 \u1076 \u1099 \u1082 \u1093 \u1085 \u1101  \u1086 \u1088 \u1076 \u1077 \u1085 \u1099  \u1080 \'a0\u1084 \u1077 \u1076 \u1072 \u1083 \u1080 , \u1091 \u1088 \u1072 \u1082 \u1080 \u1088 \u1076 \u1101  \u1083 \u1101 \u1089 , \u1089 \u1086 \'a0\u1105 \u1074  \u1103 \u1074 \u1101 \u1083 \u1072  \u1073 \u1072 \u1088 \u1086  \u1076 \u1088 \u1086  \u1090 \u1072 \u1073 \u1086 \u1088 \u1086 . \u1044 \u1072 \u1089 \u1072 \u1074 \u1086  \u1074 \u1086 \u1078 \u1072 \u1082 \u1086  \u1089 \u1072 \u1088 \u1101  \u1088 \u1101 \u1085 \u1076 \u1072  \u1088 \u1077 \u1096 \u1080 \u1085 \u1101  \u1074 \u1083 \u1072 \u1089 \u1090 \u1101 \u1085 \u1094 \u1072 . \u1025 \u1085 \u1101  \u1089 \u1099 \u1075 \u1086  \u1091 \u1076 \u1099 \u1082 \u1093 \u1085 \u1101 , \u1089 \u1086 \'a0\u1105 \u1074  \u1083 \u1099 \u1076 \u1078 \u1080 \u1103  \u1088 \u1101 \u1085 \u1076 \u1086  \u1076 \u1103 \u1082 \u1101 , \u1089 \u1086 \'a0\u1085 \u1072 \u1085 \u1101  \u1085 \u1072 \u1076 \u1077 \u1078 \u1076 \u1072  \u1090 \u1101  \u1075 \'92\u1072 \u1088 \u1072 \u1074 \u1101 \u1085 \u1087 \u1101  \u1087 \u1072 \u1083  \u1083 \u1101 \u1089 \u1082 \u1080 \u1088 \u1086  \u1076 \u1091 \u1084 \u1086 . \u1057 \u1099 \u1088 \'a0\u1073 \u1099  \u1085 \u1072 \'a0\u1079 \u1072 \u1090 \u1088 \u1072 \u1076 \u1099 \u1085 \u1101  \u1090 \u1072 \u1073 \u1086 \u1088 \u1086 \u1089 \u1072  \u1076 \u1088 \u1086  \u1082 \u1086 \u1083 \u1093 \u1086 \u1079 \u1086  \u1089 \u1072 \u1088 \u1101  \u1082 \u1080 \u1073 \u1080 \u1090 \u1082 \u1101 \u1085 \u1094 \u1072 . \u1025 \u1085 \u1101  \u1074 \u1086 \u1079 \u1088 \u1086 \u1087 \u1090 \u1072 \u1083 \u1080 . \u1050 \u1072 \u1081  \u1072 \u1076 \u1072  \u1076 \u1099 \u1082 \u1093 \u1085 \u1101 , \u1089 \u1086 \u1073 \u1099  \u1073 \u1072 \u1088 \u1086  \u1086 \u1090 \u1087 \u1093 \u1101 \u1085 \u1076 \u1103 \u1087 \u1101  \u1090 \u1101  \u1076 \u1101 \u1083  \u1079 \u1072 \u1097 \u1080 \u1090 \u1072  \u1087 \u1101 \u1089 \u1082 \u1080 \u1088 \u1101 \u1089 \u1082 \u1101  \u1089 \u1086 \u1087 \u1083 \u1077 \u1084 \u1077 \u1085 \u1085 \u1080 \u1082 \u1086 \u1089 \u1082 \u1101  \u1072 \u1085 \u1075 \u1080 \u1083  \u1074 \u1083 \u1072 \u1089 \u1090 \u1101 \u1085 \u1076 \u1101 ? \u1052 \u1072 \u1083 \u1086  \u1086 \u1076 \u1086 \u1074 \u1072 , \u1082 \u1086 \u1082 \u1086 \u1088 \u1086  \u1088 \u1072 \u1082 \u1080 \u1088 \u1101 \u1083 , \u1089 \u1086 \'a0\u1086 \u1090 \u1076 \u1101 \u1083 \u1072  \u1076 \u1088 \u1086  \u1074 \u1072 \u1089 \u1090 \u1072  \u1087 \u1088 \u1072 \u1074 \u1086 \u1089 \u1091 \u1076 \u1080 \u1105 \u1089 \u1082 \u1101 , \u1082 \u1086 \u1085  \u1095 \u1105 \u1088 \u1101 \u1083 \u1072  \u1074 \u1072 \u1096  \u1090 \u1072 \u1073 \u1086 \u1088 \u1086  \u1075 \u1088 \u1101 \u1089  \u1080 \u1083 \u1080  \u1075 \u1088 \u1072 \u1089 \u1085 \u1103 . \u1050 \u1072 \u1081  \u1072 \u1076 \u1072  \u1089 \u1099 \u1089 , \u1089 \u1086 \u1073 \u1099  \u1088 \u1086 \u1084 \u1101 \u1085 \u1075 \u1080 \u1088 \u1101  \u1095 \u1072 \u1074 \u1086 \u1088 \u1101 \u1085  \u1087 \u1088 \u1101  \u1079 \u1080 \u1084 \u1072  \u1082 \u1074 \u1072 \u1088 \u1090 \u1080 \u1088 \u1086 \u1074 \u1072 \u1083 \u1080  \u1076 \u1088 \u1086  \u1092 \u1086 \u1088 \u1086 , \u1089 \u1090 \u1072 \u1085 \u1080 \u1094 \u1072 . \u1043 \u1101 \u1085 \u1101  \u1073 \u1072 \u1088 \u1101  \u1083 \u1086 \u1074 \u1101  \u1074 \u1072 \u1096  \u1086 \u1076 \u1086 \u1074 \u1072 , \u1089 \u1086 \u1073 \u1099  \u1090 \u1101  \u1089 \u1082 \u1101 \u1076 \u1101 \u1085  \u1095 \u1072 \u1074 \u1086 \u1088 \u1101 \u1085  \u1076 \u1088 \u1101  \u1096 \u1082 \u1086 \u1083 \u1072 . \u1055 \u1093 \u1091 \u1088 \u1101  \u1080 \'a0\u1090 \u1101 \u1088 \u1085 \u1101  \u1088 \u1086 \u1084 \u1085 \u1103  \u1087 \u1088 \u1086 \u1084 \u1099 \u1096 \u1083 \u1103 \u1083 \u1080  \u1077 \u1082 \u1076 \u1078 \u1080 \u1085 \u1101  \u1073 \u1080  \u1087 \u1086 \u1084 \u1086 \u1097 \u1085 \u1080 \u1082 \u1101 \u1085 \u1076 \u1101 . \u1045 \u1082 \u1093  \u1088 \u1101 \u1085 \u1076 \u1086 , \u1082 \u1101 \u1076 \u1101  \u1090 \u1099 \u1088 \u1086  \u1090 \u1099 \u1082 \u1085 \u1086  \u1095 \u1072 \u1074 \u1086 \u1088 \u1086  \u1080 \u1083 \u1080  \u1090 \u1099 \u1082 \u1085 \u1099  \u1095 \u1072 \u1081  \u1089 \u1082 \u1093 \u1101 \u1083 \u1101 \u1083 \u1072  \u1087 \u1088 \u1086  \u1090 \u1072 \u1088 \u1075 \u1086 , \u1080 \u1083 \u1080  \u1089 \u1073 \u1072 \u1075 \u1072 \u1083 \u1072  \u1087 \u1088 \u1086  \u1089 \u1072 \u1073 \u1101 : \'ab\u1062 \u1099 \u1075 \u1072 \u1085  \u1093 \u1086 \u1076 \u1080 \u1090  \u1090 \u1088 \u1091 \u1073 \u1082 \u1091  \u1082 \u1091 \u1088 \u1080 \u1090 , \u1072 \'a0\u1094 \u1099 \u1075 \u1072 \u1085 \u1082 \u1072  \u1083 \u1102 \u1076 \u1077 \u1081  \u1076 \u1091 \u1088 \u1080 \u1090 \'bb, \u1074 \u1072 \u1074 \u1080 \u1088  \u1088 \u1101 \u1085 \u1076 \u1086 , \u1082 \u1101 \u1076 \u1101  \u1090 \u1091 \u1082 \u1101  \u1079 \u1072 \u1082 \u1072 \u1084 \u1100 \u1103  \'ab\u1087 \u1086 \u1079 \u1086 \u1083 \u1086 \u1090 \u1080 \u1090 \u1100 \'bb \u1074 \u1072 \u1089 \u1090  \u1076 \u1086 \u1074 \u1077 \u1088 \u1095 \u1080 \u1074 \u1086  \u1084 \u1072 \u1085 \u1091 \u1096 . \u1044 \u1072 \u1089 \u1072 \u1074 \u1101  \u1089 \u1099 \u1089  \u1090 \u1099 \u1082 \u1085 \u1101 \u1076 \u1099 \u1088 . \'ab\u1044 \u1086 \u1093 \u1086 \u1076 \u1099 \'bb \u1088 \u1086 \u1084 \u1085 \u1101 \u1085 \u1075 \u1080 \u1088 \u1086  \u1089 \u1099 \u1089  \u1090 \u1099 \u1082 \u1085 \u1099 \u1076 \u1099 \u1088 . \u1025 \u1085 \u1101  \u1075 \u1101 \u1085 \u1101  \u1082 \u1101  \u1073 \u1077 \u1083 \u1100 \u1074 \u1077 \u1083 \u1100  \u1076 \u1088 \u1086  \u1090 \u1072 \u1073 \u1086 \u1088 \u1086  \u1073 \u1086 \u1082 \u1093 \u1072 \u1083 \u1101  \u1080 \'a0\u1093 \u1086 \u1083 \u1103 \u1084 \u1101 . \u1051 \u1086 \u1074 \u1101  \u1087 \u1088 \u1086  \u1093 \u1072 \u1073 \u1101  \u1085 \u1072 \u1085 \u1101 . \u1040 \'a0\u1105 \u1074  \u1093 \u1072 \u1081  \u1076 \u1091 \u1078 \u1072 \u1082 \u1080 \u1088 \u1076 \u1103  \u1072 \u1076 \u1072 \u1074 \u1072 . \u1056 \u1086 \u1084 \u1085 \u1103  \u1074 \u1079 \u1088 \u1086 \u1087 \u1090 \u1072 \u1083 \u1080 , \u1072 \'a0\u1041 \u1091 \u1076 \u1091 \u1083 \u1072 \u1105  \u1076 \u1103 \u1082 \u1101  \u1088 \u1080 \u1089 \u1082 \u1080 \u1088 \u1076 \u1103  \u1086 \'a0\u1088 \u1101 \u1085 \u1076 \u1086 , \u1089 \u1086 \'a0\u1103 \u1075  \u1087 \u1099 \u1103  \u1087 \u1088 \u1086  \u1096 \u1101 \u1088 \u1086  \u1083 \u1101 \u1085 \u1075 \u1088 \u1101  \u1088 \u1086 \u1084 \u1101 \u1085 \u1075 \u1101 . \u1056 \u1072 \u1082 \u1080 \u1088 \u1101 \u1083 \u1072 \u1089  \u1088 \u1086 \u1084 \u1085 \u1077 \u1085 \u1075 \u1101 , \u1072 \u1076 \u1072  \u1083 \u1101 \u1085 \u1075 \u1080 \u1088 \u1101  \u1088 \u1086 \u1084 \u1072  \u1086 \u1073 \u1083 \u1077 \u1085 \u1080 \u1083 \u1080 \u1089 \u1100  \u1076 \u1103 \u1082 \u1101 , \u1089 \u1086 \'a0\u1075 \'92\u1072 \u1088 \u1072  \u1076 \u1078 \u1080 \u1074 \u1101 \u1085 \u1072  \u1089 \u1099 \u1088  \u1073 \u1072 \u1081 \u1073 \u1072 \u1082 \u1080  \u1087 \u1088 \u1086  \u1079 \u1088 \u1080 \u1082 \u1080 \u1088 \u1080 \u1073 \u1101  \u1087 \u1101 \u1089 \u1082 \u1088 \u1101  \u1088 \u1086 \u1084 \u1085 \u1077 \u1085 \u1075 \u1101  \u1080 \'a0\u1095 \u1072 \u1074 \u1086 \u1088 \u1101 \u1085 \u1075 \u1101 . \u1025 \u1085 \u1101  \u1085 \u1072 \'a0\u1076 \u1099 \u1082 \u1093 \u1085 \u1101 , \u1089 \u1086 \'a0\u1087 \u1086 \u1087 \u1088 \u1086 \u1096 \u1072 \u1081 \u1089 \u1090 \u1074 \u1086  \u1080 \'a0\u1095 \u1105 \u1088 \u1080 \u1073 \u1101  \u1075 \u1088 \u1101 \u1085 \'a0\'96 \u1085 \u1072 \u1085 \u1101  \u1074 \u1099 \u1075 \u1101 \u1080 \u1073 \u1101 . \u1053 \u1072 \'a0\u1087 \u1088 \u1086 \u1076 \u1078 \u1080 \u1074 \u1101 \u1089 \u1072 . \u1042 \u1072 \u1074 \u1080 \u1088  \u1103 \u1074 \u1100 \u1103  \u1074 \u1088 \u1077 \u1084 \u1105 . \u1056 \u1072 \u1079 \u1074 \u1077  \u1085 \u1072 \'a0\u1076 \u1099 \u1082 \u1093 \u1101 \u1085 , \u1089 \u1086 \'a0\u1075 \u1088 \u1101 \u1085  \u1087 \u1072 \u1088 \u1091 \u1076 \u1101  \u1087 \u1088 \u1086  \u1087 \u1093 \u1091 \u1088 \u1076 \u1099 \u1085 \u1103 ? \u1043 \u1088 \u1101 \u1085  \u1072 \u1076 \u1072 \u1082 \u1080 \u1094 \u1099 , \u1089 \u1086 \'a0\u1089 \u1099 \u1075 \u1086  \u1085 \u1072 \'a0\u1103 \u1074 \u1101 \u1083 \u1072  \u1082 \u1072 \u1081  \u1090 \u1101  \u1095 \u1105 \u1088 \u1101 \u1089 . \u1040 \u1085 \u1075 \u1083 \u1099 \u1076 \u1099 \u1088  \u1088 \u1086 \u1084 \u1072  \u1076 \u1078 \u1080 \u1085 \u1101 \u1085 \u1072 \u1089  \u1090 \u1086 \u1083 \u1082 \u1086  \u1075 \u1088 \u1101 \u1085 \u1075 \u1101 , \u1088 \u1086 \u1084  \u1089 \u1099 \u1089  \u1083 \u1072 \u1095 \u1105  \u1074 \u1089 \u1072 \u1076 \u1085 \u1080 \u1082 \u1086 . \u1050 \u1072 \u1085 \u1072  \u1082 \u1080 \u1085 \u1101 \u1083 \u1072  \u1075 \u1088 \u1072 \u1089 \u1085 \u1103 , \u1087 \u1086 \u1076 \u1095 \u1103 \u1088 \u1072 \u1076 \u1103  \u1085 \u1072 \u1073 \u1091 \u1090 , \u1080 \'a0\u1089 \u1076 \u1099 \u1103  \u1074 \'a0\'ab\u1047 \u1072 \u1075 \u1086 \u1090 \u1089 \u1082 \u1086 \u1090 \'bb \u1087 \u1088 \u1101  \u1075 \u1086 \u1081 . \u1051 \u1072 \u1076 \u1078 \u1103 \u1082 \u1080 \u1088 \u1080 \u1073 \u1101 . \u1040 \'a0\u1087 \u1072 \u1083  \u1073 \u1072 \u1088 \u1101 \u1089 \u1090 \u1101  \u1082 \u1086 \u1085  \u1076 \u1078 \u1080 \u1085 \u1101 \u1083  \u1076 \u1088 \u1086  \u1090 \u1072 \u1073 \u1086 \u1088 \u1086 ? \u1053 \u1072 \u1090 . \u1055 \u1072 \u1083 \u1086 \u1076 \u1086 \u1074 \u1072  \u1089 \u1086 \'a0\u1085 \u1077 \u1075 \u1088 \u1072 \u1084 \u1086 \u1090 \u1085 \u1086 . \u1041 \u1091 \u1076 \u1091 \u1083 \u1072 \u1105  \u1075 \u1080 \u1085 \u1101 \u1083 \u1072 \u1089  \u1076 \u1088 \u1086  \u1096 \u1091 \u1085 \u1080 \u1073 \u1101  \u1087 \u1072 \u1096  \u1103 \u1075  \u1075 \u1072 \u1079 \u1077 \u1090 \u1072 , \u1082 \u1072 \u1081  \u1089 \u1099 \u1089  \u1087 \u1072 \u1087 \u1101  \u1073 \u1072 \u1088 \u1101 \u1089 \u1090 \u1101 , \u1082 \u1086 \u1085 \u1101 \u1089 \u1090 \u1099 \u1088  \u1083 \u1099 \u1085 \u1101  \u1076 \u1091 \u1081  \u1095 \u1077 \u1084 \u1086 \u1076 \u1072 \u1085 \u1072  \u1089 \u1086 \u1074 \u1085 \u1072 \u1082 \u1072 \u1089 \u1072  \u1087 \u1088 \u1101  \u1076 \u1091 \u1081  \u1084 \u1080 \u1083 \u1083 \u1080 \u1086 \u1085 \u1072 . \u1056 \u1086 \u1084 \u1085 \u1103  \u1089 \u1082 \u1101 \u1076 \u1099 \u1085 \u1101  \u1083 \u1101 \u1089 \u1082 \u1101  \u1087 \u1086 \'a0\u1075 \u1088 \u1080 \u1074 \u1077 \u1085 \u1085 \u1080 \u1082 \u1091 , \u1079 \u1091 \u1084 \u1072 \u1074 \u1101 \u1085 \u1072 \u1089 , \u1089 \u1099 \u1089  \u1084 \u1072 \u1075 \u1072 \u1095 \u1080 , \u1072 \'a0\u1090 \u1086  \u1080 \'a0\u1095 \u1105 \u1088 \u1101 \u1085 \u1072 \u1089  \u1084 \u1072 \u1085 \u1091 \u1096 \u1101 \u1085 \u1076 \u1099 \u1088 . \u1040 \'a0\u1105 \u1074  \u1090 \u1088 \u1072 \u1076 \u1101 \u1083 \u1072 \u1089  \u1087 \u1088 \u1101  \u1087 \u1093 \u1091 \u1088 \u1076 \u1099 \u1085 \u1099 , \u1090 \u1088 \u1072 \u1076 \u1101 \u1083 \u1072 \u1089  \u1087 \u1088 \u1086  \u1082 \u1091 \u1088 \u1086 \u1088 \u1090 \u1086 . \u1057 \u1086 \'a0\u1078 \u1077 , \u1082 \u1101 \u1088 \u1101 \u1085 \u1090 \u1080  \u1076 \u1103 \u1082 \u1101  \u1080 \'a0\u1076 \u1091 \u1088 \u1099 \u1076 \u1099 \u1088 . \u1057 \u1082 \u1101 \u1076 \u1101 \u1085 \u1090 \u1080  \u1087 \u1101 \u1089 \u1082 \u1088 \u1101  \u1073 \u1072 \u1088 \u1101 \u1089 \u1082 \u1101  \u1095 \u1077 \u1084 \u1086 \u1076 \u1072 \u1085 \u1099  \u1083 \u1086 \u1074 \u1101 \u1085 \u1094 \u1072 , \u1072 \'a0\u1085 \u1077 \u1075 \u1088 \u1072 \u1084 \u1086 \u1090 \u1085 \u1086  \u1095 \u1072 \u1074 \u1086 \u1088 \u1101  \u1084 \u1101 \u1082  \u1082 \u1093 \u1101 \u1083 \u1101 \u1085  \u1087 \u1088 \u1086  \u1090 \u1072 \u1088 \u1075 \u1086 , \u1080 \'a0\u1073 \u1072 \u1075 \u1072 \u1085 \u1072  \u1083 \u1072 \u1076 \u1078 \u1103 \u1082 \u1080 \u1088 \u1101 \u1085  \u1088 \u1086 \u1084 \u1101 \u1085  \u1075 \u1080 \u1083 \u1103 ! \u1041 \u1091 \u1076 \u1091 \u1083 \u1072 \u1105  \u1088 \u1080 \u1089 \u1082 \u1080 \u1088 \u1076 \u1103  \u1088 \u1101 \u1085 \u1076 \u1086  \u1076 \u1103 \u1082 \u1101 , \u1089 \u1086 \'a0\u1075 \u1088 \u1086 \u1079 \u1072  \u1084 \u1080 \u1085 \u1086 \u1074 \u1072 \u1083 \u1072  \u1083 \u1101 \u1089 , \u1080 \'a0\u1087 \u1099 \u1103  \u1087 \u1088 \u1086  \u1096 \u1101 \u1088 \u1086  \u1074 \u1072 \u1074 \u1088 \u1101  \u1088 \u1086 \u1084 \u1101 \u1085 \u1075 \u1101 , \u1089 \u1072 \u1074 \u1101  \u1082 \u1072 \u1084 \u1101 \u1085 \u1072 \u1089  \u1090 \u1101  \u1103 \u1095 \u1077 \u1085 \u1087 \u1101  \u1076 \u1088 \u1101  \u1089 \u1090 \u1088 \u1086 \u1085 \u1072 . \u1053 \u1080 \u1082 \u1101 \u1076 \u1101  \u1085 \u1072 \'a0\u1089 \u1099 \u1089 , \u1089 \u1086 \u1073 \u1099  \u1088 \u1086 \u1084 \u1085 \u1103 , \u1089 \u1072 \u1074 \u1101  \u1073 \u1077 \u1079 \u1088 \u1086 \u1087 \u1086 \u1090 \u1085 \u1086  \u1076 \u1078 \u1103 \u1085 \u1072 \u1089  \u1090 \u1101  \u1079 \u1091 \u1084 \u1072 \u1074 \u1101 \u1085 , \u1090 \u1101  \u1084 \u1072 \u1085 \u1075 \u1101 \u1085 , \u1089 \u1099 \u1082 \u1083 \u1103 \u1082 \u1080 \u1088 \u1076 \u1101  \u1095 \u1072 \u1074 \u1086 \u1088 \u1101 \u1085  \u1090 \u1101  \u1095 \u1105 \u1088 \u1101 \u1085 , \u1089 \u1086 \u1073 \u1099  \u1083 \u1101 \u1085 \u1075 \u1080 \u1088 \u1101  \u1088 \u1086 \u1084 \u1072  \u1090 \u1101  \u1085 \u1072 \u1076 \u1099 \u1082 \u1093 \u1101 \u1085  \u1092 \u1091 \u1080 \u1087 \u1101 , \u1072 \'a0\u1082 \u1086 \u1082 \u1086 \u1088 \u1101  \u1076 \u1086 \u1074 \u1086 \u1083 \u1100 \u1089 \u1090 \u1074 \u1086 \u1074 \u1072 \u1083 \u1080 \u1089 \u1100  \u1082 \u1101 \u1076 \u1101  \u1083 \u1072 \u1095 \u1077  \u1084 \u1072 \u1085 \u1091 \u1096 \u1072  \u1087 \u1086 \u1076 \u1101 \u1085 \u1072  \u1083 \u1086 \u1084 \u1090 \u1105  \u1084 \u1072 \u1088 \u1086 , \u1095 \u1105 \u1088 \u1089 \u1090 \u1074 \u1086  \u1087 \u1072 \u1088 \u1072 \u1084 \u1072 \u1088 \u1086 , \u1074 \u1076 \u1088 \u1091 \u1075  \u1075 \u1101 \u1085 \u1101  \u1076 \u1088 \u1101  \u1072 \u1090 \u1072 \u1082 \u1072  \u1082 \u1101  \u1087 \u1101 \u1089 \u1082 \u1080 \u1088 \u1101  \u1088 \u1086 \u1084 \u1072 , \u1089 \u1074 \u1077 \u1088 \u1082 \u1072 \u1103  \u1103 \u1082 \u1093 \u1101 \u1085 \u1094 \u1072 , \u1090 \u1101  \u1074 \u1099 \u1084 \u1101 \u1082 \u1101 \u1085  \u1089 \u1072 \u1088 \u1101  \u1086 \u1073 \u1080 \u1076 \u1099 .\cb1 \
\cb3 \uc0\u1044 \u1083 \u1101 \u1085 \u1075 \u1080  \u1093 \u1072 \u1095 \u1105 \u1083 \u1072 \u1089  \u1073 \u1077 \u1083 \u1100 \u1074 \u1077 \u1083 \u1103 \u1089 \u1072  \u1073 \u1072 \u1088 \u1080  \u1088 \u1086 \u1084 \u1072 \u1085 \u1099  \u1103 \u1075  \u1087 \u1072 \u1083 \u1101  \u1089 \u1090 \u1072 \u1085 \u1080 \u1094 \u1072 . \u1044 \u1086 \u1083 \u1075 \u1086  \u1085 \u1077 \'a0\u1091 \u1084 \u1086 \u1083 \u1082 \u1072 \u1083  \u1075 \u1086 \u1084 \u1086 \u1085 \u1086  \u1076 \u1088 \u1086  \u1090 \u1072 \u1073 \u1086 \u1088 \u1086 . \u1052 \u1072 \u1085 \u1091 \u1096 \u1072  \u1087 \u1088 \u1086 \u1089 \u1091 \u1090 \u1101 \u1087 \u1101 \u1089 , \u1079 \u1076 \u1072 \u1088 \u1072 \u1085 \u1076 \u1099 \u1085 \u1101 \u1087 \u1101 \u1089 , \u1076 \u1091 \u1084 \u1080 \u1085 \u1076 \u1101  \u1089 \u1086 \'a0\u1072 \u1076 \u1072  \u1088 \u1086 \u1084 \u1072  \u1088 \u1072 \u1079 \u1084 \u1080 \u1090 \u1080 \u1085 \u1075 \u1086 \u1074 \u1072 \u1083 \u1080 \u1089 \u1100 ? \u1057 \u1086 \'a0\'96 \u1090 \u1086  \u1079 \u1072 \u1076 \u1091 \u1084 \u1080 \u1085 \u1076 \u1083 \u1101 , \u1089 \u1072 \u1074 \u1080 \'a0\'96 \u1090 \u1086  \u1087 \u1072 \u1082 \u1086 \u1089 \u1090 \u1100  \u1087 \u1072 \u1090 \u1099 \u1074 \u1072 \u1083 \u1101 \u1085 \u1075 \u1101  \u1084 \u1072 \u1085 \u1091 \u1096 \u1101 \u1085 \u1075 \u1101 . \u1052 \u1072 \u1085 \u1091 \u1096 \u1072  \u1075 \u1101 \u1085 \u1101  \u1090 \u1101  \u1079 \u1084 \u1101 \u1082 \u1101 \u1085  \u1076 \u1078 \u1091 \u1082 \u1083 \u1101 \u1085  \u1094 \u1101 \u1087 \u1101 \u1085 \u1076 \u1099 \u1088 , \u1076 \u1099 \u1082 \u1093 \u1101 \u1085 \u1072 \u1089  \u1079 \u1072 \u1087 \u1086 \u1088 \u1099 , \u1072 \'a0\u1088 \u1072 \u1082 \u1093 \u1080 \u1073 \u1085 \u1086 \u1088 \u1100 \u1103  \u1087 \u1088 \u1101  \u1092 \u1077 \u1088 \u1084 \u1072 , \u1087 \u1090 \u1080 \u1095 \u1085 \u1080 \u1082 \u1077 , \u1088 \u1080 \u1082 \u1080 \u1088 \u1101 \u1085 \u1072 \u1089  \u1076 \u1088 \u1086  \u1074 \u1072 \u1089 \u1090 \u1072  \u1084 \u1072 \u1088 \u1076 \u1103 . \u1056 \u1072 \u1090 \u1103 \u1089 \u1072  \u1084 \u1072 \u1085 \u1091 \u1096 \u1072  \u1085 \u1072 \'a0\u1089 \u1099 \u1089  \u1089 \u1091 \u1090 \u1101 . \u1045 \u1097 \u1105  \u1073 \u1091 \u1090 \u1099 \u1076 \u1099 \u1088  \u1089 \u1099 \u1089  \u1091 \u1076 \u1080 \u1074 \u1083 \u1077 \u1085 \u1080 \u1077 , \u1082 \u1101 \u1076 \u1101  \u1088 \u1072 \u1085 \u1086  \u1091 \u1090 \u1088 \u1086 \u1089 \u1072  \u1076 \u1088 \u1086  \u1087 \u1088 \u1072 \u1074 \u1083 \u1077 \u1085 \u1080 \u1077  \u1103 \u1074 \u1085 \u1101  \u1088 \u1086 \u1084 \u1072 , \u1076 \u1072 \u1089 \u1072 \u1074 \u1101 , \u1089 \u1086 \'a0\u1084 \u1080 \u1090 \u1080 \u1085 \u1075 \u1086 \u1074 \u1072 \u1083 \u1080  \u1088 \u1072 \u1090 \u1103 \u1089 \u1072 , \u1083 \u1101 \u1085 \u1094 \u1072  \u1073 \u1072 \u1088 \u1086  \u1089 \'a0\u1084 \u1077 \u1076 \u1072 \u1083 \u1103 \u1084 \u1080 . \u1048 \'a0\u1105 \u1074  \u1089 \u1072 \u1088 \u1101 \u1089 \u1072  \u1086 \u1096 \u1072 \u1088 \u1072 \u1096 \u1080 \u1083  \u1087 \u1088 \u1077 \u1076 \u1089 \u1077 \u1076 \u1072 \u1090 \u1077 \u1083 \u1105 \u1089  \u1079 \u1072 \u1103 \u1074 \u1083 \u1077 \u1085 \u1100 \u1105 \u1089 \u1072 :\cb1 \
\cb3 \'96\'a0\uc0\u1055 \u1088 \u1080 \u1083 \u1101 \u1085 \u1090 \u1080  \u1076 \u1088 \u1086  \u1082 \u1086 \u1083 \u1093 \u1086 \u1079 \u1086 ! \u1041 \u1101 \u1096 \u1072 \u1089 \u1072 \u1087 \u1101  \u1087 \u1088 \u1101  \u1087 \u1093 \u1091 \u1074 !\cb1 \
\cb3 \'96\'a0\uc0\u1057 \u1072 \u1088 \u1086  \u1090 \u1072 \u1073 \u1086 \u1088 \u1086  \u1091 \u1088 \u1072 \u1082 \u1080 \u1088 \u1076 \u1105 \u1084  \u1090 \u1101  \u1073 \u1101 \u1096 \u1101 \u1085  \u1087 \u1088 \u1086  \u1077 \u1082 \u1093 \u1101  \u1096 \u1090 \u1101 \u1090 \u1086 , \u1072 \'a0\u1082 \u1086 \u1082 \u1086 \u1088 \u1086  \u1089 \u1088 \u1080 \u1089 \u1082 \u1080 \u1088 \u1076 \u1105 \u1084 \u1087 \u1101  \u1096 \u1090 \u1101 \u1090 \u1086 \u1089 \u1090 \u1099 \u1088 , \u1083 \u1086 \u1076 \u1072 \u1074 \u1072 \u1089 , \u1088 \u1086 \u1076 \u1072 \u1074 \u1072 \u1089  \u1087 \u1101 \u1089 \u1082 \u1080 \u1088 \u1086  \u1089 \u1077 \u1084 \u1077 \u1081 \u1089 \u1090 \u1074 \u1086 , \u1087 \u1086 \u1082 \u1072  \u1085 \u1072 \'a0\u1087 \u1088 \u1080 \u1103 \u1095 \u1100 \u1105 \u1084  \u1082 \u1101  \u1072 \u1076 \u1072 \u1074 \u1072  \u1073 \u1088 \u1101 \u1075 \u1086 ,\'a0\'96 \u1085 \u1077 \u1074 \u1077 \u1089 \u1077 \u1083 \u1086  \u1088 \u1086 \u1089 \u1087 \u1093 \u1101 \u1085 \u1076 \u1103  \u1042 \u1072 \u1085 \u1103 \u1089 \u1082 \u1101  \u1041 \u1091 \u1076 \u1091 \u1083 \u1072 \u1105 ,\'a0\'96 \u1050 \u1072 \u1085 \u1072  \u1089 \u1072 \u1088 \u1101  \u1088 \u1086 \u1084 \u1072 , \u1084 \u1080 \u1088 \u1101  \u1088 \u1086 \u1076 \u1080 \u1095 \u1080  \u1080 \'a0\u1074 \u1072 \u1074 \u1088 \u1101 , \u1082 \u1072 \u1078 \u1076 \u1086  \u1095 \u1105 \u1085  \u1095 \u1080 \u1085 \u1101 \u1085 \u1072  \u1084 \u1072 \u1085 \u1075 \u1101  \u1083 \u1099 \u1083 \u1072 , \u1082 \u1086 \u1096 \u1101 \u1085 \u1087 \u1101 \u1089 , \u1082 \u1093 \u1072 \u1088 \u1101 \u1085  \u1082 \u1101  \u1087 \u1101 . \u1040 \'a0\u1082 \u1072 \u1088 \u1080 \u1082  \u1084 \u1072 \u1085 \u1075 \u1101  \u1072 \u1076 \u1072 \u1094 \u1080 \u1088  \u1090 \u1101  \u1090 \u1088 \u1072 \u1076 \u1072 \u1074 ? \u1040 \u1076 \u1072 \u1081  \u1082 \u1072 \u1085 \u1072  \u1084 \u1080 \u1088 \u1086  \u1082 \u1086 \u1088 \u1085 \u1105 \'85\cb1 \
\cb3 \uc0\u1058 \u1086 \u1083 \u1100 \u1082 \u1086  \u1077 \u1082 \u1093 \u1101 \u1089 \u1082 \u1101  \u1089 \u1083 \u1091 \u1096 \u1072 \u1090 \u1077 \u1083 \u1102  \u1042 \u1072 \u1085 \u1103 \u1089 \u1082 \u1101 , \u1082 \u1086 \u1085  \u1096 \u1091 \u1085 \u1101 \u1083 \u1072 \u1089 , \u1086 \u1090 \u1082 \u1101 \u1088 \u1076 \u1103  \u1041 \u1091 \u1076 \u1091 \u1083 \u1072 \u1081  \u1087 \u1101 \u1089 \u1082 \u1080 \u1088 \u1086  \u1080 \u1083 \u1086 , \u1085 \u1072 \'a0\u1076 \u1072 \u1088 \u1101 \u1083 \u1072 \u1089 \u1087 \u1101 . \u1042 \u1072 \u1085 \u1103  \u1076 \u1103 \u1082 \u1101  \u1076 \u1078 \u1080 \u1085 \u1101 \u1083 \u1072 \u1089  \u1090 \u1101  \u1096 \u1091 \u1085 \u1101 \u1083 , \u1076 \u1099 \u1082 \u1093 \u1103  \u1087 \u1101 \u1089 \u1082 \u1080 \u1088 \u1101  \u1103 \u1082 \u1093 \u1101 \u1085 \u1094 \u1072 .\cb1 \
\cb3 \uc0\u1050 \u1072 \u1085 \u1072  \u1087 \u1088 \u1080 \u1074 \u1103 \u1079 \u1072 \u1085 \u1085 \u1086 \u1089 \u1090 \u1100  \u1079 \u1086 \u1088 \u1072 \u1083 \u1099 \u1076 \u1099 \u1088 . \u1057 \u1099 \u1089  \u1087 \u1088 \u1080 \u1095 \u1080 \u1085 \u1072 . \u1048 \u1089 \u1099  \u1084 \u1085 \u1077 \u1085 \u1080 \u1077 , \u1089 \u1086 \'a0\u1088 \u1086 \u1084 \u1072  \u1085 \u1072 \'a0\u1089 \u1084 \u1101 \u1082 \u1101 \u1085  \u1086 \u1073 \u1080 \u1076 \u1099 , \u1085 \u1086 \'a0\u1085 \u1072 \u1073 \u1091 \u1090  \u1082 \u1086 \u1085  \u1076 \u1078 \u1080 \u1085 \u1101 \u1083 , \u1089 \u1086 \'a0\u1090 \u1080 \u1084 \u1080 \u1085 \u1101 \u1085  \u1089 \u1086 \u1095 \u1091 \u1074 \u1089 \u1090 \u1074 \u1080 \u1077 , \u1079 \u1072 \u1073 \u1086 \u1090 \u1072 , \u1074 \u1085 \u1080 \u1084 \u1072 \u1085 \u1080 \u1077 . \u1041 \u1091 \u1076 \u1091 \u1083 \u1072 \u1105  \u1089 \u1099 \u1089  \u1076 \u1072 \u1089 \u1072 \u1074 \u1086  \u1084 \u1072 \u1085 \u1091 \u1096 . \u1044 \u1088 \u1086  \u1093 \u1091 \u1090 \u1086 \u1088 \u1086  \u1076 \u1078 \u1080 \u1085 \u1101 \u1085 \u1072 \u1089 , \u1089 \u1086 \'a0\u1041 \u1091 \u1076 \u1091 \u1083 \u1072 \u1105  \u1085 \u1072 \'a0\u1086 \u1090 \u1087 \u1093 \u1101 \u1085 \u1101 \u1083 \u1072  \u1085 \u1080 \u1082 \u1086 \u1085 \u1101 \u1089 \u1082 \u1101 . \u1053 \u1072 \'a0\u1075 \u1080 \u1085 \u1101 \u1083  \u1074 \u1088 \u1077 \u1084 \u1105 . \u1055 \u1086 \u1083 \u1100 \u1079 \u1086 \u1074 \u1072 \u1083 \u1080 \u1089 \u1100 , \u1089 \u1086 \'a0\u1105 \u1074  \u1073 \u1077 \u1079 \u1086 \u1090 \u1082 \u1072 \u1079 \u1085 \u1086 . \u1048 \u1085 \u1086 \u1075 \u1076 \u1072  \u1085 \u1072 \'a0\u1083 \u1072 \u1076 \u1078 \u1103 \u1074 \u1086  \u1089 \u1099 \u1089 , \u1089 \u1072 \u1074 \u1086 \'a0\'96 \u1090 \u1086  \u1096 \u1086 \u1092 \u1105 \u1088 \u1086  \u1076 \u1078 \u1103 \u1085 \u1075 \u1072 \u1074 \u1101 \u1083 \u1072 \u1089  \u1088 \u1072 \u1090 \u1103 \u1089 \u1072 , \u1088 \u1077 \u1089 \u1089 \u1086 \u1088 \u1072  \u1089 \u1087 \u1093 \u1072 \u1075 \u1080 \u1088 \u1076 \u1103 . \u1025 \u1074 , \u1085 \u1072 \'a0\u1088 \u1072 \u1082 \u1080 \u1088 \u1076 \u1103  \u1085 \u1080  \u1083 \u1072 \u1074 , \u1076 \u1078 \u1103 \u1083 , \u1088 \u1086 \u1089 \u1087 \u1093 \u1091 \u1088 \u1076 \u1099 \u1103  \u1075 \u1086 \u1088 \u1085 \u1086  \u1076 \u1088 \u1101  \u1082 \u1091 \u1079 \u1085 \u1103 , \u1089 \u1086 \u1073 \u1099  \u1091 \u1090 \u1088 \u1086 \u1089 \u1072  \u1096 \u1086 \u1092 \u1105 \u1088 \u1086  \u1090 \u1088 \u1072 \u1076 \u1099 \u1103  \u1076 \u1088 \u1086  \u1076 \u1088 \u1086 \u1084 . \u1044 \u1088 \u1101  \u1082 \u1072 \u1096 \u1091 \u1082 \u1080  \u1087 \u1072 \u1096 \u1088 \u1072 \u1090  \u1093 \u1072 \u1095 \u1105 \u1083  \u1103 \u1075  \u1076 \u1088 \u1101  \u1082 \u1091 \u1079 \u1085 \u1103 . \u1059 \u1090 \u1088 \u1086 \u1089 \u1072  \u1087 \u1093 \u1091 \u1088 \u1080  \u1051 \u1091 \u1097 \u1080 \u1083 \u1080 \u1093 \u1072  \u1087 \u1080 \u1088 \u1076 \u1072 \u1083  \u1087 \u1083 \u1077 \u1090 \u1085 \u1105  \u1086 \u1089 \u1074 \u1077 \u1076 \u1086 \u1084 \u1083 \u1103 \u1083 \u1072  \u1089 \u1086 \u1089 \u1077 \u1076 \u1082 \u1101 \u1085 , \u1089 \u1086 \'a0\u1086 \u1087 \u1103 \u1090 \u1100  \u1105 \u1074  \u1088 \u1072 \u1090 \u1103 \u1089 \u1072  \u1089 \u1083 \u1091 \u1078 \u1080 \u1083  \u1087 \u1101 \u1089 \u1082 \u1080 \u1088 \u1086  \u1084 \u1086 \u1083 \u1077 \u1073 \u1085 \u1086 .\
\uc0\u1041 \u1091 \u1076 \u1091 \u1083 \u1072 \u1105  \u1075 \'92\u1072 \u1088 \u1072  \u1082 \u1072 \u1084 \u1101 \u1083 \u1072 \u1089  \u1090 \u1101  \u1082 \u1101 \u1088 \u1101 \u1083  \u1086 \u1075 \u1088 \u1072 \u1076 \u1082 \u1072  \u1087 \u1088 \u1101  \u1084 \u1086 \u1075 \u1080 \u1083 \u1082 \u1072  \u1043 \u1072 \u1083 \u1103 \u1082 \u1101  \u1076 \u1088 \u1101  \u1092 \u1101 \u1083 \u1076 \u1072 . \u1051 \u1101 \u1089  \u1088 \u1072 \u1089 \u1090 \u1088 \u1086 \u1075 \u1072 \u1083 \u1086  \u1042 \u1072 \u1085 \u1103 \u1089 \u1082 \u1080 \u1088 \u1086  \u1091 \u1095 \u1072 \u1089 \u1090 \u1080 \u1077 . \u1041 \u1091 \u1076 \u1091 \u1083 \u1072 \u1105  \u1080 \'a0\u1088 \u1080 \u1089 \u1091 \u1085 \u1082 \u1086  \u1089 \u1082 \u1101 \u1088 \u1076 \u1103 , \u1085 \u1101  \u1085 \u1072 \'a0\u1089 \u1099 \u1089  \u1074 \u1088 \u1077 \u1084 \u1103  \u1090 \u1101  \u1082 \u1101 \u1088 \u1101 \u1083 . \u1050 \u1086 \u1083 \u1093 \u1086 \u1079 \u1086  \u1079 \u1072 \u1075 \u1088 \u1091 \u1078 \u1072 \u1083  \u1083 \u1101 \u1089 . \u1042 \u1079 \u1076 \u1099 \u1093 \u1080 \u1085 \u1101 \u1083 \u1072 \u1089 , \u1076 \u1099 \u1082 \u1093 \u1093 \u1101 \u1083 \u1072 \u1089  \u1087 \u1088 \u1101  \u1089 \u1095 \u1102 \u1076 \u1099  \u1076 \u1088 \u1086  \u1074 \u1101 \u1085 \u1075 \u1083 \u1086  \u1086 \u1089 \u1090 \u1088 \u1086 \u1091 \u1075 \u1086 \u1083 \u1100 \u1085 \u1072  \u1087 \u1086 \u1083 \u1086 \u1089 \u1099  \u1080 \'a0\u1082 \u1088 \u1101 \u1085 \u1075 \u1083 \u1072  \u1089 \u1072 \u1089 \u1090 \u1088 \u1091 \u1085 \u1101  \u1087 \u1088 \u1091 \u1090 \u1099  \u1079 \u1072 \u1075 \u1086 \u1090 \u1086 \u1074 \u1086 \u1082 . \u1058 \u1077 \u1096 \u1080 \u1083  \u1087 \u1101 \u1089  \u1085 \u1072 \u1076 \u1077 \u1078 \u1076 \u1072 \u1089 \u1072 , \u1089 \u1086 \'a0\u1058 \u1080 \u1084 \u1086 \u1092 \u1077 \u1105  \u1048 \u1083 \u1100 \u1080 \u1095 \u1105  \u1079 \u1088 \u1080 \u1082 \u1080 \u1088 \u1101 \u1083 \u1072  \u1087 \u1101 \u1089 \u1082 \u1080 \u1088 \u1086  \u1083 \u1072 \u1074 , \u1076 \u1101 \u1083 \u1072  \u1083 \u1101 \u1089 \u1082 \u1101  \u1086 \u1090 \u1087 \u1091 \u1089 \u1082 \u1086  \u1076 \u1091 \u1081  \u1082 \u1091 \u1088 \u1082 \u1101 . \u1058 \u1080 \u1084 \u1086 \u1092 \u1077 \u1105  \u1048 \u1083 \u1100 \u1080 \u1095 \u1105  \u1089 \u1072 \u1088 \u1086  \u1074 \u1088 \u1077 \u1084 \u1105  \u1090 \u1099 \u1088 \u1076 \u1101 \u1083 \u1072 \u1089  \u1086 \u1073 \u1077 \u1097 \u1072 \u1085 \u1080 \u1105 \u1089 \u1072 . \u1041 \u1091 \u1076 \u1091 \u1083 \u1072 \u1105  \u1074 \u1089 \u1105  \u1095 \u1072 \u1097 \u1077  \u1076 \u1099 \u1082 \u1093 \u1101 \u1083 \u1072 \u1089  \u1087 \u1088 \u1101  \u1079 \u1072 \u1075 \u1086 \u1090 \u1086 \u1074 \u1082 \u1080  \u1076 \u1088 \u1086  \u1074 \u1101 \u1085 \u1075 \u1083 \u1086 . \u1040 \u1076 \u1072  \u1091 \u1076 \u1099 \u1082 \u1090 \u1103  \u1042 \u1072 \u1085 \u1103 . \u1045 \u1082 \u1093  \u1084 \u1086 \u1083 \u1086  \u1089 \u1087 \u1091 \u1095 \u1100 \u1103  \u1087 \u1072 \u1083 \u1089 \u1086  \u1105 \u1085 \u1101 . \u1059 \u1075 \'92\u1072 \u1083 \u1099 \u1103  \u1074 \u1072 \u1096  \u1089 \u1086 , \u1080 \'a0\u1087 \u1086 \u1084 \u1072 \u1085 \u1075 \u1100 \u1103  \u1090 \u1101  \u1087 \u1086 \u1087 \u1088 \u1086 \u1073 \u1080 \u1085 \u1101 \u1083  \u1090 \u1101  \u1082 \u1101 \u1088 \u1101 \u1083 . \u1040 \u1076 \u1072  \u1103 \u1074 \u1101 \u1083 \u1072  \u1087 \u1077 \u1088 \u1074 \u1086  \u1089 \u1072 \u1084 \u1086 \u1089 \u1090 \u1086 \u1103 \u1090 \u1077 \u1083 \u1100 \u1085 \u1086  \u1073 \u1091 \u1090 \u1099 . \u1025 \u1074  \u1076 \u1103 \u1082 \u1101  \u1085 \u1072 \u1089 \u1090 \u1086 \u1081 \u1095 \u1080 \u1074 \u1086  \u1091 \u1088 \u1072 \u1082 \u1080 \u1088 \u1083 \u1072 \u1089 , \u1089 \u1086 \'a0\u1041 \u1091 \u1076 \u1091 \u1083 \u1072 \u1105  \u1089 \u1086 \u1075 \u1083 \u1072 \u1089 \u1080 \u1085 \u1076 \u1103 \u1087 \u1101 . \u1050 \u1086 \u1085 \u1077 \u1095 \u1085 \u1086 , \u1092 \u1101 \u1076 \u1099 \u1088  \u1082 \u1086 \u1082 \u1086 \u1088 \u1086 \u1089 \u1082 \u1101  \u1090 \u1101  \u1082 \u1101 \u1088 \u1101 \u1083 , \u1085 \u1101  \u1042 \u1072 \u1085 \u1103 \'a0\u1078 \u1077  \u1103 \u1074 \u1101 \u1083 \u1072  \u1090 \u1101  \u1082 \u1101 \u1088 \u1101 \u1083  \u1089 \u1099 \u1088  \u1087 \u1080 \u1088  \u1083 \u1101 \u1089 \u1082 \u1080 \u1088 \u1086  \u1088 \u1080 \u1089 \u1091 \u1085 \u1082 \u1086 , \u1041 \u1091 \u1076 \u1091 \u1083 \u1072 \u1105  \u1087 \u1088 \u1080 \u1076 \u1099 \u1082 \u1093 \u1101 \u1083 \u1072 . \u1057 \u1099 \u1088  \u1086 \u1090 \u1087 \u1093 \u1101 \u1085 \u1101 \u1089 \u1072  \u1072 \u1076 \u1072 \u1083 \u1101 \u1085 \u1075 \u1101  \u1103 \u1082 \u1093 \u1101 \u1085 \u1075 \u1101 ? \u1044 \u1078 \u1080 \u1076 \u1101 , \u1082 \u1072 \u1083 \u1101 , \u1087 \u1072 \u1088 \u1091 \u1074 \u1101 \u1085  \u1082 \u1072 \u1078 \u1085 \u1086  \u1084 \u1080 \u1075  \u1074 \u1099 \u1088 \u1072 \u1078 \u1077 \u1085 \u1080 \u1077 . \u1063 \u1080 \u1089 \u1090 \u1072 . \u1055 \u1080 \u1088 \u1076 \u1072 \u1083  \u1083 \u1101 \u1085 \u1076 \u1101  \u1076 \u1099 \u1082 \u1085 \u1086  \u1083 \u1101 \u1089 \u1082 \u1080 \u1088 \u1086 \'a0\u1080 \u1083 \u1086 .\cb1 \
\cb3 \uc0\u1050 \u1072 \u1085 \u1072  \u1042 \u1072 \u1085 \u1103  \u1076 \u1078 \u1103 \u1083  \u1087 \u1088 \u1101  \u1073 \u1091 \u1090 \u1099  \u1082 \u1101 \u1076 \u1101  \u1082 \u1093 \u1072 \u1084  \u1090 \u1086 \u1083 \u1100 \u1082 \u1086  \u1075 \'92\u1072 \u1079 \u1076 \u1101 \u1083 \u1087 \u1101 , \u1072 \'a0\u1088 \u1080 \u1089 \u1105 \u1083 \u1087 \u1101  \u1082 \u1101 \u1076 \u1101  \u1089 \u1072 \u1088 \u1101 \u1089 \u1072  \u1073 \u1101 \u1096 \u1101 \u1083 \u1072  \u1087 \u1072 \u1083 \u1086  \u1074 \u1101 \u1096 . \u1050 \u1072 \u1085 \u1072  \u1076 \u1072 \u1081  \u1080 \'a0\u1087 \u1093 \u1101 \u1085 \u1086 \u1088 \u1080  \u1053 \u1102 \u1088 \u1082 \u1072  \u1089 \u1072 \u1088 \u1101 \u1089 \u1072  \u1085 \u1072 \'a0\u1076 \u1099 \u1082 \u1093 \u1101 \u1085 \u1072 \u1089 \'a0\u1083 \u1101 \u1089 .\cb1 \
\cb3 \uc0\u1053 \u1072 \u1073 \u1091 \u1090  \u1076 \u1091 \u1088 \u1099 \u1076 \u1099 \u1088  \u1041 \u1091 \u1076 \u1091 \u1083 \u1072 \u1105 \u1089 \u1082 \u1080 \u1088 \u1080  \u1085 \u1072 \u1082 \u1086 \u1074 \u1072 \u1083 \u1100 \u1085 \u1103  \u1089 \u1095 \u1102 \u1076 \u1101  \u1085 \u1072 \u1073 \u1072 \u1088 \u1080 , \u1082 \u1072 \u1081  \u1042 \u1072 \u1085 \u1103  \u1082 \u1101 \u1088 \u1101 \u1083  \u1087 \u1101 \u1089 \u1082 \u1080 \u1088 \u1080  \u1087 \u1077 \u1088 \u1074 \u1086  \u1089 \u1072 \u1084 \u1086 \u1089 \u1090 \u1086 \u1103 \u1090 \u1077 \u1083 \u1100 \u1085 \u1086  \u1082 \u1086 \u1074 \u1072 \u1083 \u1105 \u1089 \u1082 \u1080 \u1088 \u1080  \u1073 \u1091 \u1090 \u1099 . \u1050 \u1072 \u1085 \u1072  \u1096 \u1091 \u1085 \u1101 \u1085 \u1072 \u1089  \u1082 \u1091 \u1079 \u1085 \u1103 \u1090 \u1099 \u1088  \u1079 \u1074 \u1086 \u1085 \u1086  \u1076 \u1091 \u1077 \u1085 \u1075 \u1080 \u1088 \u1101  \u1084 \u1086 \u1083 \u1086 \u1090 \u1082 \u1101 \u1085 \u1075 \u1080 \u1088 \u1101 . \u1041 \u1091 \u1076 \u1091 \u1083 \u1072 \u1105  \u1089 \u1099 \u1075 \u1086  \u1087 \u1077 \u1088 \u1077 \u1103 \u1095 \u1100 \u1103  \u1089 \u1086 \u1084 \u1085 \u1077 \u1074 \u1072 \u1090 \u1100 \u1089 \u1103 , \u1089 \u1086 \'a0\u1076 \u1072 \u1089 \u1072 \u1074 \u1080  \u1073 \u1091 \u1090 \u1099  \u1042 \u1072 \u1085 \u1103 \u1089 \u1082 \u1101  \u1085 \u1072 \u1085 \u1101  \u1087 \u1080 \u1088 \u1086  \u1087 \u1089 \u1080 \u1082 \u1086 . \u1044 \u1072 \u1078 \u1077  \u1080 \u1085 \u1086 \u1075 \u1076 \u1072  \u1083 \u1102 \u1073 \u1086 \u1074 \u1072 \u1083 \u1089 \u1103 . \u1044 \u1088 \u1086  \u1041 \u1091 \u1076 \u1091 \u1083 \u1072 \u1105 \u1089 \u1082 \u1080 \u1088 \u1086  \u1088 \u1080 \u1089 \u1091 \u1085 \u1082 \u1086  \u1089 \u1099 \u1089  \u1096 \u1090 \u1072 \u1088  \u1075 \u1088 \u1072 \u1081 \u1103 . \u1040 \u1095 \u1100 \u1103 \u1087 \u1101  \u1091 \u1076 \u1080 \u1074 \u1083 \u1103 \u1090 \u1100 \u1089 \u1103 , \u1089 \u1099 \u1088  \u1042 \u1072 \u1085 \u1103 \u1089 \u1082 \u1101  \u1091 \u1076 \u1099 \u1103 \u1087 \u1101  \u1090 \u1101  \u1082 \u1101 \u1088 \u1101 \u1083  \u1076 \u1103 \u1082 \u1101 , \u1093 \u1072 \u1081  \u1073 \u1072 \u1083 \u1074 \u1072 \u1083  \u1088 \u1086 \u1089 \u1095 \u1102 \u1088 \u1076 \u1099 \u1103  \u1083 \u1101 \u1089 \u1082 \u1101  \u1075 \u1088 \u1080 \u1074 \u1072 . \u1061 \u1072 \u1081  \u1089 \u1072 \u1088 \u1086  \u1076 \u1078 \u1080 \u1080 \u1073 \u1101 \u1085  \u1090 \u1086 \u1083 \u1100 \u1082 \u1086  \u1080 \'a0\u1089 \u1072 \u1085 \u1072 \u1089  \u1087 \u1072 \u1096 \u1101  \u1075 \u1088 \u1101 \u1085 \u1076 \u1101 . \u1041 \u1091 \u1076 \u1091 \u1083 \u1072 \u1105  \u1085 \u1072 \'a0\u1087 \u1072 \u1090 \u1103 \u1083 \u1072 \u1089 , \u1089 \u1086 \'a0\u1042 \u1072 \u1085 \u1103  \u1077 \u1097 \u1105  \u1085 \u1080  \u1077 \u1082  \u1084 \u1086 \u1083 \u1086  \u1085 \u1072 \'a0\u1090 \u1088 \u1072 \u1076 \u1101 \u1083 \u1072 \u1089  \u1087 \u1088 \u1101  \u1075 \u1088 \u1101 \u1089 \u1090 \u1101 .\cb1 \
\cb3 \'96\'a0\uc0\u1040 \'a0\u1082 \u1072 \u1084 \u1101 \u1089  \u1090 \u1101  \u1090 \u1088 \u1072 \u1076 \u1101 \u1089 ?\'a0\'96 \u1089 \u1087 \u1091 \u1095 \u1100 \u1103  \u1041 \u1091 \u1076 \u1091 \u1083 \u1072 \u1105 .\cb1 \
\cb3 \uc0\u1048 \'a0\u1076 \u1088 \u1080 \u1074 \u1072 \u1085  \u1086 \u1073 \u1088 \u1072 \u1076 \u1099 \u1085 \u1076 \u1103 \u1087 \u1101 , \u1082 \u1101 \u1076 \u1101  \u1105 \u1074  \u1089 \u1099 \u1075 \u1101 \u1089  \u1087 \u1093 \u1101 \u1085 \u1076 \u1103 :\cb1 \
\cb3 \'96\'a0\uc0\u1045 \u1097 \u1105 \'a0\u1073 \u1099 !\cb1 \
\cb3 \'96\'a0\uc0\u1040 \u1076 \u1072 \u1081  \u1085 \u1080 \u1095 \u1080  \u1085 \u1072 \'a0\u1089 \u1082 \u1101 \u1088 \u1072 \u1074 \u1072 ,\'a0\'96 \u1090 \u1091 \u1075 \u1072 \u1089 \u1072  \u1087 \u1093 \u1101 \u1085 \u1076 \u1103  \u1041 \u1091 \u1076 \u1091 \u1083 \u1072 \u1105 ,\'a0\'96 \u1055 \u1088 \u1101  \u1084 \u1080 \u1088 \u1086  \u1074 \u1077 \u1083 \u1086 \u1089 \u1080 \u1087 \u1077 \u1076 \u1086  \u1090 \u1088 \u1072 \u1076 \u1101  \u1089 \u1082 \u1080 \u1094 \u1080 \u1082  \u1082 \u1072 \u1084 \u1101 \u1089 . \u1041 \u1091 \u1090 \u1099 \u1088  \u1085 \u1080 \u1095 \u1080  \u1085 \u1072 \u1085 \u1101  \u1090 \u1101 \u1083  \u1079 \u1101 \u1085 . \u1040 \u1084 \u1101 , \u1088 \u1086 \u1084 \u1072 , \u1082 \u1072 \u1085 \u1072  \u1084 \u1072 \u1085 \u1091 \u1096 \u1072  \u1073 \u1080 \u1075 \u1088 \u1101 \u1089 \u1082 \u1080 \u1088 \u1101 \'a0\u1089 \u1072 \u1084 .\cb1 \
\cb3 \'96\'a0\uc0\u1053 \u1072 \u1085 \u1101  \u1090 \u1072 \u1085 \u1075 \u1086  \u1090 \u1091 \u1084 \u1101 \u1085 \u1075 \u1101 ?\'a0\'96 \u1089 \u1087 \u1091 \u1095 \u1100 \u1103  \u1042 \u1072 \u1085 \u1103 .\cb1 \
\cb3 \'96\'a0\uc0\u1057 \u1086 \u1089 \u1082 \u1101 , \u1042 \u1072 \u1085 \u1103 , \u1072 \u1084 \u1101 \u1085 \u1075 \u1101  \u1090 \u1101  \u1090 \u1072 \u1085 \u1075 \u1101 \u1085 ?\cb1 \
\cb3 \'96\'a0\uc0\u1058 \u1091 \u1084 \u1072 \u1088 \u1086  \u1087 \u1091 \u1088 \u1072 \u1085 \u1086  \u1076 \u1078 \u1080 \u1080 \u1073 \u1101 . \u1050 \u1072 \u1088 \u1080 \u1082  \u1082 \u1072 \u1084 \u1101 \u1085 \u1072 \u1089  \u1090 \u1088 \u1072 \u1076 \u1101 \u1085 \u1072 \u1089 . \u1050 \u1072 \u1085 \u1072  \u1095 \u1077 \u1081 \u1085 \u1086  \u1087 \u1088 \u1086  \u1077 \u1082 \u1093  \u1096 \u1090 \u1101 \u1090 \u1086  \u1090 \u1101  \u1076 \u1078 \u1080 \u1074 \u1101 \u1085 .\cb1 \
\cb3 \uc0\u1041 \u1091 \u1076 \u1091 \u1083 \u1072 \u1105  \u1079 \u1072 \u1076 \u1091 \u1084 \u1095 \u1080 \u1074 \u1086  \u1087 \u1093 \u1101 \u1085 \u1076 \u1103 :\cb1 \
\cb3 \'96\'a0\uc0\u1057 \u1099 \u1088  \u1090 \u1091 \u1082 \u1101  \u1090 \u1101  \u1087 \u1093 \u1101 \u1085 \u1072 \u1074 \'85 \u1050 \u1086 \u1085 \u1077 \u1095 \u1085 \u1086 , \u1085 \u1072 \'a0\u1073 \u1080  \u1072 \u1076 \u1072 \u1083 \u1101 \u1089 \u1082 \u1080 \u1088 \u1086 \'85 \u1048 \'a0\u1082 \u1072 \u1085 \u1072 , \u1082 \u1072 \u1081  \u1091 \u1076 \u1099 \u1082 \u1093 \u1072 \u1074 \u1072  \u1083 \u1072 \u1095 \u1103  \u1075 \u1088 \u1072 \u1089 \u1085 \u1103 , \u1088 \u1072 \u1090  \u1076 \u1088 \u1101 \'a0 \u1084 \u1072 \u1085 \u1076 \u1101 \'a0 \u1082 \u1080 \u1087 \u1080 \u1085 \u1101 .\'a0 \u1042 \u1072 \u1074 \u1088 \u1101 \u1085 \u1076 \u1101 \'a0 \u1088 \u1086 \u1084 \u1101 \u1085 , \u1076 \u1078 \u1080 \u1085 \u1072 \u1074 , \u1103 \u1089 \u1074 \u1072  \u1087 \u1086 \u1090 \u1093 \u1072 \u1076 \u1099 \u1085 \u1101  \u1087 \u1080 \u1088 \u1086  \u1084 \u1091 \u1081 , \u1082 \u1101 \u1076 \u1101  \u1105 \u1085 \u1101  \u1088 \u1086 \u1079 \u1072 \u1095 \u1085 \u1101 \u1087 \u1101 \u1089  \u1075 \u1088 \u1101 \u1085 \u1094 \u1072 . \u1055 \u1093 \u1091 \u1088 \u1086 \u1084  \u1076 \u1088 \u1086  \u1082 \u1086 \u1083 \u1093 \u1086 \u1079 \u1086  \u1074 \u1089 \u1077 \u1075 \u1076 \u1072  \u1087 \u1086 \u1084 \u1072 \u1085 \u1075 \u1101 \u1083 \u1087 \u1101  \u1096 \u1090 \u1072 \u1083 \u1099 \u1090 \u1082 \u1086 \u1089 \u1072 , \u1090 \u1072 \u1073 \u1091 \u1085 \u1097 \u1080 \u1082 \u1086 \u1089 \u1072 . \u1055 \u1093 \u1072 \u1088 \u1101 \u1089  \u1090 \u1101  \u1079 \u1072 \u1073 \u1080 \u1089 \u1090 \u1088 \u1101 \u1085  \u1083 \u1101 \u1085 \u1075 \u1101 . \u1057 \u1072 \u1088 \u1086  \u1074 \u1088 \u1105 \u1084 \u1105  \u1087 \u1088 \u1101  \u1088 \u1086 \u1090 \u1099 . \u1055 \u1093 \u1091 \u1088 \u1101  \u1088 \u1086 \u1084 \u1072 , \u1076 \u1072 \u1076 \u1072  \u1083 \u1086 \u1076 \u1101 \u1085 \u1072 \u1089 . \u1055 \u1072 \u1083  \u1072 \u1076 \u1072 \u1074 \u1072  \u1089 \u1072 \u1088 \u1101  \u1088 \u1086 \u1084 \u1072 \u1085 \u1101  \u1075 \u1080 \u1083 \u1103  \u1073 \u1072 \u1075 \u1072 \u1085 . \u1050 \u1072 \u1085 \u1072  \u1084 \u1072 \u1096 \u1082 \u1080 \u1088  \u1087 \u1093 \u1091 \u1088 \u1101 \u1085 \u1076 \u1101  \u1080 \'a0\u1090 \u1101 \u1088 \u1085 \u1101 \u1085 \u1076 \u1101  \u1084 \u1072 \u1088 \u1080 \u1073 \u1101  \u1076 \u1078 \u1103 \u1083  \u1087 \u1072 \u1083  \u1072 \u1076 \u1072 \u1074 \u1072 . \u1058 \u1091  \u1076 \u1088 \u1101  \u1079 \u1080 \u1084 \u1072  \u1076 \u1088 \u1101  \u1096 \u1082 \u1086 \u1083 \u1072  \u1076 \u1078 \u1103 \u1089 , \u1084 \u1086 \u1078 \u1077 \u1090 , \u1074 \u1099 \u1089 \u1099 \u1082 \u1083 \u1103 \u1082 \u1080 \u1088 \u1101 \u1089 \u1072 \u1087 \u1101  \u1087 \u1088 \u1101  \u1072 \u1075 \u1088 \u1086 \u1085 \u1086 \u1084 \u1086 \u1089 \u1090 \u1101 . \u1040 \'a0\u1089 \u1086 \u1089 \u1072  \u1088 \u1086 \u1084 \u1072 \u1085 \u1101  \u1095 \u1072 \u1074 \u1086 \u1088 \u1101  \u1085 \u1072 \u1083 \u1072 \u1095 \u1077 ? \u1058 \u1101 \u1088 \u1085 \u1101  \u1095 \u1072 \u1074 \u1101  \u1080 \'a0\u1095 \u1072 \u1081 \u1103  \u1076 \u1086 \u1087 \u1093 \u1101 \u1085 \u1101 \u1085 , \u1089 \u1086 \'a0\u1075 \'92\u1072 \u1088 \u1072  \u1103 \u1074 \u1100 \u1103  \u1087 \u1086 \u1088 \u1072  \u1090 \u1101  \u1076 \u1078 \u1080 \u1074 \u1101 \u1085  \u1074 \u1072 \u1074 \u1088 \u1101 \u1089 , \u1089 \u1099 \u1088  \u1074 \u1072 \u1074 \u1088 \u1101  \u1084 \u1072 \u1085 \u1091 \u1096 \u1072 . \u1063 \u1077 \u1081 \u1085 \u1101  \u1090 \u1101  \u1082 \u1101 \u1088 \u1101 \u1085  \u1073 \u1091 \u1090 \u1099 , \u1090 \u1101  \u1085 \u1072 \'a0\u1095 \u1105 \u1088 \u1101 \u1085 , \u1090 \u1101  \u1085 \u1072 \u1076 \u1099 \u1083 \u1085 \u1103 \u1082 \u1080 \u1088 \u1101 \u1085  \u1084 \u1072 \u1085 \u1091 \u1096 \u1077 \u1085 . \u1058 \u1091 , \u1042 \u1072 \u1085 \u1103 , \u1082 \u1101 \u1076 \u1101 \'a0\'96 \u1085 \u1080 \u1073 \u1091 \u1076 \u1100  \u1076 \u1099 \u1082 \u1093 \u1090 \u1103 \u1085  \u1072 \u1084 \u1072 \u1088 \u1101 \u1085  \u1088 \u1086 \u1084 \u1085 \u1077 \u1085 ?\cb1 \
\cb3 \'96\'a0\uc0\u1045 \u1082 \u1093  \u1080 \u1083 \u1080  \u1076 \u1091 \u1081  \u1084 \u1086 \u1083 \u1099 . \u1052 \u1072 \u1085 \'a0 \u1076 \u1072 \u1081 , \u1089 \u1099 \u1088 \'a0 \u1091 \u1076 \u1099 \u1082 \u1093 \u1101 \u1083 \u1072 \'a0 \u1082 \u1072 \u1081 \'a0 \u1088 \u1086 \u1084 \u1072 , \u1089 \u1099 \u1075 \u1101 \u1089  \u1090 \u1101  \u1079 \u1072 \u1082 \u1101 \u1088 \u1101 \u1083 \u1072 \u1089  \u1076 \u1088 \u1086  \u1082 \u1093 \u1101 \u1088 .\cb1 \
\cb3 \'96\'a0\uc0\u1053 \u1101 , \u1084 \u1086 \u1078 \u1077 \u1090 , \u1090 \u1091  \u1089 \u1072  \u1077 \u1082 \u1093  \u1091 \u1076 \u1099 \u1082 \u1093 \u1090 \u1103 \u1085 , \u1089 \u1086 \'a0\u1105 \u1085 \u1101  \u1089 \u1072 \u1088 \u1101  \u1075 \u1086 \u1078 \u1072 ?\cb1 \
\cb3 \'96\'a0\uc0\u1044 \u1099 \u1082 \u1093 \u1090 \u1105 \u1084 .\cb1 \
\cb3 \'96\'a0\uc0\u1044 \u1099 \u1082 \u1093 \u1101 \u1089 , \u1076 \u1072 \u1089 \u1072 \u1074 \u1101  \u1075 \u1086 \u1078 \u1072  \u1088 \u1086 \u1084 \u1085 \u1103  \u1072 \u1076 \u1103 \u1082 \u1101 \'a0\u1078 \u1077  \u1075 \u1086 \u1078 \u1101 \u1089  \u1093 \u1086 \u1093 \u1072 \u1074 \u1101 \u1085 . \u1058 \u1099 \u1088 \u1080  \u1076 \u1072 \u1081  \u1085 \u1072 \u1085 \u1101  \u1079 \u1088 \u1103  \u1090 \u1091 \u1090  \u1075 \'92\u1072 \u1088 \u1072 \u1074 \u1101 \u1083 \u1072 \u1089 . \u1025 \u1081  \u1076 \u1072 \u1088 \u1072 \u1083 \u1072 \u1089 , \u1089 \u1086 \u1073 \u1099  \u1090 \u1091  \u1076 \u1099 \u1083 \u1085 \u1101 \u1087 \u1085 \u1072 \u1089 \u1090 \u1099 \u1088  \u1085 \u1072 \'a0\u1087 \u1086 \u1087 \u1099 \u1103 \u1085  \u1087 \u1088 \u1086  \u1083 \u1101 \u1085 \u1075 \u1080 \u1088 \u1086  \u1093 \u1086 \u1093 \u1072 \u1080 \u1073 \u1101 . \u1050 \u1086 \u1085 \u1077 \u1095 \u1085 \u1086 , \u1089 \u1072 \u1088 \u1101  \u1088 \u1072 \u1082 \u1080 \u1088 \u1080 \u1073 \u1101 \u1085 \u1072  \u1089 \u1086 \'a0\u1095 \u1105 \u1088 \u1101 \u1085  \u1095 \u1072 \u1074 \u1086 \u1088 \u1101 \u1085  \u1080 \u1089 \u1099  \u1074 \u1099 \u1076 \u1091 \u1084 \u1082 \u1072 . \u1041 \u1072 \u1073 \u1099  \u1089 \u1090 \u1088 \u1072 \u1097 \u1072 \u1083 \u1080  \u1074 \u1085 \u1091 \u1082 \u1101 \u1085 , \u1072 \'a0\u1105 \u1085 \u1101  \u1087 \u1101 \u1089 \u1082 \u1080 \u1088 \u1101 \u1085  \u1095 \u1072 \u1074 \u1086 \u1088 \u1101 \u1085 . \u1040 \'a0\u1074 \u1086 \u1073 \u1097 \u1077 \'85 \u1077 \u1089 \u1083 \u1080  \u1088 \u1086 \u1084 \u1085 \u1099  \u1085 \u1072 \'a0\u1086 \u1073 \u1093 \u1086 \u1093 \u1072 \u1074 \u1101 \u1083 \u1072 , \u1090 \u1086  \u1080 \'a0\u1085 \u1072 \u1085 \u1101  \u1088 \u1086 \u1084 \u1085 \u1099 . \u1048 \'a0\u1089 \u1072 \u1084 \u1086  \u1075 \u1083 \u1072 \u1074 \u1085 \u1086 , \u1089 \u1086 \'a0\u1085 \u1072 \u1096 \u1090 \u1099  \u1086 \u1073 \u1074 \u1080 \u1085 \u1103 \u1090 \u1100 . \u1025 \u1085 \u1101  \u1090 \u1101 \u1088 \u1085 \u1101 \u1085 \u1076 \u1099 \u1088  \u1073 \u1101 \u1088 \u1096 \u1101 \u1085 \u1076 \u1099 \u1088  \u1087 \u1088 \u1080 \u1089 \u1099 \u1082 \u1083 \u1099 \u1085 \u1101  \u1076 \u1103 \u1082 \u1101 . \u1042 \u1072 \u1074 \u1088 \u1101 \u1089  \u1085 \u1072 \'a0\u1076 \u1078 \u1080 \u1085 \u1101 \u1085 . \u1051 \u1101 \u1085 \u1075 \u1080 \u1088 \u1101  \u1073 \u1072 \u1073 \u1100 \u1103 , \u1076 \u1072 \u1081 \u1103  \u1076 \u1103 \u1082 \u1101  \u1076 \u1078 \u1080 \u1074 \u1101 \u1085 \u1072 \u1089 . \u1025 \u1085 \u1101  \u1085 \u1072 \'a0\u1087 \u1086 \u1083 \u1101 \u1085 , \u1089 \u1086 \'a0\u1084 \u1086 \u1078 \u1085 \u1086  \u1074 \u1072 \u1074 \u1088 \u1101 \u1089  \u1090 \u1101  \u1076 \u1078 \u1080 \u1074 \u1101 \u1085 . \u1045 \u1089 \u1083 \u1080  \u1093 \u1086 \u1093 \u1072 \u1074 \u1101 \u1085 , \u1090 \u1086  \u1085 \u1072 \'a0\u1087 \u1072 \u1083 \u1076 \u1086 \u1074 \u1072 , \u1089 \u1086 \'a0\u1093 \u1086 \u1083 \u1103 \u1084 \u1101 . \u1059 \u1090 \u1088 \u1086 \u1089 \u1072  \u1105 \u1085 \u1101  \u1075 \u1101 \u1085 \u1101  \u1090 \u1072 \u1073 \u1086 \u1088 \u1086 \u1089 \u1090 \u1099 \u1088  \u1090 \u1101  \u1079 \u1091 \u1084 \u1072 \u1074 \u1101 \u1085 , \u1090 \u1101  \u1095 \u1105 \u1088 \u1101 \u1085 , \u1089 \u1099 \u1088  \u1087 \u1088 \u1101  \u1073 \u1091 \u1090 \u1099 . \u1040 \'a0\u1088 \u1086 \u1084 \u1072 \u1085 \u1101  \u1095 \u1072 \u1074 \u1086 \u1088 \u1101 , \u1042 \u1072 \u1085 \u1103 , \u1076 \u1072 \u1089 \u1072 \u1074 \u1101 \'a0\u1078 \u1077  \u1095 \u1072 \u1074 \u1086 \u1088 \u1101  \u1089 \u1099 \u1088  \u1090 \u1091  \u1080 \'a0\u1053 \u1102 \u1088 \u1072 , \u1076 \u1088 \u1101  \u1072 \u1076 \u1072  \u1074 \u1088 \u1077 \u1084 \u1105  \u1090 \u1099 \u1088 \u1076 \u1099 \u1085 \u1101  \u1074 \u1072 \u1089 \u1090 \u1072  \u1087 \u1072 \u1083 \u1086  \u1087 \u1086 \u1076 \u1072 \u1103 \u1085 \u1080 \u1077 . \u1048 \'a0\u1087 \u1086 \u1087 \u1088 \u1086 \u1073 \u1080 \u1085 \u1101  \u1088 \u1086 \u1084 \u1085 \u1099  \u1090 \u1101  \u1085 \u1072 \'a0\u1103 \u1085 \u1076 \u1101 \u1083  \u1088 \u1086 \u1084 \u1101 \u1089 \u1082 \u1101  \u1083 \u1086 \u1074 \u1101  \u1074 \u1072 \u1096  \u1073 \u1088 \u1072 \u1074 \u1080 \u1085 \u1090 \u1072  \u1080 \'a0\u1090 \u1072 \u1073 \u1072 \u1082 \u1086 ! \u1025 \u1074  \u1089 \u1083 \u1101 \u1083 \u1072  \u1094 \u1099 \u1087 \u1072 . \u1058 \u1091  \u1085 \u1080 \u1082 \u1101 \u1076 \u1101  \u1085 \u1072 \'a0\u1076 \u1099 \u1082 \u1093 \u1090 \u1103 \u1085 , \u1089 \u1099 \u1088  \u1084 \u1072 \u1088 \u1101 \u1085  \u1088 \u1086 \u1084 \u1085 \u1077 \u1085  \u1073 \u1072 \u1076 \u1086 \u1075 \u1086 \u1089 \u1072 ?\cb1 \
\cb3 \uc0\u1042 \u1072 \u1085 \u1103  \u1087 \u1077 \u1088 \u1077 \u1089 \u1087 \u1091 \u1095 \u1100 \u1103 :\cb1 \
\cb3 \'96\'a0\uc0\u1040 \'a0\u1089 \u1086 \'a0\u1076 \u1072 , \'ab\u1073 \u1072 \u1076 \u1086 \u1075 \'bb?\cb1 \
\cb3 \'96\'a0\uc0\u1044 \u1099 \u1082 \u1093 \u1101 \u1089 , \u1076 \u1072 \u1078 \u1077  \u1085 \u1072 \'a0\u1076 \u1078 \u1080 \u1085 \u1101 \u1089 , \u1089 \u1086 \'a0\u1072 \u1076 \u1072  \u1073 \u1072 \u1088 \u1080  \u1095 \u1102 \u1087 \u1085 \u1099 . \u1052 \u1101  \u1076 \u1099 \u1082 \u1090 \u1105 \u1084  \u1085 \u1072 \'a0\u1077 \u1082 \u1093  \u1084 \u1086 \u1083 \u1086 , \u1089 \u1099 \u1088  \u1076 \u1072 \u1076  \u1084 \u1072 \u1088 \u1076 \u1103  \u1084 \u1080 \u1088 \u1100 \u1103  \u1076 \u1072 , \u1082 \u1101 \u1076 \u1101  \u1087 \u1088 \u1080 \u1103 \u1085 \u1076 \u1103  \u1085 \u1072 \u1073 \u1091 \u1090 . \u1048 \'a0\u1084 \u1072 \u1085 \u1075 \u1101  \u1076 \u1086 \u1088 \u1101 \u1089 \u1090 \u1103 \u1087 \u1101  \u1095 \u1102 \u1087 \u1085 \u1103 \u1090 \u1099 \u1088 . \u1040 \'a0\u1076 \u1072 \u1076  \u1089 \u1099 \u1089  \u1085 \u1072 \u1085 \u1101  \u1089 \u1072 \u1084 \u1086  \u1093 \u1086 \u1083 \u1103 \u1084 \u1086  \u1076 \u1088 \u1086  \u1090 \u1072 \u1073 \u1086 \u1088 \u1086 . \u1055 \u1072 \u1083  \u1072 \u1076 \u1072 \u1074 \u1072  \u1080 \'a0\u1089 \u1099 \u1089  \u1084 \u1072 \u1088 \u1080 \u1073 \u1101  \u1084 \u1072 \u1096 \u1082 \u1080 \u1088  \u1090 \u1101 \u1088 \u1085 \u1101 \u1085 \u1076 \u1101  \u1080 \'a0\u1087 \u1093 \u1091 \u1088 \u1101 \u1085 \u1076 \u1101 . \u1054 \u1089 \u1086 \u1073 \u1077 \u1085 \u1085 \u1086  \u1076 \u1072 \u1089 \u1072 \u1074 \u1101 , \u1082 \u1086 \u1085  \u1089 \u1099 \u1089  \u1087 \u1088 \u1086  \u1084 \u1072 \u1088 \u1080 \u1073 \u1101 , \u1085 \u1072 \'a0\u1082 \u1072 \u1084 \u1101 \u1085 \u1072 \u1089  \u1090 \u1101  \u1096 \u1091 \u1085 \u1101 \u1085  \u1076 \u1072 \u1078 \u1077  \u1087 \u1072 \u1083  \u1083 \u1086 \u1076 \u1099 \u1087 \u1101 . \u1063 \u1072 \u1074 \u1086 \u1088 \u1101  \u1080 \'a0\u1076 \u1072 \u1076 \u1072  \u1084 \u1072 \u1088 \u1101 \u1085 \u1072 \u1089 \u1087 \u1101 \u1089  \u1084 \u1072 \u1096 \u1082 \u1080 \u1088  \u1087 \u1101 \u1089 \u1090 \u1101 . \u1044 \u1072 \u1078 \u1077  \u1078 \u1099 \u1082 \u1086  \u1088 \u1072 \u1090 . \u1053 \u1072 \'a0\u1076 \u1078 \u1080 \u1085 \u1072 \u1074 , \u1089 \u1082 \u1080 \u1094 \u1080 \u1082  \u1074 \u1088 \u1077 \u1084 \u1105  \u1076 \u1078 \u1080 \u1074 \u1101 \u1085 \u1072 \u1089 \'a0\u1073 \u1099  \u1076 \u1088 \u1101  \u1085 \u1091 \u1078 \u1076 \u1072 , \u1082 \u1072 \u1081  \u1076 \u1078 \u1102 \u1074 \u1072 . \u1055 \u1093 \u1091 \u1088 \u1101  \u1088 \u1086 \u1084 \u1072  \u1079 \u1086 \u1088 \u1072 \u1083 \u1101 \u1089  \u1088 \u1080 \u1082 \u1080 \u1088 \u1101 \u1085 \u1072 \u1089  \u1074 \u1083 \u1072 \u1089 \u1090 \u1100  \u1076 \u1088 \u1086  \u1074 \u1072 \u1089 \u1090 \u1072 . \u1053 \u1101  \u1103 \u1074 \u1100 \u1103  \u1089 \u1086 \u1074 \u1077 \u1090 \u1089 \u1082 \u1086  \u1074 \u1083 \u1072 \u1089 \u1090 \u1100 . \u1055 \u1093 \u1101 \u1085 \u1076 \u1103 : \'ab\'96 \u1040 \u1074 \u1101 \u1083 \u1072  \u1090 \u1091 \u1084 \u1101 \u1085 \u1075 \u1101  \u1090 \u1101  \u1083 \u1086 \u1076 \u1101 \u1085 ! \u1050 \u1072 \u1085 \u1072  \u1090 \u1091 \u1084 \u1101  \u1073 \u1091 \u1090 \u1099 \u1088  \u1085 \u1072 \u1085 \u1101  \u1073 \u1080 \u1082 \u1093 \u1101 \u1088 \u1080 \u1090 \u1082 \u1072 , \u1072 \'a0\u1076 \u1072 \u1089 \u1072 \u1074 \u1101 , \u1089 \u1099 \u1088  \u1089 \u1072 \u1088 \u1101 !\'bb. \u1048 \'a0\u1077 \u1089 \u1083 \u1080  \u1090 \u1091 \u1082 \u1101 , \u1042 \u1072 \u1085 \u1103 , \u1082 \u1086 \u1085  \u1087 \u1093 \u1101 \u1085 \u1101 \u1083 \u1072  \u1089 \u1086 \'a0\u1084 \u1101  \u1095 \u1102 \u1088 \u1076 \u1072 \u1074 \u1072  \u1082 \u1086 \u1083 \u1093 \u1086 \u1079 \u1086 , \u1076 \u1078 \u1103 \u1074 \u1072  \u1087 \u1080 \u1088 \u1101  \u1087 \u1093 \u1091 \u1074  \u1090 \u1101  \u1088 \u1086 \u1076 \u1072 \u1074  \u1087 \u1101 \u1089 \u1082 \u1080 \u1088 \u1080  \u1088 \u1086 \u1084 \u1072 \u1085 \u1099  \u1073 \u1072 \u1093 \u1090 , \u1090 \u1091  \u1085 \u1072 \'a0\u1087 \u1072 \u1090 \u1103  \u1072 \u1076 \u1072 \u1083 \u1101 \u1089 \u1082 \u1101  \u1084 \u1072 \u1085 \u1091 \u1096 \u1101 \u1089 \u1082 \u1101 . \u1052 \u1086 \u1078 \u1077 \u1090 , \u1082 \u1086 \u1085  \u1074 \u1072 \u1074 \u1088 \u1101 \u1085 \u1076 \u1099 \u1088  \u1088 \u1086 \u1084 \u1101 \u1085 \u1076 \u1099 \u1088  \u1076 \u1099 \u1082 \u1093 \u1101 \u1083  \u1076 \u1088 \u1101  \u1092 \u1101 \u1083 \u1076 \u1072 , \u1089 \u1091 \u1085 \u1075 \u1101 \u1083  \u1073 \u1072 \u1083 \u1074 \u1072 \u1083 , \u1085 \u1101  \u1090 \u1086 \u1083 \u1100 \u1082 \u1086  \u1085 \u1072 \u1085 \u1101  \u1084 \u1101 . \u1052 \u1101  \u1072 \u1076 \u1072 \u1083 \u1101 \u1085  \u1073 \u1072 \u1083 \u1074 \u1072 \u1083 \u1101 \u1085  \u1085 \u1072 \u1089 \u1091 \u1085 \u1075 \u1090 \u1105 \u1084 \u1087 \u1101 . \u1052 \u1101  \u1082 \u1101  \u1072 \u1076 \u1072 \u1074 \u1072  \u1073 \u1088 \u1101 \u1075 \u1086  \u1078 \u1099 \u1082 \u1086  \u1082 \u1086 \u1085 \u1094 \u1086  \u1076 \u1078 \u1080 \u1080 \u1073 \u1101  \u1103 \u1074 \u1100 \u1105 \u1084 . \u1040 \u1076 \u1072 \u1081  \u1088 \u1086 \u1076 \u1085 \u1086  \u1084 \u1086 \u1075 \u1080 \u1083 \u1082 \u1072 , \u1072 \u1076 \u1072 \u1081  \u1080 \'a0\u1076 \u1086 \u1076 \u1078 \u1080 \u1074 \u1072 \u1074 \u1072  \u1087 \u1101 \u1089 \u1082 \u1080 \u1088 \u1086  \u1074 \u1077 \u1082 \u1086 .\cb1 \
\cb3 \uc0\u1055 \u1088 \u1101  \u1072 \u1076 \u1072 \u1074 \u1072  \u1042 \u1072 \u1085 \u1103  \u1090 \u1080 \u1093 \u1101 \u1089  \u1087 \u1093 \u1101 \u1085 \u1076 \u1103 :\cb1 \
\cb3 \'96\'a0\uc0\u1058 \u1091 \u1084 \u1101  \u1077 \u1097 \u1105  \u1085 \u1072 \u1085 \u1101  \u1087 \u1093 \u1091 \u1088 \u1086 .\cb1 \
\cb3 \'96\'a0\uc0\u1054 \u1076 \u1086 \u1074 \u1072  \u1084 \u1072 \u1085 \u1091 \u1096  \u1076 \u1083 \u1101 \u1085 \u1075 \u1101 \u1089  \u1076 \u1078 \u1080 \u1074 \u1101 \u1083 , \u1082 \u1086 \u1085  \u1076 \u1078 \u1080 \u1085 \u1101 \u1083 , \u1083 \u1101 \u1089 \u1082 \u1101  \u1095 \u1077 \u1081 \u1085 \u1086  \u1095 \u1072 \u1074 \u1086 \u1088 \u1101 \u1085  \u1087 \u1088 \u1101  \u1075 \'92\u1101 \u1088 \u1072  \u1090 \u1101  \u1075 \'92\u1072 \u1079 \u1076 \u1101 \u1083 . \u1040 \'a0\u1084 \u1072 \u1085 \u1075 \u1101 , \u1042 \u1072 \u1085 \u1103 , \u1085 \u1072 \u1085 \u1101  \u1082 \u1086 \u1085 \u1101 \u1089  \u1090 \u1101  \u1075 \'92\u1072 \u1079 \u1076 \u1072 \u1074 .\cb1 \
\cb3 \uc0\u1044 \u1072 \u1089 \u1072 \u1074 \u1101  \u1088 \u1072 \u1082 \u1080 \u1088 \u1080 \u1073 \u1101 \u1085 \u1072  \u1089 \u1073 \u1083 \u1080 \u1078 \u1072 \u1083 \u1080  \u1083 \u1101 \u1085 . \u1050 \u1072 \u1085 \u1072  \u1089 \u1099 \u1089  \u1090 \u1101 \u1088 \u1085 \u1086  \u1076 \u1088 \u1091 \u1075 \u1086 , \u1082 \u1086 \u1085 \u1101 \u1089 \u1082 \u1101  \u1084 \u1086 \u1078 \u1085 \u1101 \u1089  \u1090 \u1101  \u1086 \u1090 \u1082 \u1101 \u1088 \u1101 \u1089  \u1086 \'a0\u1076 \u1080 . \u1053 \u1072 \'a0\u1076 \u1072 \u1088 \u1101 \u1083 \u1087 \u1101 , \u1089 \u1086 \'a0\u1105 \u1074  \u1089 \u1082 \u1101 \u1088 \u1101 \u1083 \u1072  \u1092 \u1091 \u1080 \u1087 \u1101 . \u1042 \u1072 \u1074 \u1088 \u1101  \u1076 \u1088 \u1086  \u1093 \u1091 \u1090 \u1086 \u1088 \u1086  \u1075 \u1080 \u1085 \u1101 \u1085 \u1072 \u1089 , \u1089 \u1086 \'a0\u1041 \u1091 \u1076 \u1091 \u1083 \u1072 \u1105  \u1089 \u1082 \u1088 \u1099 \u1090 \u1085 \u1086  \u1084 \u1072 \u1085 \u1091 \u1096 . \u1047 \u1072 \u1075 \u1072 \u1076 \u1086 \u1095 \u1085 \u1086  \u1091 \u1083 \u1099 \u1073 \u1082 \u1072  \u1087 \u1088 \u1072 \u1089 \u1090 \u1072 \u1083  \u1087 \u1088 \u1101  \u1042 \u1072 \u1085 \u1103 \u1089 \u1082 \u1080 \u1088 \u1086  \u1084 \u1091 \u1081 , \u1082 \u1101 \u1076 \u1101  \u1096 \u1091 \u1085 \u1101 \u1083 \u1072 \u1089  \u1076 \u1072 \u1089 \u1072 \u1074 \u1101  \u1083 \u1072 \u1074 \u1072 . \u1044 \u1078 \u1080 \u1085 \u1101 \u1085 \'a0\u1083 \u1080  \u1105 \u1085 \u1101  \u1076 \u1103 \u1082 \u1101 \'a0\u1078 \u1077  \u1086 \u1090 \u1082 \u1088 \u1086 \u1074 \u1077 \u1085 \u1085 \u1086  \u1080 \'a0\u1080 \u1085 \u1090 \u1077 \u1088 \u1077 \u1089 \u1085 \u1086  \u1090 \u1101  \u1088 \u1072 \u1082 \u1080 \u1088 \u1101 \u1085 ? \u1041 \u1091 \u1076 \u1091 \u1083 \u1072 \u1105 \'a0\u1078 \u1077  \u1076 \u1080 \u1074 \u1080 \u1085 \u1076 \u1103 \u1087 \u1101 , \u1089 \u1099 \u1088  \u1042 \u1072 \u1085 \u1103 \u1089 \u1082 \u1101  \u1091 \u1076 \u1099 \u1103 \u1087 \u1101  \u1083 \u1101 \u1089  \u1090 \u1101  \u1088 \u1086 \u1079 \u1088 \u1072 \u1082 \u1080 \u1088 \u1101 \u1083 . \u1052 \u1086 \u1078 \u1077 \u1090 , \u1073 \u1072 \u1085 \u1075 \u1086  \u1042 \u1072 \u1085 \u1103 \u1089 \u1082 \u1080 \u1088 \u1086  \u1074 \u1079 \u1076 \u1099 \u1093 \u1080 \u1080 \u1073 \u1101 , \u1089 \u1072 \u1074 \u1086  \u1083 \u1101 \u1089  \u1073 \u1077 \u1089 \u1087 \u1086 \u1082 \u1086 \u1080 \u1083 ? \u1054 \u1089 \u1086 \u1073 \u1077 \u1085 \u1085 \u1086  \u1082 \u1101 \u1076 \u1101  \u1105 \u1085 \u1101  \u1090 \u1101 \u1088 \u1076 \u1105 \u1085 \u1072 \u1089  \u1077 \u1082 \u1093  \u1082 \u1086  \u1077 \u1082 \u1093  \u1084 \u1091 \u1077 \u1085 \u1094 \u1072 . \u1042 \u1072 \u1085 \u1103  \u1080 \u1085 \u1086 \u1075 \u1076 \u1072  \u1076 \u1088 \u1086  \u1091 \u1087 \u1086 \u1088 \u1086  \u1076 \u1099 \u1082 \u1093 \u1101 \u1083 \u1072 \u1089  \u1087 \u1088 \u1101  \u1041 \u1091 \u1076 \u1091 \u1083 \u1072 \u1105 \u1089 \u1090 \u1101 . \u1048 \'a0\u1089 \u1099 \u1088  \u1105 \u1074  \u1096 \u1091 \u1085 \u1101 \u1083 \u1072 \u1089 , \u1089 \u1090 \u1088 \u1072 \u1076 \u1072 \u1083 \u1100 \u1095 \u1077 \u1089 \u1082 \u1080  \u1087 \u1093 \u1072 \u1075 \u1080 \u1088 \u1101 \u1083  \u1087 \u1093 \u1086 \u1074 \u1072 , \u1089 \u1072 \u1085 \u1101  \u1085 \u1086 \u1079 \u1076 \u1088 \u1080 , \u1082 \u1101 \u1076 \u1101  \u1041 \u1091 \u1076 \u1091 \u1083 \u1072 \u1105  \u1080 \u1083 \u1101 \u1089 \u1090 \u1099 \u1088  \u1090 \u1086 \u1089 \u1082 \u1080 \u1085 \u1076 \u1103 . \u1053 \u1101  \u1073 \u1091 \u1090 \u1099 \u1088  \u1090 \u1080 \u1084 \u1080 \u1085 \u1101 \u1083 \u1072 \u1089  \u1041 \u1091 \u1076 \u1091 \u1083 \u1072 \u1105 , \u1089 \u1086 \'a0\u1077 \u1074  \u1089 \u1099 \u1089  \u1089 \u1087 \u1086 \u1089 \u1086 \u1073 \u1085 \u1086 . \u1040 \'a0\u1082 \u1101 \u1076 \u1101  \u1083 \u1099 \u1103 \u1087 \u1101  \u1090 \u1101  \u1082 \u1101 \u1088 \u1101 \u1083  \u1088 \u1077 \u1097 \u1105 \u1090 \u1082 \u1072  \u1074 \u1072 \u1096  \u1086 \u1075 \u1088 \u1072 \u1076 \u1082 \u1072 , \u1093 \u1072 \u1081  \u1076 \u1091 \u1078 \u1072 \u1082 \u1080 \u1088 \u1101 \u1083 \u1072 \u1089  \u1090 \u1101  \u1089 \u1099 \u1082 \u1072 \u1074 \u1101 \u1083  \u1087 \u1088 \u1101  \u1089 \u1086 \'a0\u1089 \u1087 \u1086 \u1089 \u1086 \u1073 \u1085 \u1086 .\cb1 \
