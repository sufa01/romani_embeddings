\cb3 \'96\'a0\uc0\u1057 \u1086 \'a0\u1078 \u1077  \u1090 \u1091  \u1082 \u1072 \u1085 \u1072  \u1082 \u1072 \u1084 \u1101 \u1089  \u1084 \u1072 \u1085 \u1076 \u1099 \u1088 ?\cb1 \
\cb3 \uc0\u1050 \u1072 \u1083 \u1086  \u1089 \u1082 \u1101 \u1088 \u1076 \u1103  \u1074 \u1072 \u1089 \u1090 :\cb1 \
\cb3 \'96\'a0\uc0\u1044 \u1086 \u1075 \u1086 \u1074 \u1086 \u1088 \u1086 \'a0\'96 \u1083 \u1099 \u1083 . \u1055 \u1080 \u1088 \u1076 \u1072 \u1083  \u1095 \u1072 \u1089 \u1086  \u1075 \u1088 \u1072 \u1089 \u1085 \u1099 \'a0\u1087 \u1099 \u1103 .\cb1 \
\cb3 \uc0\u1041 \u1091 \u1093 \u1075 \u1072 \u1083 \u1090 \u1077 \u1088 \u1086  \u1080 \u1079 \u1074 \u1077 \u1088 \u1085 \u1091 \u1083 \u1089 \u1103 , \u1080 \'a0\u1089 \u1099 \u1075 \u1101 \u1089  \u1089 \u1087 \u1091 \u1095 \u1100 \u1103 :\cb1 \
