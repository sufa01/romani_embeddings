\cb3 \uc0\u1043 \u1072 \u1076 \u1078 \u1105  \u1080 \'a0\u1075 \u1072 \u1076 \u1080  \u1087 \u1077 \u1088 \u1074 \u1086  \u1088 \u1103 \u1076 \u1086 \u1089 \u1090 \u1099 \u1088  \u1075 \'92\u1072 \u1079 \u1076 \u1099 \u1085 \u1101 \u1087 \u1101 \u1089  \u1087 \u1088 \u1101  \u1089 \u1090 \u1091 \u1087 \u1077 \u1085 \u1100 \u1082 \u1080  \u1082 \u1086  \u1089 \u1082 \u1072 \u1084 \u1080 \u1085 \u1076 , \u1082 \u1072 \u1081  \u1089 \u1099 \u1089  \u1089 \u1077 \u1088 \u1086  \u1094 \u1074 \u1101 \u1090 \u1086 \u1089 \u1082 \u1080 \u1088 \u1086  \u1089 \u1082 \u1072 \u1090 \u1105 \u1088 \u1082 \u1072 . \u1041 \u1101 \u1096 \u1085 \u1101 . \u1061 \u1091 \u1083 \u1072 \u1085 \u1099  \u1080 \'a0\u1072 \u1076 \u1072 \u1081  \u1087 \u1088 \u1086 \u1074 \u1086 \u1088 \u1095 \u1072 \u1083 \u1072  \u1087 \u1088 \u1101  \u1082 \u1072 \u1085  \u1089 \u1086 \u1089 \u1077 \u1076 \u1082 \u1077 :\cb1 \
