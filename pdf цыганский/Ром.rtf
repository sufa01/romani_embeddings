\cb3 \'96\'a0\uc0\u1061 \u1086 \u1093 \u1072 \u1074 \u1101 \u1089 !\'a0\'96 \u1079 \u1075 \u1086 \u1076 \u1083 \u1099 \u1103  \u1105 \u1081 ,\'a0\'96 \u1058 \u1091  \u1089 \u1072 \u1088 \u1086 , \u1072 \u1088 \u1084 \u1072 \u1085 \u1076 \u1099 \u1085 \u1099 , \u1093 \u1086 \u1093 \u1072 \u1074 \u1101 \u1089 !\'a0\'96 \u1080 \'a0\u1088 \u1072 \u1089 \u1090 \u1086 \u1087 \u1099 \u1088 \u1080 \u1074  \u1072 \u1085 \u1075 \u1091 \u1096 \u1090 \u1072 , \u1095 \u1102 \u1088 \u1076 \u1099 \u1103 \u1087 \u1101  \u1082 \u1101  \u1053 \u1072 \u1089 \u1090 \u1103 .\cb1 \
\cb3 \'96\'a0\uc0\u1040 \u1076 \u1072  \u1089 \u1072 \u1088 \u1086  \u1087 \u1080 \u1088 \u1076 \u1072 \u1083  \u1090 \u1091 \u1090 \u1101 ! \u1058 \u1091  \u1085 \u1072 \u1085 \u1101  \u1088 \u1086 \u1084 \u1085 \u1099 ! \u1056 \u1086 \u1084 \u1072 \u1085 \u1099 \u1087 \u1101  \u1085 \u1080 \u1095 \u1080  \u1085 \u1072 \'a0\u1072 \u1095 \u1100 \u1103 \u1087 \u1101 ! \u1055 \u1086 \u1076 \u1099 \u1082 \u1093  \u1087 \u1088 \u1101  \u1087 \u1101 \u1089 \u1090 \u1101 ! \u1053 \u1072 \u1085 \u1101  \u1084 \u1091 \u1088 \u1096 , \u1085 \u1072 \u1085 \u1101  \u1088 \u1086 \u1084 \u1085 \u1099 ! \u1056 \u1086 \u1084 \u1085 \u1099  \u1085 \u1080 \u1082 \u1101 \u1076 \u1101  \u1087 \u1101 \u1089 \u1082 \u1080 \u1088 \u1101 \u1085  \u1085 \u1072 \'a0\u1073 \u1080 \u1082 \u1085 \u1101 \u1083 \u1072 \u1089 !\cb1 \
