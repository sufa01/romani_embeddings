\cb3 \'96\'a0\uc0\u1040 \'a0\u1072 \u1076 \u1072  \u1084 \u1101  \u1087 \u1086 \u1083 \u1091 \u1095 \u1080 \u1083  \u1082 \u1101 \u1076 \u1101  \u1091 \u1075 \u1101 \u1105 \u1084  \u1076 \u1088 \u1101  \u1086 \u1090 \u1089 \u1090 \u1072 \u1074 \u1082 \u1072 . \u1050 \u1101 \u1076 \u1101  \u1088 \u1086 \u1089 \u1092 \u1086 \u1088 \u1084 \u1080 \u1088 \u1086 \u1074 \u1072 \u1083 \u1080  \u1072 \u1084 \u1072 \u1088 \u1086  \u1055 \u1103 \u1090 \u1086  \u1044 \u1086 \u1085 \u1089 \u1082 \u1086  \u1082 \u1086 \u1088 \u1087 \u1091 \u1089 \u1086 . \u1057 \u1095 \u1080 \u1085 \u1076 \u1083 \u1101  \u1082 \u1086 \u1085 \u1085 \u1080 \u1094 \u1091  \u1076 \u1088 \u1101  \u1072 \u1088 \u1093 \u1080 \u1074 \u1086 \'85 \u1053 \u1101 , \u1077 \u1089 \u1083 \u1080  \u1090 \u1091  \u1086 \u1076 \u1086 \u1074 \u1072  \u1088 \u1086 \u1084 , \u1090 \u1086  \u1076 \u1078 \u1080 \u1085 \u1101 \u1089 , \u1089 \u1099 \u1088  \u1090 \u1091 \u1084 \u1101 \u1085 \u1075 \u1101  \u1076 \u1088 \u1086  \u1076 \u1074 \u1077 \u1085 \u1072 \u1076 \u1094 \u1072 \u1090 \u1086  \u1091 \u1076 \u1099 \u1103 \u1087 \u1101  \u1096 \u1090 \u1072 \u1083 \u1072 \u1090 \u1099 \u1088  \u1082 \u1086 \u1088 \u1086 \u1083 \u1103  \u1052 \u1080 \u1093 \u1072 \u1103  \u1075 \u1088 \u1101 \u1089  \u1090 \u1101  \u1095 \u1105 \u1088 \u1101 \u1085 ?\cb1 \
