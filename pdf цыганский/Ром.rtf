\cb3 \'96\'a0\uc0\u1045 \u1089 \u1083 \u1080  \u1076 \u1088 \u1086 \u1075 \u1086  \u1090 \u1091 \u1082 \u1101 \'a0\'96 \u1087 \u1080 \u1088 \u1076 \u1072 \u1083  \u1076 \u1091 \u1081  \u1082 \u1093 \u1101 \u1088 \u1072  \u1040 \u1085 \u1092 \u1080 \u1089 \u1072  \u1052 \u1103 \u1075 \u1082 \u1086 \u1085 \u1086 \u1089 \u1086 \u1074 \u1072  \u1083 \u1101 \u1083  \u1087 \u1072 \u1085 \u1095 \u1100 -\u1076 \u1101 \u1096  \u1075 \'92\u1072 \u1089 \u1088 \u1080 \u1085 , \u1090 \u1077 \u1083 \u1077 \u1074 \u1080 \u1079 \u1077 \u1088 \u1086  \u1085 \u1072 \u1085 \u1101 . \u1052 \u1086 \u1075 \u1091  \u1090 \u1101  \u1087 \u1088 \u1086 \u1083 \u1099 \u1076 \u1078 \u1103 \u1074 .\cb1 \
