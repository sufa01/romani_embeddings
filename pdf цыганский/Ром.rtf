\cb3 \'96\'a0\uc0\u1050 \u1086 \u1085 \u1077 \u1095 \u1085 \u1086 , \u1041 \u1091 \u1076 \u1091 \u1083 \u1072 \u1105 .\cb1 \
\cb3 \'96\'a0\uc0\u1048 \'a0\u1089 \u1072 \u1088 \u1101  \u1087 \u1088 \u1086 \u1090 \u1080 \u1074  \u1076 \u1078 \u1102 \u1074 \u1083 \u1101 \u1085 . \u1053 \u1072 \'a0\u1075 \u1080 \u1085 \u1101 \u1085 \u1087 \u1101  \u1076 \u1078 \u1102 \u1074 \u1083 \u1077 \u1085 \u1094 \u1072 . \u1055 \u1072 \u1083  \u1082 \u1086 \u1085 \u1101 \u1089 \u1090 \u1101  \u1087 \u1088 \u1080 \u1087 \u1093 \u1101 \u1085 \u1101 \u1085 \u1072 , \u1087 \u1072 \u1083  \u1083 \u1101 \u1089 \u1090 \u1101  \u1080 \'a0\u1076 \u1078 \u1103 \u1083 . \u1044 \u1072 \u1078 \u1077  \u1077 \u1089 \u1083 \u1080  \u1105 \u1074  \u1089 \u1072 \u1088 \u1101 \u1089 \u1072  \u1087 \u1093 \u1091 \u1088 \u1086 , \u1085 \u1101 , \u1089 \u1099 \u1088  \u1084 \u1101 , \u1072 \'a0\u1105 \u1081  \u1090 \u1101 \u1088 \u1085 \u1099  \u1089 \u1099 \u1088  \u1090 \u1091 , \u1089 \u1072 \u1088 \u1101 \u1089 \u1072  \u1090 \u1099 \u1082 \u1085 \u1077 \u1085 \u1100 \u1082 \u1086 .\cb1 \
\cb3 \'96\'a0\uc0\u1052 \u1101  \u1091 \u1078 \u1077  \u1085 \u1072 \u1085 \u1101  \u1090 \u1099 \u1082 \u1085 \u1099 .\cb1 \
\cb3 \'96\'a0\uc0\u1040 \u1076 \u1072  \u1084 \u1101 , \u1053 \u1072 \u1089 \u1090 \u1103 , \u1074 \u1072 \u1096  \u1087 \u1088 \u1080 \u1084 \u1077 \u1088 \u1086  \u1087 \u1093 \u1101 \u1085 \u1076 \u1105 \u1084 .\cb1 \
\cb3 \'96\'a0\uc0\u1048 \'a0\u1090 \u1091  \u1085 \u1072 \u1085 \u1101  \u1087 \u1093 \u1091 \u1088 \u1086 , \u1084 \u1101  \u1090 \u1091 \u1082 \u1101  \u1088 \u1072 \u1082 \u1080 \u1088 \u1076 \u1105 \u1084 . \u1050 \u1086 \u1085 \u1077 \u1095 \u1085 \u1086 , \u1073 \u1091 \u1090  \u1076 \u1080 \u1082 \u1072  \u1086 \u1073 \u1099 \u1095 \u1072 \u1080 , \u1085 \u1101  \u1080 \'a0\u1083 \u1072 \u1095 \u1077  \u1080 \u1089 \u1099 , \u1041 \u1091 \u1076 \u1091 \u1083 \u1072 \u1105 .\cb1 \
\cb3 \uc0\u1055 \u1093 \u1091 \u1074  \u1087 \u1088 \u1080 \u1083 \u1101 \u1083  \u1080 \u1083 \u1099 \u1090 \u1082 \u1072  \u1091 \u1076 \u1072 \u1088 \u1099 , \u1089 \u1086 \u1073 \u1099  \u1090 \u1101  \u1088 \u1080 \u1089 \u1105 \u1083  \u1087 \u1072 \u1083 \u1101 . \u1048 \'a0\u1085 \u1072 \'a0\u1076 \u1078 \u1080 \u1085 \u1101 \u1089 , \u1082 \u1072 \u1081  \u1105 \u1085 \u1101  \u1073 \u1080 \u1103 \u1085 \u1076 \u1083 \u1101 \u1087 \u1101 \u1089 . \'ab\u1069 \u1085 \u1072 , \u1089 \u1072 \u1074 \u1101  \u1086 \u1073 \u1099 \u1095 \u1072 \u1080  \u1082 \u1101  \u1105 \u1085 \u1101  \u1080 \u1089 \u1099 ! \u1048 \'a0\u1087 \u1072 \u1083 \u1089 \u1086  \u1089 \u1087 \u1091 \u1095 \u1100 \u1103  \u1083 \u1101 \u1089 , \u1077 \u1089 \u1083 \u1080  \u1076 \u1078 \u1080 \u1085 \u1101 \u1083 , \u1089 \u1086 \'a0\u1105 \u1074  \u1089 \u1072 \u1088 \u1086  \u1088 \u1080 \u1087 \u1080 \u1088 \u1101 \u1083 ? \u1057 \u1099 \u1088  \u1080 \'a0\u1075 \u1080 \u1083 \u1099 , \u1089 \u1086 \'a0\u1073 \u1072 \u1075 \u1072 \u1083 \u1072 \u1089  \u1083 \u1101 \u1089 \u1082 \u1101  \u1043 \u1072 \u1083 \u1103 . \u1048 \'a0\u1089 \u1072  \u1077 \u1082 \u1093 , \u1089 \u1086 \'a0\u1105 \u1074  \u1083 \u1072 \u1082 \u1101  \u1087 \u1093 \u1101 \u1085 \u1076 \u1103 ?\'bb.\cb1 \
\cb3 \uc0\u1048 \'a0\u1072 \u1076 \u1072 \u1081  \u1079 \u1072 \u1093 \u1088 \u1080 \u1084 \u1080 \u1090 \u1099 \u1085 \u1076 \u1103  \u1086 \'a0\u1075 \u1088 \u1072 \u1081 . \u1059 \u1095 \u1091 \u1080 \u1085 \u1076 \u1103  \u1087 \u1101 \u1089 \u1082 \u1080 \u1088 \u1101 \u1089  \u1093 \u1091 \u1083 \u1072 \u1089 , \u1091 \u1096 \u1091 \u1085 \u1076 \u1103  \u1083 \u1101 \u1089 \u1082 \u1080 \u1088 \u1080  \u1075 \u1083 \u1086 \u1089 . \u1044 \u1099 \u1103  \u1090 \u1101  \u1076 \u1078 \u1080 \u1085 \u1101 \u1083  \u1087 \u1072 \u1083  \u1087 \u1101 \u1089 \u1090 \u1101 . \u1048 \'a0\u1093 \u1091 \u1083 \u1072 \u1081  \u1091 \u1096 \u1091 \u1085 \u1076 \u1103 , \u1079 \u1072 \u1073 \u1077 \u1089 \u1087 \u1086 \u1082 \u1086 \u1080 \u1083 \u1089 \u1103 . \u1059 \u1096 \u1090 \u1099 \u1103 , \u1080 \'a0\u1087 \u1086 \u1076 \u1099 \u1082 \u1093 \u1090 \u1103  \u1076 \u1088 \u1101  \u1083 \u1101 \u1089 \u1082 \u1080 \u1088 \u1080  \u1089 \u1090 \u1088 \u1086 \u1085 \u1072 .\cb1 \
